-    Perl_av_create_and_push(aTHX_ &PL_blockhooks, newSViv(PTR2IV(hk)));
+    Perl_av_create_and_push(aTHX_ &PL_blockhooks, newSViv(zptrtable_encode(Perl_xsub_ptrtable, hk)));
 }
 
