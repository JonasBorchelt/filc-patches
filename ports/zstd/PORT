NAME="zstd"
VERSION="1.5.7"
LICENSE="BSD-3-Clause OR GPL-2.0-only"
UPSTREAM_URL="https://github.com/meta/zstd/releases/download/v1.5.7/zstd-1.5.7.tar.gz"
UPSTREAM_SHA256="eb33e51f49a15e023950cd7825ca74a4a2b43db8354825ac24fc1b7ee09e6fa3"
EXTRACT_DIR="zstd-1.5.7"
TIER=1
DEPS="zlib lz4"
BUILD_SYSTEM="make"
MAKE_ARGS=""
INSTALL_ARGS=""
TEST_CMD=""
POLICY_CLASS="P2-Package"
POLICY_RATIONALE="Uses ZSTD_NO_ASM=1 to disable external x86-64 assembly files plus a minimal !defined(__FILC__) guard on x86-64 inline asm (cmova pointer selection in ZSTD_selectAddr and .p2align/nop loop alignment hints) to fall back to upstream portable C."
FILC_ORIGIN_REF="cede3de02b42:projects/zstd-1.5.7"

port_build() {
  ZSTD_NO_ASM=1 CPPFLAGS="-I$PIZFIX/include" LDFLAGS="-L$PIZFIX/lib" \
    make -j "$JOBS" CC="$CC" CXX="$CXX" HAVE_ZLIB=1 HAVE_LZ4=1 HAVE_LZMA=0 prefix="$PIZFIX"
}

port_install() {
  ZSTD_NO_ASM=1 CPPFLAGS="-I$PIZFIX/include" LDFLAGS="-L$PIZFIX/lib" \
    make CC="$CC" CXX="$CXX" HAVE_ZLIB=1 HAVE_LZ4=1 HAVE_LZMA=0 prefix="$PIZFIX" install
}

port_test() {
  "$PIZFIX/bin/zstd" --version
  printf 'filc-zstd-roundtrip-check\n' | "$PIZFIX/bin/zstd" -c | "$PIZFIX/bin/zstd" -dc | grep -qx 'filc-zstd-roundtrip-check'
}
