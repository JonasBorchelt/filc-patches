port_configure() {
  PATH="$PIZFIX/bin:$PATH" M4="$PIZFIX/bin/m4" \
    ./configure --prefix="$PIZFIX"
}

port_test() {
  "$PIZFIX/bin/bison" --version | grep -q 'GNU Bison.*3\.8\.2'
  local td
  td="$(mktemp -d)"
  cat > "$td/calc.y" <<'EOF'
%{
#include <stdio.h>
int yylex(void);
void yyerror(const char *s) { fprintf(stderr, "%s\n", s); }
static int result = 0;
%}
%token NUM
%%
input: expr { result = $1; };
expr: NUM { $$ = $1; }
    | expr '+' NUM { $$ = $1 + $3; };
%%
static const int toks[] = { NUM, '+', NUM, '+', NUM, 0 };
static const int vals[] = { 10, 0, 20, 0, 12, 0 };
static int pos = 0;
int yylex(void) {
  int t = toks[pos];
  yylval = vals[pos];
  if (t) pos++;
  return t;
}
int main(void) {
  if (yyparse() != 0) return 1;
  printf("BISON_OK: %d\n", result);
  return result == 42 ? 0 : 1;
}
EOF
  M4="$PIZFIX/bin/m4" "$PIZFIX/bin/bison" -d -o "$td/calc.tab.c" "$td/calc.y"
  "$CC" -O2 "$td/calc.tab.c" -o "$td/calc"
  "$td/calc" | grep -Fxq 'BISON_OK: 42'
  rm -rf "$td"
}
