NAME="openssl"
VERSION="3.6.5"
LICENSE="Apache-2.0"
UPSTREAM_URL="https://github.com/openssl/openssl/releases/download/openssl-3.6.5/openssl-3.6.5.tar.gz"
UPSTREAM_SHA256="a2157c2830efdec3788939b00c9b0638306d3f0bbb76dc4832ee503bb397df98"
UPSTREAM_SHA256_SOURCE="sha256:https://github.com/openssl/openssl/releases/download/openssl-3.6.5/openssl-3.6.5.tar.gz.sha256"
EXTRACT_DIR="openssl-3.6.5"
TIER=3
DEPS="zlib zstd"
BUILD_SYSTEM="custom"
CONFIGURE_ARGS="no-asm zlib enable-zstd -DOPENSSL_NO_SECURE_MEMORY"
MAKE_ARGS=""
INSTALL_ARGS="install_sw install_ssldirs"
TEST_CMD=""
POLICY_CLASS="P2-Package"
POLICY_RATIONALE="Audited down from Fil-C zunsafe-openssl3 (78 files, +2367/-756) to 1 file (+2/-1): pure-C no-asm build removes all -yolo-assembler/zunsafe wrappers, P1 llvm/06b eliminates shared-info.pl, and -DOPENSSL_NO_SECURE_MEMORY disables OpenSSL's raw-arena secure heap."
# P4-Audit note (-DOPENSSL_NO_SECURE_MEMORY functional tradeoff):
# OpenSSL's CRYPTO_secure_malloc() manages a custom raw mmap() arena with
# mlock() and guard pages using raw pointer arithmetic that is incompatible
# with Fil-C's capability heap allocator. Building with
# -DOPENSSL_NO_SECURE_MEMORY routes secure heap allocations through standard
# malloc/OPENSSL_cleanse. Users retain full Fil-C spatial/temporal memory
# safety (bounds, type, and use-after-free checks) and explicit zeroing on
# free, but give up mlock() swap prevention and guard pages around private
# key buffers (matching OpenSSL's behavior on platforms without mlock).
FILC_ORIGIN_REF="cede3de02b42:projects/zunsafe-openssl3.projeny"

port_configure() {
  ./Configure no-asm zlib enable-zstd -DOPENSSL_NO_SECURE_MEMORY \
    --prefix="$PIZFIX" --libdir=lib \
    --with-zlib-include="$PIZFIX/include" --with-zlib-lib="$PIZFIX/lib" \
    --with-zstd-include="$PIZFIX/include" --with-zstd-lib="$PIZFIX/lib" \
    -I"$PIZFIX/include" -L"$PIZFIX/lib"
}

port_build() {
  make -j"$JOBS"
}

port_install() {
  make -j"$JOBS" install_sw install_ssldirs
}

port_test() {
  "$PIZFIX/bin/openssl" version
  HARNESS_JOBS="$JOBS" make test TESTS="test_sha test_evp test_rsa test_ec test_x509 test_ssl_new"
  local td
  td="$(mktemp -d)"
  printf 'filc-openssl-check\n' > "$td/in.txt"
  "$PIZFIX/bin/openssl" dgst -sha256 "$td/in.txt" | grep -q 'SHA2-256'
  "$PIZFIX/bin/openssl" enc -aes-256-cbc -pbkdf2 -pass pass:filc-test -in "$td/in.txt" -out "$td/out.enc"
  "$PIZFIX/bin/openssl" enc -d -aes-256-cbc -pbkdf2 -pass pass:filc-test -in "$td/out.enc" -out "$td/out.txt"
  cmp -s "$td/in.txt" "$td/out.txt"
  "$PIZFIX/bin/openssl" genpkey -algorithm ED25519 -out "$td/ed.key"
  "$PIZFIX/bin/openssl" pkeyutl -sign -inkey "$td/ed.key" -rawin -in "$td/in.txt" -out "$td/in.sig"
  "$PIZFIX/bin/openssl" pkeyutl -verify -inkey "$td/ed.key" -rawin -in "$td/in.txt" -sigfile "$td/in.sig"
  rm -rf "$td"
}

port_package_smoke() {
  "$PKG_PREFIX/bin/openssl" version | grep -q '3\.6\.5'
  printf 'hello\n' | "$PKG_PREFIX/bin/openssl" dgst -sha256 | grep -q '5891b5b522d5df086d0ff0b110fbd9d21bb4fc7163af34d08286a2e846f6be03'
}
