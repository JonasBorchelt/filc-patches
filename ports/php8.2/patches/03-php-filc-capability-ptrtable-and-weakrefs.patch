Subject: Preserve pointer capabilities for typed properties and WeakRefs/WeakMap under Fil-C
Policy-Class: P4-Audit
Rationale: Fil-C drops a pointer's capability across integer round-trips. Tag zend_property_info_source_list and weakref payloads via pointer arithmetic, and route WeakMap object keys through a weak zexact_ptrtable mapping under __FILC__.
Upstream-Status: Fil-C-Specific
Fil-C-Origin-Commits: fd1f26a649078e4e12cb01026cf43199b6e6d160
Origin-Kind: filc-upstream
Origin-Project: pizlonator/fil-c
Origin-Commit: fd1f26a649078e4e12cb01026cf43199b6e6d160
Origin-URL: https://github.com/pizlonator/fil-c/commit/fd1f26a649078e4e12cb01026cf43199b6e6d160

diff --git a/Zend/zend_types.h b/Zend/zend_types.h
index 19e8d194..53302cb9 100644
--- a/Zend/zend_types.h
+++ b/Zend/zend_types.h
@@ -587,6 +587,19 @@ typedef struct {
 	struct _zend_property_info *ptr[1];
 } zend_property_info_list;
 
+#ifdef __FILC__
+/* Fil-C drops a pointer's capability when it becomes an integer, so tag the
+ * list pointer with pointer arithmetic instead. */
+typedef union {
+	struct _zend_property_info *ptr;
+	char *list;
+} zend_property_info_source_list;
+
+#define ZEND_PROPERTY_INFO_SOURCE_FROM_LIST(list) ((char *) (list) + 0x1)
+#define ZEND_PROPERTY_INFO_SOURCE_TO_LIST(list) \
+	((zend_property_info_list *) ((list) - ((uintptr_t) (list) & 0x1)))
+#define ZEND_PROPERTY_INFO_SOURCE_IS_LIST(list) ((uintptr_t) (list) & 0x1)
+#else
 typedef union {
 	struct _zend_property_info *ptr;
 	uintptr_t list;
@@ -595,6 +608,7 @@ typedef union {
 #define ZEND_PROPERTY_INFO_SOURCE_FROM_LIST(list) (0x1 | (uintptr_t) (list))
 #define ZEND_PROPERTY_INFO_SOURCE_TO_LIST(list) ((zend_property_info_list *) ((list) & ~0x1))
 #define ZEND_PROPERTY_INFO_SOURCE_IS_LIST(list) ((list) & 0x1)
+#endif
 
 struct _zend_reference {
 	zend_refcounted_h              gc;
--- a/Zend/zend_weakrefs.c
+++ b/Zend/zend_weakrefs.c
@@ -48,8 +48,23 @@
 #define ZEND_WEAKREF_TAG_REF 0
 #define ZEND_WEAKREF_TAG_MAP 1
 #define ZEND_WEAKREF_TAG_HT  2
 #define ZEND_WEAKREF_GET_TAG(p) (((uintptr_t) (p)) & 3)
+#ifdef __FILC__
+/* Tag with pointer arithmetic, which keeps the capability that an integer
+ * round trip would drop. Tagged pointers are aligned, so this matches | t. */
+#define ZEND_WEAKREF_GET_PTR(p) ((void *) ((char *) (p) - ZEND_WEAKREF_GET_TAG(p)))
+#define ZEND_WEAKREF_ENCODE(p, t) ((void *) ((char *) (p) + (t)))
+
+ZEND_API zexact_ptrtable *zend_weakref_objects;
+
+__attribute__((constructor)) static void zend_weakref_objects_init(void)
+{
+	/* Weak: weak references must not keep their objects alive. */
+	zend_weakref_objects = zexact_ptrtable_new_weak();
+}
+#else
 #define ZEND_WEAKREF_GET_PTR(p) ((void *) (((uintptr_t) (p)) & ~3))
 #define ZEND_WEAKREF_ENCODE(p, t) ((void *) (((uintptr_t) (p)) | (t)))
+#endif
 
 zend_class_entry *zend_ce_weakref;
 zend_class_entry *zend_ce_weakmap;
--- a/Zend/zend_weakrefs.h
+++ b/Zend/zend_weakrefs.h
@@ -51,6 +51,24 @@
  * It is not used for the HashTable instances associated with ZEND_WEAKREF_TAG_HT tags (created in zend_weakref_register, which uses ZEND_WEAKREF_ENCODE instead).
  * The ZEND_WEAKREF_TAG_HT instances are used to disambiguate between multiple weak references to the same zend_object.
  */
+#ifdef __FILC__
+/* Fil-C drops a pointer's capability when it becomes an integer, so record
+ * each object whose address becomes a key and look it up again. */
+#include <stdfil.h>
+
+extern ZEND_API zexact_ptrtable *zend_weakref_objects;
+
+static zend_always_inline zend_ulong zend_object_to_weakref_key(const zend_object *object)
+{
+	ZEND_ASSERT(((uintptr_t)object) % ZEND_MM_ALIGNMENT == 0);
+	return zexact_ptrtable_encode(zend_weakref_objects, (void *) object) >> ZEND_MM_ALIGNMENT_LOG2;
+}
+
+static zend_always_inline zend_object *zend_weakref_key_to_object(zend_ulong key)
+{
+	return zexact_ptrtable_decode(zend_weakref_objects, ((uintptr_t) key) << ZEND_MM_ALIGNMENT_LOG2);
+}
+#else
 static zend_always_inline zend_ulong zend_object_to_weakref_key(const zend_object *object)
 {
 	ZEND_ASSERT(((uintptr_t)object) % ZEND_MM_ALIGNMENT == 0);
@@ -61,5 +79,6 @@
 {
 	return (zend_object *) (((uintptr_t) key) << ZEND_MM_ALIGNMENT_LOG2);
 }
+#endif
 
 END_EXTERN_C()
