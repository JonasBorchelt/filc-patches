#!/usr/bin/env bash
set -euo pipefail

# Fast offline unit test for scripts/package-release using a realistic mock
# toolchain tree (including clang -> clang-23 and ld.lld -> lld symlinks).
#
# Verifies:
#   1. Packaging succeeds idempotently (no self-symlink failures on lld/clang)
#   2. Archive extracts cleanly and SHA256SUMS + MANIFEST pass sha256sum -c
#   3. LICENSES/, NOTICE, PROVENANCE, setup.sh, and bin/ wrappers are present
#   4. Leak-Gate rejects build-path / private-IP leaks in both text and ELF/ar strings

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TMP_DIR="$(cd "$(mktemp -d "${TMPDIR:-/tmp}/filc-pkgtest-XXXXXX")" && pwd)"
trap 'rm -rf "$TMP_DIR"' EXIT

# On Linux CI, real GNU tar, strip, patchelf, xz, sha256sum are used directly.
# On hosts without patchelf or GNU tar (e.g. macOS dev machines), provide thin
# shims in PATH so the exact packaging logic can still be unit-tested locally.
SHIM_BIN="$TMP_DIR/shim-bin"
mkdir -p "$SHIM_BIN"
if ! command -v patchelf >/dev/null 2>&1; then
  printf '#!/usr/bin/env bash\nexit 0\n' > "$SHIM_BIN/patchelf"
  chmod +x "$SHIM_BIN/patchelf"
fi
if ! strip --version 2>/dev/null | grep -qi 'GNU'; then
  printf '#!/usr/bin/env bash\nexit 0\n' > "$SHIM_BIN/strip"
  chmod +x "$SHIM_BIN/strip"
fi
if ! tar --version 2>/dev/null | grep -qi 'GNU tar'; then
  cat > "$SHIM_BIN/tar" <<'EOF'
#!/usr/bin/env python3
import os, sys, tarfile
args = sys.argv[1:]
if "-cf" in args:
    c_dir = None
    i = 0
    positional = []
    while i < len(args):
        a = args[i]
        if a == "-C":
            c_dir = args[i + 1]; i += 2
        elif a in ("-cf", "-f"):
            i += 2
        elif a.startswith("--"):
            i += 1
        else:
            positional.append(a); i += 1
    root = os.path.join(c_dir, positional[0]) if c_dir else positional[0]
    with tarfile.open(fileobj=sys.stdout.buffer, mode="w|") as tf:
        tf.add(root, arcname=positional[0])
else:
    os.execv("/usr/bin/tar", ["/usr/bin/tar"] + args)
EOF
  chmod +x "$SHIM_BIN/tar"
fi
export PATH="$SHIM_BIN:$PATH"

make_mock_toolchain() {
  local work="$1"
  mkdir -p \
    "$work/build/bin" \
    "$work/build/lib/clang/23/include" \
    "$work/build/include/c++/v1" \
    "$work/build/include/x86_64-unknown-linux-gnu/c++/v1" \
    "$work/pizfix/lib" \
    "$work/pizfix/include" \
    "$work/pizfix/musl-include" \
    "$work/pizfix/stdfil-include" \
    "$work/llvm-project" \
    "$work/filc-runtime/libpas" \
    "$work/usermusl"

  cat > "$work/build/bin/clang-23" <<'EOF'
#!/bin/sh
if [ "${1:-}" = "-print-target-triple" ]; then
  echo "x86_64-unknown-linux-gnu"
  exit 0
fi
echo "MOCK_CLANG:$0:$*"
EOF
  chmod 0755 "$work/build/bin/clang-23"
  ln -s clang-23 "$work/build/bin/clang"
  ln -s clang "$work/build/bin/clang++"

  cat > "$work/build/bin/lld" <<'EOF'
#!/bin/sh
echo "MOCK_LLD:$0:$*"
EOF
  chmod 0755 "$work/build/bin/lld"
  ln -s lld "$work/build/bin/ld.lld"

  echo "/* stddef */" > "$work/build/lib/clang/23/include/stddef.h"
  echo "// iostream" > "$work/build/include/c++/v1/iostream"
  echo "// config" > "$work/build/include/x86_64-unknown-linux-gnu/c++/v1/__config_site"
  echo "/* stdio */" > "$work/pizfix/include/stdio.h"
  echo "/* stdfil */" > "$work/pizfix/stdfil-include/stdfil.h"

  for f in libyoloc.so libpizlo.so libc.so libc++.so.1.0 libc++abi.so.1.0 crt1.o libyolort.a; do
    printf 'MOCK_LIB_%s\n' "$f" > "$work/pizfix/lib/$f"
  done
  ln -s libc++.so.1.0 "$work/pizfix/lib/libc++.so.1"
  ln -s "$work/pizfix/lib/libyoloc.so" "$work/pizfix/lib/ld-fil1-x86_64.so"

  echo "Apache-2.0 WITH LLVM-exception" > "$work/llvm-project/LICENSE.TXT"
  echo "BSD-2-Clause" > "$work/filc-runtime/libpas/LICENSE.txt"
  echo "MIT musl copyright" > "$work/usermusl/COPYRIGHT"
}

echo "=== [1/2] Clean mock toolchain packaging & archive integrity ==="
MOCK_WORK="$TMP_DIR/mock-tc"
OUT_DIR="$TMP_DIR/out"
make_mock_toolchain "$MOCK_WORK"

"$REPO_ROOT/scripts/package-release" "$MOCK_WORK" "$OUT_DIR" "0.0.0-mock"

(cd "$OUT_DIR" && sha256sum -c SHA256SUMS)
ARCHIVE="$(ls "$OUT_DIR"/filc-0.0.0-mock-*-linux.tar.xz)"
test -s "$ARCHIVE"
test -s "$OUT_DIR/PROVENANCE"
test -s "$OUT_DIR/MANIFEST"
test -s "$OUT_DIR/RELEASE_NOTES.md"

EXTRACT="$TMP_DIR/extract"
mkdir -p "$EXTRACT"
tar -xf "$ARCHIVE" -C "$EXTRACT"
ROOT_DIR="$(find "$EXTRACT" -mindepth 1 -maxdepth 1 -type d | head -n 1)"

(cd "$ROOT_DIR" && sha256sum -c MANIFEST >/dev/null)
for req in \
  LICENSES/LLVM-Apache-2.0-WITH-LLVM-exception.txt \
  LICENSES/FilC-Runtime-BSD-2-Clause.txt \
  LICENSES/musl-COPYRIGHT.txt \
  NOTICE \
  PROVENANCE \
  MANIFEST \
  README.txt \
  setup.sh \
  bin/clang \
  bin/clang++ \
  bin/ld.lld \
  build/bin/clang \
  build/bin/clang-23 \
  build/bin/lld \
  build/bin/ld.lld; do
  test -e "$ROOT_DIR/$req" || { echo "FAIL: missing $req in extracted archive" >&2; exit 1; }
done

# Verify wrapper invokes build/bin/clang with preserved root path
"$ROOT_DIR/bin/clang" -print-target-triple | grep -Fxq "x86_64-unknown-linux-gnu"
"$ROOT_DIR/bin/ld.lld" --version | grep -q "MOCK_LLD:$ROOT_DIR/build/bin/ld.lld:--version"
echo "CLEAN PACKAGING & MANIFEST OK"

echo "=== [2/2] Leak-Gate negative test ==="
LEAK_WORK="$TMP_DIR/leak-tc"
LEAK_OUT="$TMP_DIR/leak-out"
make_mock_toolchain "$LEAK_WORK"
printf '\x7fELF\x02\x01\x01\x00/Users/leak-fixture-path\x00' > "$LEAK_WORK/pizfix/lib/libpizlo.so"

if "$REPO_ROOT/scripts/package-release" "$LEAK_WORK" "$LEAK_OUT" "0.0.0-leak" 2>/dev/null; then
  echo "FAIL: package-release Leak-Gate should have rejected local path in binary strings" >&2
  exit 1
fi
echo "LEAK-GATE REJECTION OK"
echo "ALL PACKAGE-RELEASE TESTS PASSED"
