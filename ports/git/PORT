NAME="git"
VERSION="2.56.0"
LICENSE="GPL-2.0-only"
UPSTREAM_URL="https://www.kernel.org/pub/software/scm/git/git-2.56.0.tar.xz"
UPSTREAM_SHA256="26c56c296b38c0695b26fa95f475f1d01704d2d38e73465ca30b0b2f5dc789d3"
UPSTREAM_SHA256_SOURCE="sha256:https://www.kernel.org/pub/software/scm/git/sha256sums.asc"
EXTRACT_DIR="git-2.56.0"
TIER=5
DEPS="zlib curl expat openssl pcre2 pkgconf"
BUILD_SYSTEM="autotools"
CONFIGURE_ARGS="--with-libpcre2"
MAKE_ARGS="NO_RUST=1 NO_GETTEXT=1 NO_TCLTK=1 RUNTIME_PREFIX=YesPlease"
INSTALL_ARGS="NO_RUST=1 NO_GETTEXT=1 NO_TCLTK=1 RUNTIME_PREFIX=YesPlease INSTALL_SYMLINKS=YesPlease"
TEST_CMD=""
POLICY_CLASS="P2-Package"
POLICY_RATIONALE="Pinned to 2.56.0 to match the Fil-C git.projeny 23-file parse-options defval patch base. Audited down from 24 files (+74/-96) to 23 source files by passing NO_RUST=1 via MAKE_ARGS instead of patching config.mak. Preserves pointer capabilities in parse-options defval (void* instead of intptr_t) and uses single-object-per-chunk allocation in compat/obstack."
FILC_ORIGIN_REF="cede3de02b42:projects/git.projeny"

port_configure() {
  PATH="$PIZFIX/bin:$PATH" \
    CPPFLAGS="-I$PIZFIX/include" \
    LDFLAGS="-L$PIZFIX/lib" \
    PKG_CONFIG_PATH="$PIZFIX/lib/pkgconfig" \
    ./configure --prefix="$PIZFIX" \
      --with-gitconfig=/etc/gitconfig \
      --with-python=python3 \
      --with-libpcre2 \
      --with-curl="$PIZFIX" \
      --with-expat="$PIZFIX" \
      --with-zlib="$PIZFIX" \
      --with-openssl="$PIZFIX"
}

port_build() {
  make -j"$JOBS" NO_RUST=1 NO_GETTEXT=1 NO_TCLTK=1 RUNTIME_PREFIX=YesPlease
}

port_install() {
  make -j"$JOBS" NO_RUST=1 NO_GETTEXT=1 NO_TCLTK=1 RUNTIME_PREFIX=YesPlease INSTALL_SYMLINKS=YesPlease install
}

port_test() {
  test -L "$PIZFIX/libexec/git-core/git-status"
  local out ver
  out="$("$PIZFIX/bin/git" --version)"
  ver="${out%%$'\n'*}"
  echo "git version: $ver"
  echo "git --exec-path: $("$PIZFIX/bin/git" --exec-path)"
  printf '%s\n' "$ver" | grep -Fxq 'git version 2.56.0'
  local td
  td="$(mktemp -d)"
  "$PIZFIX/bin/git" -C "$td" init -q -b main
  "$PIZFIX/bin/git" -C "$td" config user.name "Fil-C Test"
  "$PIZFIX/bin/git" -C "$td" config user.email "test@example.invalid"
  printf 'hello filc\nfixed-string-needle\n' > "$td/file.txt"
  "$PIZFIX/bin/git" -C "$td" add file.txt
  "$PIZFIX/bin/git" -C "$td" commit -q -m "initial"
  # Exercises parse-options pointer defval ('git status -u')
  "$PIZFIX/bin/git" -C "$td" status -u --short
  # Exercises compat/obstack via kwset ('git grep -F')
  "$PIZFIX/bin/git" -C "$td" grep -F "fixed-string-needle" | grep -Fq 'file.txt:fixed-string-needle'
  "$PIZFIX/bin/git" -C "$td" log -n 1 --format=%s | grep -Fxq 'initial'
  rm -rf "$td"
}

port_package_smoke() {
  test -L "$PKG_PREFIX/libexec/git-core/git-status"
  test "$(readlink "$PKG_PREFIX/libexec/git-core/git-status")" = "../../bin/git"
  local out ver td exec_path expected_exec_path actual_exec_path
  out="$(env -u GIT_EXEC_PATH -u GIT_TEMPLATE_DIR "$PKG_PREFIX/bin/git" --version)"
  ver="${out%%$'\n'*}"
  printf '%s\n' "$ver" | grep -Fxq 'git version 2.56.0'
  # Verify RUNTIME_PREFIX resolves libexec/git-core relative to the binary without GIT_EXEC_PATH
  exec_path="$(env -u GIT_EXEC_PATH -u GIT_TEMPLATE_DIR "$PKG_PREFIX/bin/git" --exec-path)"
  expected_exec_path="$(realpath "$PKG_PREFIX/libexec/git-core")"
  actual_exec_path="$(realpath "$exec_path" 2>/dev/null || printf '%s' "$exec_path")"
  echo "git --exec-path: $exec_path (resolved=$actual_exec_path expected=$expected_exec_path)"
  test "$actual_exec_path" = "$expected_exec_path"
  td="$(mktemp -d)"
  env -u GIT_EXEC_PATH -u GIT_TEMPLATE_DIR "$PKG_PREFIX/bin/git" -C "$td" init -q -b main
  env -u GIT_EXEC_PATH -u GIT_TEMPLATE_DIR "$PKG_PREFIX/bin/git" -C "$td" config user.name "Fil-C Smoke"
  env -u GIT_EXEC_PATH -u GIT_TEMPLATE_DIR "$PKG_PREFIX/bin/git" -C "$td" config user.email "smoke@example.invalid"
  printf 'hello relocated\nneedle-line\n' > "$td/file.txt"
  env -u GIT_EXEC_PATH -u GIT_TEMPLATE_DIR "$PKG_PREFIX/bin/git" -C "$td" add file.txt
  env -u GIT_EXEC_PATH -u GIT_TEMPLATE_DIR "$PKG_PREFIX/bin/git" -C "$td" commit -q -m "smoke-initial"
  printf 'untracked\n' > "$td/new.txt"
  # Run git-status directly through the relative symlink in libexec/git-core
  (cd "$td" && env -u GIT_EXEC_PATH -u GIT_TEMPLATE_DIR "$PKG_PREFIX/libexec/git-core/git-status" -u --short) | grep -Fxq '?? new.txt'
  env -u GIT_EXEC_PATH -u GIT_TEMPLATE_DIR "$PKG_PREFIX/bin/git" -C "$td" grep -F "needle-line" | grep -Fq 'file.txt:needle-line'
  env -u GIT_EXEC_PATH -u GIT_TEMPLATE_DIR "$PKG_PREFIX/bin/git" -C "$td" log -n 1 --format=%s | grep -Fxq 'smoke-initial'
  rm -rf "$td"
}
