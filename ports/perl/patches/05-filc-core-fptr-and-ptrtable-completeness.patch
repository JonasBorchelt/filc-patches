-            if (svp && *svp != &PL_sv_undef && SvIVX(*svp) == PTR2IV(cop) ) {
+            if (svp && *svp != &PL_sv_undef && SvIVX(*svp) == (IV)zptrtable_encode(Perl_xsub_ptrtable, cop) ) {
                 SvIV_set(*svp, 0);
             }
         }
@@ -4667,7 +4667,7 @@
 {
