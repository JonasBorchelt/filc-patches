FILC_ORIGIN_REF="8553fcd026b9:projects/make-4.4.1"

port_configure() {
  ./configure --prefix="$PIZFIX" --without-guile --disable-nls
}

port_test() {
  local out
  out="$("$PIZFIX/bin/make" --version)"
  grep -q 'GNU Make 4\.4\.1' <<<"$out"

  local td
  td="$(mktemp -d)"
  cat > "$td/Makefile" <<'EOF'
GREETING := hello
TARGET ?= filc

all: out.txt
	@cat out.txt

out.txt:
	@printf '%s-%s\n' "$(GREETING)" "$(TARGET)" > $@
EOF
  out="$("$PIZFIX/bin/make" -C "$td" TARGET=make441)"
  grep -Fxq 'hello-make441' <<<"$out"
  test -f "$td/out.txt"
  rm -rf "$td"
}

port_package_smoke() {
  local out
  out="$("$PKG_PREFIX/bin/make" --version)"
  grep -q 'GNU Make 4\.4\.1' <<<"$out"

  local td
  td="$(mktemp -d)"
  cat > "$td/Makefile" <<'EOF'
ITEMS := a b c
all:
	@printf '%s\n' "$(words $(ITEMS)):$(strip $(ITEMS))"
EOF
  out="$("$PKG_PREFIX/bin/make" -C "$td")"
  grep -Fxq '3:a b c' <<<"$out"
  rm -rf "$td"
}
