NAME="curl-openssl1.1"
VERSION="8.23.0"
LICENSE="curl"
SUPPORT_STATUS="eol"
EOL_DATE="2023-09-11"
SECURITY_SOURCE="freexian-elts"
UPSTREAM_URL="https://github.com/curl/curl/releases/download/curl-8_23_0/curl-8.23.0.tar.xz"
UPSTREAM_SHA256="8dadd7d2536a314f982ad05a651b713f426bf7d02cc2c76cffb9796f2218e6c5"
UPSTREAM_SHA256_SOURCE="pgp:https://github.com/curl/curl/releases/download/curl-8_23_0/curl-8.23.0.tar.xz.asc key:ports/pgp-keys/curl-release-key.asc fpr:27EDEAF22F3ABCEB50DB9A125CC908FDB71E12C2"
UPSTREAM_SIG_URL="https://github.com/curl/curl/releases/download/curl-8_23_0/curl-8.23.0.tar.xz.asc"
UPSTREAM_PGP_KEY="ports/pgp-keys/curl-release-key.asc"
UPSTREAM_PGP_FPR="27EDEAF22F3ABCEB50DB9A125CC908FDB71E12C2"
EXTRACT_DIR="curl-8.23.0"
TIER=4
DEPS="openssl1.1 nghttp2 zlib zstd brotli libidn2 pkgconf"
