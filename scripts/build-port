#!/usr/bin/env bash
set -euo pipefail

# Build, install into staged Fil-C sysroot, and test a single port recipe.
#
# Usage: scripts/build-port <port-name> [WORK_ROOT]
#
# Environment:
#   FILC_TOOLCHAIN_ROOT   Path to Stage 5 toolchain work root (default: <WORK_ROOT>/toolchain or <REPO_ROOT>/.work/toolchain)
#   FILC_PORTS_CACHE_DIR  Tarball download cache directory (default: <WORK_ROOT>/ports-cache)
#   FILC_PORTS_JOBS       Parallel compile jobs (default: host nproc)
#   FILC_PORT_TIMEOUT     Per-stage command timeout in seconds (default: 900)
#   FILC_PORT_SKIP_DEPS   Set to 1 to skip dependency installation check

if [[ $# -lt 1 ]]; then
  echo "Usage: $0 <port-name> [WORK_ROOT]" >&2
  exit 2
fi

PORT_NAME="$1"
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PORTS_DIR="${FILC_PORTS_DIR:-$REPO_ROOT/ports}"
PORT_DIR="$PORTS_DIR/$PORT_NAME"
PORT_FILE="$PORT_DIR/PORT"

if [[ ! -f "$PORT_FILE" ]]; then
  echo "error: port recipe not found: $PORT_FILE" >&2
  exit 1
fi

WORK_ROOT="${2:-$REPO_ROOT/.work/ports}"
mkdir -p "$WORK_ROOT"
WORK_ROOT="$(cd "$WORK_ROOT" && pwd)"

CACHE_DIR="${FILC_PORTS_CACHE_DIR:-$WORK_ROOT/ports-cache}"
STATE_DIR="$WORK_ROOT/ports-state"
BUILD_BASE="$WORK_ROOT/ports-build"
mkdir -p "$CACHE_DIR" "$STATE_DIR" "$BUILD_BASE"

# Ensure the Fil-C runtime panic report directory exists before building so
# safety panics remain readable even when a failing program has closed fd 2.
FILC_PANICS_DIR="${FILC_PANICS_DIR:-/var/filc/panics}"
mkdir -p "$FILC_PANICS_DIR" 2>/dev/null || true
PANIC_SNAPSHOT="$STATE_DIR/$PORT_NAME.panics-before.$$"
if [[ -d "$FILC_PANICS_DIR" ]]; then
  ls -1 "$FILC_PANICS_DIR" 2>/dev/null | sort > "$PANIC_SNAPSHOT" || : > "$PANIC_SNAPSHOT"
else
  : > "$PANIC_SNAPSHOT"
fi

# Locate Stage 5 Fil-C toolchain
if [[ -n "${FILC_TOOLCHAIN_ROOT:-}" ]]; then
  TOOLCHAIN_ROOT="$FILC_TOOLCHAIN_ROOT"
elif [[ -d "$WORK_ROOT/toolchain/pizfix" ]]; then
  TOOLCHAIN_ROOT="$WORK_ROOT/toolchain"
else
  TOOLCHAIN_ROOT="$REPO_ROOT/.work/toolchain"
fi

PIZFIX="${FILC_PIZFIX:-$TOOLCHAIN_ROOT/pizfix}"
CLANG_BIN="${FILC_CLANG:-$TOOLCHAIN_ROOT/build/bin/clang}"
CLANGXX_BIN="${FILC_CLANGXX:-$TOOLCHAIN_ROOT/build/bin/clang++}"
LLVM_AR="${FILC_AR:-$TOOLCHAIN_ROOT/build/bin/llvm-ar}"
LLVM_RANLIB="${FILC_RANLIB:-$TOOLCHAIN_ROOT/build/bin/llvm-ranlib}"
LLVM_NM="${FILC_NM:-$TOOLCHAIN_ROOT/build/bin/llvm-nm}"

# Resolve host interpreter absolute paths before $PIZFIX/bin is prepended to PATH
# so harness logic never invokes staged Fil-C binaries (e.g. Fil-C ruby/python3).
resolve_host_tool() {
  local tool="$1"
  local fallback="$2"
  local clean_path=""
  local entry
  local old_ifs="$IFS"
  IFS=':'
  for entry in $PATH; do
    [[ -z "$entry" ]] && continue
    [[ "$entry" == "$PIZFIX/bin" ]] && continue
    clean_path="${clean_path:+$clean_path:}$entry"
  done
  IFS="$old_ifs"
  local found=""
  if [[ -n "$clean_path" ]]; then
    found="$(PATH="$clean_path" command -v "$tool" 2>/dev/null || true)"
  fi
  if [[ -n "$found" && -x "$found" ]]; then
    printf '%s\n' "$found"
  elif [[ -x "$fallback" ]]; then
    printf '%s\n' "$fallback"
  else
    printf '%s\n' "$tool"
  fi
}

HOST_RUBY="${FILC_HOST_RUBY:-$(resolve_host_tool ruby /usr/bin/ruby)}"
HOST_PYTHON3="${FILC_HOST_PYTHON3:-$(resolve_host_tool python3 /usr/bin/python3)}"
HOST_PERL="${FILC_HOST_PERL:-$(resolve_host_tool perl /usr/bin/perl)}"
export HOST_RUBY HOST_PYTHON3 HOST_PERL

NPROC="$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 2)"
JOBS="${FILC_PORTS_JOBS:-$NPROC}"
TIMEOUT_SEC="${FILC_PORT_TIMEOUT:-900}"

# Defaults for recipe variables
NAME=""
VERSION=""
LICENSE=""
UPSTREAM_URL=""
UPSTREAM_SHA256=""
EXTRACT_DIR=""
TIER=""
DEPS=""
HOST_TOOLS=""
BUILD_SYSTEM=""
CONFIGURE_ARGS=""
CMAKE_ARGS=""
CMAKE_SOURCE_SUBDIR=""
MAKE_ARGS=""
INSTALL_ARGS=""
TEST_CMD=""
POLICY_CLASS=""
POLICY_RATIONALE=""
FILC_ORIGIN_REF=""
SUPPORT_STATUS=""
EOL_DATE=""
SECURITY_SOURCE=""
DEBIAN_TARBALL_URL=""
DEBIAN_TARBALL_SHA256=""
DEBIAN_DSC_SHA256=""
DEBIAN_SECURITY_PATCHES=""
DEBIAN_BINARY_TARBALLS=""

# shellcheck source=/dev/null
source "$PORT_FILE"

for req in NAME VERSION LICENSE UPSTREAM_URL UPSTREAM_SHA256 EXTRACT_DIR TIER BUILD_SYSTEM POLICY_CLASS; do
  if [[ -z "${!req:-}" ]]; then
    echo "error: $PORT_FILE missing required field: $req" >&2
    exit 1
  fi
done

if [[ "$NAME" != "$PORT_NAME" ]]; then
  echo "error: $PORT_FILE NAME ($NAME) != directory name ($PORT_NAME)" >&2
  exit 1
fi

T_START="$(date +%s)"
CURRENT_STAGE="init"
PATCH_COUNT=0
PATCH_ADDED=0
PATCH_REMOVED=0
PATCH_FILES=0

write_state() {
  local status="$1"
  local fail_stage="${2:-}"
  local fail_kind="${3:-}"
  local dur=$(( $(date +%s) - T_START ))
  mkdir -p "$STATE_DIR"
  "$HOST_PYTHON3" - "$STATE_DIR/$PORT_NAME.json" "$NAME" "$VERSION" "$TIER" "$status" "$POLICY_CLASS" \
    "$dur" "$PATCH_COUNT" "$PATCH_ADDED" "$PATCH_REMOVED" "$PATCH_FILES" "$fail_stage" "$fail_kind" "$DEPS" <<'PY'
import json, sys
out_path, name, ver, tier, status, policy, dur, pc, pa, pr, pf, fstage, fkind, deps = sys.argv[1:]
rec = {
    "name": name,
    "version": ver,
    "tier": int(tier),
    "status": status,
    "policy_class": policy,
    "deps": [d for d in deps.split() if d],
    "duration_seconds": max(0, int(dur)),
    "patch_count": int(pc),
    "added_lines": int(pa),
    "removed_lines": int(pr),
    "files_changed": int(pf),
}
if fstage:
    rec["failed_stage"] = fstage
if fkind:
    rec["failed_kind"] = fkind
with open(out_path, "w", encoding="utf-8") as f:
    json.dump(rec, f, indent=2, sort_keys=True)
    f.write("\n")
PY
}

dump_test_logs() {
  [[ -n "${SRC_DIR:-}" && -d "${SRC_DIR:-}" ]] || return 0
  local logf
  while IFS= read -r logf; do
    echo "--- TEST LOG ($logf) ---" >&2
    grep -E '^(FAIL|XPASS|ERROR):' "$logf" >&2 || true
    awk '/^The following tests FAILED:/{p=1} p{print; if (/^Errors while running CTest/) p=0}' "$logf" >&2 || true
    "$HOST_RUBY" - "$logf" >&2 <<'RB' || tail -n 120 "$logf" >&2 || true
path = ARGV[0]
lines = File.binread(path).force_encoding("UTF-8").encode("UTF-8", invalid: :replace, undef: :replace).lines.map { |l| l.chomp("\n").chomp("\r") }
hdr_re = /\bfilc\b[^\n]*\berror:/i
end_re = /(?:\bfilc panic:|thwarted a futile attempt)/i
hdr_idx = lines.rindex { |l| hdr_re.match?(l) }
end_idx = lines.rindex { |l| end_re.match?(l) }

if hdr_idx.nil? && end_idx.nil?
  puts lines.last(120)
  exit 0
end

start_i = hdr_idx || [0, end_idx - 120].max
stop_i = (end_idx && end_idx >= start_i) ? end_idx : [lines.length - 1, start_i + 4000].min
block = lines[start_i..stop_i]

short_label = lambda do |ln|
  s = ln.strip
  if s.include?(": ")
    s.split(": ").last.strip
  else
    s
  end
end

header_lines = []
frame_lines = []
tail_marker = nil
in_frames = false
in_semantic_origin = false

block.each_with_index do |ln, idx|
  if idx == block.length - 1 && end_re.match?(ln)
    tail_marker = ln
    next
  end
  st = ln.strip
  if !in_frames
    header_lines << ln
    if /\Asemantic origin:/i.match?(st)
      in_semantic_origin = true
    elsif /\Acheck scheduled at/i.match?(st)
      in_semantic_origin = false
      in_frames = true
    elsif idx > 0 && !in_semantic_origin && ln.start_with?(" ", "\t") && !/\Apointer:/i.match?(st)
      header_lines.pop
      in_frames = true
      frame_lines << ln
    end
  else
    frame_lines << ln
  end
end

runs = []
frame_lines.each do |ln|
  if !runs.empty? && runs.last[0].strip == ln.strip
    runs.last[1] += 1
  else
    runs << [ln, 1]
  end
end

out = []
out.concat(header_lines)
shown_runs = runs.first(20)
shown_runs.each do |ln, cnt|
  out << ln
  out << "    ... #{cnt}x #{short_label.call(ln)}" if cnt > 1
end
if runs.length > 20
  omitted = runs[20..].sum { |_, c| c }
  out << "    ... (#{omitted} more frames omitted)"
  tail_frames = runs.last(3)
  tail_frames.each do |ln, cnt|
    out << ln
    out << "    ... #{cnt}x #{short_label.call(ln)}" if cnt > 1
  end
end
out << tail_marker if tail_marker

after = lines[(stop_i + 1)..] || []
if !after.empty?
  out << "--- TEST LOG TAIL ---"
  out.concat(after.last(60))
end
puts out
RB
  done < <(find "$SRC_DIR" -maxdepth 4 \( -name 'test-suite.log' -o -name 'LastTest.log' \) -type f 2>/dev/null)
}

dump_configure_logs() {
  [[ -n "${SRC_DIR:-}" && -d "${SRC_DIR:-}" ]] || return 0
  local logf
  while IFS= read -r logf; do
    echo "--- CONFIGURE LOG ($logf) ---" >&2
    "$HOST_RUBY" - "$logf" >&2 <<'RB' || tail -n 80 "$logf" >&2 || true
path = ARGV[0]
lines = File.binread(path).force_encoding("UTF-8").encode("UTF-8", invalid: :replace, undef: :replace).lines.map { |l| l.chomp("\n").chomp("\r") }
var_idx = lines.index { |l| /\A##\s*(?:Cache|Output)\s+variables\.\s*##\z/.match?(l) }
body = var_idx ? lines[0...var_idx] : lines
err_idx = body.rindex { |l| /\bconfigure:\s*error:/i.match?(l) }
if err_idx
  err_stop = [body.length - 1, err_idx + 5].min
  err_block = []
  (err_idx..err_stop).each do |i|
    break if i > err_idx && /\A(?:##\s|configure:\d+:|See\s+`config\.log')/.match?(body[i])
    err_block << body[i]
  end
  puts "CONFIGURE_ERROR:"
  puts err_block
end

failed_prog_idx = body.rindex { |l| /\Aconfigure:\s+failed program was:/.match?(l) }
if failed_prog_idx && (err_idx.nil? || (err_idx - failed_prog_idx).abs <= 1200)
  search_floor = [0, failed_prog_idx - 120].max
  chk_idx = nil
  (failed_prog_idx - 1).downto(search_floor) do |i|
    if /\Aconfigure:\d+:\s+checking\b/.match?(body[i])
      chk_idx = i
      break
    end
  end
  chk_start = chk_idx || [0, failed_prog_idx - 40].max
  puts "--- LAST FAILED CONFIGURE CHECK (lines #{chk_start + 1}..#{failed_prog_idx + 1}) ---"
  puts body[chk_start..failed_prog_idx]

  end_defs_idx = nil
  ((failed_prog_idx + 1)...body.length).each do |i|
    if body[i].include?("/* end confdefs.h.")
      end_defs_idx = i
      break
    end
  end
  prog_start = end_defs_idx || (failed_prog_idx + 1)
  prog_tail = body[prog_start..] || []
  prog_tail = prog_tail.last(60) if prog_tail.length > 60
  puts "--- FAILED PROGRAM BODY (from line #{prog_start + 1}) ---"
  puts prog_tail
else
  non_defs = body.reject { |l| l.start_with?("| #define ") }
  puts "--- CONFIGURE LOG TAIL ---"
  puts non_defs.last(80)
end
RB
  done < <(find "$SRC_DIR" -maxdepth 3 \( -name 'config.log' -o -name 'CMakeError.log' \) -type f 2>/dev/null)
}

dump_patch_rejects() {
  [[ -n "${SRC_DIR:-}" && -d "${SRC_DIR:-}" ]] || return 0
  local rejf
  while IFS= read -r rejf; do
    echo "--- PATCH REJECT ($rejf) ---" >&2
    head -n 80 "$rejf" >&2 || true
  done < <(find "$SRC_DIR" -maxdepth 4 -name '*.rej' -type f 2>/dev/null)
}

save_clang_crash_reproducers() {
  local dest_base="${FILC_REPORT_ARCHIVE_DIR:-$WORK_ROOT}/reproducers"
  local found=0
  local shf
  for shf in "${TMPDIR:-/tmp}"/*-*.sh; do
    [[ -f "$shf" ]] || continue
    grep -q 'Crash reproducer for ' "$shf" 2>/dev/null || continue
    local stem="${shf%.sh}"
    local dest="$dest_base/crash-$PORT_NAME"
    mkdir -p "$dest"
    cp -f "$shf" "$dest/" 2>/dev/null || true
    for ext in c cc cpp cxx i ii m mm; do
      [[ -f "${stem}.${ext}" ]] && cp -f "${stem}.${ext}" "$dest/" 2>/dev/null || true
    done
    found=1
  done
  if [[ "$found" -eq 1 ]]; then
    echo "--- CLANG CRASH REPRODUCER SAVED: $dest_base/crash-$PORT_NAME ---" >&2
  fi
}

dump_filc_panics() {
  [[ -d "${FILC_PANICS_DIR:-}" && -f "${PANIC_SNAPSHOT:-}" ]] || return 0
  "$HOST_RUBY" - "$FILC_PANICS_DIR" "$PANIC_SNAPSHOT" "$BUILD_BASE" "$PORT_NAME" >&2 <<'RB' || true
panics_dir, snap_file, build_base, port_name = ARGV
before = {}
if File.file?(snap_file)
  File.readlines(snap_file, chomp: true).each { |n| before[n] = true unless n.empty? }
end
new_files = Dir.children(panics_dir).reject { |n| before[n] || n.start_with?(".") }.sort
exit 0 if new_files.empty?

own_prefix = File.join(build_base, port_name) + "/"
other_prefix = build_base.end_with?("/") ? build_base : "#{build_base}/"
build_base_real = File.directory?(build_base) ? File.realpath(build_base) : build_base
own_real = File.join(build_base_real, port_name) + "/"
other_real = build_base_real.end_with?("/") ? build_base_real : "#{build_base_real}/"

primary = []
conftest = []
new_files.each do |fname|
  path = File.join(panics_dir, fname)
  next unless File.file?(path)

  exe_line = nil
  File.open(path, "rb") do |f|
    5.times do
      ln = f.gets
      break unless ln
      if ln.start_with?("executable:")
        exe_line = ln.sub(/\Aexecutable:\s*/, "").strip
        break
      end
    end
  end
  if exe_line && ((exe_line.start_with?(other_prefix) && !exe_line.start_with?(own_prefix)) ||
                  (exe_line.start_with?(other_real) && !exe_line.start_with?(own_real)))
    next
  end

  is_conftest = (exe_line && File.basename(exe_line) == "conftest") || fname.include?("-conftest-")
  mtime = begin
    File.mtime(path).to_f
  rescue StandardError
    0.0
  end
  if is_conftest
    conftest << fname
  else
    primary << [mtime, fname, path]
  end
end

# Print the most recent non-conftest panic first and completely unabridged so
# the actual failing command's report is never buried or truncated.
primary.sort_by { |mtime, fname, _| [-mtime, fname] }.first(5).each_with_index do |(_, fname, path), idx|
  lines = File.binread(path)
              .force_encoding("UTF-8")
              .encode("UTF-8", invalid: :replace, undef: :replace)
              .lines
  puts "--- FIL-C PANIC REPORT (#{path}) ---"
  if idx == 0 || lines.length <= 60
    puts lines
  else
    puts lines.first(40)
    puts "... (#{lines.length - 60} lines omitted)"
    puts lines.last(20)
  end
  puts "--- END FIL-C PANIC REPORT (#{fname}) ---"
end

unless conftest.empty?
  puts "--- FIL-C CONFTEST PANICS (count=#{conftest.length}): #{conftest.sort.join(', ')} ---"
end
RB
}

classify_failure_kind() {
  local stage="$1"
  local rc="$2"
  case "$stage" in
    init|deps|toolchain)
      echo "runner"
      return 0
      ;;
  esac
  if [[ "$rc" -eq 126 || "$rc" -eq 127 ]]; then
    echo "runner"
    return 0
  fi
  echo "package"
  return 0
}

PORT_DONE=0
on_exit() {
  local rc=$?
  set +e
  if [[ "$PORT_DONE" != "1" ]]; then
    local fkind
    fkind="$(classify_failure_kind "$CURRENT_STAGE" "$rc")"
    echo "STAGE_FAILED port=$PORT_NAME stage=$CURRENT_STAGE rc=$rc kind=$fkind" >&2
    if [[ "$CURRENT_STAGE" == "test" ]]; then
      dump_test_logs || true
    elif [[ "$CURRENT_STAGE" == "configure" ]]; then
      dump_configure_logs || true
    elif [[ "$CURRENT_STAGE" == "patch" ]]; then
      dump_patch_rejects || true
    elif [[ "$CURRENT_STAGE" == "build" ]]; then
      save_clang_crash_reproducers || true
    fi
    dump_filc_panics || true
    local dur=$(( $(date +%s) - T_START ))
    echo "FILC_PORT $PORT_NAME failed:$fkind policy=$POLICY_CLASS duration=$dur stage=$CURRENT_STAGE rc=$rc" >&2
    if ! write_state "failed" "$CURRENT_STAGE" "$fkind"; then
      echo "warning: write_state failed for $PORT_NAME ($STATE_DIR/$PORT_NAME.json)" >&2
    fi
  fi
  rm -f "${PANIC_SNAPSHOT:-}" 2>/dev/null || true
}
trap on_exit EXIT

TIMEOUT_DIAG_HELPER="$REPO_ROOT/scripts/run-with-timeout-diag"

run_with_timeout() {
  if [[ -f "$TIMEOUT_DIAG_HELPER" ]]; then
    "$HOST_RUBY" "$TIMEOUT_DIAG_HELPER" \
      --timeout "$TIMEOUT_SEC" \
      --label "port=$PORT_NAME stage=$CURRENT_STAGE" \
      --child-path "$PATH" \
      -- "$@"
  elif command -v timeout >/dev/null 2>&1; then
    timeout --foreground "$TIMEOUT_SEC" "$@"
  else
    "$@"
  fi
}

run_with_install_lock() {
  local lock_file="${FILC_PORTS_INSTALL_LOCK:-$WORK_ROOT/ports-install.lock}"
  "$HOST_RUBY" -e '
    lock_path = ARGV.shift
    File.open(lock_path, File::CREAT | File::RDWR, 0o666) do |f|
      f.flock(File::LOCK_EX)
      ok = system(*ARGV)
      exit(ok ? 0 : ($?.exitstatus || 1))
    end
  ' "$lock_file" "$@"
}

# Atomically snapshot $PIZFIX before and after install while holding the
# exclusive ports-install.lock, writing the exact per-port file manifest to
# $STATE_DIR/$PORT_NAME.manifest.json for scripts/package-port.
run_install_with_manifest() {
  local lock_file="${FILC_PORTS_INSTALL_LOCK:-$WORK_ROOT/ports-install.lock}"
  local manifest_out="$STATE_DIR/$PORT_NAME.manifest.json"
  "$HOST_RUBY" -e '
    require "digest/sha2"
    require "json"

    lock_path = ARGV.shift
    pizfix = ARGV.shift
    manifest_out = ARGV.shift
    port_name = ARGV.shift
    cmd = ARGV

    def snapshot_tree(root)
      entries = {}
      return entries unless File.directory?(root)
      stack = [""]
      until stack.empty?
        rel = stack.pop
        full = rel.empty? ? root : File.join(root, rel)
        Dir.children(full).each do |child|
          crel = rel.empty? ? child : "#{rel}/#{child}"
          cfull = File.join(root, crel)
          st = File.lstat(cfull)
          if st.directory? && !st.symlink?
            stack << crel
          elsif st.symlink?
            entries[crel] = [:symlink, File.readlink(cfull)]
          elsif st.file?
            entries[crel] = [:file, st.size, st.mtime.to_f]
          end
        end
      end
      entries
    end

    File.open(lock_path, File::CREAT | File::RDWR, 0o666) do |f|
      f.flock(File::LOCK_EX)
      before = snapshot_tree(pizfix)
      ok = system(*cmd)
      exit($?.exitstatus || 1) unless ok
      after = snapshot_tree(pizfix)
      changed = []
      after.keys.sort.each do |rel|
        next if before[rel] == after[rel]
        changed << rel
      end
      payload = {
        "port" => port_name,
        "files" => changed
      }
      File.write(manifest_out, JSON.pretty_generate(payload) + "\n", encoding: "UTF-8")
    end
  ' "$lock_file" "$PIZFIX" "$manifest_out" "$PORT_NAME" "$@"
}

run_install_cmd() {
  if [[ -f "$TIMEOUT_DIAG_HELPER" ]]; then
    run_install_with_manifest "$HOST_RUBY" "$TIMEOUT_DIAG_HELPER" \
      --timeout "$TIMEOUT_SEC" \
      --label "port=$PORT_NAME stage=$CURRENT_STAGE" \
      --child-path "$PATH" \
      -- "$@"
  elif command -v timeout >/dev/null 2>&1; then
    run_install_with_manifest timeout --foreground "$TIMEOUT_SEC" "$@"
  else
    run_install_with_manifest "$@"
  fi
}

run_stage_fn() {
  local fn="$1"
  local use_lock="${2:-0}"
  local trace_flag=""
  if [[ "$fn" == "port_test" ]]; then
    trace_flag="set -x;"
  fi
  local stage_script="set -eEuo pipefail; export PS4='+ [$fn:\${LINENO}] '; trap 'rc=\$?; echo \"STAGE_CMD_FAILED port=\$PORT_NAME stage=\$CURRENT_STAGE fn=$fn line=\${LINENO} rc=\$rc cmd=\${BASH_COMMAND}\" >&2' ERR; source \"\$PORT_FILE\"; $trace_flag $fn"
  export PORT_NAME CURRENT_STAGE PORT_FILE SRC_DIR PIZFIX CC CXX AR RANLIB NM lt_cv_sys_global_symbol_pipe PREFIX PKG_CONFIG_PATH PATH CFLAGS CXXFLAGS LDFLAGS JOBS
  if [[ "$use_lock" == "1" ]]; then
    run_install_cmd bash -c "$stage_script"
  else
    run_with_timeout bash -c "$stage_script"
  fi
}

compute_sha256() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}

echo "=== Building port: $NAME $VERSION (tier=$TIER, policy=$POLICY_CLASS) ==="
echo "FILC_PORT $PORT_NAME building policy=$POLICY_CLASS"

# 1. Dependency check
CURRENT_STAGE="deps"
if [[ "${FILC_PORT_SKIP_DEPS:-0}" != "1" ]]; then
  for dep in $DEPS; do
    if [[ ! -f "$STATE_DIR/$dep.installed" ]]; then
      echo "error: dependency '$dep' not installed in $STATE_DIR" >&2
      exit 1
    fi
  done
fi

# 1b. Declared host build tools pre-flight check (before fetch/extract)
if [[ -n "$HOST_TOOLS" ]]; then
  CURRENT_STAGE="toolchain"
  for ht in $HOST_TOOLS; do
    if ! command -v "$ht" >/dev/null 2>&1; then
      echo "error: required host build tool '$ht' not found in PATH (declared in HOST_TOOLS for $PORT_NAME)" >&2
      exit 1
    fi
  done
fi

# 2. Fetch & SHA-256 verification
CURRENT_STAGE="fetch"
TARBALL_NAME="$(basename "${UPSTREAM_URL%%\?*}")"
TARBALL_PATH="$CACHE_DIR/${NAME}-${VERSION}-${UPSTREAM_SHA256:0:12}-${TARBALL_NAME}"

if [[ ! -f "$TARBALL_PATH" ]]; then
  TMP_DL="$TARBALL_PATH.part.$$"
  rm -f "$TMP_DL"
  curl -fsSL --retry 3 --retry-delay 2 -o "$TMP_DL" "$UPSTREAM_URL"
  mv "$TMP_DL" "$TARBALL_PATH"
fi

ACTUAL_SHA="$(compute_sha256 "$TARBALL_PATH")"
if [[ "$ACTUAL_SHA" != "$UPSTREAM_SHA256" ]]; then
  echo "error: SHA-256 mismatch for $TARBALL_PATH" >&2
  echo "  expected: $UPSTREAM_SHA256" >&2
  echo "  actual:   $ACTUAL_SHA" >&2
  rm -f "$TARBALL_PATH"
  exit 1
fi
echo "SHA-256 verified: $ACTUAL_SHA"

# 3. Extract
CURRENT_STAGE="extract"
PORT_BUILD_DIR="$BUILD_BASE/$PORT_NAME"
rm -rf "$PORT_BUILD_DIR"
mkdir -p "$PORT_BUILD_DIR"
tar -xf "$TARBALL_PATH" -C "$PORT_BUILD_DIR"
SRC_DIR="$PORT_BUILD_DIR/$EXTRACT_DIR"
if [[ ! -d "$SRC_DIR" ]]; then
  echo "error: expected extract directory not found: $SRC_DIR" >&2
  exit 1
fi

# 4. Apply patches (Debian ELTS security patches if configured, then Fil-C series)
CURRENT_STAGE="patch"
if [[ -n "$DEBIAN_TARBALL_URL" ]]; then
  if [[ -z "$DEBIAN_TARBALL_SHA256" ]]; then
    echo "error: $PORT_FILE sets DEBIAN_TARBALL_URL without DEBIAN_TARBALL_SHA256" >&2
    exit 1
  fi
  DEB_TARBALL_NAME="$(basename "${DEBIAN_TARBALL_URL%%\?*}")"
  DEB_TARBALL_PATH="$CACHE_DIR/${NAME}-${VERSION}-${DEBIAN_TARBALL_SHA256:0:12}-${DEB_TARBALL_NAME}"
  if [[ ! -f "$DEB_TARBALL_PATH" ]]; then
    TMP_DEB_DL="$DEB_TARBALL_PATH.part.$$"
    rm -f "$TMP_DEB_DL"
    curl -fsSL --retry 3 --retry-delay 2 -o "$TMP_DEB_DL" "$DEBIAN_TARBALL_URL"
    mv "$TMP_DEB_DL" "$DEB_TARBALL_PATH"
  fi
  ACTUAL_DEB_SHA="$(compute_sha256 "$DEB_TARBALL_PATH")"
  if [[ "$ACTUAL_DEB_SHA" != "$DEBIAN_TARBALL_SHA256" ]]; then
    echo "error: SHA-256 mismatch for $DEB_TARBALL_PATH" >&2
    echo "  expected: $DEBIAN_TARBALL_SHA256" >&2
    echo "  actual:   $ACTUAL_DEB_SHA" >&2
    rm -f "$DEB_TARBALL_PATH"
    exit 1
  fi
  echo "Debian ELTS tarball SHA-256 verified: $ACTUAL_DEB_SHA"
  DEB_EXTRACT_DIR="$PORT_BUILD_DIR/_debian"
  rm -rf "$DEB_EXTRACT_DIR"
  mkdir -p "$DEB_EXTRACT_DIR"
  tar -xf "$DEB_TARBALL_PATH" -C "$DEB_EXTRACT_DIR"
  DEB_APPLIED=0
  for dp in $DEBIAN_SECURITY_PATCHES; do
    dpfile="$DEB_EXTRACT_DIR/debian/patches/$dp"
    if [[ ! -f "$dpfile" ]]; then
      echo "error: Debian ELTS security patch not found in tarball: $dpfile" >&2
      exit 1
    fi
    echo "Applying Debian ELTS security patch: $dp"
    patch -d "$SRC_DIR" -p1 --batch --forward -F 0 < "$dpfile"
    DEB_APPLIED=$((DEB_APPLIED + 1))
  done
  echo "Applied $DEB_APPLIED Debian ELTS security patch(es)"
  DEB_BIN_EXTRACTED=0
  for bspec in $DEBIAN_BINARY_TARBALLS; do
    if [[ "$bspec" != *:* ]]; then
      echo "error: invalid DEBIAN_BINARY_TARBALLS entry (expected <filename>:<sha256>): $bspec" >&2
      exit 1
    fi
    bname="${bspec%%:*}"
    bsha="${bspec#*:}"
    if [[ -z "$bname" || "$bname" == */* || "$bname" == *".."* ]]; then
      echo "error: unsafe DEBIAN_BINARY_TARBALLS filename: $bname" >&2
      exit 1
    fi
    if [[ ! "$bsha" =~ ^[0-9a-f]{64}$ ]]; then
      echo "error: invalid SHA-256 in DEBIAN_BINARY_TARBALLS for $bname: $bsha" >&2
      exit 1
    fi
    bfile="$DEB_EXTRACT_DIR/debian/$bname"
    if [[ ! -f "$bfile" ]]; then
      echo "error: Debian ELTS binary tarball not found in debian/: $bfile" >&2
      exit 1
    fi
    actual_bsha="$(compute_sha256 "$bfile")"
    if [[ "$actual_bsha" != "$bsha" ]]; then
      echo "error: SHA-256 mismatch for Debian ELTS binary tarball $bname (expected=$bsha, actual=$actual_bsha)" >&2
      exit 1
    fi
    while IFS= read -r member; do
      [[ -z "$member" ]] && continue
      if [[ "$member" == /* || "$member" == *".."* ]]; then
        echo "error: unsafe member path in $bname: $member" >&2
        exit 1
      fi
    done < <(tar -tf "$bfile")
    echo "Extracting verified Debian ELTS binary tarball: $bname ($actual_bsha)"
    tar -xf "$bfile" -C "$SRC_DIR"
    DEB_BIN_EXTRACTED=$((DEB_BIN_EXTRACTED + 1))
  done
  if [[ "$DEB_BIN_EXTRACTED" -gt 0 ]]; then
    echo "Extracted $DEB_BIN_EXTRACTED Debian ELTS binary tarball(s)"
  fi
elif [[ -n "$DEBIAN_BINARY_TARBALLS" ]]; then
  echo "error: $PORT_FILE sets DEBIAN_BINARY_TARBALLS without DEBIAN_TARBALL_URL" >&2
  exit 1
fi
if [[ -f "$PORT_DIR/patches/series" ]]; then
  while IFS= read -r raw_line || [[ -n "$raw_line" ]]; do
    line="${raw_line%%#*}"
    line="$(echo "$line" | xargs)"
    [[ -z "$line" ]] && continue
    pfile="$PORT_DIR/patches/$line"
    if [[ ! -f "$pfile" ]]; then
      echo "error: patch listed in series not found: $pfile" >&2
      exit 1
    fi
    echo "Applying patch: $line"
    patch -d "$SRC_DIR" -p1 --batch --forward < "$pfile"
    PATCH_COUNT=$((PATCH_COUNT + 1))
    read -r pa pr pf < <("$HOST_PYTHON3" - "$pfile" <<'PY'
import sys
a = r = f = 0
in_diff = False
for raw in open(sys.argv[1], encoding="utf-8", errors="replace"):
    ln = raw.rstrip("\r\n")
    if ln.startswith("diff --git ") or (not in_diff and ln.startswith("--- ")):
        in_diff = True
        if ln.startswith("diff --git "):
            f += 1
        continue
    if in_diff:
        if ln.startswith("diff --git "):
            f += 1
        elif ln.startswith("+") and not ln.startswith("+++ "):
            a += 1
        elif ln.startswith("-") and not ln.startswith("--- "):
            r += 1
if f == 0 and (a > 0 or r > 0):
    f = 1
print(a, r, f)
PY
)
    PATCH_ADDED=$((PATCH_ADDED + pa))
    PATCH_REMOVED=$((PATCH_REMOVED + pr))
    PATCH_FILES=$((PATCH_FILES + pf))
  done < "$PORT_DIR/patches/series"
fi

# 5. Prepare Fil-C toolchain environment
CURRENT_STAGE="toolchain"
for tool_spec in \
  "clang:$CLANG_BIN" \
  "clang++:$CLANGXX_BIN" \
  "llvm-ar:$LLVM_AR" \
  "llvm-ranlib:$LLVM_RANLIB" \
  "llvm-nm:$LLVM_NM"; do
  tool_label="${tool_spec%%:*}"
  tool_path="${tool_spec#*:}"
  if [[ ! -x "$tool_path" ]]; then
    echo "error: Fil-C toolchain binary '$tool_label' not found or not executable at $tool_path (set FILC_TOOLCHAIN_ROOT)" >&2
    exit 1
  fi
done
if [[ ! -d "$PIZFIX" ]]; then
  echo "error: Fil-C sysroot (pizfix) not found at $PIZFIX" >&2
  exit 1
fi

export CC="$CLANG_BIN"
export CXX="$CLANGXX_BIN"
export AR="$LLVM_AR"
export RANLIB="$LLVM_RANLIB"
export NM="$LLVM_NM"
# Provide a capability/ABI-aware libtool global_symbol_pipe centrally so
# autotools/libtool ports using -export-symbols-regex work unmodified under
# Fil-C's pizlonated_ symbol prefix (paired with Clang driver version-script
# rewriting for both --version-script and -version-script).
if [[ -z "${lt_cv_sys_global_symbol_pipe+x}" ]]; then
  export lt_cv_sys_global_symbol_pipe="sed -n -e 's/^.*[	 ]\([ABCDGIRSTW][ABCDGIRSTW]*\)[	 ][	 ]*pizlonated_\([_A-Za-z][_A-Za-z0-9]*\)$/\1 pizlonated_\2 \2/p' | sed '/ __gnu_lto/d'"
fi
export PREFIX="$PIZFIX"
export PKG_CONFIG_PATH="$PIZFIX/lib/pkgconfig:$PIZFIX/share/pkgconfig"
export PATH="$PIZFIX/bin:$(dirname "$CLANG_BIN"):$PATH"
case "$BUILD_BASE" in
  /build/filc-ports|/build/filc-ports/*)
    export CFLAGS="${CFLAGS:--O2 -g}"
    export CXXFLAGS="${CXXFLAGS:--O2 -g}"
    ;;
  *)
    PREFIX_MAP_FLAGS="-ffile-prefix-map=$BUILD_BASE=/build/filc-ports"
    export CFLAGS="${CFLAGS:--O2 -g} $PREFIX_MAP_FLAGS"
    export CXXFLAGS="${CXXFLAGS:--O2 -g} $PREFIX_MAP_FLAGS"
    ;;
esac
export LDFLAGS="${LDFLAGS:-}"

# 6. Configure, Build, Install
cd "$SRC_DIR"

CURRENT_STAGE="configure"
if declare -F port_configure >/dev/null 2>&1; then
  run_stage_fn port_configure
else
  case "$BUILD_SYSTEM" in
    autotools)
      # shellcheck disable=SC2086
      run_with_timeout ./configure --prefix="$PIZFIX" $CONFIGURE_ARGS
      ;;
    cmake)
      CMAKE_SRC="$SRC_DIR"
      [[ -n "$CMAKE_SOURCE_SUBDIR" ]] && CMAKE_SRC="$SRC_DIR/$CMAKE_SOURCE_SUBDIR"
      # shellcheck disable=SC2086
      run_with_timeout cmake -S "$CMAKE_SRC" -B "$SRC_DIR/_build" \
        -DCMAKE_INSTALL_PREFIX="$PIZFIX" \
        -DCMAKE_C_COMPILER="$CC" \
        -DCMAKE_CXX_COMPILER="$CXX" \
        -DCMAKE_AR="$AR" \
        -DCMAKE_RANLIB="$RANLIB" \
        -DCMAKE_NM="$NM" \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        $CMAKE_ARGS
      ;;
    make)
      ;;
    custom)
      echo "error: BUILD_SYSTEM=custom requires port_configure/port_build functions" >&2
      exit 1
      ;;
    *)
      echo "error: unsupported BUILD_SYSTEM: $BUILD_SYSTEM" >&2
      exit 1
      ;;
  esac
fi

CURRENT_STAGE="build"
T_BUILD_START="$(date +%s)"
if declare -F port_build >/dev/null 2>&1; then
  run_stage_fn port_build
else
  case "$BUILD_SYSTEM" in
    autotools|make)
      # shellcheck disable=SC2086
      run_with_timeout make -j "$JOBS" $MAKE_ARGS
      ;;
    cmake)
      run_with_timeout cmake --build "$SRC_DIR/_build" -j "$JOBS"
      ;;
  esac
fi
BUILD_SECONDS=$(( $(date +%s) - T_BUILD_START ))
echo "FILC_PORT_BUILD_SECONDS port=$PORT_NAME build_seconds=$BUILD_SECONDS"

CURRENT_STAGE="install"
if declare -F port_install >/dev/null 2>&1; then
  run_stage_fn port_install 1
else
  case "$BUILD_SYSTEM" in
    autotools|make)
      # shellcheck disable=SC2086
      run_install_cmd make install $INSTALL_ARGS
      ;;
    cmake)
      run_install_cmd cmake --install "$SRC_DIR/_build"
      ;;
  esac
fi

# 7. Test
emit_stage_testing() {
  local line="FILC_PORT $PORT_NAME testing policy=$POLICY_CLASS stage=test"
  echo "$line"
  if [[ -n "${FILC_PORT_STAGE_MARKER:-}" ]]; then
    local tmp="${FILC_PORT_STAGE_MARKER}.tmp.$$"
    printf '%s\n' "$line" > "$tmp" && mv -f "$tmp" "$FILC_PORT_STAGE_MARKER" || true
  fi
}

FINAL_STATUS="built"
if declare -F port_test >/dev/null 2>&1; then
  CURRENT_STAGE="test"
  emit_stage_testing
  run_stage_fn port_test
  FINAL_STATUS="tested"
elif [[ -n "$TEST_CMD" ]]; then
  CURRENT_STAGE="test"
  emit_stage_testing
  run_with_timeout bash -ceuxo pipefail "$TEST_CMD"
  FINAL_STATUS="tested"
fi

touch "$STATE_DIR/$PORT_NAME.installed"
write_state "$FINAL_STATUS" "" ""
PORT_DONE=1
echo "FILC_PORT $PORT_NAME $FINAL_STATUS policy=$POLICY_CLASS duration=$(( $(date +%s) - T_START )) build=$BUILD_SECONDS patches=$PATCH_COUNT"
