+       zmkptr(__P, (uintptr_t)((B) + ((__P - (B) + (A)) & ~(A)))); })
 #else
-# define __PTR_ALIGN(B, P, A) \
+# ifndef _OBSTACK_UINTPTR_TYPE
+#  define __PTR_ALIGN(B, P, A) \
+   ((B) + (((P) - (B) + (A)) & ~(A)))
+# else
+#  define __PTR_ALIGN(B, P, A) \
    ((P) + ((- (_OBSTACK_UINTPTR_TYPE) (P)) & (A)))
+# endif
 #endif
 
