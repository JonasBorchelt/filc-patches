Subject: Fix remaining Perl 5.40.5 CPAN/XS ptrtable boundaries and ExtUtils::MM_Unix pizlonated_boot_ detection
Policy-Class: P4-Audit
Rationale: Project-authored completeness patch separated from the adopted Fil-C commits for P4 auditability. A central perl.h replacement of INT2PTR/PTR2IV is semantically invalid because Perl defines PTR2IV/PTR2UV via INT2PTR(IV/UV,p) and intentionally stores non-pointer integers in pointer slots (e.g. B.xs OP_ARGELEM op_aux, Storable.xs classnum/tagnum). This patch covers all remaining XS/CPAN Fil-C boundaries in Perl 5.40.5: (1) lib/ExtUtils/typemap T_REF_IV_REF, T_REF_IV_PTR, T_PTRDESC, T_REFREF, T_REFOBJ decodes matching sv_setref_pv; (2) ext/B/B.xs get_overlay_object key encoding matching B::Deparse $$op; (3) cpan/Encode/bin/enc2xs plus all 8 hardcoded Encode_XSEncoding generators in Byte/CN/EBCDIC/JP/KR/Symbol/TW Makefile.PL and Encode/Makefile_PL.e2x using Perl_xsub_ptrtable to match Encode.xs; (4) cpan/Digest-SHA/SHA.xs getSHA decode matching sv_setref_pv; (5) cpan/Compress-Raw-Bzip2/typemap T_PTROBJ_AV decode; (6) cpan/ExtUtils-MakeMaker/lib/ExtUtils/MM_Unix.pm xs_static_lib_is_xs recognizing Fil-C's pizlonated_boot_* ELF symbols from FilPizlonator so static multi-XS and subdir builds link XS::Other into perlmain.c (fixes 03-xsstatic.t tests 29 and 35).
Upstream-Status: Fil-C-Specific
Fil-C-Origin-Commits: none

--- a/lib/ExtUtils/typemap
+++ b/lib/ExtUtils/typemap
@@ -215,7 +215,7 @@
 T_REF_IV_REF
 	if (sv_isa($arg, \"${ntype}\")) {
 	    IV tmp = SvIV((SV*)SvRV($arg));
-	    $var = *INT2PTR($type *, tmp);
+	    $var = *(($type *)zptrtable_decode(Perl_xsub_ptrtable, tmp));
 	}
 	else {
 		const char* refstr = SvROK($arg) ? \"\" : SvOK($arg) ? \"scalar \" : \"undef\";
@@ -228,7 +228,7 @@
 T_REF_IV_PTR
 	if (sv_isa($arg, \"${ntype}\")) {
 	    IV tmp = SvIV((SV*)SvRV($arg));
-	    $var = INT2PTR($type, tmp);
+	    $var = zptrtable_decode(Perl_xsub_ptrtable, tmp);
 	}
 	else {
 		const char* refstr = SvROK($arg) ? \"\" : SvOK($arg) ? \"scalar \" : \"undef\";
@@ -254,7 +254,7 @@
 T_PTRDESC
 	if (sv_isa($arg, \"${ntype}\")) {
 	    IV tmp = SvIV((SV*)SvRV($arg));
-	    ${type}_desc = (\U${type}_DESC\E*) tmp;
+	    ${type}_desc = (\U${type}_DESC\E*) zptrtable_decode(Perl_xsub_ptrtable, tmp);
 	    $var = ${type}_desc->ptr;
 	}
 	else {
@@ -268,7 +268,7 @@
 T_REFREF
 	if (SvROK($arg)) {
 	    IV tmp = SvIV((SV*)SvRV($arg));
-	    $var = *INT2PTR($type,tmp);
+	    $var = *(($type)zptrtable_decode(Perl_xsub_ptrtable, tmp));
 	}
 	else
 	    Perl_croak_nocontext(\"%s: %s is not a reference\",
@@ -277,7 +277,7 @@
 T_REFOBJ
 	if (sv_isa($arg, \"${ntype}\")) {
 	    IV tmp = SvIV((SV*)SvRV($arg));
-	    $var = *INT2PTR($type,tmp);
+	    $var = *(($type)zptrtable_decode(Perl_xsub_ptrtable, tmp));
 	}
 	else {
 		const char* refstr = SvROK($arg) ? \"\" : SvOK($arg) ? \"scalar \" : \"undef\";
--- a/ext/B/B.xs
