 #define IS_TMP_FREE(should_free) ((zend_uintptr_t)should_free.var & 1L)
 
@@ -159,10 +169,21 @@
 #define IS_CTOR_CALL(ce) (((zend_uintptr_t)(ce)) & CTOR_CALL_BIT)
 #define IS_CTOR_USED(ce) (((zend_uintptr_t)(ce)) & CTOR_USED_BIT)
 
+static zend_always_inline zend_class_entry *zend_encode_ctor(zend_class_entry *ce, zend_uintptr_t used)
+{
+	zend_uintptr_t bits = CTOR_CALL_BIT | (used ? CTOR_USED_BIT : 0);
+	return (zend_class_entry *)((char *)ce - (((zend_uintptr_t)ce) & (CTOR_CALL_BIT | CTOR_USED_BIT)) + bits);
+}
+
+static zend_always_inline zend_class_entry *zend_decode_ctor(zend_class_entry *ce)
+{
+	return (zend_class_entry *)((char *)ce - (((zend_uintptr_t)ce) & (CTOR_CALL_BIT | CTOR_USED_BIT)));
+}
+
 #define ENCODE_CTOR(ce, used) \
-	((zend_class_entry*)(((zend_uintptr_t)(ce)) | CTOR_CALL_BIT | ((used) ? CTOR_USED_BIT : 0)))
+	zend_encode_ctor((ce), (used))
 #define DECODE_CTOR(ce) \
-	((zend_class_entry*)(((zend_uintptr_t)(ce)) & ~(CTOR_CALL_BIT|CTOR_USED_BIT)))
+	zend_decode_ctor(ce)
 
 #undef EX
 #define EX(element) execute_data->element
