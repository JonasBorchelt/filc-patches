Subject: Fall back to /proc/self/exe in runtime_libruby_path when dladdr fails on Linux
Policy-Class: P2-Package
Rationale: Under Fil-C musl, dladdr() returns 0 for symbols inside the main ruby executable, causing --enable-load-relative to return an empty path and lose relative prefix relocation. Falling back to readlink("/proc/self/exe") on Linux restores native runtime relocation.
Upstream-Status: Pending
Fil-C-Origin-Commits: none

--- a/ruby.c
+++ b/ruby.c
@@ -653,7 +653,14 @@ runtime_libruby_path(void)
     const void* addr = (void *)(VALUE)expand_include_path;
 
     if (!dladdr((void *)addr, &dli)) {
+#ifdef __linux__
+        fname = rb_str_new_cstr("/proc/self/exe");
+        path = rb_readlink(fname, NULL);
+        rb_str_resize(fname, 0);
+        return path;
+#else
         return rb_str_new(0, 0);
+#endif
     }
 #ifdef __linux__
     else if (origarg.argc > 0 && origarg.argv && dli.dli_fname == origarg.argv[0]) {
