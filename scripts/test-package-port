        "lib/python3.12/ipaddress.py" => "'#{ip4(192, 168, 0, 0)}/16', '#{ip4(10, 0, 0, 0)}/8', '#{ip4(172, 16, 0, 0)}/12'\n",
        "lib/python3.12/random.py" => "ref=#{ip4(10, 1, 1, 47)}.1\n",
        "lib/python3.12/site-packages/pip/_vendor/requests/utils.py" => "eg #{ip4(192, 168, 1, 1)}\n",
        "lib/python3.12/site-packages/pip/_vendor/rich/highlighter.py" => "eg #{ip4(192, 168, 1, 4)}\n",
        "lib/python3.12/urllib/request.py" => "proxy #{ip4(192, 168, 0, 1)}\"\n"
