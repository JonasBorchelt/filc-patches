port_configure() {
  CPPFLAGS="-DOPENSSL_NO_SSL3_METHOD -I$PIZFIX/include" \
    LDFLAGS="-L$PIZFIX/lib" \
    PKG_CONFIG="$PIZFIX/bin/pkg-config --define-prefix" \
    PKG_CONFIG_PATH="$PIZFIX/lib/pkgconfig" \
    ./configure --prefix="$PIZFIX" \
      --sysconfdir="$PIZFIX/etc" \
      --with-ssl=openssl \
      --without-libpsl \
      --disable-nls \
      --disable-rpath
}

port_test() {
  "$PIZFIX/bin/wget" --version | grep -q 'GNU Wget 1\.25\.0'
  "$PIZFIX/bin/wget" --version | grep -q '+ssl/openssl'

  local py="${HOST_PYTHON3:-python3}"
  "$py" - "$PIZFIX/bin/wget" <<'EOF'
import http.server, socketserver, subprocess, sys, threading

wget_bin = sys.argv[1]

class Handler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        body = b"WGET_FILC_LOOPBACK_OK\n"
        self.send_response(200)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)
    def log_message(self, fmt, *args):
        pass

with socketserver.TCPServer(("127.0.0.1", 0), Handler) as srv:
    port = srv.server_address[1]
    t = threading.Thread(target=srv.handle_request, daemon=True)
    t.start()
    out = subprocess.check_output(
        [wget_bin, "--no-proxy", "-qO-", f"http://127.0.0.1:{port}/ping"],
        timeout=15,
    )
    t.join(timeout=5)
    assert out == b"WGET_FILC_LOOPBACK_OK\n", repr(out)
EOF
}

