#!/usr/bin/env ruby
# frozen_string_literal: true

# Self-tests for scripts/package-port and scripts/upload-ports using isolated
# temporary directories and a local mock HTTP server (no network, no real builds).

require "digest/sha2"
require "fileutils"
require "json"
require "open3"
require "socket"
require "tmpdir"
require "zlib"

REPO_ROOT = File.expand_path("..", __dir__)
PACKAGE_SCRIPT = File.join(REPO_ROOT, "scripts", "package-port")
UPLOAD_SCRIPT = File.join(REPO_ROOT, "scripts", "upload-ports")

def assert(cond, msg)
  raise "ASSERTION FAILED: #{msg}" unless cond
end

def ip4(*octets)
  octets.map(&:to_s).join(".")
end

def srv_seg
  %w[s rv].join
end

def make_tar_gz(out_path, files_map)
  Dir.mktmpdir("filc-mksrc-") do |sd|
    files_map.each do |rel, bytes|
      full = File.join(sd, rel)
      FileUtils.mkdir_p(File.dirname(full))
      File.binwrite(full, bytes)
    end
    entries = Dir.children(sd).sort
    _o, err, st = Open3.capture3("tar", "-czf", out_path, "-C", sd, *entries)
    raise "tar -czf failed: #{err}" unless st.success?
  end
  Digest::SHA256.file(out_path).hexdigest
end

# Build a minimal valid ZIP (.whl) with deflate compression using Ruby stdlib Zlib.
def make_zip_bytes(entries_map)
  local_parts = +"".b
  cd_parts = +"".b
  count = 0
  entries_map.each do |name, raw_content|
    fname = name.b
    raw = raw_content.b
    crc = Zlib.crc32(raw)
    deflated = Zlib::Deflate.new(Zlib::DEFAULT_COMPRESSION, -Zlib::MAX_WBITS).deflate(raw, Zlib::FINISH)
    offset = local_parts.bytesize
    local_parts << ["PK\x03\x04".b, 20, 0, 8, 0, 0, crc, deflated.bytesize, raw.bytesize, fname.bytesize, 0].pack("a4vvvvvVVVvv")
    local_parts << fname << deflated
    cd_parts << ["PK\x01\x02".b, 20, 20, 0, 8, 0, 0, crc, deflated.bytesize, raw.bytesize, fname.bytesize, 0, 0, 0, 0, 0, offset].pack("a4vvvvvvVVVvvvvvVV")
    cd_parts << fname
    count += 1
  end
  cd_offset = local_parts.bytesize
  eocd = ["PK\x05\x06".b, 0, 0, count, count, cd_parts.bytesize, cd_offset, 0].pack("a4vvvvVVv")
  local_parts + cd_parts + eocd
end

# Build a minimal valid Ruby .gem (tar archive containing data.tar.gz).
def make_gem_bytes(files_map)
  Dir.mktmpdir("filc-mkgem-") do |gd|
    data_gz = File.join(gd, "data.tar.gz")
    make_tar_gz(data_gz, files_map)
    gem_path = File.join(gd, "bundle.gem")
    _o, err, st = Open3.capture3("tar", "-cf", gem_path, "-C", gd, "data.tar.gz")
    raise "tar -cf gem failed: #{err}" unless st.success?
    File.binread(gem_path)
  end
end

# Create a deterministic fake ELF file + fake patchelf wrapper in a temp bin dir
# so RPATH relocation and absolute-RPATH rejection are tested identically on macOS and Linux.
def setup_fake_patchelf(bin_dir)
  FileUtils.mkdir_p(bin_dir)
  script = File.join(bin_dir, "patchelf")
  File.write(script, <<~SH)
    #!/usr/bin/env ruby
    mode = ARGV[0]
    if mode == "--print-rpath"
      raw = File.binread(ARGV[1])
      if (m = raw.match(/RPATH=([^\\x00\\n]+)/))
        puts m[1]
      end
      exit 0
    elsif mode == "--set-rpath"
      new_rpath = ARGV[1]
      file = ARGV[2]
      raw = File.binread(file)
      updated = raw.sub(/RPATH=[^\\x00\\n]+/, "RPATH=" + new_rpath)
      File.binwrite(file, updated)
      exit 0
    else
      exit 1
    end
  SH
  File.chmod(0o755, script)
  # Provide a no-op strip so fake ELF fixtures are not mangled by host strip
  strip_script = File.join(bin_dir, "strip")
  File.write(strip_script, "#!/bin/sh\nexit 0\n")
  File.chmod(0o755, strip_script)
end

TEST_EXACT_TOKENS = [
  ip4(198, 51, 100, 10),
  ip4(198, 51, 100, 20),
  "/#{srv_seg}/example-ci",
  "/mnt/example-ci-artifacts",
  "/home/opsfixture",
  "Internal-Forge-Org",
  "builder-host.internal"
].join("\n") + "\n"

BASE_ENV = { "FILC_LEAK_EXACT_TOKENS" => TEST_EXACT_TOKENS }.freeze

Dir.mktmpdir("filc-pkg-test-") do |td|
  repo = File.join(td, "repo")
  work = File.join(td, "work")
  pizfix = File.join(td, "pizfix")
  cache = File.join(work, "ports-cache")
  state = File.join(work, "ports-state")
  out = File.join(td, "out")

  FileUtils.mkdir_p([
    File.join(repo, "ports", "demo", "patches"),
    File.join(pizfix, "bin"),
    File.join(pizfix, "lib", "pkgconfig"),
    File.join(pizfix, "include"),
    cache,
    state,
    out
  ])

  # Create real upstream source tarball for demo
  src_tmp = File.join(td, "demo-1.0.tar.gz")
  src_sha = make_tar_gz(src_tmp, { "demo-1.0/README" => "demo upstream source archive content\n" })
  src_file = File.join(cache, "demo-1.0-#{src_sha[0, 12]}-demo-1.0.tar.gz")
  FileUtils.cp(src_tmp, src_file)

  File.write(File.join(repo, "UPSTREAM"), <<~UP)
    LLVM_TAG=llvmorg-23.1.6
    FILC_COMMIT=cede3de02b42b58a14acc9ce39c9894ab952a915
    MUSL_COMMIT=f314e133929b6379eccc632bef32eaebb66a7335
  UP

  File.write(File.join(repo, "ports", "demo", "PORT"), <<~PORT)
    NAME=demo
    VERSION=1.0
    LICENSE=GPL-3.0-or-later
    UPSTREAM_URL=https://example.invalid/demo-1.0.tar.gz
    UPSTREAM_SHA256=#{src_sha}
    EXTRACT_DIR=demo-1.0
    TIER=0
    DEPS=""
    BUILD_SYSTEM=autotools
    POLICY_CLASS=P0-Clean
  PORT

  # Installed files in pizfix + install manifest (including a .la file that must be stripped)
  File.write(File.join(pizfix, "include", "demo.h"), "#define DEMO_VER 1\n")
  File.write(File.join(pizfix, "lib", "libdemo.la"), "libdir='#{pizfix}/lib'\n")
  File.write(File.join(pizfix, "lib", "pkgconfig", "demo.pc"), <<~PC)
    prefix=#{pizfix}
    exec_prefix=${prefix}
    libdir=${exec_prefix}/lib
    includedir=${prefix}/include

    Name: demo
    Description: Demo library
    Version: 1.0
    Libs: -L${libdir} -ldemo
    Cflags: -I${includedir}
  PC
  File.write(File.join(state, "demo.manifest.json"), JSON.pretty_generate(
    "port" => "demo",
    "files" => ["include/demo.h", "lib/libdemo.la", "lib/pkgconfig/demo.pc"]
  ) + "\n")

  # 1. Clean packaging + .pc relocation + GPL corresponding source + recipe
  out_s, err_s, st = Open3.capture3(
    BASE_ENV,
    "ruby", PACKAGE_SCRIPT,
    "--repo-root", repo,
    "--work-dir", work,
    "--pizfix", pizfix,
    "--ports-cache-dir", cache,
    "--out-dir", out,
    "--channel", "0.1.3",
    "--arch", "x86_64-linux"
  )
  assert(st.success?, "package-port failed: #{out_s}\n#{err_s}")
  assert(out_s.include?("PACKAGE_PORT: OK"), "missing PACKAGE_PORT: OK banner")

  ch_dir = File.join(out, "0.1.3", "x86_64-linux")
  idx = JSON.parse(File.read(File.join(ch_dir, "index.json")))
  assert(idx["channel"] == "0.1.3", "wrong channel")
  pkg = idx.dig("packages", "demo")
  assert(pkg && pkg["version"] == "1.0", "missing demo package in index.json")
  assert(File.file?(File.join(ch_dir, pkg.dig("binary", "path"))), "missing binary tar.xz")
  assert(File.file?(File.join(ch_dir, pkg.dig("source", "path"))), "missing GPL corresponding source tarball")
  assert(File.file?(File.join(ch_dir, pkg.dig("recipe", "path"))), "missing recipe tar.xz")

  # Verify .pc relocation and .la stripping inside binary tarball
  extract = File.join(td, "extract")
  FileUtils.mkdir_p(extract)
  _to, terr, tst = Open3.capture3("tar", "-xf", File.join(ch_dir, pkg.dig("binary", "path")), "-C", extract)
  assert(tst.success?, "tar extract failed: #{terr}")
  pc_text = File.read(File.join(extract, "prefix", "lib", "pkgconfig", "demo.pc"))
  assert(pc_text.include?("prefix=${pcfiledir}/../.."), "demo.pc was not relocated: #{pc_text}")
  assert(!pc_text.include?(pizfix), "demo.pc still contains absolute pizfix path")
  assert(!File.exist?(File.join(extract, "prefix", "lib", "libdemo.la")), ".la file must be stripped from binary tarball")
  pkg_meta = JSON.parse(File.read(File.join(extract, "filc-pkg.json")))
  assert(!pkg_meta["files"].key?("lib/libdemo.la"), ".la file must not appear in filc-pkg.json")

  # 1b. Missing or empty FILC_LEAK_EXACT_TOKENS MUST hard-abort
  _mo, merr, mst = Open3.capture3(
    { "FILC_LEAK_EXACT_TOKENS" => nil },
    "ruby", PACKAGE_SCRIPT,
    "--repo-root", repo,
    "--work-dir", work,
    "--pizfix", pizfix,
    "--ports-cache-dir", cache,
    "--out-dir", File.join(td, "out-nosecret"),
    "--channel", "0.1.3",
    "--arch", "x86_64-linux"
  )
  assert(!mst.success?, "package-port must abort when FILC_LEAK_EXACT_TOKENS is unset")
  assert(merr.include?("LEAK_GATE CONFIG ERROR"), "expected config error for missing secret, got: #{merr}")

  _eo, eerr, est = Open3.capture3(
    { "FILC_LEAK_EXACT_TOKENS" => "   \n# comment only\n" },
    "ruby", PACKAGE_SCRIPT,
    "--repo-root", repo,
    "--work-dir", work,
    "--pizfix", pizfix,
    "--ports-cache-dir", cache,
    "--out-dir", File.join(td, "out-emptysecret"),
    "--channel", "0.1.3",
    "--arch", "x86_64-linux"
  )
  assert(!est.success?, "package-port must abort when FILC_LEAK_EXACT_TOKENS has no active tokens")
  assert(eerr.include?("LEAK_GATE CONFIG ERROR"), "expected config error for empty secret, got: #{eerr}")

  # 2. Leak-gate MUST collect ALL hits across ALL packages before failing
  FileUtils.mkdir_p(File.join(repo, "ports", "demo2", "patches"))
  File.write(File.join(repo, "ports", "demo2", "PORT"), <<~PORT2)
    NAME=demo2
    VERSION=1.0
    LICENSE=MIT
    UPSTREAM_URL=https://example.invalid/demo-1.0.tar.gz
    UPSTREAM_SHA256=#{src_sha}
    EXTRACT_DIR=demo-1.0
    TIER=0
    DEPS=""
    BUILD_SYSTEM=autotools
    POLICY_CLASS=P0-Clean
  PORT2
  FileUtils.cp(src_tmp, File.join(cache, "demo2-1.0-#{src_sha[0, 12]}-demo-1.0.tar.gz"))
  fake_private_ip = ip4(192, 168, 0, 1)
  File.write(File.join(pizfix, "include", "demo.h"), "#define LEAK \"#{fake_private_ip}\"\n")
  File.write(File.join(pizfix, "include", "demo2.h"), "#define LEAK2 \"#{repo}/secret\"\n")
  File.write(File.join(state, "demo2.manifest.json"), JSON.pretty_generate(
    "port" => "demo2",
    "files" => ["include/demo2.h"]
  ) + "\n")
  _lo, lerr, lst = Open3.capture3(
    BASE_ENV,
    "ruby", PACKAGE_SCRIPT,
    "--repo-root", repo,
    "--work-dir", work,
    "--pizfix", pizfix,
    "--ports-cache-dir", cache,
    "--out-dir", File.join(td, "out-leak"),
    "--channel", "0.1.3",
    "--arch", "x86_64-linux"
  )
  assert(!lst.success?, "leak-gate must reject unverified private IP and repo path")
  assert(lerr.include?("LEAK_GATE FAILED across 2 package(s)"), "expected multi-package LEAK_GATE summary, got: #{lerr}")
  assert(lerr.include?("[demo]") && lerr.include?("[demo2]"), "expected hits for both demo and demo2, got: #{lerr}")
  assert(lerr.include?("unverified generic private_ipv4_192"), "expected unverified generic reason, got: #{lerr}")

  # 2b. Neutral prefix allowed when --neutral-prefix matches --pizfix
  File.write(File.join(pizfix, "include", "demo.h"), "#define NEUTRAL_PREFIX \"#{pizfix}\"\n")
  _no, nerr, nst = Open3.capture3(
    BASE_ENV,
    "ruby", PACKAGE_SCRIPT,
    "--repo-root", repo,
    "--work-dir", work,
    "--pizfix", pizfix,
    "--neutral-prefix", pizfix,
    "--ports", "demo",
    "--ports-cache-dir", cache,
    "--out-dir", File.join(td, "out-neutral"),
    "--channel", "0.1.3",
    "--arch", "x86_64-linux"
  )
  assert(nst.success?, "neutral prefix should be allowed when --neutral-prefix == --pizfix: #{nerr}")

  # 2c. Unsafe --neutral-build-dir must be rejected
  _bo, berr, bst = Open3.capture3(
    BASE_ENV,
    "ruby", PACKAGE_SCRIPT,
    "--repo-root", repo,
    "--work-dir", work,
    "--pizfix", pizfix,
    "--neutral-build-dir", work,
    "--ports", "demo",
    "--ports-cache-dir", cache,
    "--out-dir", File.join(td, "out-badbuild"),
    "--channel", "0.1.3",
    "--arch", "x86_64-linux"
  )
  assert(!bst.success?, "unsafe --neutral-build-dir must be rejected")
  assert(berr.include?("unsafe --neutral-build-dir"), "expected unsafe --neutral-build-dir error, got: #{berr}")

  # 3. Upload script MUST refuse unsigned channel
  _uo, uerr, ust = Open3.capture3(
    "ruby", UPLOAD_SCRIPT,
    "--channel-dir", ch_dir,
    "--channel", "0.1.3",
    "--arch", "x86_64-linux",
    "--dry-run"
  )
  assert(!ust.success?, "upload-ports must refuse unsigned channel")
  assert(uerr.include?("missing required channel file"), "expected missing signature error: #{uerr}")

  # 4. Upload script end-to-end against mock HTTP server (with dummy minisig files)
  File.write(File.join(ch_dir, "index.json.minisig"), "untrusted comment: test\nAA==\ntrusted comment: t\nAA==\n")
  File.write(File.join(ch_dir, "SHA256SUMS.minisig"), "untrusted comment: test\nAA==\ntrusted comment: t\nAA==\n")

  received = []
  srv = TCPServer.new("127.0.0.1", 0)
  port = srv.addr[1]
  server_thr = Thread.new do
    loop do
      sock = begin
        srv.accept
      rescue IOError
        break
      end
      req_head = +""
      while (line = sock.gets)
        req_head << line
        break if line == "\r\n"
      end
      first = req_head.lines.first.to_s.strip
      method, path, = first.split(" ", 3)
      cl = req_head[/^Content-Length:\s*(\d+)/i, 1].to_i
      auth = req_head[/^Authorization:\s*(.+)\r?$/i, 1].to_s.strip
      body = cl > 0 ? sock.read(cl) : ""
      received << [method, path, auth, body.bytesize]

      if method == "HEAD"
        sock.write("HTTP/1.1 404 Not Found\r\nContent-Length: 2\r\nConnection: close\r\n\r\n{}")
      elsif method == "PUT"
        resp = JSON.generate("ok" => true, "created" => true)
        sock.write("HTTP/1.1 201 Created\r\nContent-Type: application/json\r\nContent-Length: #{resp.bytesize}\r\nConnection: close\r\n\r\n#{resp}")
      elsif method == "POST"
        resp = JSON.generate("ok" => true, "packages" => 1)
        sock.write("HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: #{resp.bytesize}\r\nConnection: close\r\n\r\n#{resp}")
      end
      sock.close
    end
  end

  begin
    uo2, ue2, ust2 = Open3.capture3(
      { "FILC_PORTS_UPLOAD_TOKEN" => "ci-upload-secret" },
      "ruby", UPLOAD_SCRIPT,
      "--channel-dir", ch_dir,
      "--channel", "0.1.3",
      "--arch", "x86_64-linux",
      "--allow-unsigned-test",
      "--base-url", "http://127.0.0.1:#{port}"
    )
    assert(ust2.success?, "upload-ports failed against mock server: #{uo2}\n#{ue2}")
    assert(uo2.include?("UPLOAD_PORTS: OK"), "missing UPLOAD_PORTS: OK: #{uo2}")
    puts_paths = received.select { |m, _| m == "PUT" }.map { |_, p| p }
    assert(puts_paths.length == 3, "expected 3 PUT uploads (src, recipe, bin), got #{puts_paths.inspect}")
    assert(puts_paths[0].include?("/src/") && puts_paths[1].include?("/recipes/") && puts_paths[2].include?("/bin/"),
           "uploads must run in src -> recipes -> bin order: #{puts_paths.inspect}")
    assert(received.last[0] == "POST" && received.last[1].end_with?("/commit-index"), "must end with commit-index")
    assert(received.all? { |_, _, a, _| a == "Bearer ci-upload-secret" }, "every upload request must carry Bearer token")
  ensure
    srv.close
    server_thr.join(2)
  end

  # 5. Repository minisign public key format & upload-ports missing-pubkey guard
  pubkey_path = File.join(REPO_ROOT, "ports", "ports-pubkey.pub")
  assert(File.file?(pubkey_path), "missing repository ports minisign public key: #{pubkey_path}")
  pk_lines = File.read(pubkey_path, encoding: "UTF-8").lines.map(&:strip).reject(&:empty?)
  assert(pk_lines.length == 2, "ports-pubkey.pub must have 2 lines, got #{pk_lines.length}")
  assert(pk_lines[0].start_with?("untrusted comment: minisign public key "), "unexpected pubkey comment line")
  pk_raw = pk_lines[1].unpack1("m0")
  assert(pk_raw.bytesize == 42 && pk_raw.byteslice(0, 2) == "Ed".b, "invalid minisign Ed25519 public key encoding")
  key_id_hex = pk_raw.byteslice(2, 8).bytes.reverse.map { |b| format("%02X", b) }.join
  assert(pk_lines[0].end_with?(key_id_hex), "pubkey comment key ID mismatch (expected #{key_id_hex})")

  _uo3, ue3, ust3 = Open3.capture3(
    "ruby", UPLOAD_SCRIPT,
    "--channel-dir", ch_dir,
    "--channel", "0.1.3",
    "--arch", "x86_64-linux",
    "--pubkey", File.join(td, "nonexistent.pub"),
    "--dry-run"
  )
  assert(!ust3.success?, "upload-ports must reject missing --pubkey file when verification is enabled")
  assert(ue3.include?("minisign public key not found"), "expected missing pubkey error, got: #{ue3}")

  # 6. Full 94-hit fixture from publish-ports #201:
  #    - 40 bash loadable builtins under lib/bash/* (must be relocated to $ORIGIN/.. and pass)
  #    - 54 upstream false positives across 12 packages (must all be allowed with provenance)
  p201_repo = File.join(td, "p201-repo")
  p201_work = File.join(td, "p201-work")
  p201_pizfix = File.join(td, "p201-pizfix")
  p201_cache = File.join(p201_work, "ports-cache")
  p201_state = File.join(p201_work, "ports-state")
  p201_out = File.join(td, "p201-out")
  p201_bin = File.join(td, "fake-tools")
  setup_fake_patchelf(p201_bin)

  FileUtils.mkdir_p([p201_repo, p201_pizfix, p201_cache, p201_state, p201_out])
  FileUtils.cp(File.join(repo, "UPSTREAM"), File.join(p201_repo, "UPSTREAM"))

  bash_builtins = %w[
    accept basename chmod csv cut dirname dsv fdflags finfo fltexpr
    getconf head id kv ln logname mkdir mkfifo mktemp mypid
    pathchk print printenv push realpath rm rmdir seq setpgid sleep
    stat strftime strptime sync tee truefalse tty uname unlink whoami
  ]
  assert(bash_builtins.length == 40, "expected 40 bash builtins")

  # Helper to register a fixture port in p201_repo
  register_p201_port = lambda do |name, installed_files, upstream_files|
    FileUtils.mkdir_p(File.join(p201_repo, "ports", name))
    tar_tmp = File.join(td, "#{name}-1.0.tar.gz")
    sha = make_tar_gz(tar_tmp, upstream_files)
    FileUtils.cp(tar_tmp, File.join(p201_cache, "#{name}-1.0-#{sha[0, 12]}-#{name}-1.0.tar.gz"))
    File.write(File.join(p201_repo, "ports", name, "PORT"), <<~P)
      NAME=#{name}
      VERSION=1.0
      LICENSE=MIT
      UPSTREAM_URL=https://example.invalid/#{name}-1.0.tar.gz
      UPSTREAM_SHA256=#{sha}
      EXTRACT_DIR=#{name}-1.0
      TIER=0
      DEPS=""
      BUILD_SYSTEM=autotools
      POLICY_CLASS=P0-Clean
    P
    installed_files.each do |rel, bytes|
      dst = File.join(p201_pizfix, rel)
      FileUtils.mkdir_p(File.dirname(dst))
      File.binwrite(dst, bytes)
    end
    File.write(File.join(p201_state, "#{name}.manifest.json"), JSON.pretty_generate(
      "port" => name,
      "files" => installed_files.keys.sort
    ) + "\n")
    sha
  end

  # Package 1: bash (40 loadable builtins with absolute RPATH before relocation)
  bash_files = {}
  bash_builtins.each do |b|
    bash_files["lib/bash/#{b}"] = "\x7fELF\x02\x01\x01\x00RPATH=/opt/filc/0.1.4/build/bin/../../pizfix/lib\x00".b
  end
  register_p201_port.call("bash", bash_files, { "bash-1.0/README" => "GNU Bash\n" })

  # Packages 2..13: exact 54 upstream false positives across 12 packages
  p201_fixtures = {
    "bison" => [
      {
        "share/doc/bison/TODO" => "See ref doi=#{ip4(10, 1, 1, 50)}.1234\n"
      },
      {
        "bison-1.0/TODO" => "See ref doi=#{ip4(10, 1, 1, 50)}.1234\n"
      }
    ],
    "cmake" => [
      {
        "share/cmake-4.5/Modules/FetchContent.cmake" => "# example /#{srv_seg}/repos/foo\n"
      },
      {
        "cmake-1.0/Modules/FetchContent.cmake" => "# example /#{srv_seg}/repos/foo\n"
      }
    ],
    "curl" => [
      {
        "share/man/man1/curl.1" => "e.g. #{ip4(192, 168, 0, 1)}, or #{ip4(10, 1, 2, 3)}\n",
        "share/man/man3/CURLOPT_DNS_LOCAL_IP4.3" => "opt \"#{ip4(192, 168, 0, 14)}\"\n",
        "share/man/man3/CURLOPT_DNS_SERVERS.3" => "servers #{ip4(192, 168, 1, 100)}, ...\n",
        "share/man/man3/CURLOPT_FTPPORT.3" => "port #{ip4(192, 168, 1, 2)}:21\n",
        "share/man/man3/CURLOPT_NOPROXY.3" => "cidr \"#{ip4(192, 168, 0, 0)}/16\"\n",
        "share/man/man3/libcurl-security.3" => "http://#{ip4(192, 168, 0, 1)}/ and #{ip4(10, 1, 2, 3)}.\n"
      },
      {
        "curl-1.0/docs/curl.md" => [
          ip4(192, 168, 0, 1), ip4(10, 1, 2, 3), ip4(192, 168, 0, 14),
          ip4(192, 168, 1, 100), ip4(192, 168, 1, 2), ip4(192, 168, 0, 0)
        ].join("\n") + "\n"
      }
    ],
    "git" => [
      {
