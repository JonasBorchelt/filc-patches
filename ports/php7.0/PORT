port_configure() {
  local shim_dir="$SRC_DIR/.filc-tools"
  rm -rf "$shim_dir"
  mkdir -p "$shim_dir/bin"
  ln -s "$PIZFIX/include" "$shim_dir/include"
  ln -s "$PIZFIX/lib" "$shim_dir/lib"
  cat > "$shim_dir/bin/xml2-config" <<SHIM
#!/bin/sh
PKG_CONFIG_PATH="$PIZFIX/lib/pkgconfig"
export PKG_CONFIG_PATH
case "\$1" in
  --version) exec "$PIZFIX/bin/pkg-config" --define-prefix --modversion libxml-2.0 ;;
  --cflags)  exec "$PIZFIX/bin/pkg-config" --define-prefix --cflags libxml-2.0 ;;
  --libs)    exec "$PIZFIX/bin/pkg-config" --define-prefix --libs libxml-2.0 ;;
  --prefix)  printf '%s\n' "$PIZFIX" ;;
  *)         exec "$PIZFIX/bin/pkg-config" --define-prefix "\$@" libxml-2.0 ;;
esac
SHIM
  cat > "$shim_dir/bin/icu-config" <<SHIM
#!/bin/sh
PKG_CONFIG_PATH="$PIZFIX/lib/pkgconfig"
export PKG_CONFIG_PATH
case "\$1" in
  --version)        exec "$PIZFIX/bin/pkg-config" --define-prefix --modversion icu-uc ;;
  --cppflags)       exec "$PIZFIX/bin/pkg-config" --define-prefix --cflags icu-uc icu-io icu-i18n ;;
  --ldflags)        exec "$PIZFIX/bin/pkg-config" --define-prefix --libs icu-io icu-i18n icu-uc ;;
  --ldflags-icuio)  exec "$PIZFIX/bin/pkg-config" --define-prefix --libs icu-io ;;
  --ldflags-libsonly) exec "$PIZFIX/bin/pkg-config" --define-prefix --libs-only-l icu-io icu-i18n icu-uc ;;
  --ldflags-searchpath) exec "$PIZFIX/bin/pkg-config" --define-prefix --libs-only-L icu-io icu-i18n icu-uc ;;
  --prefix)         printf '%s\n' "$PIZFIX" ;;
  --cxxflags)       printf '%s\n' "-std=c++17" ;;
  *)                printf '' ;;
esac
SHIM
  chmod +x "$shim_dir/bin/xml2-config" "$shim_dir/bin/icu-config"
  PATH="$shim_dir/bin:$PIZFIX/bin:$PATH" \
    CPPFLAGS="-I$PIZFIX/include -I$PIZFIX/include/ncursesw" \
    CXXFLAGS="${CXXFLAGS:-} -I$PIZFIX/include -std=c++17" \
    LDFLAGS="-L$PIZFIX/lib" \
