port_test() {
  local php_bin fpm_bin ext_dir out ver fpm_ver
  php_bin="$PIZFIX/bin/php7.4"
  fpm_bin="$PIZFIX/sbin/php-fpm7.4"
  ext_dir="$PIZFIX/lib/php7.4/extensions"

  out="$("$php_bin" -n -v)"
  ver="${out%%$'\n'*}"
  echo "php7.4 version: $ver"
  printf '%s\n' "$ver" | grep -q '^PHP 7\.4\.33 '

  out="$("$fpm_bin" -n -v)"
  fpm_ver="${out%%$'\n'*}"
  echo "php-fpm7.4 version: $fpm_ver"
  printf '%s\n' "$fpm_ver" | grep -q '^PHP 7\.4\.33 '

  "$php_bin" -n \
    -d extension_dir="$ext_dir" \
    -d zend.assertions=1 \
    -d assert.exception=1 \
    -d zend_extension=opcache \
    -d opcache.enable_cli=1 \
    <<'EOF' | grep -Fxq 'PHP74_FILC_SMOKE_OK'
<?php
// 1. Typed properties + WeakReference + class type hints (zend_type + source_list capabilities)
class Box {
    public ?stdClass $item = null;
    public int $count = 0;
    public function setItem(?stdClass $o): ?stdClass {
        $this->item = $o;
        return $this->item;
    }
}
$box = new Box();
$o = new stdClass();
$wr = WeakReference::create($o);
assert($box->setItem($o) === $o);
$ref =& $box->item;
$ref = null;
unset($ref, $o);
gc_collect_cycles();
assert($wr->get() === null);

// 2. ext/dom XML C14N (libxml2 2.15)
$xml = new DOMDocument();
$xml->loadXML('<root xmlns="urn:test"><child a="1">ok</child></root>');
assert(strpos($xml->C14N(), '<child a="1">ok</child>') !== false);

// 3. Overflow arithmetic, strcase provenance, opcache
$i = PHP_INT_MAX;
$i++;
assert(is_float($i));
assert(strtolower("Fil-C PHP 7.4") === "fil-c php 7.4");
assert(strtoupper("Fil-C php 7.4") === "FIL-C PHP 7.4");
assert(opcache_get_status(false)["opcache_enabled"] === true);

// 4. Core extensions: OpenSSL 1.1.1, zlib, bz2, SQLite3/PDO, PCRE2, JSON, curl, intl, mbstring, sodium, bcmath
assert(strpos(OPENSSL_VERSION_TEXT, "OpenSSL 1.1.1") === 0);
assert(hash("sha256", "hello\n") === "5891b5b522d5df086d0ff0b110fbd9d21bb4fc7163af34d08286a2e846f6be03");
assert(openssl_digest("hello\n", "sha256") === "5891b5b522d5df086d0ff0b110fbd9d21bb4fc7163af34d08286a2e846f6be03");
assert(gzuncompress(gzcompress("filc-zlib-php74")) === "filc-zlib-php74");
assert(bzdecompress(bzcompress("filc-bz2-php74")) === "filc-bz2-php74");
assert(preg_match('/^([a-z]+)-(\d+)$/', 'filc-74', $matches) === 1 && $matches[2] === '74');
assert(json_decode(json_encode(["ok" => [1, 2, 3]]), true)["ok"] === [1, 2, 3]);
assert(is_array(curl_version()) && !empty(curl_version()["version"]));
assert(mb_strlen("hällo", "UTF-8") === 5);
assert(mb_ereg_replace("([0-9]+)", "[\\1]", "v74") === "v[74]");
assert((new Collator("en_US"))->compare("a", "b") < 0);
assert(strlen(sodium_crypto_generichash("filc-sodium")) === SODIUM_CRYPTO_GENERICHASH_BYTES);
assert(bcadd("12345678901234567890", "1", 0) === "12345678901234567891");

$db = new SQLite3(":memory:");
$db->exec("CREATE TABLE t (v INT); INSERT INTO t VALUES (42);");
assert($db->querySingle("SELECT v FROM t") === 42);
$db->close();

$pdo = new PDO("sqlite::memory:");
$pdo->exec("CREATE TABLE p (s TEXT); INSERT INTO p VALUES ('ok');");
assert($pdo->query("SELECT s FROM p")->fetchColumn() === "ok");

// 5. pcntl_fork() + pcntl_waitpid() runtime verification
$pid = pcntl_fork();
assert($pid >= 0);
if ($pid === 0) {
    exit(42);
}
$status = 0;
assert(pcntl_waitpid($pid, $status) === $pid);
assert(pcntl_wifexited($status) && pcntl_wexitstatus($status) === 42);

echo "PHP74_FILC_SMOKE_OK\n";
EOF
}

