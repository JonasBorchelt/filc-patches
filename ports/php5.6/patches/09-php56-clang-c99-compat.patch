Subject: Fix Clang 16+ C99 strictness and pointer-type errors in PHP 5.6
Policy-Class: P2-Package
Rationale: Clang 16+ rejects implicit-int, implicit-function-declaration, int-conversion, and incompatible-pointer-types by default. Align five PHP 5.6 sites with upstream PHP 7.0: (1) declare explicit `protected int` return type on file_replace() in ext/fileinfo/libmagic/funcs.c matching file.h, (2) declare extern mbfl_filt_put_invalid_char() in ext/mbstring/libmbfl/filters/mbfilter_utf8_mobile.c, (3) take the address of mbfl_encoding_2022jp_kddi_aliases in ext/mbstring/libmbfl/filters/mbfilter_iso2022jp_mobile.c, (4) pass const unsigned char ** / const unsigned char * to php_var_unserialize() in ext/session/session.c without pointer-to-pointer type punning, and (5) make the NULL-reset branch of php_mblen() in ext/standard/php_string.h evaluate to int 0 instead of void * from memset() (fixing all 8 void*-to-int conversions in exec.c, file.c, and string.c cleanly under Fil-C).
Upstream-Status: Backport (fixed upstream in PHP 7.0)
Fil-C-Origin-Commits: none
Origin-Kind: backport
Origin-Project: php/php-src
Origin-Commit: PHP-7.0.33
Origin-URL: https://github.com/php/php-src/tree/PHP-7.0.33

--- a/ext/fileinfo/libmagic/funcs.c
+++ b/ext/fileinfo/libmagic/funcs.c
@@ -437,6 +437,7 @@ file_printedlen(const struct magic_set *ms)
 	return ms->o.buf == NULL ? 0 : strlen(ms->o.buf);
 }
 
+protected int
 file_replace(struct magic_set *ms, const char *pat, const char *rep)
 {
 	zval *patt;
--- a/ext/mbstring/libmbfl/filters/mbfilter_utf8_mobile.c
+++ b/ext/mbstring/libmbfl/filters/mbfilter_utf8_mobile.c
@@ -38,6 +38,7 @@
 
 extern int mbfl_filt_ident_utf8(int c, mbfl_identify_filter *filter);
 extern int mbfl_filt_conv_utf8_wchar_flush(mbfl_convert_filter *filter);
+extern int mbfl_filt_put_invalid_char(int c, mbfl_convert_filter *filter);
 
 extern const unsigned char mblen_table_utf8[];
 
--- a/ext/mbstring/libmbfl/filters/mbfilter_iso2022jp_mobile.c
+++ b/ext/mbstring/libmbfl/filters/mbfilter_iso2022jp_mobile.c
@@ -48,7 +48,7 @@ const mbfl_encoding mbfl_encoding_2022jp_kddi = {
 	mbfl_no_encoding_2022jp_kddi,
 	"ISO-2022-JP-MOBILE#KDDI",
 	"ISO-2022-JP",
-	mbfl_encoding_2022jp_kddi_aliases,
+	&mbfl_encoding_2022jp_kddi_aliases,
 	NULL,
 	MBFL_ENCTYPE_MBCS | MBFL_ENCTYPE_SHFTCODE | MBFL_ENCTYPE_GL_UNSAFE
 };
--- a/ext/session/session.c
+++ b/ext/session/session.c
@@ -858,13 +858,14 @@ PS_SERIALIZER_ENCODE_FUNC(php_serialize) /* {{{ */
 
 PS_SERIALIZER_DECODE_FUNC(php_serialize) /* {{{ */
 {
-	const char *endptr = val + vallen;
+	const unsigned char *p = (const unsigned char *)val;
+	const unsigned char *endptr = p + vallen;
 	zval *session_vars;
 	php_unserialize_data_t var_hash;
 
 	PHP_VAR_UNSERIALIZE_INIT(var_hash);
 	ALLOC_INIT_ZVAL(session_vars);
-	if (php_var_unserialize(&session_vars, &val, endptr, &var_hash TSRMLS_CC)) {
+	if (php_var_unserialize(&session_vars, &p, endptr, &var_hash TSRMLS_CC)) {
 		var_push_dtor(&var_hash, &session_vars);
 	}
 
--- a/ext/standard/php_string.h
+++ b/ext/standard/php_string.h
@@ -156,7 +156,7 @@ PHPAPI char *php_strerror(int errnum);
 # define php_mblen(ptr, len) 1
 #else
 # if defined(_REENTRANT) && defined(HAVE_MBRLEN) && defined(HAVE_MBSTATE_T)
-#  define php_mblen(ptr, len) ((ptr) == NULL ? memset(&BG(mblen_state), 0, sizeof(BG(mblen_state))): (int)mbrlen(ptr, len, &BG(mblen_state)))
+#  define php_mblen(ptr, len) ((ptr) == NULL ? (memset(&BG(mblen_state), 0, sizeof(BG(mblen_state))), 0) : (int)mbrlen(ptr, len, &BG(mblen_state)))
 # else
