port_configure() {
  FORCE_UNSAFE_CONFIGURE=1 \
    CPPFLAGS="-I$PIZFIX/include" \
    LDFLAGS="-L$PIZFIX/lib" \
    PKG_CONFIG_PATH="$PIZFIX/lib/pkgconfig" \
    ./configure --prefix="$PIZFIX"
}

port_test() {
  "$PIZFIX/bin/sort" --version | grep -q 'GNU coreutils.*9\.12'
  printf 'c\na\nb\n' | "$PIZFIX/bin/sort" | tr '\n' ',' | grep -Fxq 'a,b,c,'
  printf 'hello\n' | "$PIZFIX/bin/sha256sum" | grep -q '^5891b5b522d5df086d0ff0b110fbd9d21bb4fc7163af34d08286a2e846f6be03 '
  "$PIZFIX/bin/expr" 123456789012345678901234567890 + 1 | grep -Fxq '123456789012345678901234567891'
  printf 'filc-coreutils\n' | "$PIZFIX/bin/base64" | "$PIZFIX/bin/base64" -d | grep -Fxq 'filc-coreutils'
  local td
  td="$(mktemp -d)"
  printf 'line1\nline2\n' > "$td/a.txt"
  "$PIZFIX/bin/cp" "$td/a.txt" "$td/b.txt"
  "$PIZFIX/bin/wc" -l < "$td/b.txt" | tr -d ' ' | grep -Fxq '2'
  rm -rf "$td"
}
