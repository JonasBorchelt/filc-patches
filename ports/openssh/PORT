port_configure() {
  CPPFLAGS="-I$PIZFIX/include" LDFLAGS="-L$PIZFIX/lib" \
    PKG_CONFIG_PATH="$PIZFIX/lib/pkgconfig" \
    ./configure --prefix="$PIZFIX" \
      --with-ssl-dir="$PIZFIX" \
      --with-zlib="$PIZFIX" \
      --with-libedit \
      --without-pam \
      --without-selinux
}

port_install() {
  make -j"$JOBS" install-nokeys
}

port_test() {
  "$PIZFIX/bin/ssh" -V 2>&1 | grep -q 'OpenSSH_10\.6'

  # Verify Linux seccomp-filter sandbox was selected (not fallback SANDBOX_NULL/RLIMIT).
  grep -q '^#define SANDBOX_SECCOMP_FILTER 1$' "$SRC_DIR/config.h"
  grep -q '^#define SECCOMP_AUDIT_ARCH ' "$SRC_DIR/config.h"
  if grep -q '^#define SANDBOX_NULL 1$' "$SRC_DIR/config.h" || grep -q '^#define SANDBOX_RLIMIT 1$' "$SRC_DIR/config.h"; then
    echo "FAIL: OpenSSH fell back from SANDBOX_SECCOMP_FILTER" >&2
    return 1
  fi
  test -s "$SRC_DIR/sandbox-seccomp-filter.o"
  nm "$SRC_DIR/sandbox-seccomp-filter.o" | grep -q ' T ssh_sandbox_child$'
  nm "$SRC_DIR/sandbox-seccomp-filter.o" | grep -q ' U zlock_runtime_threads$'

  # Confirm installed sshd-auth (or sshd-session/sshd) links the seccomp sandbox code.
  local sbin_match=0
  for bin in "$PIZFIX/libexec/sshd-auth" "$PIZFIX/libexec/sshd-session" "$PIZFIX/sbin/sshd"; do
    if [[ -x "$bin" ]] && strings "$bin" | grep -q 'PR_SET_SECCOMP'; then
      sbin_match=1
      break
    fi
  done
  if [[ "$sbin_match" -ne 1 ]]; then
    echo "FAIL: installed sshd binaries do not contain PR_SET_SECCOMP sandbox" >&2
    return 1
  fi

  local td
  td="$(mktemp -d)"

  # Live runtime proof: activate OpenSSH's ssh_sandbox_child() in a forked child,
  # verify allowed syscalls keep working after zlock_runtime_threads()+PR_SET_SECCOMP,
  # and verify a disallowed syscall (mkdir) terminates the child with SIGSYS.
  cat > "$td/test_seccomp.c" <<'EOF'
#include <errno.h>
#include <signal.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <sys/wait.h>
#include <unistd.h>

struct monitor;
struct ssh_sandbox;
struct ssh_sandbox *ssh_sandbox_init(struct monitor *monitor);
void ssh_sandbox_child(struct ssh_sandbox *box);

void cleanup_exit(int i) { _exit(i); }

int main(void) {
    int pfd[2];
    if (pipe(pfd) != 0) {
        perror("pipe");
        return 1;
    }
    pid_t pid = fork();
    if (pid < 0) {
        perror("fork");
        return 1;
    }
    if (pid == 0) {
        close(pfd[0]);
        struct ssh_sandbox *box = ssh_sandbox_init(NULL);
        if (!box)
            _exit(2);
        ssh_sandbox_child(box);
        if (write(pfd[1], "ARMED\n", 6) != 6)
            _exit(3);
        /* Disallowed by OpenSSH preauth seccomp policy; must trigger SIGSYS. */
        (void)mkdir("/tmp/filc-seccomp-must-fail", 0700);
        _exit(4);
    }
    close(pfd[1]);
    char buf[16];
    memset(buf, 0, sizeof(buf));
    ssize_t n = read(pfd[0], buf, sizeof(buf) - 1);
    close(pfd[0]);
    int st = 0;
    if (waitpid(pid, &st, 0) < 0) {
        perror("waitpid");
        return 1;
    }
    if (n != 6 || memcmp(buf, "ARMED\n", 6) != 0) {
        fprintf(stderr, "seccomp child failed to arm sandbox (n=%zd, st=0x%x)\n", n, st);
        return 1;
    }
    if (!WIFSIGNALED(st) || WTERMSIG(st) != SIGSYS) {
        fprintf(stderr, "seccomp child was not killed by SIGSYS (st=0x%x)\n", st);
        return 1;
    }
    puts("OPENSSH_SECCOMP_FILTER_ACTIVE: OK (armed + SIGSYS enforced)");
    return 0;
}
EOF
  "$CC" -O2 -I"$SRC_DIR" -I"$PIZFIX/include" \
    "$td/test_seccomp.c" \
    "$SRC_DIR/sandbox-seccomp-filter.o" \
    "$SRC_DIR/libssh.a" \
    "$SRC_DIR/openbsd-compat/libopenbsd-compat.a" \
    -L"$PIZFIX/lib" -lcrypto -lz \
    -o "$td/test_seccomp"
  "$td/test_seccomp"

  "$PIZFIX/bin/ssh-keygen" -q -t ed25519 -N '' -f "$td/id_ed25519"
  "$PIZFIX/bin/ssh-keygen" -q -t rsa -b 2048 -N '' -f "$td/id_rsa"
  "$PIZFIX/bin/ssh-keygen" -lf "$td/id_ed25519.pub" | grep -q 'ED25519'
  "$PIZFIX/bin/ssh-keygen" -lf "$td/id_rsa.pub" | grep -q 'RSA'
  printf 'filc-openssh-sign-check\n' > "$td/msg.txt"
  "$PIZFIX/bin/ssh-keygen" -Y sign -f "$td/id_ed25519" -n filc-test "$td/msg.txt"
  printf 'filc-tester %s\n' "$(cat "$td/id_ed25519.pub")" > "$td/allowed"
  "$PIZFIX/bin/ssh-keygen" -Y verify -f "$td/allowed" -I filc-tester -n filc-test -s "$td/msg.txt.sig" < "$td/msg.txt"
  rm -rf "$td"
}
