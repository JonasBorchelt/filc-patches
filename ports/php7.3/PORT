assert($pid >= 0);
if ($pid === 0) {
    $conn = @stream_socket_accept($srv, 10);
    if ($conn === false) {
        exit(2);
    }
    stream_set_timeout($conn, 5);
    $req = "";
    while (strpos($req, "\r\n\r\n") === false && !feof($conn)) {
        $chunk = fread($conn, 4096);
