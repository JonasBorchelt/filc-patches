register_shutdown_function(function () use ($f, $lock) {
    assert(file_put_contents($lock, '1', FILE_APPEND | LOCK_EX) === 1);
    assert(file_put_contents($lock, '2', FILE_APPEND | LOCK_EX) === 1);
    assert(file_get_contents($lock) === '12');
