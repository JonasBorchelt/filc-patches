TIER=4
DEPS=""
BUILD_SYSTEM="autotools"
CONFIGURE_ARGS=""
MAKE_ARGS=""
INSTALL_ARGS=""
TEST_CMD=""
POLICY_CLASS="P3-BuildOpt"
POLICY_RATIONALE="Builds unmodified upstream GNU findutils 4.11.0 (find, xargs, locate, updatedb) with zero source patches. Passes -fno-builtin-sprintf because LLVM 23 SimplifyLibCalls lowers sprintf(p, \"%s\", s) in lib/regextype.c to stpcpy + ptrtoaddr (PtrToAddrInst), which FilPizlonator on 0.1.5 does not lower yet."
FILC_ORIGIN_REF="optfil/build_opt.sh:findutils-4.11.0"

port_configure() {
  CFLAGS="${CFLAGS:-} -fno-builtin-sprintf" \
    ./configure --prefix="$PIZFIX"
}

port_test() {
  local out
  out="$("$PIZFIX/bin/find" --version)"
  grep -q 'find (GNU findutils) 4\.11\.0' <<<"$out"
  out="$("$PIZFIX/bin/xargs" --version)"
  grep -q 'xargs (GNU findutils) 4\.11\.0' <<<"$out"

  local td
  td="$(mktemp -d)"
  mkdir -p "$td/sub/deep"
  printf 'alpha\n' > "$td/a.txt"
  printf 'beta\n' > "$td/sub/b.txt"
  printf 'skip\n' > "$td/sub/deep/c.log"

  local count
  count="$("$PIZFIX/bin/find" "$td" -type f -name '*.txt' -exec echo {} \; | wc -l | tr -d ' ')"
  test "$count" = "2"

  local joined
  joined="$("$PIZFIX/bin/find" "$td" -type f -name '*.txt' -print0 | "$PIZFIX/bin/xargs" -0 cat | sort | tr '\n' ',')"
  test "$joined" = "alpha,beta,"
  rm -rf "$td"
}

port_package_smoke() {
  local out
  out="$("$PKG_PREFIX/bin/find" --version)"
  grep -q 'find (GNU findutils) 4\.11\.0' <<<"$out"
  out="$("$PKG_PREFIX/bin/xargs" --version)"
  grep -q 'xargs (GNU findutils) 4\.11\.0' <<<"$out"

  local td
  td="$(mktemp -d)"
  mkdir -p "$td/nested"
  printf 'one\n' > "$td/1.txt"
  printf 'two\n' > "$td/nested/2.txt"
  printf 'ignored\n' > "$td/nested/3.bin"

  out="$("$PKG_PREFIX/bin/find" "$td" -type f -name '*.txt' -exec grep -h . {} \; | sort | tr '\n' ':')"
  grep -Fxq 'one:two:' <<<"$out"
  out="$("$PKG_PREFIX/bin/find" "$td" -type f -name '*.txt' -print0 | "$PKG_PREFIX/bin/xargs" -0 wc -l)"
  grep -q '2 total' <<<"$out"
  rm -rf "$td"
}
