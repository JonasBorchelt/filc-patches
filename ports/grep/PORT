port_configure() {
  CPPFLAGS="-I$PIZFIX/include" \
    LDFLAGS="-L$PIZFIX/lib" \
    PKG_CONFIG_PATH="$PIZFIX/lib/pkgconfig" \
    ./configure --prefix="$PIZFIX"
}

port_test() {
  "$PIZFIX/bin/grep" --version | grep -q 'GNU grep.*3\.12'
  printf 'foo bar\nthingy blah\n' | "$PIZFIX/bin/grep" foo | grep -Fxq 'foo bar'
  printf 'alpha 42\nbeta\n' | "$PIZFIX/bin/grep" -E 'alpha [0-9]+' | grep -Fxq 'alpha 42'
  printf 'foobar\nfoobaz\n' | "$PIZFIX/bin/grep" -P 'foo(?=bar)' | grep -Fxq 'foobar'
  if printf 'hello\n' | "$PIZFIX/bin/grep" -q 'missing'; then
    return 1
  fi
}
