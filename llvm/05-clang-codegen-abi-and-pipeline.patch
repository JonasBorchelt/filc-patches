+static void FixFilPtrUnionConstant(CodeGenModule &CGM,
+                                   QualType T,
+                                   int64_t offset,
+                                   std::vector<llvm::Constant *> &elements) {
+  if (filVerbose)
+    llvm::errs() << "Have type " << T << " at offset " << offset << "\n";
+  
+  if (T->getAs<PointerType>())
+    return;
+  
