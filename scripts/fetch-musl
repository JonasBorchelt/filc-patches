#!/usr/bin/env bash
set -euo pipefail

# Fetch upstream musl at the exact commit pinned in UPSTREAM.
# Usage: scripts/fetch-musl [--reference <git-repo>] [TARGET_DIR]

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../UPSTREAM
source "$REPO_ROOT/UPSTREAM"

REFERENCE=""
TARGET_DIR=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --reference)
      REFERENCE="${2:?--reference requires a path}"
      shift 2
      ;;
    -h|--help)
      echo "Usage: $0 [--reference <git-repo>] [TARGET_DIR]"
      exit 0
      ;;
    -*)
      echo "error: unknown option: $1" >&2
      exit 2
      ;;
    *)
      TARGET_DIR="$1"
      shift
      ;;
  esac
done

TARGET_DIR="${TARGET_DIR:-${FILC_MUSL_DIR:-$REPO_ROOT/.work/musl}}"
mkdir -p "$(dirname "$TARGET_DIR")"

if [[ ! -d "$TARGET_DIR/.git" ]]; then
  git init -q "$TARGET_DIR"
  git -C "$TARGET_DIR" remote add origin "$MUSL_REPO"
fi

if [[ -n "$REFERENCE" ]]; then
  if git -c safe.directory='*' -C "$REFERENCE" config --get-regexp '^(extensions\.partialclone|remote\..*\.promisor)$' >/dev/null 2>&1; then
    echo "note: skipping --reference $REFERENCE (partial/promisor clone); fetching from $MUSL_REPO" >&2
  else
    OBJ_DIR="$(git -c safe.directory='*' -C "$REFERENCE" rev-parse --git-path objects)"
    if [[ "$OBJ_DIR" != /* ]]; then
      OBJ_DIR="$(cd "$REFERENCE" && cd "$OBJ_DIR" && pwd)"
    fi
    ALT_FILE="$TARGET_DIR/.git/objects/info/alternates"
    if [[ ! -f "$ALT_FILE" ]] || ! grep -Fxq "$OBJ_DIR" "$ALT_FILE"; then
      echo "$OBJ_DIR" >> "$ALT_FILE"
    fi
  fi
fi

if git -C "$TARGET_DIR" cat-file -e "${MUSL_COMMIT}^{commit}" 2>/dev/null; then
  if [[ -n "$REFERENCE" ]]; then
    echo "Using cached git objects from $REFERENCE (no network fetch)"
  fi
else
  if ! git -C "$TARGET_DIR" fetch --depth=1 --no-tags origin "$MUSL_COMMIT" 2>/dev/null; then
    git -C "$TARGET_DIR" fetch --no-tags origin
  fi
fi

git -C "$TARGET_DIR" checkout -q --force --detach "$MUSL_COMMIT"
git -C "$TARGET_DIR" clean -fdx -q

ACTUAL="$(git -C "$TARGET_DIR" rev-parse HEAD)"
if [[ "$ACTUAL" != "$MUSL_COMMIT" ]]; then
  echo "error: checked-out musl commit $ACTUAL != pinned $MUSL_COMMIT" >&2
  exit 1
fi

echo "Fetched musl ($ACTUAL) into $TARGET_DIR"
