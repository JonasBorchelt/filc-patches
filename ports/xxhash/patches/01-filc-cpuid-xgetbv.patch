Subject: Replace x86 inline cpuid/xgetbv assembly with Fil-C intrinsics
Policy-Class: P2-Package
Rationale: xxh_x86dispatch.c uses raw x86 inline assembly for CPUID/XGETBV feature probing, which is not permitted under Fil-C capability semantics; routing through __get_cpuid_count() and zxgetbv() under __FILC__ keeps runtime dispatch intact without unsafe asm.
Upstream-Status: Fil-C-Specific
Fil-C-Origin-Commits: cede3de02b42

diff --git a/xxh_x86dispatch.c b/xxh_x86dispatch.c
--- a/xxh_x86dispatch.c
+++ b/xxh_x86dispatch.c
@@ -32,6 +32,8 @@
  *   - xxHash source repository: https://github.com/Cyan4973/xxHash
  */
 
+#include <stdfil.h>
+#include <cpuid.h>
 
 /*!
  * @file xxh_x86dispatch.c
@@ -253,7 +255,13 @@
  */
 static void XXH_cpuid(xxh_u32 eax, xxh_u32 ecx, xxh_u32* abcd)
 {
-#if defined(_MSC_VER)
+#if defined(__FILC__)
+    abcd[0] = 0;
+    abcd[1] = 0;
+    abcd[2] = 0;
+    abcd[3] = 0;
+    __get_cpuid_count(eax, ecx, abcd + 0, abcd + 1, abcd + 2, abcd + 3);
+#elif defined(_MSC_VER)
     __cpuidex((int*)abcd, eax, ecx);
 #else
     xxh_u32 ebx, edx;
@@ -305,7 +313,9 @@
  */
 static xxh_u64 XXH_xgetbv(void)
 {
-#if defined(_MSC_VER)
+#if defined(__FILC__)
+    return zxgetbv();
+#elif defined(_MSC_VER)
     return _xgetbv(0);  /* min VS2010 SP1 compiler is required */
 #else
     xxh_u32 xcr0_lo, xcr0_hi;
