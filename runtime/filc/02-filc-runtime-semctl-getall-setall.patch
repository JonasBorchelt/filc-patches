Subject: Implement memory-safe semctl(GETALL/SETALL) in Fil-C runtime
Policy-Class: P1-Toolchain
Rationale: Previously filc_native_zsys_semctl returned ENOSYS for GETALL and SETALL, forcing Perl's IPC-SysV tests (io/sem.t, cpan/IPC-SysV/t/{ipcsysv,sem}.t) to be excluded. Query sem_nsems via IPC_STAT, check capability bounds for nsems * sizeof(unsigned short) with overflow-checked multiplication, and forward the validated array pointer to the kernel semctl syscall.
Upstream-Status: Upstream-Candidate

--- a/libpas/src/libpas/filc_runtime.c
+++ b/libpas/src/libpas/filc_runtime.c
@@ -11426,10 +11426,20 @@
             my_thread, semctl(semid, semnum, cmd, (struct seminfo*)filc_ptr_ptr(seminfo_ptr)));
     }
 
     case GETALL:
-    case SETALL:
-        filc_set_errno(ENOSYS);
-        return -1;
+    case SETALL: {
+        filc_ptr array_ptr = filc_cc_cursor_get_next_ptr(my_thread, args);
+        struct semid_ds stat_buf;
+        if (FILC_SYSCALL(my_thread, semctl(semid, 0, IPC_STAT, &stat_buf)) < 0)
+            return -1;
+        size_t byte_size = filc_mul_size((size_t)stat_buf.sem_nsems, sizeof(unsigned short));
+        if (cmd == GETALL)
+            filc_check_write(array_ptr, byte_size);
+        else
+            filc_check_read(array_ptr, byte_size);
+        return FILC_SYSCALL(
+            my_thread, semctl(semid, semnum, cmd, (unsigned short*)filc_ptr_ptr(array_ptr)));
+    }
 
     case SETVAL: {
         int val = filc_cc_cursor_get_next_int(my_thread, args);
