 // Out of line virtual dtor for TargetInfo.
 TargetInfo::~TargetInfo() {}
 
-void TargetInfo::resetDataLayout(StringRef DL) { DataLayoutString = DL.str(); }
+void TargetInfo::resetDataLayout(StringRef DL) {
+  DataLayoutStringBeforeFilC = DL.str();
+  DataLayoutStringAfterFilC = DL.str();
+}
+
+void TargetInfo::resetDataLayout(StringRef DLBeforeFilC, StringRef DLAfterFilC) {
+  DataLayoutStringBeforeFilC = DLBeforeFilC.str();
+  DataLayoutStringAfterFilC = DLAfterFilC.str();
+}
 
 void TargetInfo::resetDataLayout() {
-  DataLayoutString = Triple.computeDataLayout(getABI());
+  std::string After = Triple.computeDataLayout(getABI());
+  std::string Before = After;
+  if (Triple.isOSBinFormatELF() &&
+      (Triple.getArch() == llvm::Triple::x86_64 ||
+       Triple.getArch() == llvm::Triple::aarch64)) {
+    // Inject non-integral address space 0 (ni:0) for pre-pizlonation Fil-C IR.
+    if (Before.rfind("e-m:e-", 0) == 0)
+      Before = "e-m:e-ni:0-" + Before.substr(6);
+    else if (!Before.empty())
+      Before += "-ni:0";
+  }
+  DataLayoutStringBeforeFilC = std::move(Before);
+  DataLayoutStringAfterFilC = std::move(After);
 }
 
