port_test() {
  "$PIZFIX/bin/patch" --version | grep -q 'GNU patch 2\.8\.1'
  local td
  td="$(mktemp -d)"
  printf 'alpha\nbeta\ngamma\n' > "$td/f.txt"
  cat > "$td/f.patch" <<'EOF'
--- a/f.txt
+++ b/f.txt
@@ -1,3 +1,3 @@
 alpha
-beta
+beta-patched
 gamma
EOF
  "$PIZFIX/bin/patch" -d "$td" -p1 --batch --forward < "$td/f.patch"
  grep -qx 'beta-patched' "$td/f.txt"
  rm -rf "$td"
}
