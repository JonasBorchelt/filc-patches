UPSTREAM_SHA256_SOURCE="pgp:https://astron.com/pub/file/file-5.48.tar.gz.asc key:ports/pgp-keys/file-zoulas-release-key.asc fpr:BE04995BA8F90ED0C0C176C471112AB16CB33B3A"
