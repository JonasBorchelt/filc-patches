port_configure() {
  FORCE_UNSAFE_CONFIGURE=1 \
    ./configure --prefix="$PIZFIX" \
      --without-posix-acls \
      --without-selinux \
      --disable-nls \
      --disable-rpath
}

port_test() {
  "$PIZFIX/bin/tar" --version | grep -q 'tar (GNU tar) 1\.35'

  local td
  td="$(mktemp -d)"
  mkdir -p "$td/src/sub" "$td/out-xz" "$td/out-zstd"
  printf 'tar-filc-payload-1\n' > "$td/src/a.txt"
  printf 'tar-filc-payload-2\n' > "$td/src/sub/b.txt"

  PATH="$PIZFIX/bin:$PATH" "$PIZFIX/bin/tar" -C "$td/src" --xz -cf "$td/archive.tar.xz" a.txt sub/b.txt
  PATH="$PIZFIX/bin:$PATH" "$PIZFIX/bin/tar" -C "$td/out-xz" --xz -xf "$td/archive.tar.xz"
  cmp "$td/src/a.txt" "$td/out-xz/a.txt"
  cmp "$td/src/sub/b.txt" "$td/out-xz/sub/b.txt"

  PATH="$PIZFIX/bin:$PATH" "$PIZFIX/bin/tar" -C "$td/src" --zstd -cf "$td/archive.tar.zst" a.txt sub/b.txt
  PATH="$PIZFIX/bin:$PATH" "$PIZFIX/bin/tar" -C "$td/out-zstd" --zstd -xf "$td/archive.tar.zst"
  cmp "$td/src/a.txt" "$td/out-zstd/a.txt"
  cmp "$td/src/sub/b.txt" "$td/out-zstd/sub/b.txt"
  rm -rf "$td"
}

port_package_smoke() {
  "$PKG_PREFIX/bin/tar" --version | grep -q 'tar (GNU tar) 1\.35'

  local td
  td="$(mktemp -d)"
  mkdir -p "$td/in" "$td/out-xz" "$td/out-zstd"
  printf 'pkg-tar-roundtrip\n' > "$td/in/hello.txt"

  "$PKG_PREFIX/bin/tar" -C "$td/in" --xz -cf "$td/test.tar.xz" hello.txt
  "$PKG_PREFIX/bin/tar" -C "$td/out-xz" --xz -xf "$td/test.tar.xz"
  grep -Fxq 'pkg-tar-roundtrip' "$td/out-xz/hello.txt"

  "$PKG_PREFIX/bin/tar" -C "$td/in" --zstd -cf "$td/test.tar.zst" hello.txt
  "$PKG_PREFIX/bin/tar" -C "$td/out-zstd" --zstd -xf "$td/test.tar.zst"
  grep -Fxq 'pkg-tar-roundtrip' "$td/out-zstd/hello.txt"
  rm -rf "$td"
}
