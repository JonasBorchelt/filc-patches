NAME="bzip2"
VERSION="1.0.8"
LICENSE="bzip2-1.0.6"
UPSTREAM_URL="https://sourceware.org/pub/bzip2/bzip2-1.0.8.tar.gz"
UPSTREAM_SHA256="ab5a03176ee106d3f0fa90e381da478ddae405918153cca248e682cd0c4a2269"
UPSTREAM_SHA256_SOURCE="upstream-sha512-only:https://sourceware.org/pub/bzip2/sha512.sum"
EXTRACT_DIR="bzip2-1.0.8"
TIER=0
DEPS=""
BUILD_SYSTEM="make"
MAKE_ARGS=""
INSTALL_ARGS=""
TEST_CMD=""
POLICY_CLASS="P0-Clean"
POLICY_RATIONALE="Builds unmodified from official upstream bzip2 1.0.8 release tarball."
FILC_ORIGIN_REF="cede3de02b42:build_bzip2.sh"

port_build() {
  make -j "$JOBS" CC="$CC" AR="$AR" RANLIB="$RANLIB" libbz2.a bzip2 bzip2recover
}

port_install() {
  make CC="$CC" PREFIX="$PIZFIX" install
}

port_test() {
  make CC="$CC" test
}

port_package_smoke() {
  printf 'filc-bz2-pkg-smoke\n' | "$PKG_PREFIX/bin/bzip2" -c | "$PKG_PREFIX/bin/bunzip2" -c | grep -qx 'filc-bz2-pkg-smoke'
}
