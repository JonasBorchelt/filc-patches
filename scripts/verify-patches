#!/usr/bin/env ruby
# frozen_string_literal: true

# Verify that every patch in ports/*/patches/series applies cleanly to its
# pinned, SHA-256-verified upstream tarball with zero fuzz (--fuzz=0) and zero
# line offset.
#
# Usage:
#   scripts/verify-patches [--all | --ports a,b [--with-deps] | <port>...]
#                          [--cache-dir <dir>] [--cached-only] [--ports-dir <dir>]

require "digest"
require "fileutils"
require "open3"
require "optparse"
require "set"
require "tmpdir"

def parse_port_file(port_file)
  data = {}
  File.foreach(port_file, encoding: "UTF-8") do |raw|
    line = raw.strip
    next if line.empty? || line.start_with?("#")
    break if line.start_with?("port_") && line.include?("()")

    m = /\A([A-Z0-9_]+)=(.*)\z/.match(line)
    next unless m

    key = m[1]
    val = m[2].strip
    if val.length >= 2 && ((val.start_with?('"') && val.end_with?('"')) ||
                           (val.start_with?("'") && val.end_with?("'")))
      val = val[1..-2]
    end
    data[key] = val
  end
  data
end

def read_series(port_dir)
  series = File.join(port_dir, "patches", "series")
  return [] unless File.file?(series)

  out = []
  File.foreach(series, encoding: "UTF-8") do |raw|
    name = raw.split("#", 2).first.to_s.strip
    out << File.join(port_dir, "patches", name) unless name.empty?
  end
  out
end

def read_lines_lossy(path)
  File.binread(path).force_encoding("UTF-8").encode("UTF-8", invalid: :replace, undef: :replace).lines
end

def extract_patch_targets(patch_files)
  targets = []
  seen = Set.new
  patch_files.each do |pfile|
    read_lines_lossy(pfile).each do |raw|
      next unless raw.start_with?("--- ", "+++ ")

      path = raw[4..].split("\t", 2).first.to_s.strip
      next if path == "/dev/null"

      path = path[2..] if path.start_with?("a/", "b/")
      next if path.empty? || seen.include?(path)

      seen.add(path)
      targets << path
    end
  end
  targets
end

def sha256_file(path)
  Digest::SHA256.file(path).hexdigest
end

def ensure_tarball(meta, cache_dir, cached_only)
  name = meta.fetch("NAME")
  version = meta.fetch("VERSION")
  expected = meta.fetch("UPSTREAM_SHA256")
  url = meta.fetch("UPSTREAM_URL")
  tarball_name = File.basename(url.split("?", 2).first)
  FileUtils.mkdir_p(cache_dir)
  tarball_path = File.join(cache_dir, "#{name}-#{version}-#{expected[0, 12]}-#{tarball_name}")

  unless File.file?(tarball_path)
    return nil if cached_only

    tmp_path = "#{tarball_path}.part.#{Process.pid}"
    begin
      _out, err, status = Open3.capture3("curl", "-fsSL", "--retry", "3", "--retry-delay", "2", "-o", tmp_path, url)
      raise "#{name}: curl failed for #{url} (rc=#{status.exitstatus}): #{err.strip}" unless status.success?

      File.rename(tmp_path, tarball_path)
    ensure
      File.unlink(tmp_path) if File.exist?(tmp_path)
    end
  end

  actual = sha256_file(tarball_path)
  if actual != expected
    File.unlink(tarball_path)
    raise "#{name}: SHA-256 mismatch for #{tarball_name}: expected #{expected}, got #{actual}"
  end

  tarball_path
end

def strip_eol(line)
  line.sub(/\r?\n\z/, "")
end

def verify_exact_hunks(src_dir, pfile)
  pname = File.basename(pfile)
  lines = read_lines_lossy(pfile)
  i = 0
  cur_file = nil
  cur_lines = nil

  while i < lines.length
    ln = lines[i]
    if ln.start_with?("--- ")
      path = ln[4..].split("\t", 2).first.to_s.strip
      if path == "/dev/null"
        cur_file = nil
        cur_lines = nil
      else
        path = path[2..] if path.start_with?("a/")
        cur_file = path
        full = File.join(src_dir, path)
        raise "#{pname}: target file missing: #{path}" unless File.file?(full)

        cur_lines = read_lines_lossy(full).map { |l| strip_eol(l) }
      end
      i += 1
      next
    end

    if ln.start_with?("@@ ")
      m = /\A@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@/.match(ln)
      raise "#{pname}: malformed hunk header: #{ln.strip}" unless m

      old_start = m[1].to_i
      old_count = m[2].nil? ? 1 : m[2].to_i
      i += 1
      if cur_file.nil? || cur_lines.nil?
        # New file creation (/dev/null)
        i += 1 while i < lines.length && !lines[i].start_with?("@@ ", "--- ", "diff --git ")
        next
      end

      expected_old = []
      while i < lines.length && expected_old.length < old_count
        hl = lines[i]
        if hl.start_with?("\\ No newline")
          i += 1
          next
        end
        if hl.start_with?(" ", "-")
          expected_old << strip_eol(hl[1..])
          i += 1
        elsif hl.start_with?("+")
          i += 1
        else
          break
        end
      end

      idx0 = old_start - 1
      actual_old = if expected_old.empty?
                     []
                   elsif idx0 < 0 || idx0 >= cur_lines.length
                     nil
                   else
                     cur_lines[idx0, expected_old.length]
                   end
      if actual_old != expected_old
        raise "#{pname}: #{cur_file} hunk at line #{old_start} does not match verbatim " \
              "(offset or fuzz required)"
      end
      next
    end

    i += 1
  end
end

def ensure_debian_tarball(meta, cache_dir, cached_only)
  url = meta.fetch("DEBIAN_TARBALL_URL", "")
  return nil if url.empty?

  name = meta.fetch("NAME")
  version = meta.fetch("VERSION")
  expected = meta.fetch("DEBIAN_TARBALL_SHA256")
  tarball_name = File.basename(url.split("?", 2).first)
  FileUtils.mkdir_p(cache_dir)
  tarball_path = File.join(cache_dir, "#{name}-#{version}-#{expected[0, 12]}-#{tarball_name}")

  unless File.file?(tarball_path)
    return nil if cached_only

    tmp_path = "#{tarball_path}.part.#{Process.pid}"
    begin
      _out, err, status = Open3.capture3("curl", "-fsSL", "--retry", "3", "--retry-delay", "2", "-o", tmp_path, url)
      raise "#{name}: curl failed for #{url} (rc=#{status.exitstatus}): #{err.strip}" unless status.success?

      File.rename(tmp_path, tarball_path)
    ensure
      File.unlink(tmp_path) if File.exist?(tmp_path)
    end
  end

  actual = sha256_file(tarball_path)
  if actual != expected
    File.unlink(tarball_path)
    raise "#{name}: SHA-256 mismatch for #{tarball_name}: expected #{expected}, got #{actual}"
  end

  tarball_path
end

def verify_port_patches(name, meta, port_dir, cache_dir, cached_only)
  patches = read_series(port_dir)
  deb_patches = meta.fetch("DEBIAN_SECURITY_PATCHES", "").split.reject(&:empty?)
  return "SKIP [no-patches] #{name} #{meta['VERSION']}" if patches.empty? && deb_patches.empty?

  tarball_path = ensure_tarball(meta, cache_dir, cached_only)
  return "SKIP [uncached] #{name} #{meta['VERSION']}" if tarball_path.nil?

  deb_tarball_path = nil
  unless deb_patches.empty?
    deb_tarball_path = ensure_debian_tarball(meta, cache_dir, cached_only)
    return "SKIP [uncached] #{name} #{meta['VERSION']}" if deb_tarball_path.nil?
  end

  extract_dir = meta.fetch("EXTRACT_DIR")
  targets = extract_patch_targets(patches)

  Dir.mktmpdir("filc-vpatch-#{name}-") do |td|
    if deb_patches.empty?
      members = targets.map { |t| "#{extract_dir}/#{t}" }
      # Fast selective extract first; fall back to full extract if a patch creates new files
      _sout, _serr, sel_status = Open3.capture3("tar", "-xf", tarball_path, "-C", td, *members)
      unless sel_status.success?
        _fout, ferr, full_status = Open3.capture3("tar", "-xf", tarball_path, "-C", td)
        raise "#{name}: tar extract failed (rc=#{full_status.exitstatus}): #{ferr.strip}" unless full_status.success?
      end
    else
      _fout, ferr, full_status = Open3.capture3("tar", "-xf", tarball_path, "-C", td)
      raise "#{name}: tar extract failed (rc=#{full_status.exitstatus}): #{ferr.strip}" unless full_status.success?
    end

    src_dir = File.join(td, extract_dir)
    raise "#{name}: extract dir #{extract_dir.inspect} not found in #{tarball_path}" unless File.directory?(src_dir)

    unless deb_patches.empty?
      deb_dir = File.join(td, "_debian")
      FileUtils.mkdir_p(deb_dir)
      _dout, derr, dstatus = Open3.capture3("tar", "-xf", deb_tarball_path, "-C", deb_dir)
      raise "#{name}: debian tar extract failed (rc=#{dstatus.exitstatus}): #{derr.strip}" unless dstatus.success?

      deb_patches.each do |dp|
        dpfile = File.join(deb_dir, "debian", "patches", dp)
        raise "#{name}: Debian ELTS security patch missing: #{dp}" unless File.file?(dpfile)

        out, err, status = Open3.capture3(
          "patch", "-d", src_dir, "-p1", "--batch", "--forward", "--fuzz=0",
          stdin_data: File.binread(dpfile),
          binmode: true
        )
        unless status.success?
          combined = [
            out.force_encoding("UTF-8").encode("UTF-8", invalid: :replace, undef: :replace),
            err.force_encoding("UTF-8").encode("UTF-8", invalid: :replace, undef: :replace),
          ].join("\n").strip
          raise "#{name}/debian:#{dp}: patch failed (rc=#{status.exitstatus}):\n#{combined}"
        end
      end
    end

    patches.each do |pfile|
      pname = File.basename(pfile)
      verify_exact_hunks(src_dir, pfile)
      patch_bytes = File.binread(pfile)
      out, err, status = Open3.capture3(
        "patch", "-d", src_dir, "-p1", "--batch", "--forward", "--fuzz=0",
        stdin_data: patch_bytes,
        binmode: true
      )
      combined = [
        out.force_encoding("UTF-8").encode("UTF-8", invalid: :replace, undef: :replace),
        err.force_encoding("UTF-8").encode("UTF-8", invalid: :replace, undef: :replace),
      ].join("\n").strip
      unless status.success?
        raise "#{name}/#{pname}: patch failed (rc=#{status.exitstatus}):\n#{combined}"
      end
      if combined.match?(/\b(offset|fuzz)\b/i)
        raise "#{name}/#{pname}: patch applied with fuzz or line offset (must be exact):\n#{combined}"
      end
    end
  end

  deb_note = deb_patches.empty? ? "" : ", elts=#{deb_patches.length}"
  "OK [patches=#{patches.length}#{deb_note}, fuzz=0, offset=0] #{name} #{meta['VERSION']}"
end

def expand_deps(all_ports, names)
  selected = Set.new
  stack = names.dup
  until stack.empty?
    cur = stack.pop
    raise ArgumentError, "unknown port: #{cur}" unless all_ports.key?(cur)
    next if selected.include?(cur)

    selected.add(cur)
    all_ports[cur].fetch("DEPS", "").split.each { |dep| stack << dep unless dep.empty? }
  end
  selected.to_a.sort
end

def parse_port_list(raw)
  raw.to_s.split(/[\s,]+/).reject(&:empty?).uniq
end

def main(argv)
  repo_root = File.expand_path("..", __dir__)
  opts = {
    all: false,
    ports: "",
    with_deps: false,
    cached_only: false,
    ports_dir: File.join(repo_root, "ports"),
    cache_dir: ENV.fetch("FILC_PORTS_CACHE_DIR", File.join(repo_root, ".work", "ports", "ports-cache")),
  }

  parser = OptionParser.new do |o|
    o.banner = "Usage: verify-patches [--all | --ports a,b [--with-deps] | <port>...] [options]"
    o.on("--all", "Check all patched ports") { opts[:all] = true }
    o.on("--ports LIST", "Comma- or whitespace-separated list of port names") { |v| opts[:ports] = v }
    o.on("--with-deps", "Include transitive dependencies of selected ports") { opts[:with_deps] = true }
    o.on("--cached-only", "Only verify ports whose tarball is already in cache") { opts[:cached_only] = true }
    o.on("--ports-dir DIR", "Ports directory") { |v| opts[:ports_dir] = v }
    o.on("--cache-dir DIR", "Tarball cache directory") { |v| opts[:cache_dir] = v }
  end

  begin
    remaining = parser.parse(argv)
  rescue OptionParser::ParseError => e
    warn "error: #{e.message}"
    return 2
  end

  all_ports = {}
  Dir.children(opts[:ports_dir]).sort.each do |entry|
    pfile = File.join(opts[:ports_dir], entry, "PORT")
    all_ports[entry] = parse_port_file(pfile) if File.file?(pfile)
  end

  wanted = remaining.flat_map { |raw| parse_port_list(raw) }
  wanted.concat(parse_port_list(opts[:ports])) unless opts[:ports].empty?
  wanted.uniq!

  selected = if !wanted.empty?
               if opts[:with_deps]
                 expand_deps(all_ports, wanted)
               else
                 wanted.uniq.sort
               end
             else
               all_ports.keys.sort
             end

  patched_selected = selected.select do |n|
    !read_series(File.join(opts[:ports_dir], n)).empty? ||
      !all_ports.fetch(n, {}).fetch("DEBIAN_SECURITY_PATCHES", "").strip.empty?
  end
  if patched_selected.empty?
    puts "VERIFY_PATCHES: PASS (0 patched ports in selection)"
    return 0
  end

  checked = 0
  skipped = 0
  failures = []
  patched_selected.each do |name|
    unless all_ports.key?(name)
      warn "error: unknown port: #{name}"
      return 1
    end
    begin
      msg = verify_port_patches(
        name,
        all_ports[name],
        File.join(opts[:ports_dir], name),
        opts[:cache_dir],
        opts[:cached_only]
      )
      $stdout.puts(msg)
      $stdout.flush
      if msg.start_with?("SKIP ")
        skipped += 1
      else
        checked += 1
      end
    rescue StandardError => e
      $stderr.puts("FAIL [#{name}] #{e.message}")
      $stderr.flush
      failures << [name, e.message]
    end
  end

  unless failures.empty?
    warn "VERIFY_PATCHES: FAILED (#{failures.length}/#{patched_selected.length})"
    return 1
  end

  puts "VERIFY_PATCHES: PASS (checked=#{checked}, skipped=#{skipped})"
  0
end

exit(main(ARGV)) if $PROGRAM_NAME == __FILE__
