Subject: Default to tracked system allocator and fix strcase pointer provenance under Fil-C
Policy-Class: P4-Audit
Rationale: Zend's 2 MiB chunk allocator hides intra-chunk overflows and UAF between PHP values; default to PHP's tracked system allocator under __FILC__ so every value gets its own capability while preserving memory_limit and recording memory_get_peak_usage(), skip integer-key free in tracked_free_all() (reclaimed by Fil-C GC), and compute res offsets from res instead of source in zend_str_tolower_dup_ex()/zend_str_toupper_dup_ex().
Upstream-Status: Fil-C-Specific (strcase offset fix is upstreamable)
Fil-C-Origin-Commits: 18e0199cef6c30fc815442c0dd3f9d97fae3702a
Origin-Kind: filc-upstream
Origin-Project: pizlonator/fil-c
Origin-Commit: 18e0199cef6c30fc815442c0dd3f9d97fae3702a
Origin-URL: https://github.com/pizlonator/fil-c/commit/18e0199cef6c30fc815442c0dd3f9d97fae3702a

diff --git a/Zend/zend_alloc.c b/Zend/zend_alloc.c
index 85eed438..66817f3a 100644
--- a/Zend/zend_alloc.c
+++ b/Zend/zend_alloc.c
@@ -3160,6 +3160,17 @@ static zend_always_inline zend_result tracked_check_max_allocs(zend_mm_heap *hea
 	return SUCCESS;
 }
 
+#if defined(__FILC__) && ZEND_MM_STAT
+/* PHP's tracked allocator never recorded peaks, so memory_get_peak_usage()
+ * reported 0; it is the default here, and monitoring code reads it. */
+# define TRACKED_PEAK(heap) do { \
+		if ((heap)->size > (heap)->peak) (heap)->peak = (heap)->size; \
+		if ((heap)->real_size > (heap)->real_peak) (heap)->real_peak = (heap)->real_size; \
+	} while (0)
+#else
+# define TRACKED_PEAK(heap) do { } while (0)
+#endif
+
 static void *tracked_malloc(size_t size)
 {
 	zend_mm_heap *heap = AG(mm_heap);
@@ -3181,6 +3192,7 @@ static void *tracked_malloc(size_t size)
 	heap->size += size;
 	heap->real_size = heap->size;
 #endif
+	TRACKED_PEAK(heap);
 	return ptr;
 }
 
@@ -3229,10 +3241,17 @@ static void *tracked_realloc(void *ptr, size_t new_size) {
 	heap->size += new_size - old_size;
 	heap->real_size = heap->size;
 #endif
+	TRACKED_PEAK(heap);
 	return ptr;
 }
 
 static void tracked_free_all(void) {
+#ifdef __FILC__
+	/* The keys are addresses, and an integer cast back to a pointer has no
+	 * capability, so free() would trap. Fil-C's collector reclaims the
+	 * request's leftover allocations once nothing refers to them. */
+	return;
+#endif
 	HashTable *tracked_allocs = AG(mm_heap)->tracked_allocs;
 	zend_ulong h;
 	ZEND_HASH_FOREACH_NUM_KEY(tracked_allocs, h) {
@@ -3248,8 +3267,20 @@ static void alloc_globals_ctor(zend_alloc_globals *alloc_globals)
 
 #if ZEND_MM_CUSTOM
 	tmp = getenv("USE_ZEND_ALLOC");
+#ifdef __FILC__
+	/* Zend's allocator carves request memory out of 2 MiB chunks, so Fil-C
+	 * bounds every PHP value only by its chunk and a freed value's memory is
+	 * reused inside it: use after free and overflows between values go
+	 * undetected. Default to the system allocator, which gives each value
+	 * its own capability, tracked so that memory_limit and
+	 * memory_get_usage() still work. USE_ZEND_ALLOC=1 selects Zend's
+	 * allocator and USE_TRACKED_ALLOC=0 untracked malloc. */
+	if (!tmp || !ZEND_ATOL(tmp)) {
+		bool tracked = !(tmp = getenv("USE_TRACKED_ALLOC")) || ZEND_ATOL(tmp);
+#else
 	if (tmp && !ZEND_ATOL(tmp)) {
 		bool tracked = (tmp = getenv("USE_TRACKED_ALLOC")) && ZEND_ATOL(tmp);
+#endif
 		zend_mm_heap *mm_heap = alloc_globals->mm_heap = malloc(sizeof(zend_mm_heap));
 		memset(mm_heap, 0, sizeof(zend_mm_heap));
 		mm_heap->use_custom_heap = ZEND_MM_CUSTOM_HEAP_STD;
diff --git a/Zend/zend_operators.c b/Zend/zend_operators.c
