Preserve Fil-C pointer provenance and capabilities across OPcache persistence and arena load

Fix three classes of Fil-C pointer-provenance bugs in PHP 7.0 ext/opcache:

1. ARENA_REALLOC() in zend_accelerator_util_funcs.c added the delta
   (ZCG(arena_mem) - current_persistent_script->arena_mem) to ptr, keeping
   the SHM capability of ptr instead of rebasing onto ZCG(arena_mem).
2. The __SSE2__ 64-byte alignment blocks in ZendAccelerator.c,
   zend_persist.c, zend_persist_calc.c, zend_accelerator_util_funcs.c, and
   zend_file_cache.c cast pointers through (zend_uintptr_t ... & ~63L),
   stripping Fil-C capabilities, and used SSE2 vector loads/stores in
   fast_memcpy() that strip pointer metadata when copying arena structs.
   Disable the __SSE2__ fast path under __FILC__ so the portable memcpy()
   and capability-preserving allocation paths are used everywhere.
3. Rebase opline->op{1,2}.zv onto (char*)op_array->literals in
   zend_persist.c (ZEND_USE_ABS_CONST_ADDR path) so pointers never retain
   the freed orig_literals capability.

--- a/ext/opcache/ZendAccelerator.c
+++ b/ext/opcache/ZendAccelerator.c
@@ -1224,7 +1224,7 @@
 	memory_used = zend_accel_script_persist_calc(new_persistent_script, NULL, 0, 0);
 
 	/* Allocate memory block */
-#ifdef __SSE2__
+#if defined(__SSE2__) && !defined(__FILC__)
 	/* Align to 64-byte boundary */
 	ZCG(mem) = zend_arena_alloc(&CG(arena), memory_used + 64);
 	ZCG(mem) = (void*)(((zend_uintptr_t)ZCG(mem) + 63L) & ~63L);
@@ -1312,7 +1312,7 @@
 	memory_used = zend_accel_script_persist_calc(new_persistent_script, key, key_length, 1);
 
 	/* Allocate shared memory */
-#ifdef __SSE2__
+#if defined(__SSE2__) && !defined(__FILC__)
 	/* Align to 64-byte boundary */
 	ZCG(mem) = zend_shared_alloc(memory_used + 64);
 	ZCG(mem) = (void*)(((zend_uintptr_t)ZCG(mem) + 63L) & ~63L);
--- a/ext/opcache/zend_accelerator_util_funcs.c
+++ b/ext/opcache/zend_accelerator_util_funcs.c
@@ -35,7 +35,7 @@
 #endif
 
 #define ARENA_REALLOC(ptr) \
-	(void*)(((char*)(ptr)) + ((char*)ZCG(arena_mem) - (char*)ZCG(current_persistent_script)->arena_mem))
+	(void*)((char*)ZCG(arena_mem) + ((char*)(ptr) - (char*)ZCG(current_persistent_script)->arena_mem))
 
 typedef int (*id_function_t)(void *, void *);
 typedef void (*unique_copy_ctor_func_t)(void *pElement);
@@ -648,7 +648,7 @@
 	return;
 }
 
-#ifdef __SSE2__
+#if defined(__SSE2__) && !defined(__FILC__)
 #include <mmintrin.h>
 #include <emmintrin.h>
 
@@ -689,7 +689,7 @@
 		ZCG(current_persistent_script) = persistent_script;
 		ZCG(arena_mem) = NULL;
 		if (EXPECTED(persistent_script->arena_size)) {
-#ifdef __SSE2__
+#if defined(__SSE2__) && !defined(__FILC__)
 			/* Target address must be aligned to 64-byte boundary */
