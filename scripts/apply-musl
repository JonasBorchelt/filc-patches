#!/usr/bin/env bash
set -euo pipefail

# Fetch upstream musl at UPSTREAM's pinned commit and apply either the
# yolomusl or usermusl Fil-C patch series.
# Usage: scripts/apply-musl <yolomusl|usermusl> [--reference <git-repo>] [TARGET_DIR]

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ $# -lt 1 ]]; then
  echo "Usage: $0 <yolomusl|usermusl> [--reference <git-repo>] [TARGET_DIR]" >&2
  exit 2
fi

VARIANT="$1"
shift

case "$VARIANT" in
  yolomusl|usermusl) ;;
  -h|--help)
    echo "Usage: $0 <yolomusl|usermusl> [--reference <git-repo>] [TARGET_DIR]"
    exit 0
    ;;
  *)
    echo "error: unknown musl variant '$VARIANT' (expected yolomusl or usermusl)" >&2
    exit 2
    ;;
esac

REFERENCE=""
TARGET_DIR=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --reference)
      REFERENCE="${2:?--reference requires a path}"
      shift 2
      ;;
    -h|--help)
      echo "Usage: $0 <yolomusl|usermusl> [--reference <git-repo>] [TARGET_DIR]"
      exit 0
      ;;
    -*)
      echo "error: unknown option: $1" >&2
      exit 2
      ;;
    *)
      TARGET_DIR="$1"
      shift
      ;;
  esac
done

TARGET_DIR="${TARGET_DIR:-$REPO_ROOT/.work/$VARIANT}"
BASE_DIR="$REPO_ROOT/libc/musl/$VARIANT"
SERIES_FILE="$BASE_DIR/series"

if [[ ! -f "$SERIES_FILE" ]]; then
  echo "error: missing series file $SERIES_FILE" >&2
  exit 1
fi

FETCH_CMD=("$REPO_ROOT/scripts/fetch-musl")
[[ -n "$REFERENCE" ]] && FETCH_CMD+=(--reference "$REFERENCE")
FETCH_CMD+=("$TARGET_DIR")
"${FETCH_CMD[@]}"

while IFS= read -r line || [[ -n "$line" ]]; do
  line="${line%%#*}"
  line="$(echo "$line" | xargs)"
  [[ -z "$line" ]] && continue
  patch_path="$BASE_DIR/$line"
  if [[ ! -f "$patch_path" ]]; then
    echo "error: missing patch $patch_path" >&2
    exit 1
  fi
  echo "Applying ${patch_path#"$REPO_ROOT"/} ..."
  git -C "$TARGET_DIR" apply --check --whitespace=nowarn "$patch_path"
  git -C "$TARGET_DIR" apply --whitespace=nowarn "$patch_path"
done < "$SERIES_FILE"

echo "Applied Fil-C $VARIANT patch series cleanly to $TARGET_DIR"
