port_configure() {
  ./configure --prefix="$PIZFIX" \
    --disable-lib-suffixes --with-shared --without-ada --enable-pc-files \
    --with-pkg-config-libdir="$PIZFIX/lib/pkgconfig"
}

port_install() {
  make install
  ln -fs ncurses6-config "$PIZFIX/bin/ncursesw6-config"
}

port_test() {
  "$PIZFIX/bin/ncurses6-config" --version
  "$PIZFIX/bin/infocmp" -V
}
