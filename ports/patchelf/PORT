port_test() {
  "$PIZFIX/bin/patchelf" --version | grep -q 'patchelf 0\.19\.3'
  local td
  td="$(mktemp -d)"
  cp "$PIZFIX/bin/patchelf" "$td/sample"
  "$PIZFIX/bin/patchelf" --print-interpreter "$td/sample" | grep -q 'ld-fil1'
  "$PIZFIX/bin/patchelf" --set-rpath '$ORIGIN' "$td/sample"
  "$PIZFIX/bin/patchelf" --print-rpath "$td/sample" | grep -Fxq '$ORIGIN'
  rm -rf "$td"
}
