+static void FixFilPtrUnionConstantForBase(CodeGenModule &CGM,
+                                          const CXXRecordDecl *base,
+                                          int64_t offset,
+                                          std::vector<llvm::Constant *> &elements) {
+  const CGRecordLayout &baseLayout = CGM.getTypes().getCGRecordLayout(base);
