Subject: Guard CLMUL CRC over-reads, inline-asm range decoder, and IO buffer alignment under Fil-C
Policy-Class: P2-Package
Rationale: liblzma's CLMUL CRC32/CRC64 routines read 16-byte aligned spans that can cross object bounds, range_decoder.h enables x86-64 inline asm by default, and xz's io_buf needs 16-byte alignment for vectorized accesses. Checking zinbounds() to fall back to generic CRC and disabling inline asm under Fil-C preserves full memory safety without patching Makefiles.
Upstream-Status: Fil-C-Specific
Fil-C-Origin-Commits: cede3de02b42

diff --git a/src/liblzma/check/crc32_fast.c b/src/liblzma/check/crc32_fast.c
--- a/src/liblzma/check/crc32_fast.c
+++ b/src/liblzma/check/crc32_fast.c
@@ -22,7 +22,9 @@
 #	include "crc32_loongarch.h"
 #endif
 
+#include <stdfil.h>
 
+
 #ifdef CRC32_GENERIC
 
 ///////////////////
@@ -177,6 +179,10 @@
 lzma_crc32(const uint8_t *buf, size_t size, uint32_t crc)
 {
 #if defined(CRC32_GENERIC) && defined(CRC32_ARCH_OPTIMIZED)
+	if (!zinbounds(zmkptr(buf, (uintptr_t)buf & -16)) ||
+	    !zinbounds(zmkptr(buf, (((uintptr_t)buf + size + 15) & -16) - 1)))
+		return lzma_crc32_generic(buf, size, crc);
+
 /*
 #ifndef HAVE_FUNC_ATTRIBUTE_CONSTRUCTOR
 	// See crc32_dispatch(). This would be the alternative which uses
diff --git a/src/liblzma/check/crc64_fast.c b/src/liblzma/check/crc64_fast.c
--- a/src/liblzma/check/crc64_fast.c
+++ b/src/liblzma/check/crc64_fast.c
@@ -18,7 +18,9 @@
 #	include "crc_x86_clmul.h"
 #endif
 
+#include <stdfil.h>
 
+
 #ifdef CRC64_GENERIC
 
 /////////////////////////////////
@@ -147,6 +149,10 @@
 lzma_crc64(const uint8_t *buf, size_t size, uint64_t crc)
 {
 #if defined(CRC64_GENERIC) && defined(CRC64_ARCH_OPTIMIZED)
+	if (!zinbounds(zmkptr(buf, (uintptr_t)buf & -16)) ||
+	    !zinbounds(zmkptr(buf, (((uintptr_t)buf + size + 15) & -16) - 1)))
+		return lzma_crc64_generic(buf, size, crc);
+
 	return crc64_func(buf, size, crc);
 
 #elif defined(CRC64_ARCH_OPTIMIZED)
diff --git a/src/liblzma/rangecoder/range_decoder.h b/src/liblzma/rangecoder/range_decoder.h
--- a/src/liblzma/rangecoder/range_decoder.h
+++ b/src/liblzma/rangecoder/range_decoder.h
@@ -47,7 +47,8 @@
 #	if defined(__x86_64__) && !defined(__ILP32__) \
 			&& !defined(__arm64ec__) && !defined(_M_ARM64EC) \
 			&& !defined(__NVCOMPILER) \
-			&& (defined(__GNUC__) || defined(__clang__))
+			&& (defined(__GNUC__) || defined(__clang__)) \
