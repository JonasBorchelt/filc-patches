POLICY_CLASS="P3-BuildOpt"
POLICY_RATIONALE="Builds unmodified upstream GNU less 710 against staged Fil-C ncurses using POSIX regex (--with-regex=posix) with zero source patches. Passes Fil-C CC and ncursesw include/library paths explicitly on the lesstest sub-make command line so lesstest/display.c finds termcap.h under $PIZFIX/include/ncursesw during the upstream lesstest run. Verified against pinned Fil-C (cede3de02b42) that no less port patch exists upstream."
FILC_ORIGIN_REF="none (new Stage 6b port; verified no less patch in cede3de02b42)"

port_configure() {
  CPPFLAGS="-I$PIZFIX/include -I$PIZFIX/include/ncursesw" \
    LDFLAGS="-L$PIZFIX/lib" \
    ./configure --prefix="$PIZFIX" --with-regex=posix
}

port_test() {
  "$PIZFIX/bin/less" --version | grep -q '^less 710 '
  make -j"$JOBS" LESSTEST=1
  make -C lesstest -j"$JOBS" \
    CC="$CC" \
    CFLAGS="-O2 -g -I$PIZFIX/include -I$PIZFIX/include/ncursesw" \
    LDFLAGS="-L$PIZFIX/lib"
  (cd lesstest && ./runtest -e -l "$SRC_DIR/less_t" lt)
}
