#!/usr/bin/env ruby
# frozen_string_literal: true

# DAG-validated Wave/Tier orchestrator for Fil-C userland ports.
#
# Discovers recipes in ports/*/PORT, validates dependencies (rejecting cycles and
# unknown dependencies), schedules ports in topological tier order, propagates
# 'blocked' status to transitive dependents when a dependency fails, and writes a
# consolidated report (JSON + text) with policy metrics.

require "fileutils"
require "json"
require "open3"
require "optparse"
require "set"

VALID_POLICY_CLASSES = Set.new(%w[
  P0-Clean
  P1-Toolchain
  P2-Package
  P3-BuildOpt
  P4-Audit
]).freeze

VALID_BUILD_SYSTEMS = Set.new(%w[autotools cmake make meson custom]).freeze
SHA256_RE = /\A[0-9a-f]{64}\z/
PORT_NAME_RE = /\A[a-z0-9][a-z0-9._+-]{0,63}\z/

WAVE_TIERS = {
  1 => Set.new([0, 1]).freeze,
  2 => Set.new([2, 3]).freeze,
  3 => Set.new([4, 5]).freeze,
}.freeze

def parse_port_file(port_file)
  data = {}
  File.foreach(port_file, encoding: "UTF-8") do |raw|
    line = raw.strip
    next if line.empty? || line.start_with?("#")
    break if line.start_with?("port_") && line.include?("()")

    m = /\A([A-Z0-9_]+)=(.*)\z/.match(line)
    next unless m

    key = m[1]
    val = m[2].strip
    if val.length >= 2 && ((val.start_with?('"') && val.end_with?('"')) ||
                           (val.start_with?("'") && val.end_with?("'")))
      val = val[1..-2]
    end
    data[key] = val
  end
  data
end

def count_recipe_patches(port_dir)
  series = File.join(port_dir, "patches", "series")
  return [0, 0, 0, 0] unless File.file?(series)

  pcount = 0
  added = 0
  removed = 0
  files = 0

  File.foreach(series, encoding: "UTF-8") do |raw|
    line = raw.split("#", 2).first.to_s.strip
    next if line.empty?

    pfile = File.join(port_dir, "patches", line)
    raise ArgumentError, "missing patch file referenced by #{series}: #{line}" unless File.file?(pfile)

    pcount += 1
    in_diff = false
    pf = 0
    File.binread(pfile).force_encoding("UTF-8").encode("UTF-8", invalid: :replace, undef: :replace).each_line do |praw|
      ln = praw.sub(/\r?\n\z/, "")
      if ln.start_with?("diff --git ")
        in_diff = true
        pf += 1
      elsif !in_diff && ln.start_with?("--- ")
        in_diff = true
      elsif in_diff
        if ln.start_with?("+") && !ln.start_with?("+++ ")
          added += 1
        elsif ln.start_with?("-") && !ln.start_with?("--- ")
          removed += 1
        end
      end
    end
    pf = 1 if pf.zero?
    files += pf
  end

  [pcount, added, removed, files]
end

def load_ports(ports_dir)
  raise ArgumentError, "ports directory not found: #{ports_dir}" unless File.directory?(ports_dir)

  ports = {}
  Dir.children(ports_dir).sort.each do |entry|
    pdir = File.join(ports_dir, entry)
    pfile = File.join(pdir, "PORT")
    next unless File.directory?(pdir) && File.file?(pfile)

    meta = parse_port_file(pfile)
    name = meta.fetch("NAME", "")
    if name != entry || !PORT_NAME_RE.match?(name)
      raise ArgumentError, "#{pfile}: invalid or mismatched NAME=#{name.inspect}"
    end

    %w[VERSION LICENSE UPSTREAM_URL UPSTREAM_SHA256 EXTRACT_DIR TIER BUILD_SYSTEM POLICY_CLASS].each do |req|
      val = meta[req]
      raise ArgumentError, "#{pfile}: missing required field #{req}" if val.nil? || val.empty?
    end

    unless SHA256_RE.match?(meta["UPSTREAM_SHA256"])
      raise ArgumentError, "#{pfile}: UPSTREAM_SHA256 must be 64 lowercase hex chars"
    end
    unless VALID_POLICY_CLASSES.include?(meta["POLICY_CLASS"])
      raise ArgumentError, "#{pfile}: invalid POLICY_CLASS=#{meta['POLICY_CLASS'].inspect}"
    end
    unless VALID_BUILD_SYSTEMS.include?(meta["BUILD_SYSTEM"])
      raise ArgumentError, "#{pfile}: invalid BUILD_SYSTEM=#{meta['BUILD_SYSTEM'].inspect}"
    end

    begin
      tier = Integer(meta["TIER"], 10)
    rescue ArgumentError
      raise ArgumentError, "#{pfile}: invalid TIER=#{meta['TIER'].inspect}"
    end

    deps = meta.fetch("DEPS", "").split.reject(&:empty?)
    pcount, added, removed, files = count_recipe_patches(pdir)
    ports[name] = {
      "name" => name,
      "version" => meta["VERSION"],
      "license" => meta["LICENSE"],
      "tier" => tier,
      "deps" => deps,
      "build_system" => meta["BUILD_SYSTEM"],
      "policy_class" => meta["POLICY_CLASS"],
      "upstream_url" => meta["UPSTREAM_URL"],
      "upstream_sha256" => meta["UPSTREAM_SHA256"],
      "patch_count" => pcount,
      "added_lines" => added,
      "removed_lines" => removed,
      "files_changed" => files,
    }
  end
  ports
end

def select_with_deps(ports, initial_names)
  selected = Set.new
  stack = initial_names.dup
  until stack.empty?
    cur = stack.pop
    raise ArgumentError, "unknown port: #{cur}" unless ports.key?(cur)
    next if selected.include?(cur)

    selected.add(cur)
    ports[cur]["deps"].each do |dep|
      raise ArgumentError, "port '#{cur}' depends on unknown port '#{dep}'" unless ports.key?(dep)

      stack << dep
    end
  end
  selected
end

def topo_sort(ports, selected)
  indeg = {}
  rdeps = Hash.new { |h, k| h[k] = [] }
  selected.each { |n| indeg[n] = 0 }

  selected.each do |n|
    ports[n]["deps"].each do |d|
      unless selected.include?(d)
        raise ArgumentError, "port '#{n}' depends on unselected/unknown port '#{d}'"
      end

      indeg[n] += 1
      rdeps[d] << n
    end
  end

  ready = indeg.select { |_n, deg| deg.zero? }.keys.sort_by { |x| [ports[x]["tier"], x] }
  order = []
  until ready.empty?
    cur = ready.shift
    order << cur
    rdeps[cur].each do |nxt|
      indeg[nxt] -= 1
      if indeg[nxt].zero?
        ready << nxt
        ready.sort_by! { |x| [ports[x]["tier"], x] }
      end
    end
  end

  if order.length != selected.length
    cycle_nodes = (selected - Set.new(order)).to_a.sort
    raise ArgumentError, "dependency cycle detected among ports: #{cycle_nodes.join(', ')}"
  end

  order
end

def find_root_blockers(port_name, ports, statuses)
  blockers = []
  visited = Set.new
  stack = ports[port_name]["deps"].dup
  until stack.empty?
    d = stack.pop
    next if visited.include?(d)

    visited.add(d)
    st = statuses.dig(d, "status")
    if st == "failed"
      blockers << d
    elsif st == "blocked"
      stack.concat(ports[d]["deps"])
    end
  end
  blockers.uniq.sort
end

def sort_json_keys(obj)
  case obj
  when Hash
    obj.keys.sort.each_with_object({}) { |k, h| h[k] = sort_json_keys(obj[k]) }
  when Array
    obj.map { |v| sort_json_keys(v) }
  else
    obj
  end
end

def write_json(path, obj)
  File.write(path, "#{JSON.pretty_generate(sort_json_keys(obj))}\n", encoding: "UTF-8")
end

def main(argv)
  repo_root = File.expand_path("..", __dir__)
  opts = {
    ports_dir: File.join(repo_root, "ports"),
    builder: File.join(repo_root, "scripts", "build-port"),
    wave: 0,
    tiers: "",
    ports: "",
    dry_run: false,
  }

  parser = OptionParser.new do |o|
    o.banner = "Usage: build-ports [WORK_ROOT] [options]"
    o.on("--ports-dir DIR", "Ports directory") { |v| opts[:ports_dir] = v }
    o.on("--builder PATH", "Single-port builder executable") { |v| opts[:builder] = v }
    o.on("--wave N", Integer, "Build wave (1, 2, or 3)") do |v|
      unless WAVE_TIERS.key?(v)
        raise OptionParser::InvalidArgument, "wave must be 1, 2, or 3"
      end

      opts[:wave] = v
    end
    o.on("--tiers LIST", "Comma-separated tier numbers (e.g. 0,1)") { |v| opts[:tiers] = v }
    o.on("--ports LIST", "Comma-separated port names (falls back to FILC_PORTS env var when unset)") { |v| opts[:ports] = v }
    o.on("--dry-run", "Validate DAG and print plan only") { opts[:dry_run] = true }
  end

  begin
    remaining = parser.parse(argv)
  rescue OptionParser::ParseError => e
    warn "error: #{e.message}"
    return 2
  end

  work_root_arg = remaining.empty? ? File.join(repo_root, ".work", "ports") : remaining.first
  ports = load_ports(opts[:ports_dir])
  if ports.empty?
    warn "error: no port recipes found"
    return 1
  end

  ports_spec = opts[:ports].to_s.strip
  if ports_spec.empty? && opts[:tiers].empty? && opts[:wave].zero?
    ports_spec = ENV.fetch("FILC_PORTS", "").strip
  end

  wanted = if !ports_spec.empty?
             ports_spec.split(",").map(&:strip).reject(&:empty?)
           elsif !opts[:tiers].empty?
             tier_set = Set.new(opts[:tiers].split(",").map(&:strip).reject(&:empty?).map { |t| Integer(t, 10) })
             ports.select { |_n, m| tier_set.include?(m["tier"]) }.keys
           elsif !opts[:wave].zero?
             tier_set = WAVE_TIERS[opts[:wave]]
             ports.select { |_n, m| tier_set.include?(m["tier"]) }.keys
           else
             ports.keys.sort
           end

  selected = select_with_deps(ports, wanted)
  order = topo_sort(ports, selected)

  unmodified = order.count { |n| ports[n]["patch_count"].zero? }
  patched = order.length - unmodified
  total_patches = order.sum { |n| ports[n]["patch_count"] }
  total_added = order.sum { |n| ports[n]["added_lines"] }
  total_removed = order.sum { |n| ports[n]["removed_lines"] }

  if opts[:dry_run]
    puts "DAG VALID: #{order.length} ports (unmodified=#{unmodified}, patched=#{patched}, " \
         "patches=#{total_patches}, +#{total_added}/-#{total_removed})"
    order.each_with_index do |n, idx|
      m = ports[n]
      deps_str = m["deps"].empty? ? "-" : m["deps"].join(",")
      puts format(
        "  %2d. [T%d] %-16s %-10s %-12s patches=%d (+%d/-%d) deps=%s",
        idx + 1, m["tier"], n, m["version"], m["policy_class"],
        m["patch_count"], m["added_lines"], m["removed_lines"], deps_str
      )
    end
    return 0
  end

  work_root = File.expand_path(work_root_arg)
  state_dir = File.join(work_root, "ports-state")
  FileUtils.mkdir_p(state_dir)

  t0 = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  results = {}
  child_env = { "FILC_PORTS_DIR" => File.expand_path(opts[:ports_dir]) }

  unless ports_spec.empty?
    $stdout.puts("FILC_PORTS_FILTER=#{ports_spec} selected=#{order.length} (#{order.join(',')})")
    $stdout.flush
  end
  $stdout.puts("FILC_PORTS_TOTAL #{order.length}")
  $stdout.flush

  order.each_with_index do |name, idx|
    meta = ports[name]
    blockers = find_root_blockers(name, ports, results)
    unless blockers.empty?
      $stdout.puts("[#{idx + 1}/#{order.length}] BLOCKED #{name} (blocked by: #{blockers.join(', ')})")
      $stdout.puts("FILC_PORT #{name} blocked policy=#{meta['policy_class']} blocked_by=#{blockers.join(',')}")
      $stdout.flush
      rec = {
        "name" => name,
        "version" => meta["version"],
        "tier" => meta["tier"],
        "status" => "blocked",
        "policy_class" => meta["policy_class"],
        "deps" => meta["deps"],
        "blocked_by" => blockers,
        "duration_seconds" => 0,
        "patch_count" => meta["patch_count"],
        "added_lines" => meta["added_lines"],
        "removed_lines" => meta["removed_lines"],
        "files_changed" => meta["files_changed"],
      }
      results[name] = rec
      write_json(File.join(state_dir, "#{name}.json"), rec)
      next
    end

    $stdout.puts("[#{idx + 1}/#{order.length}] BUILDING #{name} #{meta['version']} (T#{meta['tier']}, #{meta['policy_class']})")
    $stdout.flush
    system(child_env, opts[:builder], name, work_root)
    rc = $?.exitstatus || 1

    state_file = File.join(state_dir, "#{name}.json")
    if File.file?(state_file)
      rec = JSON.parse(File.read(state_file, encoding: "UTF-8"))
      rec["blocked_by"] = [] unless rec.key?("blocked_by")
    else
      rec = {
        "name" => name,
        "version" => meta["version"],
        "tier" => meta["tier"],
        "status" => rc.zero? ? "tested" : "failed",
        "policy_class" => meta["policy_class"],
        "deps" => meta["deps"],
        "blocked_by" => [],
        "duration_seconds" => 0,
        "patch_count" => meta["patch_count"],
        "added_lines" => meta["added_lines"],
        "removed_lines" => meta["removed_lines"],
        "files_changed" => meta["files_changed"],
      }
    end
    rec["status"] = "failed" if rc != 0 && !%w[failed blocked].include?(rec["status"])
    results[name] = rec
  end

  counts = Hash.new(0)
  results.each_value { |r| counts[r["status"]] += 1 }
  failed_runner = results.values.count { |r| r["status"] == "failed" && r["failed_kind"] == "runner" }
  failed_package = results.values.count { |r| r["status"] == "failed" && r["failed_kind"] != "runner" }
  total_dur = (Process.clock_gettime(Process::CLOCK_MONOTONIC) - t0).to_i

  summary = {
    "updated_at" => Time.now.utc.strftime("%Y-%m-%dT%H:%M:%SZ"),
    "duration_seconds" => total_dur,
    "total" => order.length,
    "tested" => counts["tested"],
    "built" => counts["built"],
    "failed" => counts["failed"],
    "failed_runner" => failed_runner,
    "failed_package" => failed_package,
    "blocked" => counts["blocked"],
    "unmodified" => unmodified,
    "patched" => patched,
    "total_patches" => total_patches,
    "total_added_lines" => total_added,
    "total_removed_lines" => total_removed,
    "ports" => order.map { |n| results[n] },
  }

  write_json(File.join(work_root, "ports-report.json"), summary)

  lines = [
    "================================================================================",
    "FIL-C PORTS BUILD REPORT",
    "================================================================================",
    "DATE_UTC=#{summary['updated_at']}",
    "DURATION_SECONDS=#{total_dur}",
    "PORTS_TOTAL=#{summary['total']}",
    "PORTS_TESTED=#{summary['tested']}",
    "PORTS_BUILT=#{summary['built']}",
    "PORTS_FAILED=#{summary['failed']} (runner=#{failed_runner}, package=#{failed_package})",
    "PORTS_FAILED_RUNNER=#{failed_runner}",
    "PORTS_FAILED_PACKAGE=#{failed_package}",
    "PORTS_BLOCKED=#{summary['blocked']}",
    "PORTS_UNMODIFIED=#{unmodified}",
    "PORTS_PATCHED=#{patched}",
    "PATCHES_TOTAL=#{total_patches} (+#{total_added}/-#{total_removed})",
    "",
    "PORTS:",
  ]
  order.each do |n|
    r = results[n]
    st_label = r["status"]
    if st_label == "failed"
      fkind = r["failed_kind"] || "package"
      fstage = r["failed_stage"].to_s
      st_label = "failed:#{fkind}#{fstage.empty? ? '' : "(#{fstage})"}"
    end
    blk_arr = r["blocked_by"]
    blk = blk_arr && !blk_arr.empty? ? " blocked_by=#{blk_arr.join(',')}" : ""
    lines << format(
      "  %-24s [T%d] %-16s %-10s %-12s patches=%d (%ds)%s",
      st_label, r["tier"], r["name"], r["version"], r["policy_class"],
      r["patch_count"], r["duration_seconds"], blk
    )
  end
  lines << "================================================================================"
  report_txt = "#{lines.join("\n")}\n"
  File.write(File.join(work_root, "ports-report.txt"), report_txt, encoding: "UTF-8")

  $stdout.write(report_txt)
  $stdout.flush
  summary["failed"].zero? && summary["blocked"].zero? ? 0 : 1
end

if $PROGRAM_NAME == __FILE__
  begin
    exit(main(ARGV))
  rescue ArgumentError => e
    warn "error: #{e.message}"
    exit(1)
  end
end
