prefix, bins = sys.argv[1], sys.argv[2:]
search_dirs = [os.path.join(prefix, "lib"), os.path.join(prefix, "opt/openssl1.1/lib")]

def read_needed(path):
    with open(path, "rb") as f:
        data = f.read()
    e_phoff = struct.unpack_from("<Q", data, 32)[0]
    e_phentsize, e_phnum = struct.unpack_from("<HH", data, 54)
    loads, dyn = [], None
    for i in range(e_phnum):
        off = e_phoff + i * e_phentsize
        p_type, _, p_offset, p_vaddr, _, p_filesz, _, _ = struct.unpack_from("<IIQQQQQQ", data, off)
        if p_type == 1:
            loads.append((p_vaddr, p_filesz, p_offset))
        elif p_type == 2:
            dyn = (p_offset, p_filesz)
    if not dyn:
        return []
    needed_offs, strtab_va = [], None
    for pos in range(dyn[0], dyn[0] + dyn[1], 16):
        d_tag, d_val = struct.unpack_from("<qQ", data, pos)
        if d_tag == 0:
            break
        elif d_tag == 1:
            needed_offs.append(d_val)
        elif d_tag == 5:
            strtab_va = d_val
    strtab_off = next(o + (strtab_va - v) for v, s, o in loads if v <= strtab_va < v + s)
    return [data[strtab_off + n:data.index(b"\x00", strtab_off + n)].decode("ascii", "replace") for n in needed_offs]

for bin_path in bins:
    seen_libs, queue, visited = set(), [bin_path], set()
    while queue:
        real = os.path.realpath(queue.pop(0))
        if real in visited:
            continue
        visited.add(real)
        for lib in read_needed(real):
            seen_libs.add(lib)
            for d in search_dirs:
                cand = os.path.join(d, lib)
                if os.path.isfile(cand):
                    queue.append(cand)
                    break
    assert "libssl.so.1.1" in seen_libs and "libcrypto.so.1.1" in seen_libs, seen_libs
    assert "libssl.so.3" not in seen_libs and "libcrypto.so.3" not in seen_libs, seen_libs
    assert "libcurl.so.4" not in seen_libs, seen_libs
PY

