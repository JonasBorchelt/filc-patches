#!/usr/bin/env ruby
# frozen_string_literal: true

# Packages built Fil-C userland ports into relocatable, deterministic,
# leak-gated channel artifacts (bin/, src/, recipes/, index.json, SHA256SUMS)
# with optional minisign signing (via CI secret FILC_PORTS_MINISIGN_KEY).
#
# Never generates production signing keys locally.

require "digest/sha2"
require "etc"
require "fileutils"
require "json"
require "open3"
require "optparse"
require "pathname"
require "securerandom"
require "set"
require "time"
require "tmpdir"
require "zlib"

Encoding.default_external = Encoding::UTF_8
Encoding.default_internal = Encoding::UTF_8

module PortPackager
  PORT_NAME_RE = /\A[a-z0-9][a-z0-9._+-]{0,63}\z/
  CHANNEL_RE = /\A\d+\.\d+\.\d+(?:-[a-z0-9.]+)?\z/
  ARCH_RE = /\A(?:x86_64|aarch64)-linux\z/
  SHA256_RE = /\A[0-9a-f]{64}\z/
  IPV4_EXACT_RE = /\A\d{1,3}(?:\.\d{1,3}){3}\z/
  MAX_ARTIFACT_BYTES = 512 * 1024 * 1024

  INFRA_WORDS = [
    %w[ci server].join("-"),
    %w[wood pecker].join,
    %w[prox mox].join,
    %w[hyper ingress].join("-")
  ].freeze

  SRV_SEG = %w[s rv].join.freeze
  WP_SEG = %w[wood pecker].join.freeze

  # Built-in hard-block patterns (NEVER exempted by upstream provenance).
  # Host-specific CI paths and internal IPs are supplied at runtime via
  # FILC_LEAK_EXACT_TOKENS rather than hardcoded in source.
  HARD_FORBIDDEN_RE = [
    ["infra_word", Regexp.new("(?<![A-Za-z0-9_-])(?:#{INFRA_WORDS.join('|')})(?![A-Za-z0-9_-])", Regexp::IGNORECASE)],
    ["ccache_path", %r{(?<![A-Za-z0-9_.-])/ccache(?:/|(?![A-Za-z0-9_.-]))}],
    ["wp_path", Regexp.new("(?<![A-Za-z0-9_.-])/#{WP_SEG}(?:/|(?![A-Za-z0-9_.-]))")],
    ["work_path", %r{(?<![A-Za-z0-9_.-])/\.work(?:/|(?![A-Za-z0-9_.-]))}]
  ].freeze

  # Generic patterns that are ONLY allowed when the exact matched token is proven
  # to exist verbatim in the SHA-256-verified upstream source archive of the port.
  GENERIC_PROVENANCE_RE = [
    ["private_ipv4_192", /(?<![0-9])(192\.168\.\d{1,3}\.\d{1,3})(?![0-9])/],
    ["private_ipv4_10", /(?<![0-9])(10\.\d{1,3}\.\d{1,3}\.\d{1,3})(?![0-9])/],
    ["private_ipv4_172", /(?<![0-9])(172\.(?:1[6-9]|2\d|3[01])\.\d{1,3}\.\d{1,3})(?![0-9])/],
    ["srv_path", Regexp.new("(?<![A-Za-z0-9_.-])(/#{SRV_SEG}/)")]
  ].freeze

  NEUTRAL_BUILD_DIR_RE = %r{\A/build/filc-ports(?:/[A-Za-z0-9._-]+)?\z}

  module_function

  def parse_kv_file(path)
    vars = {}
    File.foreach(path, encoding: "UTF-8") do |raw|
      line = raw.strip
      next if line.empty? || line.start_with?("#")
      break if line.start_with?("port_") && line.include?("()")

      m = /\A([A-Z0-9_]+)=(.*)\z/.match(line)
      next unless m

      val = m[2].strip
      if val.length >= 2 && ((val.start_with?('"') && val.end_with?('"')) ||
                             (val.start_with?("'") && val.end_with?("'")))
        val = val[1..-2]
      end
      vars[m[1]] = val
    end
    vars
  end

  def sort_json(obj)
    case obj
    when Hash
      obj.keys.sort.each_with_object({}) { |k, h| h[k] = sort_json(obj[k]) }
    when Array
      obj.map { |v| sort_json(v) }
    else
      obj
    end
  end

  def file_sha256(path)
    sha = Digest::SHA256.new
    File.open(path, "rb") do |f|
      while (buf = f.read(65_536))
        sha.update(buf)
      end
    end
    sha.hexdigest
  end

  def elf_file?(path)
    return false unless File.file?(path) && !File.symlink?(path)

    File.open(path, "rb") { |f| f.read(4) == "\x7fELF".b }
  rescue StandardError
    false
  end

  def cmd_available?(name)
    ENV.fetch("PATH", "").split(File::PATH_SEPARATOR).any? do |dir|
      full = File.join(dir, name)
      File.file?(full) && File.executable?(full)
    end
  end

  def default_bg_cpus
    n = Etc.nprocessors
    if n >= 4
      "#{n - 2}-#{n - 1}"
    elsif n >= 2
      (n - 1).to_s
    else
      "0"
    end
  rescue StandardError
    "0"
  end

  def build_throttle_prefix(bg_cpus)
    prefix = []
    prefix.concat(["nice", "-n", "19"]) if cmd_available?("nice")
    prefix.concat(["ionice", "-c3"]) if cmd_available?("ionice")
    prefix.concat(["taskset", "-c", bg_cpus]) if bg_cpus && !bg_cpus.empty? && cmd_available?("taskset")
    prefix
  end

  def capture3_cmd(cmd, throttle_fn: nil)
    prefix = throttle_fn ? throttle_fn.call : nil
    full = (prefix && !prefix.empty?) ? (prefix + cmd) : cmd
    Open3.capture3(*full)
  end

  def load_all_ports(ports_dir)
    ports = {}
    Dir.children(ports_dir).sort.each do |name|
      pdir = File.join(ports_dir, name)
      pfile = File.join(pdir, "PORT")
      next unless File.directory?(pdir) && File.file?(pfile)

      meta = parse_kv_file(pfile)
      next unless meta["NAME"] == name && PORT_NAME_RE.match?(name)

      deps = meta.fetch("DEPS", "").split.reject(&:empty?)
      ports[name] = {
        "name" => name,
        "version" => meta["VERSION"],
        "license" => meta["LICENSE"],
        "tier" => Integer(meta["TIER"], 10),
        "deps" => deps,
        "policy_class" => meta["POLICY_CLASS"],
        "upstream_url" => meta["UPSTREAM_URL"],
        "upstream_sha256" => meta["UPSTREAM_SHA256"],
        "port_dir" => pdir
      }
    end
    ports
  end

  def transitive_deps_topo(ports, target_name)
    needed = Set.new
    stack = ports.fetch(target_name)["deps"].dup
    until stack.empty?
      cur = stack.pop
      next if needed.include?(cur)

      needed.add(cur)
      ports.fetch(cur)["deps"].each { |d| stack << d }
    end

    indeg = {}
    rdeps = Hash.new { |h, k| h[k] = [] }
    needed.each { |n| indeg[n] = 0 }
    needed.each do |n|
      ports[n]["deps"].each do |d|
        next unless needed.include?(d)

        indeg[n] += 1
        rdeps[d] << n
      end
    end

    ready = indeg.select { |_k, v| v == 0 }.keys.sort_by { |x| [ports[x]["tier"], x] }
    order = []
    until ready.empty?
      cur = ready.shift
      order << cur
      rdeps[cur].each do |nxt|
        indeg[nxt] -= 1
        if indeg[nxt] == 0
          ready << nxt
          ready.sort_by! { |x| [ports[x]["tier"], x] }
        end
      end
    end
    raise "dependency cycle while resolving transitive_deps for #{target_name}" unless order.length == needed.length

    order
  end

  def count_patches(port_dir)
    series = File.join(port_dir, "patches", "series")
    return [0, 0, 0] unless File.file?(series)

    count = 0
    added = 0
    removed = 0
    File.foreach(series, encoding: "UTF-8") do |raw|
      line = raw.split("#", 2).first.to_s.strip
      next if line.empty?

      pfile = File.join(port_dir, "patches", line)
      next unless File.file?(pfile)

      count += 1
      in_diff = false
      File.binread(pfile).force_encoding("UTF-8").encode("UTF-8", invalid: :replace, undef: :replace).each_line do |ln|
        if ln.start_with?("diff --git ") || (!in_diff && ln.start_with?("--- "))
          in_diff = true
        elsif in_diff
          added += 1 if ln.start_with?("+") && !ln.start_with?("+++ ")
          removed += 1 if ln.start_with?("-") && !ln.start_with?("--- ")
        end
      end
    end
    [count, added, removed]
  end

  def build_forbidden_literals(work_dir:, repo_root:, pizfix:, neutral_prefix: nil, neutral_build_dir: nil, wrapper_dir: nil)
    lits = []
    neutral = neutral_prefix.to_s.strip
    neutral_build = neutral_build_dir.to_s.strip
    if !neutral_build.empty? && !NEUTRAL_BUILD_DIR_RE.match?(neutral_build)
      raise ArgumentError, "unsafe --neutral-build-dir (must match #{NEUTRAL_BUILD_DIR_RE.source}): #{neutral_build}"
    end

    candidates = [repo_root, ENV["HOSTNAME"]]
    candidates << work_dir unless !neutral_build.empty? && work_dir.to_s.strip == neutral_build
    pizfix_s = pizfix.to_s.strip
    unless !neutral.empty? && pizfix_s == neutral
      candidates << pizfix_s
      if !neutral.empty? && !pizfix_s.empty? && File.basename(pizfix_s) == File.basename(neutral)
        p_parent = File.dirname(pizfix_s)
        n_parent = File.dirname(neutral)
        if p_parent != n_parent && p_parent.length >= 6 &&
           p_parent.bytesize == n_parent.bytesize &&
           File.dirname(p_parent) == File.dirname(n_parent)
          candidates << p_parent
        end
      end
    end
    candidates << wrapper_dir unless wrapper_dir.to_s.strip.empty?
    candidates.each do |v|
      s = v.to_s.strip
      lits << s if s.length >= 6 && !%w[localhost debian linux].include?(s) && s != neutral && s != neutral_build
    end
    user = ENV["USER"].to_s.strip
    if !user.empty? && !%w[root nobody ci runner user builder].include?(user)
      lits << "/home/#{user}"
      lits << "/Users/#{user}"
    end
    lits.uniq
  end

  def compile_exact_token_regex(token)
    escaped = Regexp.escape(token)
    if IPV4_EXACT_RE.match?(token)
      Regexp.new("(?<![0-9.])#{escaped}(?![0-9]|\\.[0-9])")
    elsif token.start_with?("/")
      if token.end_with?("/")
        Regexp.new("(?<![A-Za-z0-9_.-])#{escaped}")
      else
        Regexp.new("(?<![A-Za-z0-9_.-])#{escaped}(?![A-Za-z0-9_.-])")
      end
    elsif token.include?("://") || token.include?(".")
      Regexp.new("(?<![A-Za-z0-9_.-])#{escaped}(?![A-Za-z0-9_.-])", Regexp::IGNORECASE)
    else
      Regexp.new("(?<![A-Za-z0-9_-])#{escaped}(?![A-Za-z0-9_-])", Regexp::IGNORECASE)
    end
  end

  def load_exact_tokens!(env_var: "FILC_LEAK_EXACT_TOKENS")
    raw = ENV[env_var]
    if raw.nil? || raw.strip.empty?
      raise "LEAK_GATE CONFIG ERROR: required exact-token secret env #{env_var} is missing or empty"
    end

    rules = []
    raw.each_line do |line|
      tok = line.strip
      next if tok.empty? || tok.start_with?("#")

      rules << { idx: rules.length + 1, regex: compile_exact_token_regex(tok), length: tok.length }
    end
    if rules.empty?
      raise "LEAK_GATE CONFIG ERROR: required exact-token secret env #{env_var} contains no active tokens"
    end

    rules
  end

  def scan_text_for_leaks(label, text, literals, exact_rules: [])
    hard_hits = []
    generic_hits = []

    literals.each do |lit|
      hard_hits << "#{label}: contains forbidden path/host #{lit.inspect}" if text.include?(lit)
    end

    exact_rules.each do |rule|
      if rule[:regex].match?(text)
        hard_hits << "#{label}: matches exact forbidden infra token ##{rule[:idx]} (len=#{rule[:length]})"
      end
    end

    HARD_FORBIDDEN_RE.each do |pat_name, re|
      if (m = re.match(text))
        hard_hits << "#{label}: matches forbidden #{pat_name} #{m[0].strip.inspect}"
      end
    end

    GENERIC_PROVENANCE_RE.each do |pat_name, re|
      seen = Set.new
      text.scan(re) do |groups|
        token = groups.is_a?(Array) ? groups.first : groups
        next if token.nil? || token.empty? || seen.include?(token)

        seen.add(token)
        generic_hits << { file: label, pattern: pat_name, token: token }
      end
    end

    [hard_hits, generic_hits]
  end

  def scan_directory_leaks(stage_dir, literals:, exact_rules: [], scan_elf_strings: true, throttle_fn: nil)
    hard_hits = []
    generic_hits = []
    inode_cache = {}
    placeholder = "__FILC_INODE_REL__"

    Dir.glob(File.join(stage_dir, "**", "*"), File::FNM_DOTMATCH).sort.each do |path|
      base = File.basename(path)
      next if base == "." || base == ".."
      next if File.directory?(path) && !File.symlink?(path)

      rel = path.sub("#{stage_dir}/", "")
      if File.symlink?(path)
        target = File.readlink(path)
        h, g = scan_text_for_leaks("symlink #{rel}", target, literals, exact_rules: exact_rules)
        hard_hits.concat(h)
        generic_hits.concat(g)
        next
      end

      st_f = File.stat(path)
      ino_key = [st_f.dev, st_f.ino]
      unless inode_cache.key?(ino_key)
        ino_hard = []
        ino_generic = []
        if elf_file?(path)
          if cmd_available?("patchelf")
            out, _e, st = capture3_cmd(["patchelf", "--print-rpath", path], throttle_fn: throttle_fn)
            out_s = out.to_s.dup.force_encoding(Encoding::UTF_8)
            out_s = out_s.scrub("?") unless out_s.valid_encoding?
            if st.success? && !out_s.strip.empty?
              h, g = scan_text_for_leaks("ELF RPATH #{placeholder}", out_s.strip, literals, exact_rules: exact_rules)
              ino_hard.concat(h)
              ino_generic.concat(g)
              if out_s.strip.start_with?("/")
                ino_hard << "ELF RPATH #{placeholder}: absolute RPATH not allowed (#{out_s.strip})"
              end
            end
          end
          if scan_elf_strings && cmd_available?("strings")
            out, _e, st = capture3_cmd(["strings", "-a", "-n", "6", path], throttle_fn: throttle_fn)
            if st.success?
              out_s = out.to_s.dup.force_encoding(Encoding::UTF_8)
              out_s = out_s.scrub("?") unless out_s.valid_encoding?
              h, g = scan_text_for_leaks("ELF strings #{placeholder}", out_s, literals, exact_rules: exact_rules)
              ino_hard.concat(h)
              ino_generic.concat(g)
            end
          end
        else
          raw = File.binread(path)
          unless raw.include?("\x00".b)
            text = raw.force_encoding("UTF-8").encode("UTF-8", invalid: :replace, undef: :replace)
            h, g = scan_text_for_leaks(placeholder, text, literals, exact_rules: exact_rules)
            ino_hard.concat(h)
            ino_generic.concat(g)
          end
        end
        inode_cache[ino_key] = [ino_hard, ino_generic]
      end

      cached_hard, cached_generic = inode_cache[ino_key]
      cached_hard.each { |msg| hard_hits << msg.sub(placeholder, rel) }
      cached_generic.each { |g| generic_hits << g.merge(file: g[:file].sub(placeholder, rel)) }
    end

    [hard_hits.uniq, generic_hits.uniq]
  end

  def search_zip_for_tokens(zip_path, rel_prefix, remaining_tokens, found)
    return if remaining_tokens.empty?

    data = File.binread(zip_path)
    eocd = data.rindex("PK\x05\x06".b)
    return unless eocd && eocd + 22 <= data.bytesize

    cd_size, cd_offset = data.byteslice(eocd + 12, 8).unpack("V2")
    pos = cd_offset
    cd_end = cd_offset + cd_size
    while pos + 46 <= data.bytesize && pos < cd_end && !remaining_tokens.empty?
      break unless data.byteslice(pos, 4) == "PK\x01\x02".b

      method = data.byteslice(pos + 10, 2).unpack1("v")
      comp_size = data.byteslice(pos + 20, 4).unpack1("V")
      fname_len, extra_len, comment_len = data.byteslice(pos + 28, 6).unpack("v3")
      local_off = data.byteslice(pos + 42, 4).unpack1("V")
      fname = data.byteslice(pos + 46, fname_len).force_encoding("UTF-8").scrub
      pos += 46 + fname_len + extra_len + comment_len
      next if fname.end_with?("/")
      next unless local_off + 30 <= data.bytesize && data.byteslice(local_off, 4) == "PK\x03\x04".b

      l_fname_len, l_extra_len = data.byteslice(local_off + 26, 4).unpack("v2")
      payload_start = local_off + 30 + l_fname_len + l_extra_len
      next unless payload_start + comp_size <= data.bytesize

      payload = data.byteslice(payload_start, comp_size)
      content = if method == 0
                  payload
                elsif method == 8
                  begin
                    Zlib::Inflate.new(-Zlib::MAX_WBITS).inflate(payload)
                  rescue Zlib::Error
                    nil
                  end
                end
      next unless content

      remaining_tokens.dup.each do |tok|
        next unless content.include?(tok.b)

        found[tok] = "#{rel_prefix}!#{fname}"
        remaining_tokens.delete(tok)
      end
    end
  rescue StandardError
    nil
  end

  def search_gem_for_tokens(gem_path, rel_prefix, remaining_tokens, found, tar_bin, throttle_fn: nil)
    return if remaining_tokens.empty?

    Dir.mktmpdir("filc-gem-prov-") do |gtd|
      _o, _e, st = capture3_cmd([tar_bin, "-xf", gem_path, "-C", gtd, "data.tar.gz"], throttle_fn: throttle_fn)
      data_gz = File.join(gtd, "data.tar.gz")
      return unless st.success? && File.file?(data_gz)

      data_dir = File.join(gtd, "data")
      FileUtils.mkdir_p(data_dir)
      _o2, _e2, st2 = capture3_cmd([tar_bin, "-xzf", data_gz, "-C", data_dir], throttle_fn: throttle_fn)
      return unless st2.success?

      Dir.glob(File.join(data_dir, "**", "*"), File::FNM_DOTMATCH).sort.each do |f|
        break if remaining_tokens.empty?
        next unless File.file?(f) && !File.symlink?(f)

        raw = File.binread(f)
        inner_rel = f.sub("#{data_dir}/", "")
        remaining_tokens.dup.each do |tok|
          next unless raw.include?(tok.b)

          found[tok] = "#{rel_prefix}!#{inner_rel}"
          remaining_tokens.delete(tok)
        end
      end
    end
  rescue StandardError
    nil
  end

  # Extracts the SHA-256-verified upstream source archive into an isolated temp dir
  # and proves exact fixed-string provenance for every generic token (including
  # bundled .whl/.zip and .gem archives shipped inside upstream tarballs).
  def verify_upstream_provenance(upstream_tarball, generic_hits, throttle_fn: nil)
    return [{}, generic_hits] if generic_hits.empty?

    needed = generic_hits.map { |h| h[:token] }.uniq
    remaining = Set.new(needed)
    found = {}
    tar_bin = cmd_available?("gtar") ? "gtar" : "tar"

    Dir.mktmpdir("filc-prov-src-") do |src_td|
      _o, err, st = capture3_cmd([tar_bin, "-xf", upstream_tarball, "-C", src_td], throttle_fn: throttle_fn)
      unless st.success?
        raise "failed to extract verified upstream source #{File.basename(upstream_tarball)} for provenance check: #{err.strip}"
      end

      nested_zips = []
      nested_gems = []

      Dir.glob(File.join(src_td, "**", "*"), File::FNM_DOTMATCH).sort.each do |path|
        break if remaining.empty?
        next unless File.file?(path) && !File.symlink?(path)

        rel = path.sub("#{src_td}/", "")
        if rel.end_with?(".whl", ".zip")
          nested_zips << [path, rel]
          next
        elsif rel.end_with?(".gem")
          nested_gems << [path, rel]
          next
        end

        raw = File.binread(path)
        remaining.dup.each do |tok|
          next unless raw.include?(tok.b)

          found[tok] = rel
          remaining.delete(tok)
        end
      end

      unless remaining.empty?
        nested_zips.each do |zp, zrel|
          break if remaining.empty?

          search_zip_for_tokens(zp, zrel, remaining, found)
        end
      end

      unless remaining.empty?
        nested_gems.each do |gp, grel|
          break if remaining.empty?

          search_gem_for_tokens(gp, grel, remaining, found, tar_bin, throttle_fn: throttle_fn)
        end
      end
    end

    unverified = generic_hits.reject { |h| found.key?(h[:token]) }
    [found, unverified]
  end

  def evaluate_package_leaks(stage_dir, literals:, exact_rules:, upstream_tarball:, scan_elf_strings: true, throttle_fn: nil)
    hard_hits, generic_hits = scan_directory_leaks(
      stage_dir, literals: literals, exact_rules: exact_rules, scan_elf_strings: scan_elf_strings, throttle_fn: throttle_fn
    )
    provenance_map, unverified = verify_upstream_provenance(upstream_tarball, generic_hits, throttle_fn: throttle_fn)

    allowed = []
    generic_hits.each do |gh|
      src_rel = provenance_map[gh[:token]]
      next unless src_rel

      allowed << {
        "file" => gh[:file],
        "pattern" => gh[:pattern],
        "token" => gh[:token],
        "upstream_source" => src_rel
      }
    end

    unverified.each do |gh|
      hard_hits << "#{gh[:file]}: unverified generic #{gh[:pattern]} #{gh[:token].inspect} (not found in verified upstream source)"
    end

    [hard_hits.uniq, allowed]
  end

  def format_mib(bytes)
    format("%.2f MiB", bytes.to_f / (1024 * 1024))
  end

  def compute_elf_rpath(rel)
    parts = rel.split("/")
    if parts[0] == "lib" || parts[0] == "lib64"
      if parts.length == 2
        "$ORIGIN"
      else
        "$ORIGIN/" + ("../" * (parts.length - 2)).chomp("/")
      end
    else
      "$ORIGIN/" + ("../" * (parts.length - 1)) + "lib"
    end
  end

  def relocate_stage!(prefix_dir, pizfix, src_inode_map: {}, throttle_fn: nil, neutral_prefix: nil, wrapper_dir: nil)
    has_patchelf = cmd_available?("patchelf")
    has_strip = cmd_available?("strip")
    processed_elfs = {}
    neutral = neutral_prefix.to_s.strip
    pizfix_s = pizfix.to_s.strip
    rewrite_view = !neutral.empty? && !pizfix_s.empty? && pizfix_s != neutral
    pizfix_parent = nil
    neutral_parent = nil
    if rewrite_view && File.basename(pizfix_s) == File.basename(neutral)
      pp_cand = File.dirname(pizfix_s)
      np_cand = File.dirname(neutral)
      # Only treat parent as a slot-view root when it is an exact-length sibling
      # of neutral's parent (e.g. /opt/filc/.v000 next to /opt/filc/0.1.4), never
      # a shared parent directory that could also contain repo_root or work_dir.
      if pp_cand != np_cand && pp_cand.length >= 6 &&
         pp_cand.bytesize == np_cand.bytesize &&
         File.dirname(pp_cand) == File.dirname(np_cand)
        pizfix_parent = pp_cand
        neutral_parent = np_cand
      end
    end
    wrapper = wrapper_dir.to_s.strip
    neutral_bin_dir = (!neutral.empty? && !wrapper.empty?) ? File.expand_path("../build/bin", neutral) : nil

    # Exact-length binary replacement pairs: preserves every ELF section offset,
    # symbol/relocation offset, tail-merged .rodata suffix pointer, Fil-C global
    # capability bound, static archive (.a) header size, and .pyc string length.
    bin_pairs = []
    if rewrite_view && pizfix_s.bytesize == neutral.bytesize
      bin_pairs << [pizfix_s.b, neutral.b]
      if pizfix_parent && neutral_parent && pizfix_parent.bytesize == neutral_parent.bytesize
        bin_pairs << [pizfix_parent.b, neutral_parent.b]
      end
    end
    if !wrapper.empty? && neutral_bin_dir && wrapper != neutral_bin_dir && wrapper.bytesize == neutral_bin_dir.bytesize
      bin_pairs << [wrapper.b, neutral_bin_dir.b]
    end

    stats = {
      elf_count: 0,
      unique_elf_count: 0,
      stripped_count: 0,
      strip_failed_count: 0,
      strip_saved_bytes: 0,
      patchelf_count: 0,
      elf_prefix_rewritten: 0,
      reused_hardlinks: 0
    }

    Dir.glob(File.join(prefix_dir, "**", "*"), File::FNM_DOTMATCH).sort.each do |path|
      base = File.basename(path)
      next if base == "." || base == ".."
      next if File.directory?(path) || File.symlink?(path)

      rel = path.sub("#{prefix_dir}/", "")

      # Remove libtool .la files (Debian policy; avoids hardcoded build paths)
      if rel.end_with?(".la")
        File.unlink(path)
        next
      end

      # Relocate pkg-config .pc files
      if rel.end_with?(".pc") && (rel.start_with?("lib/pkgconfig/", "share/pkgconfig/"))
        raw = File.binread(path).force_encoding(Encoding::UTF_8).scrub("?")
        depth = rel.count("/")
        rel_prefix = "${pcfiledir}" + ("/.." * depth)
        updated = raw.gsub(/^prefix=.*$/, "prefix=#{rel_prefix}")
        updated = updated.gsub(pizfix_s, "${prefix}") unless pizfix_s.empty?
        updated = updated.gsub(pizfix_parent, neutral_parent) if pizfix_parent && neutral_parent
        updated = updated.gsub(wrapper, neutral_bin_dir) if !wrapper.empty? && neutral_bin_dir
        File.write(path, updated, encoding: "UTF-8")
        next
      end

      # Relocate ALL ELF binaries, shared libraries, and loadable modules (e.g. lib/bash/*)
      unless elf_file?(path)
        # When building inside an isolated per-port prefix view, normalize view-specific
        # prefix/wrapper paths in text files (e.g. *-config scripts, CMake configs, headers)
        # and exact-length binary non-ELF files (e.g. static archives .a, Python .pyc)
        # back to the neutral public prefix so archives stay bit-for-bit identical.
        if rewrite_view || (!wrapper.empty? && neutral_bin_dir)
          raw = File.binread(path)
          updated = raw.dup
          changed = false
          if !raw.include?("\x00".b)
            if rewrite_view && updated.include?(pizfix_s.b)
              updated.gsub!(pizfix_s.b, neutral.b)
              changed = true
            end
            if pizfix_parent && neutral_parent && updated.include?(pizfix_parent.b)
              updated.gsub!(pizfix_parent.b, neutral_parent.b)
              changed = true
            end
            if !wrapper.empty? && neutral_bin_dir && updated.include?(wrapper.b)
              updated.gsub!(wrapper.b, neutral_bin_dir.b)
              changed = true
            end
          elsif !bin_pairs.empty?
            bin_pairs.each do |from_b, to_b|
              if updated.include?(from_b)
                updated.gsub!(from_b, to_b)
                changed = true
              end
            end
          end
          if changed
            st = File.stat(path)
            File.binwrite(path, updated)
            File.chmod(st.mode & 0o777, path)
            File.utime(st.atime, st.mtime, path) rescue nil
          end
        end
        next
      end

      stats[:elf_count] += 1
      rpath = has_patchelf ? compute_elf_rpath(rel) : nil
      st_elf = File.stat(path)
      mode = st_elf.mode & 0o777
      src_ino = src_inode_map[path]
      elf_key = src_ino ? [src_ino, mode, rpath] : nil

      if elf_key && processed_elfs.key?(elf_key)
        canonical = processed_elfs[elf_key]
        File.unlink(path)
        File.link(canonical, path)
        stats[:reused_hardlinks] += 1
        next
      end

      stats[:unique_elf_count] += 1
      if has_strip
        before_sz = File.size(path)
        _so, serr, sst = capture3_cmd(["strip", "--strip-debug", path], throttle_fn: throttle_fn)
        if sst.success?
          stats[:stripped_count] += 1
          after_sz = File.size(path)
          stats[:strip_saved_bytes] += [0, before_sz - after_sz].max
        else
          stats[:strip_failed_count] += 1
          $stderr.puts("warning: strip --strip-debug failed for #{rel}: #{serr.strip}")
        end
      end
      if has_patchelf
        if rpath
          capture3_cmd(["patchelf", "--set-rpath", rpath, path], throttle_fn: throttle_fn)
          stats[:patchelf_count] += 1
        end
        if rewrite_view
          interp_out, _ie, ist = capture3_cmd(["patchelf", "--print-interpreter", path], throttle_fn: throttle_fn)
          cur_interp = ist.success? ? interp_out.strip : ""
          if cur_interp.start_with?("#{pizfix_s}/")
            new_interp = "#{neutral}/#{cur_interp.sub("#{pizfix_s}/", "")}"
            capture3_cmd(["patchelf", "--set-interpreter", new_interp, path], throttle_fn: throttle_fn)
          end
        end
      end
      unless bin_pairs.empty?
        raw_elf = File.binread(path)
        updated_elf = raw_elf
        elf_changed = false
        bin_pairs.each do |from_b, to_b|
          if updated_elf.include?(from_b)
            updated_elf = updated_elf.dup unless elf_changed
            updated_elf.gsub!(from_b, to_b)
            elf_changed = true
          end
        end
        if elf_changed
          File.binwrite(path, updated_elf)
          File.chmod(mode, path)
          stats[:elf_prefix_rewritten] += 1
        end
      end
      processed_elfs[elf_key] = path if elf_key
    end
    stats
  end

  # Deduplicates byte-identical regular files (same size, permissions, and SHA-256)
  # inside a staged prefix into hardlinks to the lexicographically first path so
  # GNU/BSD tar stores the payload once and preserves hardlinks deterministically.
  def deduplicate_stage_hardlinks!(prefix_dir)
    buckets = Hash.new { |h, k| h[k] = [] }
    total_files = 0
    total_logical_bytes = 0

    Dir.glob(File.join(prefix_dir, "**", "*"), File::FNM_DOTMATCH).sort.each do |path|
      base = File.basename(path)
      next if base == "." || base == ".."
      next if File.directory?(path) || File.symlink?(path)

      st = File.stat(path)
      total_files += 1
      total_logical_bytes += st.size
      next if st.size <= 0

      buckets[[st.size, st.mode & 0o777]] << [path, st.dev, st.ino, st.size]
    end

    preserved_links = 0
    newly_deduped = 0
    saved_bytes = 0
    seen_inodes = Set.new

    buckets.each_value do |entries|
      if entries.length == 1
        _p, dev, ino, _sz = entries[0]
        seen_inodes.add([dev, ino])
        next
      end

      canonical_by_sha = {}
      sha_by_inode = {}
      entries.each do |path, dev, ino, sz|
        ino_key = [dev, ino]
        if sha_by_inode.key?(ino_key)
          preserved_links += 1
          saved_bytes += sz
          next
        end

        sha = file_sha256(path)
        sha_by_inode[ino_key] = sha
        if canonical_by_sha.key?(sha)
          canonical = canonical_by_sha[sha]
          File.unlink(path)
          File.link(canonical, path)
          newly_deduped += 1
          saved_bytes += sz
        else
          canonical_by_sha[sha] = path
          seen_inodes.add(ino_key)
        end
      end
    end

    {
      total_files: total_files,
      logical_bytes: total_logical_bytes,
      unique_inodes: seen_inodes.size,
      preserved_links: preserved_links,
      newly_deduped: newly_deduped,
      hardlinks: preserved_links + newly_deduped,
      saved_bytes: saved_bytes
    }
  end

  def clamp_stage_mtimes!(stage_dir, epoch)
    paths = Dir.glob(File.join(stage_dir, "**", "*"), File::FNM_DOTMATCH).reject do |p|
      b = File.basename(p)
      b == "." || b == ".."
    end
    # Deepest entries first so setting child mtimes doesn't bump parent dir mtimes.
    paths.sort_by! { |p| [-p.count("/"), p] }
    paths << stage_dir
    paths.each do |p|
      if File.symlink?(p)
        File.lutime(epoch, epoch, p) if File.respond_to?(:lutime)
      else
        File.utime(epoch, epoch, p)
      end
    rescue NotImplementedError, SystemCallError
      nil
    end
  end

  def create_deterministic_tar_xz(stage_dir, out_tar_xz, source_date_epoch, xz_threads: 1, throttle_fn: nil)
    FileUtils.mkdir_p(File.dirname(out_tar_xz))
    entries = Dir.children(stage_dir).sort
    raise "refusing to create empty archive from #{stage_dir}" if entries.empty?

    tar_bin = cmd_available?("gtar") ? "gtar" : "tar"
    ver_out, _ve, _vst = Open3.capture3(tar_bin, "--version")
    gnu_tar = ver_out.include?("GNU tar")
    clamp_stage_mtimes!(stage_dir, source_date_epoch)

    tmp_tar = "#{out_tar_xz}.tmp.tar"
    begin
      if gnu_tar
        cmd = [
          tar_bin, "--sort=name",
          "--mtime=@#{source_date_epoch}",
          "--owner=0", "--group=0", "--numeric-owner",
          "-cf", tmp_tar, "-C", stage_dir, *entries
        ]
        _o, err, st = capture3_cmd(cmd, throttle_fn: throttle_fn)
      else
        rel_list = Dir.glob(File.join(stage_dir, "**", "*"), File::FNM_DOTMATCH).reject do |p|
          b = File.basename(p)
          b == "." || b == ".."
        end.map { |p| p.sub("#{stage_dir}/", "") }.sort
        cmd = [
          tar_bin, "--no-recursion", "--format", "ustar",
          "--uid", "0", "--gid", "0", "--uname", "", "--gname", "",
          "-cf", tmp_tar, "-C", stage_dir, *rel_list
        ]
        prev_cf = ENV["COPYFILE_DISABLE"]
        ENV["COPYFILE_DISABLE"] = "1"
        begin
          _o, err, st = capture3_cmd(cmd, throttle_fn: throttle_fn)
        ensure
          prev_cf.nil? ? ENV.delete("COPYFILE_DISABLE") : ENV["COPYFILE_DISABLE"] = prev_cf
        end
      end
      raise "tar failed: #{err.strip}" unless st.success?

      threads = Integer(xz_threads.to_s, 10).clamp(0, 8)
      xz_args = ["xz", "-6", "-T#{threads}", "-f", tmp_tar]
      _xo, xerr, xst = capture3_cmd(xz_args, throttle_fn: throttle_fn)
      raise "xz failed: #{xerr.strip}" unless xst.success?

      FileUtils.mv("#{tmp_tar}.xz", out_tar_xz)
    ensure
      File.unlink(tmp_tar) if File.exist?(tmp_tar)
      File.unlink("#{tmp_tar}.xz") if File.exist?("#{tmp_tar}.xz")
    end
  end

  def copy_missing_tree!(src_root, dst_root)
    return unless File.directory?(src_root)

    Dir.glob(File.join(src_root, "**", "*"), File::FNM_DOTMATCH).sort.each do |src|
      base = File.basename(src)
      next if base == "." || base == ".."

      rel = src.sub("#{src_root}/", "")
      dst = File.join(dst_root, rel)
      if File.directory?(src) && !File.symlink?(src)
        FileUtils.mkdir_p(dst)
        next
      end
      next if File.exist?(dst) || File.symlink?(dst)

      FileUtils.mkdir_p(File.dirname(dst))
      if File.symlink?(src)
        File.symlink(File.readlink(src), dst)
      elsif File.file?(src)
        begin
          File.link(src, dst)
        rescue SystemCallError
          FileUtils.cp(src, dst, preserve: false)
          File.chmod(File.stat(src).mode & 0o777, dst)
        end
      end
    end
  end

  def copy_runtime_libs!(pizfix, dst_lib_dir)
    src_lib = File.join(pizfix, "lib")
    return unless File.directory?(src_lib)

    FileUtils.mkdir_p(dst_lib_dir)
    Dir.children(src_lib).sort.each do |entry|
      next unless entry.end_with?(".so") || entry.include?(".so.")

      dst = File.join(dst_lib_dir, entry)
      next if File.exist?(dst) || File.symlink?(dst)

      src = File.join(src_lib, entry)
      if File.symlink?(src)
        target = File.readlink(src)
        target = target.sub("#{src_lib}/", "") if target.start_with?("#{src_lib}/")
        File.symlink(target, dst)
      elsif File.file?(src)
        FileUtils.cp(src, dst, preserve: false)
        File.chmod(File.stat(src).mode & 0o777, dst)
      end
    end
  end

  def port_has_package_smoke?(port_file)
    return false unless File.file?(port_file)

    File.read(port_file, encoding: "UTF-8").match?(/^\s*port_package_smoke\s*\(\s*\)/)
  end

  def verify_packaged_archive!(name:, meta:, tdeps:, bin_out:, bin_outs:, expected_hardlinks:,
                               pizfix:, neutral_prefix:, work_dir:, throttle_fn: nil)
    errors = []
    symlinks_checked = 0
    extracted_hardlinks = 0
    ran_smoke = false

    Dir.mktmpdir("filc-pkg-smoke-#{name}-") do |smoke_dir|
      alt_prefix = File.join(smoke_dir, "prefix")
      if alt_prefix == pizfix || alt_prefix == neutral_prefix
        errors << "smoke prefix collided with build/neutral prefix: #{alt_prefix}"
        return { errors: errors, symlinks: 0, hardlinks: 0, ran_smoke: false }
      end

      _to, terr, tst = capture3_cmd(["tar", "-xf", bin_out, "-C", smoke_dir], throttle_fn: throttle_fn)
      unless tst.success?
        errors << "tar -xf failed: #{terr.strip}"
        return { errors: errors, symlinks: 0, hardlinks: 0, ran_smoke: false }
      end

      pkg_json_path = File.join(smoke_dir, "filc-pkg.json")
      unless File.file?(pkg_json_path)
        errors << "missing filc-pkg.json in extracted archive"
        return { errors: errors, symlinks: 0, hardlinks: 0, ran_smoke: false }
      end

      pkg_manifest = JSON.parse(File.read(pkg_json_path, encoding: "UTF-8"))
      if pkg_manifest["name"] != name
        errors << "filc-pkg.json name mismatch: expected #{name.inspect}, got #{pkg_manifest['name'].inspect}"
      end

      manifest_files = pkg_manifest["files"].is_a?(Hash) ? pkg_manifest["files"] : {}
      pkg_symlinks = []
      seen_reg_inodes = Set.new
      reg_count = 0
      checked_elf_inodes = Set.new
      has_patchelf = cmd_available?("patchelf")

      manifest_files.keys.sort.each do |rel|
        full = File.join(alt_prefix, rel)
        info = manifest_files[rel]
        if info["type"] == "symlink"
          unless File.symlink?(full)
            errors << "missing extracted symlink: #{rel}"
            next
          end
          pkg_symlinks << [rel, full, File.readlink(full)]
        else
          unless File.file?(full) && !File.symlink?(full)
            errors << "missing extracted file: #{rel}"
            next
          end
          st = File.stat(full)
          reg_count += 1
          ino_key = [st.dev, st.ino]
          seen_reg_inodes.add(ino_key)

          if has_patchelf && !checked_elf_inodes.include?(ino_key) && elf_file?(full)
            checked_elf_inodes.add(ino_key)
            rp_out, _rpe, rp_st = capture3_cmd(["patchelf", "--print-rpath", full], throttle_fn: throttle_fn)
            if rp_st.success? && !rp_out.strip.empty?
              rp = rp_out.strip
              if rp.start_with?("/") || !rp.start_with?("$ORIGIN")
                errors << "extracted ELF #{rel} has non-relocatable RPATH: #{rp}"
              end
            end
          end
        end
      end

      extracted_hardlinks = reg_count - seen_reg_inodes.size
      if expected_hardlinks > 0 && extracted_hardlinks < expected_hardlinks
        errors << "hardlinks not preserved after tar extract: expected >=#{expected_hardlinks}, got #{extracted_hardlinks}"
      end

      # Stage transitive dependency packages (from their packaged .tar.xz archives) without overwriting P's files,
      # plus missing Fil-C toolchain runtime libraries (*.so*) from pizfix/lib so $ORIGIN RPATH resolves cleanly.
      missing_dep_archives = false
      tdeps.sort.each do |dep|
        dep_tar = bin_outs[dep]
        if dep_tar && File.file?(dep_tar)
          Dir.mktmpdir("filc-pkg-dep-") do |dep_dir|
            _do, derr, dst = capture3_cmd(["tar", "-xf", dep_tar, "-C", dep_dir], throttle_fn: throttle_fn)
            unless dst.success?
              errors << "failed to extract dependency #{dep}: #{derr.strip}"
              next
            end
            copy_missing_tree!(File.join(dep_dir, "prefix"), alt_prefix)
          end
        else
          missing_dep_archives = true
        end
      end
      copy_runtime_libs!(pizfix, File.join(alt_prefix, "lib"))

      forbidden_prefixes = [pizfix, neutral_prefix, work_dir].compact.map(&:to_s).reject(&:empty?).uniq
      pkg_symlinks.each do |rel, full, target|
        symlinks_checked += 1
        if target.start_with?("/")
          bad_pref = forbidden_prefixes.find { |fp| target == fp || target.start_with?("#{fp}/") }
          if bad_pref
            errors << "symlink #{rel} still references forbidden prefix #{bad_pref}: #{target}"
          end
          next
        end

        resolved = File.expand_path(target, File.dirname(full))
        unless resolved == alt_prefix || resolved.start_with?("#{alt_prefix}/")
          errors << "relative symlink #{rel} -> #{target} escapes package prefix"
          next
        end
        unless File.exist?(resolved) || File.symlink?(resolved)
          unless missing_dep_archives
            errors << "broken relative symlink after extract: #{rel} -> #{target}"
          end
        end
      end

      port_file = File.join(meta["port_dir"], "PORT")
      if errors.empty? && port_has_package_smoke?(port_file)
        ran_smoke = true
        smoke_tmp = File.join(smoke_dir, "tmp")
        FileUtils.mkdir_p(smoke_tmp)
        smoke_env = {
          "PKG_PREFIX" => alt_prefix,
          "PIZFIX" => alt_prefix,
          "PORT_FILE" => port_file,
          "FILC_ORIGINAL_PIZFIX" => pizfix,
          "PATH" => "#{alt_prefix}/bin:/usr/bin:/bin",
          "LD_LIBRARY_PATH" => nil,
          "LD_PRELOAD" => nil,
          "TMPDIR" => smoke_tmp,
          "HOME" => smoke_tmp
        }
        bash_bin = ENV.fetch("PATH", "").split(File::PATH_SEPARATOR).map { |d| File.join(d, "bash") }.find { |p| File.file?(p) && File.executable?(p) } || "/bin/bash"
        timeout_bin = ENV.fetch("PATH", "").split(File::PATH_SEPARATOR).map { |d| File.join(d, "timeout") }.find { |p| File.file?(p) && File.executable?(p) }
        smoke_script = <<~'SH'.chomp
          export PS4='+ [port_package_smoke:${LINENO}] '
          trap 'rc=$?; echo "SMOKE_CMD_FAILED line=${LINENO} rc=$rc cmd=${BASH_COMMAND}" >&2' ERR
          source "$PORT_FILE"
          declare -F port_package_smoke >/dev/null
          set -x
          port_package_smoke
        SH
        bash_cmd = [bash_bin, "-eEuo", "pipefail", "-c", smoke_script]
        bash_cmd = [timeout_bin, "120", *bash_cmd] if timeout_bin
        out_err, st = Open3.capture2e(smoke_env, *bash_cmd)
        unless st.success?
          tail = out_err.lines.last(80).join.strip
          errors << "port_package_smoke failed (exit=#{st.exitstatus}):\n#{tail}"
        end
      end
    end

    { errors: errors, symlinks: symlinks_checked, hardlinks: extracted_hardlinks, ran_smoke: ran_smoke }
  end

  def find_cached_source_tarball(cache_dir, port_meta)
    url_base = File.basename(port_meta["upstream_url"].split("?", 2).first)
    expected_sha = port_meta["upstream_sha256"]
    candidates = [
      File.join(cache_dir, "#{port_meta['name']}-#{port_meta['version']}-#{expected_sha[0, 12]}-#{url_base}"),
      File.join(cache_dir, url_base)
    ]
    found = candidates.find { |p| File.file?(p) }
    raise "cached upstream source tarball not found for #{port_meta['name']} in #{cache_dir}" unless found

    actual = file_sha256(found)
    raise "upstream source SHA-256 mismatch for #{found}: expected #{expected_sha}, got #{actual}" unless actual == expected_sha

    [found, url_base, actual]
  end

  def sign_with_minisign!(file_path, sig_path, trusted_comment:, key_file:, key_env:)
    if key_file && !key_file.empty?
      actual_key_file = key_file
      cleanup_key = false
    elsif key_env && !key_env.empty? && ENV[key_env] && !ENV[key_env].strip.empty?
      td = Dir.mktmpdir("filc-ms-")
      File.chmod(0o700, td)
      actual_key_file = File.join(td, "signing.key")
      File.open(actual_key_file, File::WRONLY | File::CREAT | File::EXCL, 0o600) do |f|
        f.write(ENV[key_env])
      end
      cleanup_key = td
    else
      return false
    end

    begin
      raise "minisign binary not found in PATH" unless cmd_available?("minisign")

      pw = ENV.fetch("FILC_PORTS_MINISIGN_PASSWORD", "")
      stdin_data = pw.empty? ? "" : "#{pw}\n"
      _o, err, st = Open3.capture3(
        "minisign", "-S", "-s", actual_key_file, "-m", file_path, "-x", sig_path, "-t", trusted_comment,
        stdin_data: stdin_data
      )
      raise "minisign failed for #{file_path}: #{err.strip}" unless st.success?

      true
    ensure
      FileUtils.rm_rf(cleanup_key) if cleanup_key
    end
  end

  def main(argv)
    repo_root = File.expand_path("..", __dir__)
    opts = {
      repo_root: repo_root,
      ports_dir: nil,
      work_dir: File.join(repo_root, ".work", "ports"),
      pizfix: nil,
      neutral_prefix: nil,
      neutral_build_dir: nil,
      ports_cache_dir: nil,
      out_dir: nil,
      channel: nil,
      arch: "x86_64-linux",
      revision: 1,
      ports_filter: nil,
      sign_key_file: nil,
      sign_key_env: "FILC_PORTS_MINISIGN_KEY",
      exact_tokens_env: "FILC_LEAK_EXACT_TOKENS",
      leak_report: nil,
      pubkey_file: nil,
      sign_only: false,
      single_port: nil,
      wrapper_dir: nil,
      staged_dir: nil,
      finalize_index: false,
      parallel: 1,
      bg_parallel: nil,
      xz_threads: Integer(ENV.fetch("FILC_PACKAGE_XZ_THREADS", "1"), 10).clamp(0, 8),
      bg_xz_threads: 1,
      bg_throttle: false,
      bg_cpus: nil,
      watch_done_file: nil,
      max_artifact_bytes: MAX_ARTIFACT_BYTES,
      verify_smoke: true,
      ci_run: ENV["CI_PIPELINE_NUMBER"] ? Integer(ENV["CI_PIPELINE_NUMBER"], 10) : nil,
      source_date_epoch: Integer(ENV.fetch("SOURCE_DATE_EPOCH", "1700000000"), 10)
    }

    parser = OptionParser.new do |o|
      o.banner = "Usage: scripts/package-port [options]"
      o.on("--repo-root DIR", "Repository root") { |v| opts[:repo_root] = File.expand_path(v) }
      o.on("--ports-dir DIR", "Ports recipe directory (default: <repo-root>/ports)") { |v| opts[:ports_dir] = File.expand_path(v) }
      o.on("--work-dir DIR", "build-ports work root (contains ports-state/)") { |v| opts[:work_dir] = File.expand_path(v) }
      o.on("--pizfix DIR", "Fil-C pizfix sysroot directory") { |v| opts[:pizfix] = File.expand_path(v) }
      o.on("--neutral-prefix DIR", "Fixed public install prefix allowed in staged files (default: /opt/filc/<channel>/pizfix)") { |v| opts[:neutral_prefix] = File.expand_path(v) }
      o.on("--neutral-build-dir DIR", "Fixed neutral build root under /build/filc-ports allowed in staged build metadata") { |v| opts[:neutral_build_dir] = File.expand_path(v) }
      o.on("--ports-cache-dir DIR", "Upstream source tarball cache directory") { |v| opts[:ports_cache_dir] = File.expand_path(v) }
      o.on("--out-dir DIR", "Output channel root directory") { |v| opts[:out_dir] = File.expand_path(v) }
      o.on("--channel VERSION", "Toolchain release channel (e.g. 0.1.3)") { |v| opts[:channel] = v }
      o.on("--arch ARCH", "Target arch (default: x86_64-linux)") { |v| opts[:arch] = v }
      o.on("--revision N", Integer, "Package revision number (default: 1)") { |v| opts[:revision] = v }
      o.on("--ports LIST", "Comma-separated subset of ports to package") { |v| opts[:ports_filter] = v.split(",").map(&:strip).reject(&:empty?) }
      o.on("-j", "--parallel N", Integer, "Concurrent packaging workers (1..8, default: 1; post-build in watch mode)") { |v| opts[:parallel] = v.clamp(1, 8) }
      o.on("--bg-parallel N", Integer, "Max concurrent workers while builds run in watch mode (1..8, default: 1)") { |v| opts[:bg_parallel] = v.clamp(1, 8) }
      o.on("--xz-threads N", Integer, "Threads per xz invocation (0..8, 0=all cores, default: 1)") { |v| opts[:xz_threads] = v.clamp(0, 8) }
      o.on("--bg-xz-threads N", Integer, "Threads per xz invocation while builds run in watch mode (1..4, default: 1)") { |v| opts[:bg_xz_threads] = v.clamp(1, 4) }
      o.on("--bg-throttle", "Apply nice -n 19, ionice -c3, and 2-core taskset only while builds are running") { opts[:bg_throttle] = true }
      o.on("--bg-cpus SPEC", "CPU list for taskset while --bg-throttle is active (default: last 2 cores)") { |v| opts[:bg_cpus] = v }
      o.on("--watch-done-file PATH", "Continuously package green ports as manifests appear until PATH exists") { |v| opts[:watch_done_file] = File.expand_path(v) }
      o.on("--max-artifact-bytes N", Integer, "Maximum allowed artifact size in bytes (default: 536870912 / 512 MiB)") do |v|
        raise OptionParser::InvalidArgument, "--max-artifact-bytes must be >= 1" if v < 1

        opts[:max_artifact_bytes] = v
      end
      o.on("--skip-package-smoke", "Skip post-packaging extract and smoke verification in an alternate prefix") { opts[:verify_smoke] = false }
      o.on("--exact-tokens-env VAR", "Env var containing newline-separated exact infra tokens (default: FILC_LEAK_EXACT_TOKENS)") { |v| opts[:exact_tokens_env] = v }
      o.on("--leak-report PATH", "Optional path to write JSON leak-gate provenance report") { |v| opts[:leak_report] = File.expand_path(v) }
      o.on("--sign-key-file PATH", "Optional minisign secret key file (CI only)") { |v| opts[:sign_key_file] = v }
      o.on("--sign-key-env VAR", "Env var containing minisign secret key (default: FILC_PORTS_MINISIGN_KEY)") { |v| opts[:sign_key_env] = v }
      o.on("--pubkey-file PATH", "Optional minisign public key file to copy as pubkey.pub") { |v| opts[:pubkey_file] = v }
      o.on("--sign-only", "Only sign existing index.json and SHA256SUMS in --out-dir/<channel>/<arch>") { opts[:sign_only] = true }
      o.on("--single-port NAME", "Package, leak-gate, and smoke-verify a single port, writing staged metadata without index.json") { |v| opts[:single_port] = v.strip }
      o.on("--wrapper-dir DIR", "Optional per-port compiler wrapper directory to normalize and leak-gate") { |v| opts[:wrapper_dir] = File.expand_path(v) }
      o.on("--staged-dir DIR", "Directory for per-port staged JSON metadata (default: <out-dir>/<channel>/<arch>/.staged)") { |v| opts[:staged_dir] = File.expand_path(v) }
      o.on("--finalize-index", "Assemble and leak-gate index.json + SHA256SUMS from --staged-dir/*.json") { opts[:finalize_index] = true }
    end
    parser.parse!(argv)

    raise ArgumentError, "--channel is required (e.g. 0.1.3)" unless CHANNEL_RE.match?(opts[:channel].to_s)
    raise ArgumentError, "--arch must match #{ARCH_RE.source}" unless ARCH_RE.match?(opts[:arch].to_s)
    raise ArgumentError, "--out-dir is required" if opts[:out_dir].nil? || opts[:out_dir].empty?
    if [opts[:sign_only], !opts[:single_port].nil?, opts[:finalize_index]].count(true) > 1
      raise ArgumentError, "--sign-only, --single-port, and --finalize-index are mutually exclusive"
    end

    channel_dir = File.join(opts[:out_dir], opts[:channel], opts[:arch])
    staged_dir = opts[:staged_dir] || File.join(channel_dir, ".staged")
    if opts[:sign_only]
      index_path = File.join(channel_dir, "index.json")
      sums_path = File.join(channel_dir, "SHA256SUMS")
      raise "missing #{index_path}" unless File.file?(index_path)
      raise "missing #{sums_path}" unless File.file?(sums_path)

      if opts[:pubkey_file] && File.file?(opts[:pubkey_file])
        FileUtils.cp(opts[:pubkey_file], File.join(channel_dir, "pubkey.pub"))
      end

      parsed_idx = JSON.parse(File.read(index_path, encoding: "UTF-8"))
      pkg_map = parsed_idx["packages"].is_a?(Hash) ? parsed_idx["packages"] : {}
      pkg_names = pkg_map.keys.sort
      sums_map = {}
      File.foreach(sums_path, encoding: "UTF-8") do |ln|
        m = /\A([0-9a-f]{64})\s+(.+)\z/.match(ln.strip)
        sums_map[m[2]] = m[1] if m
      end

      s1 = sign_with_minisign!(
        index_path, "#{index_path}.minisig",
        trusted_comment: "channel:#{opts[:channel]} arch:#{opts[:arch]} file:index.json",
        key_file: opts[:sign_key_file], key_env: opts[:sign_key_env]
      )
      s2 = sign_with_minisign!(
        sums_path, "#{sums_path}.minisig",
        trusted_comment: "channel:#{opts[:channel]} arch:#{opts[:arch]} file:SHA256SUMS",
        key_file: opts[:sign_key_file], key_env: opts[:sign_key_env]
      )
      raise "signing key missing for --sign-only" unless s1 && s2

      total_pkgs = pkg_names.length
      sign_mu = Mutex.new
      sign_done = 0
      sign_error = nil
      sign_q = Queue.new
      pkg_names.each { |n| sign_q << n }
      sign_workers_cnt = [[opts[:parallel].to_i, 1].max, [total_pkgs, 1].max].min
      sign_workers_cnt.times { sign_q << nil }

      sign_threads = Array.new(sign_workers_cnt) do
        Thread.new do
          while (pkg_name = sign_q.pop)
            next if sign_mu.synchronize { !sign_error.nil? }

            sign_mu.synchronize do
              $stdout.puts("FILC_PORT #{pkg_name} signing stage=sign")
              $stdout.flush
            end

            begin
              entry = pkg_map[pkg_name]
              %w[source recipe binary].each do |kind|
                art = entry[kind]
                rel = art && art["path"]
                expected = art && art["sha256"]
                full = rel ? File.join(channel_dir, rel) : nil
                unless full && File.file?(full) && sums_map[rel] == expected && file_sha256(full) == expected
                  raise "signed checksum verification failed for #{pkg_name} (#{kind})"
                end
              end
              sign_mu.synchronize do
                sign_done += 1
                $stdout.puts("FILC_PORT #{pkg_name} signed stage=sign")
                $stdout.puts("FILC_STAGE_PROGRESS sign #{sign_done}/#{total_pkgs} #{pkg_name}")
                $stdout.flush
              end
            rescue StandardError => e
              sign_mu.synchronize { sign_error ||= e }
            end
          end
        end
      end
      sign_threads.each(&:join)
      raise sign_error if sign_error

      puts "PACKAGE_PORT: SIGNED channel=#{opts[:channel]} arch=#{opts[:arch]} packages=#{total_pkgs} parallel=#{sign_workers_cnt}"
      return 0
    end

    repo_root = opts[:repo_root]
    work_dir = opts[:work_dir]
    pizfix = opts[:pizfix] || File.join(repo_root, ".work", "toolchain", "pizfix")
    cache_dir = opts[:ports_cache_dir] || File.join(work_dir, "ports-cache")
    state_dir = File.join(work_dir, "ports-state")
    ports_dir = opts[:ports_dir] || File.join(repo_root, "ports")

    upstream = File.file?(File.join(repo_root, "UPSTREAM")) ? parse_kv_file(File.join(repo_root, "UPSTREAM")) : {}
    all_ports = load_all_ports(ports_dir)
    neutral_prefix = opts[:neutral_prefix] || "/opt/filc/#{opts[:channel]}/pizfix"
    exact_rules = load_exact_tokens!(env_var: opts[:exact_tokens_env])
    literals = build_forbidden_literals(
      work_dir: work_dir,
      repo_root: repo_root,
      pizfix: pizfix,
      neutral_prefix: neutral_prefix,
      neutral_build_dir: opts[:neutral_build_dir],
      wrapper_dir: opts[:wrapper_dir]
    )

    if opts[:finalize_index]
      raise "staged metadata directory not found: #{staged_dir}" unless File.directory?(staged_dir)

      filter_set = opts[:ports_filter] && !opts[:ports_filter].empty? ? Set.new(opts[:ports_filter]) : nil
      meta_files = Dir.glob(File.join(staged_dir, "*.json")).sort
      raise "no staged port metadata found in #{staged_dir}" if meta_files.empty?

      fin_packages = {}
      fin_sums = {}
      fin_provenance = {}
      fin_sizes = []

      meta_files.each do |mpath|
        rec = JSON.parse(File.read(mpath, encoding: "UTF-8"))
        pname = rec["name"].to_s
        next if pname.empty?
        next if filter_set && !filter_set.include?(pname)

        raise "staged channel mismatch in #{mpath}" unless rec["channel"] == opts[:channel]
        raise "staged arch mismatch in #{mpath}" unless rec["arch"] == opts[:arch]

        pkg_entry = rec["package"]
        raise "missing package entry in #{mpath}" unless pkg_entry.is_a?(Hash)

        %w[binary source recipe].each do |kind|
          art = pkg_entry[kind]
          rel = art && art["path"]
          expected_sha = art && art["sha256"]
          full = rel ? File.join(channel_dir, rel) : nil
          raise "missing artifact #{rel} referenced by #{mpath}" unless full && File.file?(full)

          actual_sha = file_sha256(full)
          raise "SHA-256 mismatch for #{rel} during finalize-index" unless actual_sha == expected_sha

          fin_sums[rel] = actual_sha
        end

        fin_packages[pname] = pkg_entry
        if rec["provenance_allowed"].is_a?(Hash)
          rec["provenance_allowed"].each { |k, v| fin_provenance[k] = v unless Array(v).empty? }
        end
        if rec["size_record"].is_a?(Hash)
          sr = rec["size_record"]
          fin_sizes << {
            name: pname,
            version: sr["version"].to_s,
            bin_size: sr["bin_size"].to_i,
            src_size: sr["src_size"].to_i,
            rec_size: sr["rec_size"].to_i,
            hardlinks: sr["hardlinks"].to_i,
            saved_bytes: sr["saved_bytes"].to_i,
            stripped_count: sr["stripped_count"].to_i,
            unique_elf_count: sr["unique_elf_count"].to_i
          }
        end
      end

      if filter_set
        missing_ports = (filter_set.to_a - fin_packages.keys).sort
        raise "finalize-index missing staged metadata for: #{missing_ports.join(', ')}" unless missing_ports.empty?
      end
      raise "no packages matched in #{staged_dir}" if fin_packages.empty?

      if opts[:leak_report]
        FileUtils.mkdir_p(File.dirname(opts[:leak_report]))
        report_obj = {
          "channel" => opts[:channel],
          "arch" => opts[:arch],
          "exact_token_rules_loaded" => exact_rules.length,
          "failed_packages" => [],
          "failed_hits_total" => 0,
          "provenance_allowed_total" => fin_provenance.values.sum(&:length),
          "provenance_allowed" => sort_json(fin_provenance)
        }
        File.write(opts[:leak_report], "#{JSON.pretty_generate(report_obj)}\n", encoding: "UTF-8")
      end

      unless fin_sizes.empty?
        sorted_sizes = fin_sizes.sort_by { |r| [-r[:bin_size], r[:name]] }
        total_bin_bytes = sorted_sizes.sum { |r| r[:bin_size] }
        max_bin_bytes = sorted_sizes.first[:bin_size]
        total_hardlinks = sorted_sizes.sum { |r| r[:hardlinks] }
        total_saved_bytes = sorted_sizes.sum { |r| r[:saved_bytes] }
        puts "PACKAGE_SIZES: packages=#{sorted_sizes.length} total_bin=#{format_mib(total_bin_bytes)} " \
             "max_bin=#{format_mib(max_bin_bytes)} limit=#{format_mib(opts[:max_artifact_bytes])} " \
             "hardlinks=#{total_hardlinks} dedup_saved=#{format_mib(total_saved_bytes)}"
        puts "TOP_10_LARGEST_PACKAGES:"
        sorted_sizes.first(10).each_with_index do |r, idx|
          puts format(
            "  %2d. %-16s %s bin=%s src=%s hardlinks=%d saved=%s stripped=%d/%d",
            idx + 1, r[:name], r[:version], format_mib(r[:bin_size]), format_mib(r[:src_size]),
            r[:hardlinks], format_mib(r[:saved_bytes]), r[:stripped_count], r[:unique_elf_count]
          )
        end
      end

      index_obj = {
        "schema_version" => 1,
        "channel" => opts[:channel],
        "arch" => opts[:arch],
        "generated_at" => Time.now.utc.iso8601,
        "toolchain" => {
          "version" => opts[:channel],
          "llvm_tag" => upstream["LLVM_TAG"],
          "filc_commit" => upstream["FILC_COMMIT"],
          "musl_commit" => upstream["MUSL_COMMIT"]
        }.compact,
        "packages" => fin_packages
      }
      index_path = File.join(channel_dir, "index.json")
      index_json = "#{JSON.pretty_generate(sort_json(index_obj))}\n"
      idx_hard, idx_gen = scan_text_for_leaks("index.json", index_json, literals, exact_rules: exact_rules)
      idx_leaks = idx_hard + idx_gen.map { |g| "#{g[:file]}: forbidden generic #{g[:pattern]} #{g[:token].inspect}" }
      raise "LEAK_GATE FAILED on index.json:\n  #{idx_leaks.join("\n  ")}" unless idx_leaks.empty?

      File.write(index_path, index_json, encoding: "UTF-8")
      fin_sums["index.json"] = file_sha256(index_path)
      sums_text = fin_sums.keys.sort.map { |rel| "#{fin_sums[rel]}  #{rel}\n" }.join
      sums_path = File.join(channel_dir, "SHA256SUMS")
      File.write(sums_path, sums_text, encoding: "UTF-8")

      if opts[:pubkey_file] && File.file?(opts[:pubkey_file])
        FileUtils.cp(opts[:pubkey_file], File.join(channel_dir, "pubkey.pub"))
      end

      signed_idx = sign_with_minisign!(
        index_path, "#{index_path}.minisig",
        trusted_comment: "channel:#{opts[:channel]} arch:#{opts[:arch]} file:index.json",
        key_file: opts[:sign_key_file], key_env: opts[:sign_key_env]
      )
      signed_sums = sign_with_minisign!(
        sums_path, "#{sums_path}.minisig",
        trusted_comment: "channel:#{opts[:channel]} arch:#{opts[:arch]} file:SHA256SUMS",
        key_file: opts[:sign_key_file], key_env: opts[:sign_key_env]
      )
      puts "PACKAGE_PORT: FINALIZED channel=#{opts[:channel]} arch=#{opts[:arch]} packages=#{fin_packages.size} signed=#{signed_idx && signed_sums}"
      return 0
    end

    channel_dir = File.join(opts[:out_dir], opts[:channel], opts[:arch])
    FileUtils.mkdir_p(File.join(channel_dir, "bin"))
    FileUtils.mkdir_p(File.join(channel_dir, "src"))
    FileUtils.mkdir_p(File.join(channel_dir, "recipes"))

    repo_commit = if cmd_available?("git")
                    repo_commit_out, _e, rc_st = Open3.capture3("git", "-C", repo_root, "rev-parse", "--short=12", "HEAD")
                    rc_st.success? ? repo_commit_out.strip : nil
                  end

    packages_index = {}
    sums_entries = {}
    all_leaks = {}
    all_size_violations = {}
    package_size_records = []
    packaged_targets = {}
    all_provenance_allowed = {}
    created_archives = []
    mu = Mutex.new
    slot_cv = ConditionVariable.new
    active_workers = 0
    builds_done = opts[:watch_done_file].nil?
    bg_par = opts[:bg_parallel] ? [opts[:bg_parallel], opts[:parallel]].min : 1
    bg_cpus = opts[:bg_cpus] || default_bg_cpus
    bg_prefix = opts[:bg_throttle] ? build_throttle_prefix(bg_cpus) : []
    packaged_done = 0
    planned_total = 0

    throttle_fn = lambda do
      done = mu.synchronize { builds_done }
      (!done && !bg_prefix.empty?) ? bg_prefix : nil
    end
    xz_threads_fn = lambda do
      done = mu.synchronize { builds_done }
      done ? opts[:xz_threads] : opts[:bg_xz_threads]
    end

    if !builds_done && opts[:bg_throttle]
      begin
        Process.setpriority(Process::PRIO_PROCESS, 0, 19)
      rescue Errno::EACCES, Errno::EPERM, NotImplementedError
        nil
      end
      $stdout.puts("PACKAGER_MODE: phase=background parallel=#{bg_par} xz_threads=#{opts[:bg_xz_threads]} throttle=#{bg_prefix.empty? ? 'none' : bg_prefix.join(' ')}")
      $stdout.flush
    elsif builds_done
      $stdout.puts("PACKAGER_MODE: phase=post-build parallel=#{opts[:parallel]} xz_threads=#{opts[:xz_threads]} throttle=off")
      $stdout.flush
    end

    read_planned_total = lambda do |fallback|
      plan_path = File.join(state_dir, "ports-plan.json")
      if File.file?(plan_path)
        begin
          plan = JSON.parse(File.read(plan_path, encoding: "UTF-8"))
          t = plan["total"].to_i
          return t if t > 0
        rescue StandardError
          nil
        end
      end
      fallback
    end

    process_port = lambda do |name|
      meta = all_ports.fetch(name) { raise "unknown port: #{name}" }
      manifest_file = File.join(state_dir, "#{name}.manifest.json")
      raise "missing install manifest: #{manifest_file}" unless File.file?(manifest_file)

      manifest = JSON.parse(File.read(manifest_file, encoding: "UTF-8"))
      files = Array(manifest["files"]).uniq.sort
      raise "empty install manifest for #{name}" if files.empty?

      mu.synchronize do
        if opts[:single_port]
          $stdout.puts("FILC_PORT #{name} verifying policy=#{meta['policy_class']} stage=verify")
        else
          $stdout.puts("FILC_PORT #{name} packaging policy=#{meta['policy_class']} stage=package")
        end
        $stdout.flush
      end

      tdeps = transitive_deps_topo(all_ports, name)
      pcount, added, removed = count_patches(meta["port_dir"])

      # Resolve and SHA-256-verify the upstream source tarball first so the leak-gate
      # can prove upstream provenance for generic patterns without trusting unverified files.
      cached_src, src_fname, src_sha = find_cached_source_tarball(cache_dir, meta)

      bin_fname = "#{name}-#{meta['version']}-r#{opts[:revision]}-#{opts[:arch]}.tar.xz"
      bin_rel = "bin/#{bin_fname}"
      bin_out = File.join(channel_dir, bin_rel)

      # 1. Stage binary package, strip .la files, relocate, deduplicate hardlinks, leak-gate, and pack
      bin_leaks = []
      bin_allowed = []
      reloc_stats = nil
      dedup_stats = nil
      Dir.mktmpdir("filc-pkg-bin-") do |td|
        prefix_stage = File.join(td, "prefix")
        FileUtils.mkdir_p(prefix_stage)
        src_inode_map = {}

        files.each do |rel|
          raise "unsafe manifest relative path: #{rel}" if rel.start_with?("/") || rel.split("/").include?("..")
          next if rel.end_with?(".la")

          src_item = File.join(pizfix, rel)
          next unless File.exist?(src_item) || File.symlink?(src_item)

          dst_item = File.join(prefix_stage, rel)
          FileUtils.mkdir_p(File.dirname(dst_item))
          if File.symlink?(src_item)
            link_target = File.readlink(src_item)
            if link_target.start_with?("#{pizfix}/")
              target_rel = link_target.sub("#{pizfix}/", "")
              from_dir = Pathname.new(File.dirname(rel))
              link_target = Pathname.new(target_rel).relative_path_from(from_dir).to_s
            end
            File.symlink(link_target, dst_item)
          elsif File.file?(src_item)
            src_st = File.stat(src_item)
            FileUtils.cp(src_item, dst_item, preserve: false)
            File.chmod(src_st.mode & 0o777, dst_item)
            src_inode_map[dst_item] = [src_st.dev, src_st.ino]
          end
        end

        reloc_stats = relocate_stage!(
          prefix_stage, pizfix,
          src_inode_map: src_inode_map,
          throttle_fn: throttle_fn,
          neutral_prefix: neutral_prefix,
          wrapper_dir: opts[:wrapper_dir]
        )
        dedup_stats = deduplicate_stage_hardlinks!(prefix_stage)

        pkg_files = {}
        sha_cache_by_inode = {}
        Dir.glob(File.join(prefix_stage, "**", "*"), File::FNM_DOTMATCH).sort.each do |p|
          base = File.basename(p)
          next if base == "." || base == ".."
          next if File.directory?(p) && !File.symlink?(p)

          rel = p.sub("#{prefix_stage}/", "")
          if File.symlink?(p)
            pkg_files[rel] = { "type" => "symlink", "target" => File.readlink(p) }
          else
            st_p = File.stat(p)
            ino_key = [st_p.dev, st_p.ino]
            sha_p = (sha_cache_by_inode[ino_key] ||= file_sha256(p))
            pkg_files[rel] = { "type" => "file", "size_bytes" => st_p.size, "sha256" => sha_p }
          end
        end

        pkg_manifest = {
          "schema_version" => 1,
          "name" => name,
          "version" => meta["version"],
          "revision" => opts[:revision],
          "channel" => opts[:channel],
          "arch" => opts[:arch],
          "license" => meta["license"],
          "policy_class" => meta["policy_class"],
          "deps" => meta["deps"],
          "transitive_deps" => tdeps,
          "files" => pkg_files
        }
        File.write(File.join(td, "filc-pkg.json"), "#{JSON.pretty_generate(sort_json(pkg_manifest))}\n", encoding: "UTF-8")

        bin_leaks, bin_allowed = evaluate_package_leaks(
          td,
          literals: literals,
          exact_rules: exact_rules,
          upstream_tarball: cached_src,
          scan_elf_strings: true,
          throttle_fn: throttle_fn
        )
        if bin_leaks.empty?
          create_deterministic_tar_xz(td, bin_out, opts[:source_date_epoch],
                                      xz_threads: xz_threads_fn.call, throttle_fn: throttle_fn)
        end
      end

      # 2. Copy SHA-256 verified upstream corresponding source tarball (GPL compliance)
      src_rel = "src/#{src_fname}"
      src_out = File.join(channel_dir, src_rel)
      if bin_leaks.empty?
        mu.synchronize do
          FileUtils.cp(cached_src, src_out) unless File.file?(src_out) && file_sha256(src_out) == src_sha
        end
      end

      # 3. Package recipe + patches + provenance + license metadata
      rec_fname = "#{name}-#{meta['version']}-r#{opts[:revision]}-recipe.tar.xz"
      rec_rel = "recipes/#{rec_fname}"
      rec_out = File.join(channel_dir, rec_rel)

      rec_leaks = []
      rec_allowed = []
      Dir.mktmpdir("filc-pkg-rec-") do |td|
        FileUtils.cp(File.join(meta["port_dir"], "PORT"), File.join(td, "PORT"))
        patches_dir = File.join(meta["port_dir"], "patches")
        FileUtils.cp_r(patches_dir, File.join(td, "patches")) if File.directory?(patches_dir)
        prov = File.join(repo_root, "PROVENANCE.md")
        FileUtils.cp(prov, File.join(td, "PROVENANCE.md")) if File.file?(prov)

        rec_meta = {
          "name" => name,
          "version" => meta["version"],
          "revision" => opts[:revision],
          "license" => meta["license"],
          "upstream_url" => meta["upstream_url"],
          "upstream_sha256" => src_sha,
          "patch_count" => pcount,
          "added_lines" => added,
          "removed_lines" => removed
        }
        File.write(File.join(td, "recipe-meta.json"), "#{JSON.pretty_generate(sort_json(rec_meta))}\n", encoding: "UTF-8")

        rec_leaks, rec_allowed = evaluate_package_leaks(
          td,
          literals: literals,
          exact_rules: exact_rules,
          upstream_tarball: cached_src,
          scan_elf_strings: false,
          throttle_fn: throttle_fn
        )
        if rec_leaks.empty? && bin_leaks.empty?
          create_deterministic_tar_xz(td, rec_out, opts[:source_date_epoch],
                                      xz_threads: xz_threads_fn.call, throttle_fn: throttle_fn)
        end
      end

      bin_sha = bin_leaks.empty? ? file_sha256(bin_out) : nil
      rec_sha = (bin_leaks.empty? && rec_leaks.empty?) ? file_sha256(rec_out) : nil
      bin_size = (bin_leaks.empty? && File.file?(bin_out)) ? File.size(bin_out) : 0
      src_size = (bin_leaks.empty? && File.file?(src_out)) ? File.size(src_out) : 0
      rec_size = (bin_leaks.empty? && rec_leaks.empty? && File.file?(rec_out)) ? File.size(rec_out) : 0

      size_violations = []
      if bin_leaks.empty? && rec_leaks.empty?
        [[bin_rel, bin_size], [src_rel, src_size], [rec_rel, rec_size]].each do |art_rel, art_sz|
          next unless art_sz > opts[:max_artifact_bytes]

          size_violations << "#{art_rel}: #{art_sz} bytes (#{format_mib(art_sz)}) exceeds limit #{opts[:max_artifact_bytes]} bytes (#{format_mib(opts[:max_artifact_bytes])})"
        end
      end

      mu.synchronize do
        all_provenance_allowed[name] = bin_allowed unless bin_allowed.empty?
        all_provenance_allowed["#{name} (recipe)"] = rec_allowed unless rec_allowed.empty?
        all_leaks[name] = bin_leaks unless bin_leaks.empty?
        all_leaks["#{name} (recipe)"] = rec_leaks unless rec_leaks.empty?
        all_size_violations[name] = size_violations unless size_violations.empty?
        created_archives << bin_out if bin_leaks.empty?
        created_archives << rec_out if bin_leaks.empty? && rec_leaks.empty?

        if bin_leaks.empty? && rec_leaks.empty?
          package_size_records << {
            name: name,
            version: meta["version"],
            bin_size: bin_size,
            src_size: src_size,
            rec_size: rec_size,
            hardlinks: dedup_stats ? dedup_stats[:hardlinks] : 0,
            saved_bytes: dedup_stats ? dedup_stats[:saved_bytes] : 0,
            elf_count: reloc_stats ? reloc_stats[:elf_count] : 0,
            stripped_count: reloc_stats ? reloc_stats[:stripped_count] : 0,
            unique_elf_count: reloc_stats ? reloc_stats[:unique_elf_count] : 0
          }
        end

        packaged_done += 1
        eff_total = [read_planned_total.call(planned_total), packaged_done].max
        if bin_leaks.empty? && rec_leaks.empty? && size_violations.empty?
          sums_entries[bin_rel] = bin_sha
          sums_entries[src_rel] = src_sha
          sums_entries[rec_rel] = rec_sha
          pkg_entry = {
            "version" => meta["version"],
            "revision" => opts[:revision],
            "tier" => meta["tier"],
            "policy_class" => meta["policy_class"],
            "license" => meta["license"],
            "deps" => meta["deps"],
            "transitive_deps" => tdeps,
            "binary" => {
              "path" => bin_rel,
              "size_bytes" => bin_size,
              "sha256" => bin_sha
            },
            "source" => {
              "path" => src_rel,
              "upstream_url" => meta["upstream_url"],
              "size_bytes" => src_size,
              "sha256" => src_sha
            },
            "recipe" => {
              "path" => rec_rel,
              "patch_count" => pcount,
              "added_lines" => added,
              "removed_lines" => removed,
              "size_bytes" => rec_size,
              "sha256" => rec_sha
            },
            "built_at" => Time.now.utc.iso8601
          }
          pkg_entry["ci_run"] = opts[:ci_run] if opts[:ci_run]
          pkg_entry["repo_commit"] = repo_commit if repo_commit
          packages_index[name] = pkg_entry
          packaged_targets[name] = {
            meta: meta,
            tdeps: tdeps,
            bin_out: bin_out,
            expected_hardlinks: dedup_stats ? dedup_stats[:hardlinks] : 0
          }
          if opts[:single_port]
            $stdout.puts(
              "PACKAGE_PORT_STAGED: port=#{name} size_bytes=#{bin_size} hardlinks=#{dedup_stats[:hardlinks]} " \
              "dedup_saved=#{dedup_stats[:saved_bytes]} stripped=#{reloc_stats[:stripped_count]}/#{reloc_stats[:unique_elf_count]}"
            )
          else
            $stdout.puts(
              "FILC_PORT #{name} packaged policy=#{meta['policy_class']} stage=package " \
              "size_bytes=#{bin_size} hardlinks=#{dedup_stats[:hardlinks]} " \
              "dedup_saved=#{dedup_stats[:saved_bytes]} stripped=#{reloc_stats[:stripped_count]}/#{reloc_stats[:unique_elf_count]}"
            )
          end
        else
          fail_stage = opts[:single_port] ? "verify" : "package"
          $stdout.puts("FILC_PORT #{name} failed:package policy=#{meta['policy_class']} stage=#{fail_stage}")
        end
        unless opts[:single_port]
          $stdout.puts("FILC_STAGE_PROGRESS package #{packaged_done}/#{eff_total} #{name}")
        end
        $stdout.flush
      end
    end

    if opts[:single_port]
      pname = opts[:single_port]
      planned_total = 1
      process_port.call(pname)

      unless all_leaks.empty?
        created_archives.each { |p| File.unlink(p) if File.exist?(p) }
        total_hits = all_leaks.values.sum(&:length)
        lines = ["LEAK_GATE FAILED for #{pname} (#{total_hits} hit(s)):"]
        all_leaks.each do |pkg_key, pkg_hits|
          lines << "  [#{pkg_key}] (#{pkg_hits.length} hit(s)):"
          pkg_hits.first(50).each { |h| lines << "    - #{h}" }
        end
        raise lines.join("\n")
      end

      unless all_size_violations.empty?
        created_archives.each { |p| File.unlink(p) if File.exist?(p) }
        lines = ["SIZE_LIMIT FAILED for #{pname}:"]
        all_size_violations.each { |k, vs| vs.each { |v| lines << "  [#{k}] #{v}" } }
        raise lines.join("\n")
      end

      target = packaged_targets.fetch(pname)
      smoke_res = { errors: [], symlinks: 0, hardlinks: 0, ran_smoke: false }
      if opts[:verify_smoke]
        dep_bin_outs = {}
        target[:tdeps].each do |dep|
          dep_meta_file = File.join(staged_dir, "#{dep}.json")
          if File.file?(dep_meta_file)
            dep_rec = JSON.parse(File.read(dep_meta_file, encoding: "UTF-8"))
            dep_rel = dep_rec.dig("package", "binary", "path")
            dep_bin_outs[dep] = File.join(channel_dir, dep_rel) if dep_rel
          else
            cand = Dir.glob(File.join(channel_dir, "bin", "#{dep}-*.tar.xz")).sort.last
            dep_bin_outs[dep] = cand if cand
          end
        end
        dep_bin_outs[pname] = target[:bin_out]
        smoke_res = verify_packaged_archive!(
          name: pname,
          meta: target[:meta],
          tdeps: target[:tdeps],
          bin_out: target[:bin_out],
          bin_outs: dep_bin_outs,
          expected_hardlinks: target[:expected_hardlinks],
          pizfix: pizfix,
          neutral_prefix: neutral_prefix,
          work_dir: work_dir,
          throttle_fn: nil
        )
        unless smoke_res[:errors].empty?
          created_archives.each { |p| File.unlink(p) if File.exist?(p) }
          $stdout.puts("FILC_PORT #{pname} failed:package policy=#{target[:meta]['policy_class']} stage=verify")
          $stdout.flush
          raise "PACKAGE_SMOKE FAILED for #{pname}:\n  #{smoke_res[:errors].join("\n  ")}"
        end
      end

      FileUtils.mkdir_p(staged_dir)
      sr = package_size_records.first
      staged_payload = {
        "channel" => opts[:channel],
        "arch" => opts[:arch],
        "name" => pname,
        "package" => packages_index.fetch(pname),
        "sums" => sums_entries,
        "provenance_allowed" => sort_json(all_provenance_allowed),
        "size_record" => sr ? sr.transform_keys(&:to_s) : nil,
        "smoke" => {
          "ran_smoke" => smoke_res[:ran_smoke],
          "symlinks" => smoke_res[:symlinks],
          "hardlinks" => smoke_res[:hardlinks]
        }
      }
      staged_path = File.join(staged_dir, "#{pname}.json")
      tmp_staged = "#{staged_path}.tmp.#{Process.pid}"
      File.write(tmp_staged, "#{JSON.pretty_generate(sort_json(staged_payload))}\n", encoding: "UTF-8")
      File.rename(tmp_staged, staged_path)

      bin_art = packages_index[pname]["binary"]
      puts "PACKAGE_PORT_SINGLE: OK port=#{pname} channel=#{opts[:channel]} arch=#{opts[:arch]} " \
           "bin=#{bin_art['path']} sha256=#{bin_art['sha256']} smoke=#{smoke_res[:ran_smoke]}"
      return 0
    end

    worker_error = nil
    work_q = Queue.new
    workers = Array.new(opts[:parallel]) do
      Thread.new do
        while (pname = work_q.pop)
          mu.synchronize do
            loop do
              break unless worker_error.nil?

              limit = builds_done ? opts[:parallel] : bg_par
              break if active_workers < limit

              slot_cv.wait(mu)
            end
            active_workers += 1
          end

          begin
            unless mu.synchronize { !worker_error.nil? }
              process_port.call(pname)
            end
          rescue StandardError => e
            mu.synchronize do
              worker_error ||= e
              slot_cv.broadcast
            end
          ensure
            mu.synchronize do
              active_workers -= 1
              slot_cv.broadcast
            end
          end
        end
      end
    end

    if opts[:watch_done_file]
      seen_enqueued = Set.new
      filter_set = opts[:ports_filter] && !opts[:ports_filter].empty? ? Set.new(opts[:ports_filter]) : nil
      loop do
        planned_total = read_planned_total.call(planned_total)
        Dir.glob(File.join(state_dir, "*.manifest.json")).sort.each do |mpath|
          pname = File.basename(mpath, ".manifest.json")
          next if seen_enqueued.include?(pname)
          next if filter_set && !filter_set.include?(pname)

          # Only package a port once its build+test state JSON confirms tested/built
          st_file = File.join(state_dir, "#{pname}.json")
          next unless File.file?(st_file)

          st_obj = begin
            JSON.parse(File.read(st_file, encoding: "UTF-8"))
          rescue StandardError
            nil
          end
          next unless st_obj && %w[tested built].include?(st_obj["status"])

          seen_enqueued.add(pname)
          planned_total = [planned_total, seen_enqueued.size].max
          work_q << pname
        end
        break if File.file?(opts[:watch_done_file]) || mu.synchronize { !worker_error.nil? }

        sleep 0.4
      end
      # Builds finished: unlock full post-build parallelism, normal priority, and xz_threads.
      mu.synchronize do
        unless builds_done
          builds_done = true
          if opts[:bg_throttle]
            begin
              Process.setpriority(Process::PRIO_PROCESS, 0, 0)
            rescue Errno::EACCES, Errno::EPERM, NotImplementedError
              nil
            end
            $stdout.puts("PACKAGER_MODE: phase=post-build parallel=#{opts[:parallel]} xz_threads=#{opts[:xz_threads]} throttle=off")
            $stdout.flush
          end
          slot_cv.broadcast
        end
      end
      # Final sweep after done-file appears
      Dir.glob(File.join(state_dir, "*.manifest.json")).sort.each do |mpath|
        pname = File.basename(mpath, ".manifest.json")
        next if seen_enqueued.include?(pname)
        next if filter_set && !filter_set.include?(pname)

        st_file = File.join(state_dir, "#{pname}.json")
        next unless File.file?(st_file)

        st_obj = begin
          JSON.parse(File.read(st_file, encoding: "UTF-8"))
        rescue StandardError
          nil
        end
        next unless st_obj && %w[tested built].include?(st_obj["status"])

        seen_enqueued.add(pname)
        planned_total = [planned_total, seen_enqueued.size].max
        work_q << pname
      end
      opts[:parallel].times { work_q << nil }
      workers.each(&:join)
      raise worker_error if worker_error
      raise "no built port manifests found in #{state_dir}" if seen_enqueued.empty?
    else
      selected_names = if opts[:ports_filter] && !opts[:ports_filter].empty?
                         opts[:ports_filter]
                       else
                         Dir.glob(File.join(state_dir, "*.manifest.json")).map { |p| File.basename(p, ".manifest.json") }.sort
                       end
      raise "no built port manifests found in #{state_dir}" if selected_names.empty?

      planned_total = selected_names.length
      selected_names.sort.each { |n| work_q << n }
      opts[:parallel].times { work_q << nil }
      workers.each(&:join)
      raise worker_error if worker_error
    end

    if opts[:leak_report]
      FileUtils.mkdir_p(File.dirname(opts[:leak_report]))
      report_obj = {
        "channel" => opts[:channel],
        "arch" => opts[:arch],
        "exact_token_rules_loaded" => exact_rules.length,
        "failed_packages" => all_leaks.keys.sort,
        "failed_hits_total" => all_leaks.values.sum(&:length),
        "provenance_allowed_total" => all_provenance_allowed.values.sum(&:length),
        "provenance_allowed" => sort_json(all_provenance_allowed)
      }
      File.write(opts[:leak_report], "#{JSON.pretty_generate(report_obj)}\n", encoding: "UTF-8")
    end

    unless all_provenance_allowed.empty?
      allowed_total = all_provenance_allowed.values.sum(&:length)
      puts "LEAK_GATE PROVENANCE ALLOWED: #{allowed_total} generic hit(s) across #{all_provenance_allowed.size} package(s):"
      all_provenance_allowed.keys.sort.each do |pkg_key|
        all_provenance_allowed[pkg_key].each do |entry|
          puts "  [#{pkg_key}] #{entry['file']}: #{entry['token'].inspect} (#{entry['pattern']}) <- #{entry['upstream_source']}"
        end
      end
    end

    unless all_leaks.empty?
      created_archives.each { |p| File.unlink(p) if File.exist?(p) }
      total_hits = all_leaks.values.sum(&:length)
      lines = ["LEAK_GATE FAILED across #{all_leaks.size} package(s) (#{total_hits} total hit(s)):"]
      all_leaks.keys.sort.each do |pkg_key|
        pkg_hits = all_leaks[pkg_key]
        lines << "  [#{pkg_key}] (#{pkg_hits.length} hit(s)):"
        pkg_hits.first(50).each { |h| lines << "    - #{h}" }
        lines << "    ... (#{pkg_hits.length - 50} more hits omitted)" if pkg_hits.length > 50
      end
      raise lines.join("\n")
    end

    unless package_size_records.empty?
      sorted_sizes = package_size_records.sort_by { |r| [-r[:bin_size], r[:name]] }
      total_bin_bytes = sorted_sizes.sum { |r| r[:bin_size] }
      max_bin_bytes = sorted_sizes.first[:bin_size]
      total_hardlinks = sorted_sizes.sum { |r| r[:hardlinks] }
      total_saved_bytes = sorted_sizes.sum { |r| r[:saved_bytes] }
      puts "PACKAGE_SIZES: packages=#{sorted_sizes.length} total_bin=#{format_mib(total_bin_bytes)} " \
           "max_bin=#{format_mib(max_bin_bytes)} limit=#{format_mib(opts[:max_artifact_bytes])} " \
           "hardlinks=#{total_hardlinks} dedup_saved=#{format_mib(total_saved_bytes)}"
      puts "TOP_10_LARGEST_PACKAGES:"
      sorted_sizes.first(10).each_with_index do |r, idx|
        puts format(
          "  %2d. %-16s %s bin=%s src=%s hardlinks=%d saved=%s stripped=%d/%d",
          idx + 1, r[:name], r[:version], format_mib(r[:bin_size]), format_mib(r[:src_size]),
          r[:hardlinks], format_mib(r[:saved_bytes]), r[:stripped_count], r[:unique_elf_count]
        )
      end
      $stdout.flush
    end

    unless all_size_violations.empty?
      created_archives.each { |p| File.unlink(p) if File.exist?(p) }
      lines = ["SIZE_LIMIT FAILED across #{all_size_violations.size} package(s) (limit=#{opts[:max_artifact_bytes]} bytes / #{format_mib(opts[:max_artifact_bytes])}):"]
      all_size_violations.keys.sort.each do |pkg_key|
        all_size_violations[pkg_key].each { |v| lines << "  [#{pkg_key}] #{v}" }
      end
      raise lines.join("\n")
    end

    if opts[:verify_smoke] && !packaged_targets.empty?
      bin_outs = packaged_targets.transform_values { |v| v[:bin_out] }
      smoke_q = Queue.new
      packaged_targets.keys.sort.each { |n| smoke_q << n }
      smoke_workers_n = [opts[:parallel], packaged_targets.size].min
      smoke_workers_n.times { smoke_q << nil }

      smoke_failures = {}
      smoke_totals = { packages: 0, smoke_cmds: 0, symlinks: 0, hardlinks: 0 }
      smoke_mu = Mutex.new
      smoke_workers = Array.new(smoke_workers_n) do
        Thread.new do
          while (pname = smoke_q.pop)
            target = packaged_targets[pname]
            res = verify_packaged_archive!(
              name: pname,
              meta: target[:meta],
              tdeps: target[:tdeps],
              bin_out: target[:bin_out],
              bin_outs: bin_outs,
              expected_hardlinks: target[:expected_hardlinks],
              pizfix: pizfix,
              neutral_prefix: neutral_prefix,
              work_dir: work_dir,
              throttle_fn: nil
            )
            smoke_mu.synchronize do
              smoke_totals[:packages] += 1
              smoke_totals[:smoke_cmds] += 1 if res[:ran_smoke]
              smoke_totals[:symlinks] += res[:symlinks]
              smoke_totals[:hardlinks] += res[:hardlinks]
              smoke_failures[pname] = res[:errors] unless res[:errors].empty?
            end
          end
        end
      end
      smoke_workers.each(&:join)

      unless smoke_failures.empty?
        created_archives.each { |p| File.unlink(p) if File.exist?(p) }
        lines = ["PACKAGE_SMOKE FAILED across #{smoke_failures.size} package(s):"]
        smoke_failures.keys.sort.each do |pkg_key|
          smoke_failures[pkg_key].each { |err| lines << "  [#{pkg_key}] #{err}" }
        end
        raise lines.join("\n")
      end

      puts "PACKAGE_SMOKE: PASS packages=#{smoke_totals[:packages]} smoke_cmds=#{smoke_totals[:smoke_cmds]} " \
           "symlinks=#{smoke_totals[:symlinks]} hardlinks=#{smoke_totals[:hardlinks]}"
      $stdout.flush
    end

    index_obj = {
      "schema_version" => 1,
      "channel" => opts[:channel],
      "arch" => opts[:arch],
      "generated_at" => Time.now.utc.iso8601,
      "toolchain" => {
        "version" => opts[:channel],
        "llvm_tag" => upstream["LLVM_TAG"],
        "filc_commit" => upstream["FILC_COMMIT"],
        "musl_commit" => upstream["MUSL_COMMIT"]
      }.compact,
      "packages" => packages_index
    }

    index_path = File.join(channel_dir, "index.json")
    index_json = "#{JSON.pretty_generate(sort_json(index_obj))}\n"
    idx_hard, idx_gen = scan_text_for_leaks("index.json", index_json, literals, exact_rules: exact_rules)
    idx_leaks = idx_hard + idx_gen.map { |g| "#{g[:file]}: forbidden generic #{g[:pattern]} #{g[:token].inspect}" }
    raise "LEAK_GATE FAILED on index.json:\n  #{idx_leaks.join("\n  ")}" unless idx_leaks.empty?

    File.write(index_path, index_json, encoding: "UTF-8")
    sums_entries["index.json"] = file_sha256(index_path)

    sums_text = sums_entries.keys.sort.map { |rel| "#{sums_entries[rel]}  #{rel}\n" }.join
    sums_path = File.join(channel_dir, "SHA256SUMS")
    File.write(sums_path, sums_text, encoding: "UTF-8")

    if opts[:pubkey_file] && File.file?(opts[:pubkey_file])
      FileUtils.cp(opts[:pubkey_file], File.join(channel_dir, "pubkey.pub"))
    end

    signed_idx = sign_with_minisign!(
      index_path, "#{index_path}.minisig",
      trusted_comment: "channel:#{opts[:channel]} arch:#{opts[:arch]} file:index.json",
      key_file: opts[:sign_key_file], key_env: opts[:sign_key_env]
    )
    signed_sums = sign_with_minisign!(
      sums_path, "#{sums_path}.minisig",
      trusted_comment: "channel:#{opts[:channel]} arch:#{opts[:arch]} file:SHA256SUMS",
      key_file: opts[:sign_key_file], key_env: opts[:sign_key_env]
    )

    puts "PACKAGE_PORT: OK channel=#{opts[:channel]} arch=#{opts[:arch]} packages=#{packages_index.size} signed=#{signed_idx && signed_sums}"
    0
  end
end

exit(PortPackager.main(ARGV)) if $PROGRAM_NAME == __FILE__
