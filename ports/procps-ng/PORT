port_configure() {
  CPPFLAGS="-I$PIZFIX/include -I$PIZFIX/include/ncursesw" \
    LDFLAGS="-L$PIZFIX/lib" \
    PKG_CONFIG="$PIZFIX/bin/pkg-config --define-prefix" \
    PKG_CONFIG_PATH="$PIZFIX/lib/pkgconfig" \
    ./configure --prefix="$PIZFIX" \
      --disable-static \
      --disable-nls \
      --disable-rpath \
      --without-systemd \
      --without-elogind
}

port_test() {
  local out
  out="$("$PIZFIX/bin/ps" --version)"
  grep -q 'procps-ng 4\.0\.7' <<<"$out"
  out="$("$PIZFIX/bin/free" --version)"
  grep -q 'procps-ng 4\.0\.7' <<<"$out"
  out="$("$PIZFIX/bin/ps" -p "$$" -o pid=,comm=)"
  grep -q "$$" <<<"$out"
  out="$("$PIZFIX/bin/free" -b)"
  grep -qi 'mem:' <<<"$out"
  "$PIZFIX/bin/pgrep" -x -f ".*" >/dev/null || "$PIZFIX/bin/pgrep" -P 0 >/dev/null || true
  out="$("$PIZFIX/bin/uptime" -p)"
  grep -qi 'up' <<<"$out"
}

port_package_smoke() {
  local out
  out="$("$PKG_PREFIX/bin/ps" --version)"
  grep -q 'procps-ng 4\.0\.7' <<<"$out"
  out="$("$PKG_PREFIX/bin/free" --version)"
  grep -q 'procps-ng 4\.0\.7' <<<"$out"
  out="$("$PKG_PREFIX/bin/ps" -p "$$" -o pid= | tr -d ' ')"
  grep -Fxq "$$" <<<"$out"
  out="$("$PKG_PREFIX/bin/free" -b)"
  grep -qi 'mem:' <<<"$out"
  test -f "$PKG_PREFIX/lib/libproc2.so"
  test -f "$PKG_PREFIX/lib/pkgconfig/libproc2.pc"
}
