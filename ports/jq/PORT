UPSTREAM_SHA256="71b8d6e8f5fe81f6c6d0d110e3892251f6ce76ed095abd315e26e6e1193af3af"
UPSTREAM_SHA256_SOURCE="sha256:https://github.com/jqlang/jq/releases/download/jq-1.8.2/sha256sum.txt"
EXTRACT_DIR="jq-1.8.2"
TIER=1
DEPS="oniguruma"
BUILD_SYSTEM="autotools"
CONFIGURE_ARGS="--disable-docs --disable-maintainer-mode --disable-valgrind"
MAKE_ARGS=""
INSTALL_ARGS=""
TEST_CMD=""
POLICY_CLASS="P3-BuildOpt"
POLICY_RATIONALE="Builds unmodified upstream jq 1.8.2 against the staged Fil-C oniguruma port (--with-oniguruma, --disable-docs, --disable-valgrind) with zero source patches. Under Fil-C's larger capability stack frames, jq's deep-nesting test (#531 in tests/jqtest, 3671x jv_dump_term recursion at jv_print.c:301) triggers a safe 'filc safety error: stack overflow.' at the default 8 MiB stack limit; jq aborts earlier on extreme nesting under Fil-C, but safely. port_test() raises the stack limit to 64 MiB (ulimit -s 65536) for the upstream make check test suite. Verified against pinned Fil-C (cede3de02b42) that no standalone jq port patch exists upstream."
FILC_ORIGIN_REF="none (new Stage 6b port; verified no jq patch in cede3de02b42)"

port_configure() {
  CPPFLAGS="-I$PIZFIX/include" LDFLAGS="-L$PIZFIX/lib" \
    ./configure --prefix="$PIZFIX" \
      --with-oniguruma="$PIZFIX" \
      --disable-docs \
      --disable-maintainer-mode \
      --disable-valgrind
}

port_test() {
  (ulimit -s 65536 && make -j"$JOBS" check)
}
