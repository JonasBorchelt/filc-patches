port_configure() {
  ./configure --prefix="$PIZFIX"
}

port_test() {
  "$PIZFIX/bin/sed" --version | grep -q 'GNU sed.*4\.10'
  printf 'hello filc world\n' | "$PIZFIX/bin/sed" 's/filc/FILC/g' | grep -Fxq 'hello FILC world'
  printf 'a123b\n' | "$PIZFIX/bin/sed" -E 's/([a-z]+)([0-9]+)([a-z]+)/\3-\2-\1/' | grep -Fxq 'b-123-a'
  local td
  td="$(mktemp -d)"
  printf 'one\ntwo\nthree\n' > "$td/in.txt"
  "$PIZFIX/bin/sed" -i '2s/two/TWO/' "$td/in.txt"
  grep -Fxq 'TWO' "$td/in.txt"
  rm -rf "$td"
}
