#!/usr/bin/env ruby
# frozen_string_literal: true

# Self-tests for scripts/upstream-watch using isolated temporary git repos
# (no network access, no real toolchain build).

require "fileutils"
require "json"
require "open3"
require "tmpdir"

REPO_ROOT = File.expand_path("..", __dir__)
WATCH_SCRIPT = File.join(REPO_ROOT, "scripts", "upstream-watch")

def sh!(*cmd, chdir: nil, env: {})
  opts = chdir ? { chdir: chdir } : {}
  out, err, st = Open3.capture3(env, *cmd, **opts)
  raise "command failed (#{st.exitstatus}): #{cmd.join(' ')}\n#{out}\n#{err}" unless st.success?

  out.strip
end

def assert(cond, msg)
  raise "ASSERTION FAILED: #{msg}" unless cond
end

GIT_ENV = {
  "GIT_AUTHOR_NAME" => "Test",
  "GIT_AUTHOR_EMAIL" => "test@example.invalid",
  "GIT_COMMITTER_NAME" => "Test",
  "GIT_COMMITTER_EMAIL" => "test@example.invalid"
}.freeze

def make_mock_upstream_filc(dir)
  FileUtils.mkdir_p(File.join(dir, "libpas", "src", "libpas"))
  FileUtils.mkdir_p(File.join(dir, "filc", "include"))
  FileUtils.mkdir_p(File.join(dir, "filc", "src"))
  FileUtils.mkdir_p(File.join(dir, "filc", "main"))
  FileUtils.mkdir_p(File.join(dir, "yolounwind"))
  FileUtils.mkdir_p(File.join(dir, "projects", "zegarmistrz", "include"))

  sh!("git", "init", "-q", "-b", "deluge", dir)
  File.write(File.join(dir, "libpas", "src", "libpas", "demo.c"), "int a = 1;\nint b = 2;\nint c = 3;\n")
  sh!("git", "-C", dir, "add", "-A")
  sh!("git", "-C", dir, "commit", "-q", "-m", "initial runtime", env: GIT_ENV)
  sha1 = sh!("git", "-C", dir, "rev-parse", "HEAD")

  File.write(File.join(dir, "filc", "include", "extra.h"), "/* new header */\n")
  sh!("git", "-C", dir, "add", "-A")
  sh!("git", "-C", dir, "commit", "-q", "-m", "filc: add extra header", env: GIT_ENV)
  sha2 = sh!("git", "-C", dir, "rev-parse", "HEAD")

  File.write(File.join(dir, "libpas", "src", "libpas", "demo.c"), "int a = 999;\nint b = 2;\nint c = 3;\n")
  sh!("git", "-C", dir, "add", "-A")
  sh!("git", "-C", dir, "commit", "-q", "-m", "libpas: change demo.c line 1", env: GIT_ENV)
  sha3 = sh!("git", "-C", dir, "rev-parse", "HEAD")

  [sha1, sha2, sha3]
end

def make_mock_patches_repo(dir, upstream_url, pinned_sha, origin_bare)
  FileUtils.mkdir_p(File.join(dir, "runtime", "filc"))
  sh!("git", "init", "-q", "-b", "main", dir)
  File.write(File.join(dir, "UPSTREAM"), <<~UP)
    FILC_REPO=#{upstream_url}
    FILC_BRANCH=deluge
    FILC_COMMIT=#{pinned_sha}
  UP
  File.write(File.join(dir, "runtime", "filc", "series"), "01-demo.patch\n")
  File.write(File.join(dir, "runtime", "filc", "01-demo.patch"), <<~PATCH)
    --- a/libpas/src/libpas/demo.c
    +++ b/libpas/src/libpas/demo.c
    @@ -1,3 +1,3 @@
     int a = 1;
    -int b = 2;
    +int b = 42;
     int c = 3;
  PATCH
  sh!("git", "-C", dir, "add", "-A")
  sh!("git", "-C", dir, "commit", "-q", "-m", "init mock patches repo", env: GIT_ENV)
  sh!("git", "init", "-q", "--bare", origin_bare)
  sh!("git", "-C", dir, "remote", "add", "origin", origin_bare)
  sh!("git", "-C", dir, "push", "-q", "origin", "main")
  sh!("git", "-C", dir, "rev-parse", "HEAD")
end

def make_mock_runner(path, script_body)
  File.write(path, "#!/usr/bin/env bash\nset -euo pipefail\n#{script_body}\n")
  File.chmod(0o755, path)
end

Dir.mktmpdir("filc-watch-test-") do |td|
  upstream_dir = File.join(td, "upstream-fil-c")
  sha1, sha2, sha3 = make_mock_upstream_filc(upstream_dir)

  # 1. Up-to-date case: target == pinned -> exit 0, no branch created
  repo1 = File.join(td, "repo1")
  origin1 = File.join(td, "origin1.git")
  make_mock_patches_repo(repo1, upstream_dir, sha1, origin1)
  work1 = File.join(td, "work1")
  out, err, st = Open3.capture3(
    "ruby", WATCH_SCRIPT,
    "--repo-root", repo1,
    "--work-dir", work1,
    "--cache-dir", File.join(work1, "cache"),
    "--target-commit", sha1
  )
  assert(st.success?, "up-to-date must exit 0: #{out}\n#{err}")
  assert(out.include?("UPSTREAM_WATCH: UP TO DATE"), "expected UP TO DATE message")
  rpt1 = JSON.parse(File.read(File.join(work1, "upstream-watch-report.json")))
  assert(rpt1["status"] == "UP_TO_DATE", "expected UP_TO_DATE status")
  assert(sh!("git", "-C", repo1, "rev-parse", "--abbrev-ref", "HEAD") == "main", "must stay on main")

  # 2. Patch conflict case (sha1 -> sha3 breaks 01-demo.patch at line 1)
  repo2 = File.join(td, "repo2")
  origin2 = File.join(td, "origin2.git")
  main2 = make_mock_patches_repo(repo2, upstream_dir, sha1, origin2)
  work2 = File.join(td, "work2")
  marker_build = File.join(work2, "should-not-run")
  mock_tc = File.join(td, "mock-tc-fail.sh")
  make_mock_runner(mock_tc, "touch #{marker_build}")
  out, err, st = Open3.capture3(
    "ruby", WATCH_SCRIPT,
    "--repo-root", repo2,
    "--work-dir", work2,
    "--cache-dir", File.join(work2, "cache"),
    "--target-commit", sha3,
    "--push-remote", origin2,
    "--build-toolchain-cmd", mock_tc
  )
  assert(!st.success?, "patch conflict must fail non-zero")
  assert(!File.exist?(marker_build), "toolchain build must NOT run on patch conflict")
  rpt2 = JSON.parse(File.read(File.join(work2, "upstream-watch-report.json")))
  assert(rpt2["status"] == "PATCH_CONFLICT", "expected PATCH_CONFLICT, got #{rpt2['status']}")
  assert(rpt2["runtime_patches_failed"].length == 1, "expected 1 failing patch")
  assert(rpt2["runtime_patches_failed"][0]["patch"] == "runtime/filc/01-demo.patch", "wrong failing patch name")
  assert(sh!("git", "-C", origin2, "rev-parse", "refs/heads/main") == main2, "origin/main must NEVER move")

  # 3. Clean apply + full mock toolchain + mock ports with 1 broken port -> auto/filc-<short> pushed, main untouched
  repo3 = File.join(td, "repo3")
  origin3 = File.join(td, "origin3.git")
  main3 = make_mock_patches_repo(repo3, upstream_dir, sha1, origin3)
  work3 = File.join(td, "work3")
  mock_build_tc = File.join(td, "mock-build-tc.sh")
  mock_test_tc = File.join(td, "mock-test-tc.sh")
  mock_ports_ok = File.join(td, "mock-ports-ok.sh")
  mock_ports_fail = File.join(td, "mock-ports-fail.sh")
  make_mock_runner(mock_build_tc, "mkdir -p \"$1\"")
  make_mock_runner(mock_test_tc, "echo OK > \"$2\"")
  make_mock_runner(mock_ports_ok, <<~SH)
    mkdir -p "$1"
    cat > "$1/ports-report.json" <<'JSON'
    {"ports":[{"name":"zlib","version":"1.4","status":"tested"},{"name":"perl","version":"5.40.5","status":"tested"}]}
    JSON
  SH
  make_mock_runner(mock_ports_fail, <<~SH)
    mkdir -p "$1"
    cat > "$1/ports-report.json" <<'JSON'
    {"ports":[{"name":"zlib","version":"1.4","status":"tested"},{"name":"perl","version":"5.40.5","status":"failed:package","failed_stage":"test","failed_kind":"package"}]}
    JSON
    exit 1
  SH

  out, err, st = Open3.capture3(
    "ruby", WATCH_SCRIPT,
    "--repo-root", repo3,
    "--work-dir", work3,
    "--cache-dir", File.join(work3, "cache"),
    "--target-commit", sha2,
    "--push-remote", origin3,
    "--build-toolchain-cmd", mock_build_tc,
    "--test-toolchain-cmd", mock_test_tc,
    "--build-ports-cmd", mock_ports_ok
  )
  assert(st.success?, "clean watch run must exit 0: #{out}\n#{err}")
  rpt3 = JSON.parse(File.read(File.join(work3, "upstream-watch-report.json")))
  expected_branch = "auto/filc-#{sha2[0, 8]}"
  assert(rpt3["status"] == "PASS", "expected PASS, got #{rpt3['status']}")
  assert(rpt3["auto_branch"] == expected_branch, "unexpected branch #{rpt3['auto_branch']}")
  assert(rpt3["new_commits"].any? { |c| c.include?("filc: add extra header") }, "missing upstream commit subject")
  assert(rpt3["push_status"] == "pushed (#{expected_branch})", "expected pushed status, got #{rpt3['push_status']}")
  assert(sh!("git", "-C", origin3, "rev-parse", "refs/heads/main") == main3, "origin/main must NEVER move")
  assert(sh!("git", "-C", origin3, "rev-parse", "refs/heads/#{expected_branch}") == rpt3["auto_branch_commit"],
         "auto branch not pushed to origin")

  # 4. Broken port reporting case
  repo4 = File.join(td, "repo4")
  origin4 = File.join(td, "origin4.git")
  make_mock_patches_repo(repo4, upstream_dir, sha1, origin4)
  work4 = File.join(td, "work4")
  _out, _err, st = Open3.capture3(
    "ruby", WATCH_SCRIPT,
    "--repo-root", repo4,
    "--work-dir", work4,
    "--cache-dir", File.join(work4, "cache"),
    "--target-commit", sha2,
    "--dry-run",
    "--build-toolchain-cmd", mock_build_tc,
    "--test-toolchain-cmd", mock_test_tc,
    "--build-ports-cmd", mock_ports_fail
  )
  assert(!st.success?, "broken port run must exit non-zero")
  rpt4 = JSON.parse(File.read(File.join(work4, "upstream-watch-report.json")))
  assert(rpt4["status"] == "PORTS_FAILED", "expected PORTS_FAILED, got #{rpt4['status']}")
  assert(rpt4["ports_summary"]["failed"].length == 1, "expected 1 failed port")
  assert(rpt4["ports_summary"]["failed"][0]["name"] == "perl", "expected perl in failed ports")

  # 5. Never-push-main, push-remote host, and env-auth guards
  load WATCH_SCRIPT
  %w[main master release/x auto/filc-bad!].each do |bad|
    raised = false
    begin
      UpstreamWatch.assert_safe_auto_branch!(bad)
    rescue SecurityError
      raised = true
    end
    assert(raised, "guard must reject #{bad}")
  end
  assert(UpstreamWatch.assert_safe_auto_branch!("auto/filc-8553fcd0") == "auto/filc-8553fcd0",
         "guard must allow valid auto/filc-<hex> branch")

  repo_http = File.join(td, "repo-http")
  sh!("git", "init", "-q", "-b", "main", repo_http)
  sh!("git", "-C", repo_http, "remote", "add", "origin", "https://git.internal.example:3000/org/filc-patches.git")
  assert(
    UpstreamWatch.assert_safe_push_remote!(repo_http, "https://git.internal.example:3000/org/filc-patches.git") ==
      "https://git.internal.example:3000/org/filc-patches.git",
    "guard must allow push to clone origin host"
  )
  [
    "https://github.com/pizlonator/fil-c.git",
    "https://sub.github.com/org/repo.git",
    "https://other.example:3000/org/filc-patches.git",
    "https://user:secret@git.internal.example:3000/org/filc-patches.git"
  ].each do |bad_remote|
    raised = false
    begin
      UpstreamWatch.assert_safe_push_remote!(repo_http, bad_remote)
    rescue SecurityError
      raised = true
    end
    assert(raised, "remote guard must reject #{bad_remote}")
  end

  penv = UpstreamWatch.build_push_env("tok-secret-123")
  assert(penv["GIT_CONFIG_COUNT"] == "1", "expected GIT_CONFIG_COUNT=1")
  assert(penv["GIT_CONFIG_KEY_0"] == "http.extraHeader", "expected http.extraHeader")
  assert(penv["GIT_CONFIG_VALUE_0"] == "Authorization: token tok-secret-123", "expected Authorization header")

  # 6. Partial/promisor bare mirror (--filter=blob:none) must not break strict runtime patch check
  sh!("git", "-C", upstream_dir, "config", "uploadpack.allowFilter", "true")
  sh!("git", "-C", upstream_dir, "config", "uploadpack.allowAnySHA1InWant", "true")
  partial_bare = File.join(td, "partial-filc.git")
  sh!("git", "clone", "-q", "--bare", "--filter=blob:none", "file://#{upstream_dir}", partial_bare)
  prom_cfg = sh!("git", "-C", partial_bare, "config", "--get", "remote.origin.promisor")
  assert(prom_cfg == "true", "expected partial bare mirror with remote.origin.promisor=true")
  passed_p, failed_p = UpstreamWatch.check_runtime_patches_strict(repo1, partial_bare, sha2)
  assert(failed_p.empty? && passed_p.length == 1,
         "expected clean patch check against partial bare mirror, got passed=#{passed_p.inspect} failed=#{failed_p.inspect}")
  _passed_c, failed_c = UpstreamWatch.check_runtime_patches_strict(repo1, partial_bare, sha3)
  assert(failed_c.length == 1, "expected conflict detection against partial bare mirror, got #{failed_c.inspect}")
end

puts "TEST_UPSTREAM_WATCH: PASS (6/6)"
