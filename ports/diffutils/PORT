UPSTREAM_SHA256_SOURCE="pgp:https://ftp.gnu.org/gnu/diffutils/diffutils-3.12.tar.xz.sig key:ports/pgp-keys/gnu-meyering-release-key.asc fpr:155D3FC500C834486D1EEA677FD9FCCB000BEEEE"
UPSTREAM_SIG_URL="https://ftp.gnu.org/gnu/diffutils/diffutils-3.12.tar.xz.sig"
UPSTREAM_PGP_KEY="ports/pgp-keys/gnu-meyering-release-key.asc"
