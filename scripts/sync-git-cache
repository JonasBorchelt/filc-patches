#!/usr/bin/env ruby
# frozen_string_literal: true

# Maintain a persistent bare git mirror/cache for an upstream pinned commit.
#
# Features:
# - Exclusive per-repo file lock (File#flock) for safe parallel runs (Linux + macOS).
# - Zero network traffic on cache hit when the pinned commit is already present
#   and passes integrity validation.
# - Strict 40-hex commit pin verification against the requested SHA.
# - Automatic detection of corrupt bare repositories (missing HEAD/objects,
#   partial/promisor config, broken pack/idx pairs, fsck connectivity errors)
#   with atomic directory replacement via a temporary clone.

require "fileutils"
require "open3"
require "optparse"

HEX40_RE = /\A[0-9a-f]{40}\z/

def log(msg)
  $stdout.puts(msg)
  $stdout.flush
end

def run_git(args, cwd: nil)
  cmd = ["git", "-c", "safe.directory=*"]
  cmd.push("-C", cwd) unless cwd.nil?
  cmd.concat(args)
  stdout, stderr, status = Open3.capture3(*cmd)
  [stdout, stderr, status.exitstatus]
end

def validate_bare_repo(repo_dir)
  return [false, "directory missing"] unless File.directory?(repo_dir)
  return [false, "HEAD file missing"] unless File.file?(File.join(repo_dir, "HEAD"))

  objects_dir = File.join(repo_dir, "objects")
  return [false, "objects directory missing"] unless File.directory?(objects_dir)

  out, _err, rc = run_git(["rev-parse", "--is-bare-repository"], cwd: repo_dir)
  return [false, "not a bare repository (rc=#{rc})"] if rc != 0 || out.strip != "true"

  # scripts/fetch* reject partial/promisor clones as --reference alternates.
  prom_out, _prom_err, prom_rc = run_git(
    ["config", "--get-regexp", "^(extensions\\.partialclone|remote\\..*\\.promisor)$"],
    cwd: repo_dir
  )
  return [false, "partial/promisor clone config present"] if prom_rc == 0 && !prom_out.strip.empty?

  pack_dir = File.join(objects_dir, "pack")
  if File.directory?(pack_dir)
    Dir.children(pack_dir).each do |entry|
      return [false, "leftover temporary pack file #{entry}"] if entry.start_with?("tmp_pack_", "tmp_idx_")

      next unless entry.end_with?(".pack")

      idx_path = File.join(pack_dir, "#{entry[0..-6]}.idx")
      if !File.file?(idx_path) || File.size(idx_path).zero?
        return [false, "missing or empty index for #{entry}"]
      end
    end
  end

  fsck_out, fsck_err, fsck_rc = run_git(
    ["fsck", "--connectivity-only", "--no-dangling", "--no-progress"],
    cwd: repo_dir
  )
  if fsck_rc != 0
    detail = (fsck_err.empty? ? fsck_out : fsck_err).strip.lines
    first = detail.empty? ? "rc=#{fsck_rc}" : detail.first.strip
    return [false, "git fsck failed: #{first}"]
  end

  [true, "ok"]
end

def has_commit?(repo_dir, commit)
  out, _err, rc = run_git(["rev-parse", "--verify", "--quiet", "#{commit}^{commit}"], cwd: repo_dir)
  return false if rc != 0 || out.strip.downcase != commit

  _tout, _terr, trc = run_git(["ls-tree", commit], cwd: repo_dir)
  trc == 0
end

def ensure_origin(repo_dir, repo_url)
  cur_out, _cur_err, cur_rc = run_git(["remote", "get-url", "origin"], cwd: repo_dir)
  if cur_rc != 0
    _aout, aerr, arc = run_git(["remote", "add", "origin", repo_url], cwd: repo_dir)
    raise "git remote add origin failed: #{aerr.strip}" if arc != 0
  elsif cur_out.strip != repo_url
    _uout, uerr, urc = run_git(["remote", "set-url", "origin", repo_url], cwd: repo_dir)
    raise "git remote set-url origin failed: #{uerr.strip}" if urc != 0
  end
end

def fetch_commit(repo_dir, repo_url, commit, ref, retries)
  ensure_origin(repo_dir, repo_url)
  backoffs = [0, 2, 5]
  last_err = ""
  attempts = [1, retries].max

  (1..attempts).each do |attempt|
    if attempt > 1
      wait_s = backoffs[[attempt - 1, backoffs.length - 1].min]
      sleep(wait_s) if wait_s.positive?
    end

    # Build candidate fetch commands: prefer shallow fetch of ref/commit,
    # falling back to full non-shallow fetch for servers (such as musl)
    # that disallow shallow fetch-by-SHA.
    candidates = []
    candidates << ["fetch", "--depth=1", "--no-tags", "origin", ref] unless ref.empty?
    candidates << ["fetch", "--depth=1", "--no-tags", "origin", commit]
    candidates << ["fetch", "--no-tags", "origin"]

    candidates.each do |fetch_args|
      out, err, rc = run_git(fetch_args, cwd: repo_dir)
      return if rc == 0 && has_commit?(repo_dir, commit)

      msg = (err.empty? ? out : err).strip
      last_err = if rc == 0
                   "fetched #{fetch_args.last} from #{repo_url}, " \
                     "but pinned commit #{commit} is not present"
                 else
                   msg.empty? ? "git fetch exited #{rc}" : msg
                 end
    end
  end

  raise "failed to fetch pinned commit #{commit} from #{repo_url}: #{last_err}"
end

def cleanup_stale_temps(cache_dir, name)
  ["#{name}.git.tmp.*", "#{name}.git.broken.*"].each do |pattern|
    Dir.glob(File.join(cache_dir, pattern)).each do |path|
      FileUtils.rm_rf(path)
    end
  end
end

def reclone_atomic(cache_dir, name, repo_url, commit, ref, retries)
  target_dir = File.join(cache_dir, "#{name}.git")
  tmp_dir = File.join(cache_dir, "#{name}.git.tmp.#{Process.pid}")
  broken_dir = File.join(cache_dir, "#{name}.git.broken.#{Process.pid}")

  FileUtils.rm_rf(tmp_dir)
  FileUtils.rm_rf(broken_dir)
  begin
    _iout, ierr, irc = run_git(["init", "--bare", "-q", tmp_dir])
    raise "git init --bare failed: #{ierr.strip}" if irc != 0

    fetch_commit(tmp_dir, repo_url, commit, ref, retries)
    ok, reason = validate_bare_repo(tmp_dir)
    raise "fresh bare clone failed validation: #{reason}" unless ok
    raise "fresh bare clone missing pinned commit #{commit}" unless has_commit?(tmp_dir, commit)

    moved_old = false
    if File.exist?(target_dir)
      File.rename(target_dir, broken_dir)
      moved_old = true
    end
    begin
      File.rename(tmp_dir, target_dir)
    rescue StandardError
      File.rename(broken_dir, target_dir) if moved_old && File.exist?(broken_dir) && !File.exist?(target_dir)
      raise
    end
    FileUtils.rm_rf(broken_dir) if moved_old
  ensure
    FileUtils.rm_rf(tmp_dir)
    FileUtils.rm_rf(broken_dir)
  end
end

def elapsed_seconds(t0)
  (Process.clock_gettime(Process::CLOCK_MONOTONIC) - t0).round
end

def parse_options(argv)
  opts = {
    name: nil,
    repo: nil,
    commit: nil,
    ref: "",
    cache_dir: nil,
    force_reclone: false,
    retries: 3,
  }

  parser = OptionParser.new do |o|
    o.banner = "Usage: sync-git-cache --name NAME --repo URL --commit SHA --cache-dir DIR [options]"
    o.on("--name NAME", "Logical cache name (e.g. llvm-project)") { |v| opts[:name] = v }
    o.on("--repo URL", "Upstream git repository URL or path") { |v| opts[:repo] = v }
    o.on("--commit SHA", "Pinned 40-hex commit SHA") { |v| opts[:commit] = v }
    o.on("--ref REFSPEC", "Optional git refspec") { |v| opts[:ref] = v }
    o.on("--cache-dir DIR", "Persistent cache directory") { |v| opts[:cache_dir] = v }
    o.on("--force-reclone", "Force atomic fresh reclone") { opts[:force_reclone] = true }
    o.on("--retries N", Integer, "Fetch retry count on transient failure") { |v| opts[:retries] = v }
  end

  parser.parse!(argv)
  missing = %i[name repo commit cache_dir].select { |k| opts[k].nil? }
  unless missing.empty?
    warn "error: missing required option(s): #{missing.map { |k| "--#{k.to_s.tr('_', '-')}" }.join(', ')}"
    return [nil, 2]
  end

  [opts, 0]
rescue OptionParser::ParseError => e
  warn "error: #{e.message}"
  [nil, 2]
end

def main(argv)
  opts, parse_rc = parse_options(argv)
  return parse_rc if parse_rc != 0

  commit = opts[:commit].strip.downcase
  unless HEX40_RE.match?(commit)
    warn "error: --commit must be a 40-hex SHA, got: #{opts[:commit].inspect}"
    return 2
  end

  name = opts[:name]
  repo = opts[:repo]
  ref = opts[:ref]
  retries = opts[:retries]
  cache_dir = File.expand_path(opts[:cache_dir])
  FileUtils.mkdir_p(cache_dir)
  target_dir = File.join(cache_dir, "#{name}.git")
  lock_path = File.join(cache_dir, "#{name}.lock")

  t0 = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  lock_file = File.open(lock_path, File::CREAT | File::RDWR, 0o666)
  begin
    unless lock_file.flock(File::LOCK_EX | File::LOCK_NB)
      log("src-cache[#{name}]: waiting for lock #{lock_path} ...")
      lock_file.flock(File::LOCK_EX)
    end

    cleanup_stale_temps(cache_dir, name)

    if !opts[:force_reclone] && File.exist?(target_dir)
      valid, reason = validate_bare_repo(target_dir)
      if valid
        if has_commit?(target_dir, commit)
          elapsed = elapsed_seconds(t0)
          log("src-cache[#{name}]: cache hit: #{commit} (#{elapsed}s)")
          log("FILC_SRC_CACHE #{name} hit #{commit} #{elapsed}s")
          return 0
        end

        # Healthy cache, but pinned commit is not cached yet: incremental fetch.
        log("src-cache[#{name}]: cache miss (commit #{commit} not cached); fetching ...")
        begin
          fetch_commit(target_dir, repo, commit, ref, retries)
          valid2, reason2 = validate_bare_repo(target_dir)
          raise "post-fetch validation failed: #{reason2}" unless valid2
          raise "commit #{commit} missing after fetch" unless has_commit?(target_dir, commit)

          elapsed = elapsed_seconds(t0)
          log("src-cache[#{name}]: cache miss -> fetched #{commit} (#{elapsed}s)")
          log("FILC_SRC_CACHE #{name} miss #{commit} #{elapsed}s")
          return 0
        rescue StandardError => e
          log("src-cache[#{name}]: incremental fetch failed (#{e.message}); recloning atomically ...")
          reclone_atomic(cache_dir, name, repo, commit, ref, retries)
          elapsed = elapsed_seconds(t0)
          log("src-cache[#{name}]: cache rebuilt: #{commit} (#{elapsed}s)")
          log("FILC_SRC_CACHE #{name} rebuilt #{commit} #{elapsed}s")
          return 0
        end
      else
        log("src-cache[#{name}]: corrupt cache detected (#{reason}); recloning atomically ...")
        reclone_atomic(cache_dir, name, repo, commit, ref, retries)
        elapsed = elapsed_seconds(t0)
        log("src-cache[#{name}]: cache rebuilt: #{commit} (#{elapsed}s)")
        log("FILC_SRC_CACHE #{name} rebuilt #{commit} #{elapsed}s")
        return 0
      end
    end

    # Cold cache or --force-reclone
    action_word = opts[:force_reclone] ? "rebuilt" : "miss"
    if opts[:force_reclone]
      log("src-cache[#{name}]: force-reclone requested; recloning atomically ...")
    else
      log("src-cache[#{name}]: cold cache; cloning bare mirror for #{commit} ...")
    end
    reclone_atomic(cache_dir, name, repo, commit, ref, retries)
    elapsed = elapsed_seconds(t0)
    if opts[:force_reclone]
      log("src-cache[#{name}]: cache rebuilt: #{commit} (#{elapsed}s)")
    else
      log("src-cache[#{name}]: cache miss -> cloned #{commit} (#{elapsed}s)")
    end
    log("FILC_SRC_CACHE #{name} #{action_word} #{commit} #{elapsed}s")
    0
  rescue StandardError => e
    warn "error: src-cache[#{name}]: #{e.message}"
    1
  ensure
    begin
      lock_file.flock(File::LOCK_UN)
    ensure
      lock_file.close
    end
  end
end

exit(main(ARGV)) if $PROGRAM_NAME == __FILE__
