port_configure() {
  # PHP 7.x ext/iconv/config.m4 falls back to /usr/local /usr and unconditionally
  # prepends -I$PHP_ICONV_PREFIX/include and -L$PHP_ICONV_PREFIX/lib to CFLAGS
  # and LDFLAGS whenever libc provides iconv() (leaving ICONV_DIR empty). Under
  # Fil-C that poisons subsequent configure probes with host glibc headers.
  "${HOST_RUBY:-ruby}" -e '
    p = "configure"
    s = File.binread(p)
    pat = %r{for i in /usr/local /usr; do\s*\n\s*if test -f "\$i/include/iconv\.h" \|\| test -f "\$i/include/giconv\.h"; then\s*\n\s*PHP_ICONV_PREFIX="\$i"\s*\n\s*break\s*\n\s*fi\s*\n\s*done\s*\n\s*if test -z "\$PHP_ICONV_PREFIX"; then\s*\n\s*PHP_ICONV_PREFIX="/usr"\s*\n\s*fi}
    matches = s.scan(pat).length
    raise "ext/iconv /usr prefix fallback not found in configure (matches=#{matches})" unless matches == 1
    File.binwrite(p, s.sub(pat, "PHP_ICONV_PREFIX=\"$prefix\""))
  '
  local shim_dir="$SRC_DIR/.filc-tools"
  rm -rf "$shim_dir"
  mkdir -p "$shim_dir/bin"
  ln -s "$PIZFIX/include" "$shim_dir/include"
  ln -s "$PIZFIX/lib" "$shim_dir/lib"
  cat > "$shim_dir/bin/xml2-config" <<SHIM
#!/bin/sh
PKG_CONFIG_PATH="$PIZFIX/lib/pkgconfig"
export PKG_CONFIG_PATH
case "\$1" in
  --version) exec "$PIZFIX/bin/pkg-config" --define-prefix --modversion libxml-2.0 ;;
  --cflags)  exec "$PIZFIX/bin/pkg-config" --define-prefix --cflags libxml-2.0 ;;
  --libs)    exec "$PIZFIX/bin/pkg-config" --define-prefix --libs libxml-2.0 ;;
  --prefix)  printf '%s\n' "$PIZFIX" ;;
  *)         exec "$PIZFIX/bin/pkg-config" --define-prefix "\$@" libxml-2.0 ;;
esac
SHIM
  cat > "$shim_dir/bin/icu-config" <<SHIM
#!/bin/sh
PKG_CONFIG_PATH="$PIZFIX/lib/pkgconfig"
export PKG_CONFIG_PATH
case "\$1" in
  --version)        exec "$PIZFIX/bin/pkg-config" --define-prefix --modversion icu-uc ;;
  --cppflags)       exec "$PIZFIX/bin/pkg-config" --define-prefix --cflags icu-uc icu-io icu-i18n ;;
  --ldflags)        exec "$PIZFIX/bin/pkg-config" --define-prefix --libs icu-io icu-i18n icu-uc ;;
  --ldflags-icuio)  exec "$PIZFIX/bin/pkg-config" --define-prefix --libs icu-io ;;
  --ldflags-libsonly) exec "$PIZFIX/bin/pkg-config" --define-prefix --libs-only-l icu-io icu-i18n icu-uc ;;
  --ldflags-searchpath) exec "$PIZFIX/bin/pkg-config" --define-prefix --libs-only-L icu-io icu-i18n icu-uc ;;
  --prefix)         printf '%s\n' "$PIZFIX" ;;
  --cxxflags)       printf '%s\n' "-std=c++17" ;;
  *)                printf '' ;;
esac
SHIM
  chmod +x "$shim_dir/bin/xml2-config" "$shim_dir/bin/icu-config"
  PATH="$shim_dir/bin:$PIZFIX/bin:$PATH" \
    CPPFLAGS="-I$PIZFIX/include -I$PIZFIX/include/ncursesw" \
    CXXFLAGS="${CXXFLAGS:-} -I$PIZFIX/include -std=c++17" \
    LDFLAGS="-L$PIZFIX/lib -Wl,-rpath,$PIZFIX/lib -Wl,-Bsymbolic-functions" \
    EXTRA_LDFLAGS="-L$PIZFIX/lib -Wl,-rpath,$PIZFIX/lib -Wl,-Bsymbolic-functions" \
    PKG_CONFIG="$PIZFIX/bin/pkg-config --define-prefix" \
    PKG_CONFIG_PATH="$PIZFIX/lib/pkgconfig" \
    EXTENSION_DIR="$PIZFIX/lib/php7.3/extensions" \
    PHP_UNAME="Linux" \
    PHP_BUILD_SYSTEM="Linux" \
    PHP_BUILD_PROVIDER="Fil-C" \
    ./configure --prefix="$PIZFIX" \
      --with-layout=GNU \
      --program-suffix=7.3 \
      --libdir="$PIZFIX/lib/php7.3" \
      --includedir="$PIZFIX/include/php7.3" \
      --datadir="$PIZFIX/share/php7.3" \
      --mandir="$PIZFIX/share/man" \
      --sysconfdir="$PIZFIX/etc/php7.3" \
      --localstatedir="$PIZFIX/var/php7.3" \
      --with-config-file-path="$PIZFIX/etc/php7.3" \
      --with-config-file-scan-dir="$PIZFIX/etc/php7.3/conf.d" \
      --without-pcre-jit \
      --with-pcre-regex="$PIZFIX" \
      --with-libxml-dir="$shim_dir" \
      --with-icu-dir="$shim_dir" \
      --enable-fpm \
      --with-openssl="$PIZFIX/opt/openssl1.1" \
      --with-openssl-dir="$PIZFIX/opt/openssl1.1" \
      --with-zlib="$PIZFIX" \
      --with-bz2="$PIZFIX" \
      --with-curl="$PIZFIX" \
      --with-sqlite3="$PIZFIX" \
      --with-pdo-sqlite="$PIZFIX" \
      --enable-intl \
      --with-libedit="$PIZFIX" \
      --enable-mbstring \
      --with-onig="$PIZFIX" \
      --with-sodium="$PIZFIX" \
      --enable-bcmath \
      --enable-calendar \
      --enable-exif \
      --enable-pcntl \
      --enable-sockets
  if grep -En -- '(^|[[:space:]"'"'"'])(-I["'"'"']?/usr/(local/)?include|-L["'"'"']?/usr/(local/)?lib(64)?)([[:space:]"'"'"'/]|$)' Makefile config.status >&2; then
    echo "error: host /usr include or lib path leaked into php7.3 Makefile/config.status" >&2
    return 1
  fi
}

port_test() {
  local php_bin fpm_bin ext_dir out ver fpm_ver
  php_bin="$PIZFIX/bin/php7.3"
  fpm_bin="$PIZFIX/sbin/php-fpm7.3"
  ext_dir="$PIZFIX/lib/php7.3/extensions"

  out="$("$php_bin" -n -v)"
  ver="${out%%$'\n'*}"
  echo "php7.3 version: $ver"
  printf '%s\n' "$ver" | grep -q '^PHP 7\.3\.31 '

  out="$("$fpm_bin" -n -v)"
  fpm_ver="${out%%$'\n'*}"
  echo "php-fpm7.3 version: $fpm_ver"
  printf '%s\n' "$fpm_ver" | grep -q '^PHP 7\.3\.31 '

  "$php_bin" -n \
    -d extension_dir="$ext_dir" \
    -d zend.assertions=1 \
    -d assert.exception=1 \
    -d zend_extension=opcache \
    -d opcache.enable_cli=1 \
    <<'EOF' | grep -Fxq 'PHP73_FILC_SMOKE_OK'
<?php
function checkObj(?stdClass $o): ?stdClass { return $o; }
$o = new stdClass();
assert(checkObj($o) === $o);
assert(checkObj(null) === null);

$xml = new DOMDocument();
$xml->loadXML('<root xmlns="urn:test"><child a="1">ok</child></root>');
assert(strpos($xml->C14N(), '<child a="1">ok</child>') !== false);

$i = PHP_INT_MAX;
$i++;
assert(is_float($i));
assert(strtolower("Fil-C PHP 7.3") === "fil-c php 7.3");
assert(strtoupper("Fil-C php 7.3") === "FIL-C PHP 7.3");
assert(opcache_get_status(false)["opcache_enabled"] === true);

assert(strpos(OPENSSL_VERSION_TEXT, "OpenSSL 1.1.1") === 0);
assert(hash("sha256", "hello\n") === "5891b5b522d5df086d0ff0b110fbd9d21bb4fc7163af34d08286a2e846f6be03");
assert(openssl_digest("hello\n", "sha256") === "5891b5b522d5df086d0ff0b110fbd9d21bb4fc7163af34d08286a2e846f6be03");
assert(gzuncompress(gzcompress("filc-zlib-php73")) === "filc-zlib-php73");
assert(bzdecompress(bzcompress("filc-bz2-php73")) === "filc-bz2-php73");
assert(preg_match('/^([a-z]+)-(\d+)$/', 'filc-73', $matches) === 1 && $matches[2] === '73');
assert(json_decode(json_encode(["ok" => [1, 2, 3]]), true)["ok"] === [1, 2, 3]);
assert(is_array(curl_version()) && !empty(curl_version()["version"]));
assert(mb_strlen("hällo", "UTF-8") === 5);
assert(iconv("UTF-8", "ISO-8859-1", "h\xc3\xa4llo") === "h\xe4llo");
assert(mb_ereg_replace("([0-9]+)", "[\\1]", "v73") === "v[73]");
assert((new Collator("en_US"))->compare("a", "b") < 0);
assert(strlen(sodium_crypto_generichash("filc-sodium")) === SODIUM_CRYPTO_GENERICHASH_BYTES);
assert(bcadd("12345678901234567890", "1", 0) === "12345678901234567891");

$db = new SQLite3(":memory:");
$db->exec("CREATE TABLE t (v INT); INSERT INTO t VALUES (42);");
assert($db->querySingle("SELECT v FROM t") === 42);
$db->close();

$pdo = new PDO("sqlite::memory:");
$pdo->exec("CREATE TABLE p (s TEXT); INSERT INTO p VALUES ('ok');");
assert($pdo->query("SELECT s FROM p")->fetchColumn() === "ok");

$pid = pcntl_fork();
assert($pid >= 0);
if ($pid === 0) {
    exit(42);
}
$status = 0;
assert(pcntl_waitpid($pid, $status) === $pid);
assert(pcntl_wifexited($status) && pcntl_wexitstatus($status) === 42);

echo "PHP73_FILC_SMOKE_OK\n";
EOF
}

