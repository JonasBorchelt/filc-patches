#!/usr/bin/env bash
set -euo pipefail

# End-to-end runtime verification suite for a built Fil-C toolchain.
# Runs three test groups against <WORK_ROOT>/build/bin/clang{,++} + pizfix:
#   (a) C Hello World (compile, link, run, exit 0)
#   (b) Fil-C Memory-Safety Traps:
#       - Out-of-bounds read (must trap non-zero with Fil-C safety error)
#       - Use-after-free read (must trap non-zero with Fil-C safety error)
#   (c) C++ with libc++ (std::vector, std::string, iostream, throw/catch, exit 0)
#
# Emits a structured SHA-256 evidence report (Beleg) to REPORT_FILE and stdout.
#
# Usage: scripts/test-toolchain [WORK_ROOT] [REPORT_FILE]

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../UPSTREAM
source "$REPO_ROOT/UPSTREAM"

WORK_ROOT="${1:-$REPO_ROOT/.work/toolchain}"
WORK_ROOT="$(cd "$WORK_ROOT" && pwd)"
REPORT_FILE="${2:-$WORK_ROOT/toolchain-report.txt}"

BUILD_DIR="$WORK_ROOT/build"
PIZFIX="$WORK_ROOT/pizfix"
CLANG="$BUILD_DIR/bin/clang"
CLANGXX="$BUILD_DIR/bin/clang++"
LLD="$BUILD_DIR/bin/ld.lld"
TEST_DIR="$WORK_ROOT/e2e-tests"

if [[ ! -x "$CLANG" || ! -x "$CLANGXX" || ! -d "$PIZFIX/lib" ]]; then
  echo "error: built Fil-C toolchain not found under $WORK_ROOT (run scripts/build-toolchain first)" >&2
  exit 1
fi

rm -rf "$TEST_DIR"
mkdir -p "$TEST_DIR" "$(dirname "$REPORT_FILE")"

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}

# ---------------------------------------------------------------------------
# Write test sources
# ---------------------------------------------------------------------------
cat > "$TEST_DIR/hello_world.c" <<'EOF'
#include <stdio.h>

int main(void) {
    printf("Hello from Fil-C!\n");
    return 0;
}
EOF

cat > "$TEST_DIR/trap_oob.c" <<'EOF'
#include <stdio.h>
#include <stdlib.h>

__attribute__((noinline))
static int read_oob(int *arr, volatile int idx) {
    return arr[idx];
}

int main(void) {
    int *arr = (int *)malloc(4 * sizeof(int));
    if (!arr)
        return 2;
    for (int i = 0; i < 4; ++i)
        arr[i] = i + 1;
    volatile int idx = 10;
    int val = read_oob(arr, idx);
    printf("UNEXPECTED_OOB_SURVIVED=%d\n", val);
    return 0;
}
EOF

cat > "$TEST_DIR/trap_uaf.c" <<'EOF'
#include <stdio.h>
#include <stdlib.h>

__attribute__((noinline))
static int read_after_free(int *p) {
    return *p;
}

int main(void) {
    int *p = (int *)malloc(sizeof(int));
    if (!p)
        return 2;
    *p = 42;
    free(p);
    int val = read_after_free(p);
    printf("UNEXPECTED_UAF_SURVIVED=%d\n", val);
    return 0;
}
EOF

cat > "$TEST_DIR/hello_cxx.cpp" <<'EOF'
#include <iostream>
#include <stdexcept>
#include <string>
#include <vector>

__attribute__((noinline))
static void maybe_throw(bool doit) {
    if (doit)
        throw std::runtime_error("filc-libcxx-exception-ok");
}

int main() {
    std::vector<std::string> items = {"Fil-C", "libc++", "LLVM-23"};
    std::string joined;
    for (size_t i = 0; i < items.size(); ++i) {
        if (i > 0)
            joined += " + ";
        joined += items[i];
    }
    std::string caught;
    try {
        maybe_throw(true);
    } catch (const std::exception &e) {
        caught = e.what();
    }
    std::cout << "CXX_OK: " << joined << " | catch=" << caught << "\n";
    return 0;
}
EOF

cat > "$TEST_DIR/vertest.c" <<'EOF'
int vertest_secret(int x) {
    return x * 2;
}

int vertest_add(int a, int b) {
    return vertest_secret(a) + b;
}
EOF

cat > "$TEST_DIR/vertest.map" <<'EOF'
VERTEST_1.0 {
  global:
    vertest_add;
  local:
    *;
};
EOF

cat > "$TEST_DIR/vertest_main.c" <<'EOF'
#include <stdio.h>

extern int vertest_add(int a, int b);

int main(void) {
    int r = vertest_add(10, 22);
    printf("VERTEST_OK: %d\n", r);
    return r == 42 ? 0 : 1;
}
EOF

cat > "$TEST_DIR/indirectbr_test.c" <<'EOF'
#include <stdio.h>

__attribute__((noinline))
static int run_vm(const unsigned char *code, int x) {
    static const void *const disptab[3] = { &&op_add, &&op_sub, &&op_ret };
    const unsigned char *pc = code;
    goto *disptab[*pc++];
op_add:
    x += 3;
    goto *disptab[*pc++];
op_sub:
    x -= 1;
    goto *disptab[*pc++];
op_ret:
    return x;
}

int main(void) {
    static const unsigned char prog1[] = { 0, 0, 1, 0, 2 };
    static const unsigned char prog2[] = { 1, 1, 0, 1, 2 };
    int r1 = run_vm(prog1, 10);
    int r2 = run_vm(prog2, 20);
    printf("INDIRECTBR_OK: %d %d\n", r1, r2);
    return (r1 == 18 && r2 == 20) ? 0 : 1;
}
EOF

# ---------------------------------------------------------------------------
# Compile & link all test binaries
# ---------------------------------------------------------------------------
echo "=== Compiling end-to-end test binaries ==="
T_TESTS_START="$(date +%s)"
echo "FILC_PHASE tests running"
"$CLANG" -O2 -Wall -Wextra -Werror "$TEST_DIR/hello_world.c" -o "$TEST_DIR/hello_world"
"$CLANG" -O2 -g "$TEST_DIR/trap_oob.c" -o "$TEST_DIR/trap_oob"
"$CLANG" -O2 -g "$TEST_DIR/trap_uaf.c" -o "$TEST_DIR/trap_uaf"
"$CLANGXX" -O2 -std=c++20 -Wall -Wextra -Werror "$TEST_DIR/hello_cxx.cpp" -o "$TEST_DIR/hello_cxx"
"$CLANG" -O2 -fPIC -shared "$TEST_DIR/vertest.c" \
  -Wl,--version-script="$TEST_DIR/vertest.map" \
  -o "$TEST_DIR/libvertest_eq.so"
"$CLANG" -O2 -fPIC -shared "$TEST_DIR/vertest.c" \
  -Wl,--version-script,"$TEST_DIR/vertest.map" \
  -o "$TEST_DIR/libvertest_comma.so"
"$CLANG" -O2 "$TEST_DIR/vertest_main.c" -L"$TEST_DIR" -Wl,-rpath,"$TEST_DIR" \
  -lvertest_eq -o "$TEST_DIR/vertest_eq"
"$CLANG" -O2 "$TEST_DIR/vertest_main.c" -L"$TEST_DIR" -Wl,-rpath,"$TEST_DIR" \
  -lvertest_comma -o "$TEST_DIR/vertest_comma"
"$CLANG" -O2 -Wa,--noexecstack -Wa,--noexecstack,--compress-debug-sections=zlib \
  "$TEST_DIR/hello_world.c" -o "$TEST_DIR/hello_wa"
printf '/* empty asm for -Wa driver check */\n' > "$TEST_DIR/wa_test.S"
"$CLANG" -O0 -Wall -Wextra -Werror "$TEST_DIR/indirectbr_test.c" -o "$TEST_DIR/indirectbr_o0"
"$CLANG" -O2 -Wall -Wextra -Werror "$TEST_DIR/indirectbr_test.c" -o "$TEST_DIR/indirectbr_o2"

# ---------------------------------------------------------------------------
# Execute tests and verify expectations
# ---------------------------------------------------------------------------
FAILURES=0

run_and_capture() {
  local name="$1"
  local bin="$2"
  local rc=0
  set +e
  "$bin" >"$TEST_DIR/${name}.stdout" 2>"$TEST_DIR/${name}.stderr"
  rc=$?
  set -e
  echo "$rc" >"$TEST_DIR/${name}.rc"
}

echo "=== Running (a) Hello World ==="
T_T1="$(date +%s)"
echo "FILC_PHASE test-hello running"
run_and_capture hello_world "$TEST_DIR/hello_world"
RC_HELLO="$(cat "$TEST_DIR/hello_world.rc")"
if [[ "$RC_HELLO" -eq 0 ]] && grep -Fxq "Hello from Fil-C!" "$TEST_DIR/hello_world.stdout"; then
  STATUS_HELLO="PASS"
  echo "FILC_PHASE test-hello success $(( $(date +%s) - T_T1 ))"
else
  STATUS_HELLO="FAIL"
  FAILURES=$((FAILURES + 1))
  echo "FILC_PHASE test-hello failure $(( $(date +%s) - T_T1 ))"
fi

echo "=== Running (b1) Memory-Safety Trap: Out-of-Bounds ==="
T_T2="$(date +%s)"
echo "FILC_PHASE test-oob running"
run_and_capture trap_oob "$TEST_DIR/trap_oob"
RC_OOB="$(cat "$TEST_DIR/trap_oob.rc")"
if [[ "$RC_OOB" -ne 0 ]] \
  && ! grep -q "UNEXPECTED_OOB_SURVIVED" "$TEST_DIR/trap_oob.stdout" \
  && grep -qi "filc safety error" "$TEST_DIR/trap_oob.stderr"; then
  STATUS_OOB="PASS"
  echo "FILC_PHASE test-oob success $(( $(date +%s) - T_T2 ))"
else
  STATUS_OOB="FAIL"
  FAILURES=$((FAILURES + 1))
  echo "FILC_PHASE test-oob failure $(( $(date +%s) - T_T2 ))"
fi

echo "=== Running (b2) Memory-Safety Trap: Use-After-Free ==="
T_T3="$(date +%s)"
echo "FILC_PHASE test-uaf running"
run_and_capture trap_uaf "$TEST_DIR/trap_uaf"
RC_UAF="$(cat "$TEST_DIR/trap_uaf.rc")"
if [[ "$RC_UAF" -ne 0 ]] \
  && ! grep -q "UNEXPECTED_UAF_SURVIVED" "$TEST_DIR/trap_uaf.stdout" \
  && grep -qi "filc safety error" "$TEST_DIR/trap_uaf.stderr"; then
  STATUS_UAF="PASS"
  echo "FILC_PHASE test-uaf success $(( $(date +%s) - T_T3 ))"
else
  STATUS_UAF="FAIL"
  FAILURES=$((FAILURES + 1))
  echo "FILC_PHASE test-uaf failure $(( $(date +%s) - T_T3 ))"
fi

echo "=== Running (c) C++ with libc++ ==="
T_T4="$(date +%s)"
echo "FILC_PHASE test-cxx running"
run_and_capture hello_cxx "$TEST_DIR/hello_cxx"
RC_CXX="$(cat "$TEST_DIR/hello_cxx.rc")"
EXPECTED_CXX="CXX_OK: Fil-C + libc++ + LLVM-23 | catch=filc-libcxx-exception-ok"
if [[ "$RC_CXX" -eq 0 ]] && grep -Fxq "$EXPECTED_CXX" "$TEST_DIR/hello_cxx.stdout"; then
  STATUS_CXX="PASS"
  echo "FILC_PHASE test-cxx success $(( $(date +%s) - T_T4 ))"
else
  STATUS_CXX="FAIL"
  FAILURES=$((FAILURES + 1))
  echo "FILC_PHASE test-cxx failure $(( $(date +%s) - T_T4 ))"
fi

echo "=== Running (d) Shared Library -Wl,--version-script Regression ==="
run_and_capture vertest_eq "$TEST_DIR/vertest_eq"
run_and_capture vertest_comma "$TEST_DIR/vertest_comma"
RC_VER_EQ="$(cat "$TEST_DIR/vertest_eq.rc")"
RC_VER_COMMA="$(cat "$TEST_DIR/vertest_comma.rc")"
NM_OK=1
: > "$TEST_DIR/vertest.nm"
if command -v nm >/dev/null 2>&1; then
  for so in "$TEST_DIR/libvertest_eq.so" "$TEST_DIR/libvertest_comma.so"; do
    echo "=== nm -D --defined-only $(basename "$so") ===" >> "$TEST_DIR/vertest.nm"
    nm -D --defined-only "$so" >> "$TEST_DIR/vertest.nm" 2>&1 || true
    if ! nm -D --defined-only "$so" | grep -Eq ' [A-Za-z] pizlonated_vertest_add@@VERTEST_1\.0$'; then
      echo "error: expected versioned export pizlonated_vertest_add@@VERTEST_1.0 in $so" >&2
      nm -D --defined-only "$so" >&2 || true
      NM_OK=0
    fi
    if nm -D --defined-only "$so" | grep -q 'vertest_secret'; then
      echo "error: expected vertest_secret to stay local in $so" >&2
      nm -D --defined-only "$so" >&2 || true
      NM_OK=0
    fi
  done
fi
if [[ "$RC_VER_EQ" -eq 0 && "$RC_VER_COMMA" -eq 0 && "$NM_OK" -eq 1 ]] \
  && grep -Fxq "VERTEST_OK: 42" "$TEST_DIR/vertest_eq.stdout" \
  && grep -Fxq "VERTEST_OK: 42" "$TEST_DIR/vertest_comma.stdout"; then
  STATUS_VERSCRIPT="PASS"
else
  STATUS_VERSCRIPT="FAIL"
  FAILURES=$((FAILURES + 1))
fi

echo "=== Running (e) Safe -Wa Assembler Flag Regression ==="
run_and_capture hello_wa "$TEST_DIR/hello_wa"
RC_WA_C="$(cat "$TEST_DIR/hello_wa.rc")"
WA_OK=1
if [[ "$RC_WA_C" -ne 0 ]] || ! grep -Fxq "Hello from Fil-C!" "$TEST_DIR/hello_wa.stdout"; then
  echo "error: hello_wa binary failed under -Wa,--noexecstack" >&2
  WA_OK=0
fi

set +e
"$CLANG" -c \
  -Wa,--noexecstack \
  -Wa,--noexecstack,--compress-debug-sections=zlib \
  -Wa,--generate-missing-build-notes=yes,-mrelax-relocations=no \
  -Xassembler --noexecstack \
  "$TEST_DIR/wa_test.S" -o "$TEST_DIR/wa_ok.o" \
  >"$TEST_DIR/wa_safe.stdout" 2>"$TEST_DIR/wa_safe.stderr"
set -e
if grep -q "is not supported by the sarcasm assembler" "$TEST_DIR/wa_safe.stderr"; then
  echo "error: safe -Wa flags were rejected by SarcasmAs" >&2
  cat "$TEST_DIR/wa_safe.stderr" >&2
  WA_OK=0
fi

for bad_case in "execstack:-Wa,--execstack" "mixed:-Wa,--noexecstack,--execstack" "xasm:-Xassembler:--execstack"; do
  case_id="${bad_case%%:*}"
  case_rest="${bad_case#*:}"
  set +e
  if [[ "$case_id" == "xasm" ]]; then
    "$CLANG" -c -Xassembler --execstack "$TEST_DIR/wa_test.S" -o "$TEST_DIR/wa_${case_id}.o" \
      >"$TEST_DIR/wa_${case_id}.stdout" 2>"$TEST_DIR/wa_${case_id}.stderr"
    bad_rc=$?
  else
    "$CLANG" -c "$case_rest" "$TEST_DIR/wa_test.S" -o "$TEST_DIR/wa_${case_id}.o" \
      >"$TEST_DIR/wa_${case_id}.stdout" 2>"$TEST_DIR/wa_${case_id}.stderr"
    bad_rc=$?
  fi
  set -e
  if [[ "$bad_rc" -eq 0 ]] || ! grep -q "is not supported by the sarcasm assembler" "$TEST_DIR/wa_${case_id}.stderr"; then
    echo "error: unsafe assembler flag case '$case_id' was not rejected by SarcasmAs (rc=$bad_rc)" >&2
    cat "$TEST_DIR/wa_${case_id}.stderr" >&2
    WA_OK=0
  fi
done

if [[ "$WA_OK" -eq 1 ]]; then
  STATUS_WAFLAGS="PASS"
else
  STATUS_WAFLAGS="FAIL"
  FAILURES=$((FAILURES + 1))
fi

echo "=== Running (f) Computed-Goto (indirectbr / BlockAddress) Regression ==="
run_and_capture indirectbr_o0 "$TEST_DIR/indirectbr_o0"
run_and_capture indirectbr_o2 "$TEST_DIR/indirectbr_o2"
RC_IBR_O0="$(cat "$TEST_DIR/indirectbr_o0.rc")"
RC_IBR_O2="$(cat "$TEST_DIR/indirectbr_o2.rc")"
if [[ "$RC_IBR_O0" -eq 0 && "$RC_IBR_O2" -eq 0 ]] \
  && grep -Fxq "INDIRECTBR_OK: 18 20" "$TEST_DIR/indirectbr_o0.stdout" \
  && grep -Fxq "INDIRECTBR_OK: 18 20" "$TEST_DIR/indirectbr_o2.stdout"; then
  STATUS_INDIRECTBR="PASS"
else
  STATUS_INDIRECTBR="FAIL"
  FAILURES=$((FAILURES + 1))
fi

echo "=== Running (g) Clean Compile-Time Rejection of Unsupported Constructs ==="
cat > "$TEST_DIR/reject_builtin_setjmp.c" <<'EOF'
void *buf[5];
int f(void) { return __builtin_setjmp(buf); }
EOF

cat > "$TEST_DIR/reject_builtin_longjmp.c" <<'EOF'
void *buf[5];
void f(void) { __builtin_longjmp(buf, 1); }
EOF

cat > "$TEST_DIR/reject_define_setjmp.c" <<'EOF'
int setjmp(void *env) { (void)env; return 0; }
EOF

cat > "$TEST_DIR/reject_addrspace.c" <<'EOF'
int f(int __attribute__((address_space(256))) *p) { return *p; }
EOF

cat > "$TEST_DIR/reject_module_asm.c" <<'EOF'
__asm__(".filc_invalid_directive_xyz");
int f(void) { return 0; }
EOF

cat > "$TEST_DIR/trap_asm_goto.c" <<'EOF'
#include <stdio.h>

__attribute__((noinline))
static int do_asm_goto(int x) {
    asm goto("nop" : : "r"(x) : : target1, target2);
    return x + 1;
target1:
    return x + 2;
target2:
    return x + 3;
}

int main(void) {
    volatile int x = 7;
    int r = do_asm_goto(x);
    printf("UNEXPECTED_ASM_GOTO_SURVIVED=%d\n", r);
    return 0;
}
EOF

REJECT_OK=1
check_compile_reject() {
  local case_id="$1"
  local src="$2"
  local expected="$3"
  local rc=0
  set +e
  "$CLANG" -O2 -c "$src" -o "$TEST_DIR/${case_id}.o" \
    >"$TEST_DIR/${case_id}.stdout" 2>"$TEST_DIR/${case_id}.stderr"
  rc=$?
  set -e
  echo "$rc" >"$TEST_DIR/${case_id}.rc"
  if [[ "$rc" -eq 0 || "$rc" -ge 128 ]]; then
    echo "error: reject case '$case_id' unexpected exit code rc=$rc (expected clean non-signal compile error)" >&2
    cat "$TEST_DIR/${case_id}.stderr" >&2
    REJECT_OK=0
    return
  fi
  if ! grep -Fq "$expected" "$TEST_DIR/${case_id}.stderr"; then
    echo "error: reject case '$case_id' missing expected diagnostic '$expected'" >&2
    cat "$TEST_DIR/${case_id}.stderr" >&2
    REJECT_OK=0
    return
  fi
  if grep -Eq "PLEASE submit a bug report|UNREACHABLE executed|Stack dump:" "$TEST_DIR/${case_id}.stderr"; then
    echo "error: reject case '$case_id' crashed compiler instead of emitting clean error" >&2
    cat "$TEST_DIR/${case_id}.stderr" >&2
    REJECT_OK=0
  fi
}

check_compile_reject reject_builtin_setjmp "$TEST_DIR/reject_builtin_setjmp.c" "__builtin_setjmp is not supported for this target"
check_compile_reject reject_builtin_longjmp "$TEST_DIR/reject_builtin_longjmp.c" "__builtin_longjmp is not supported for this target"
check_compile_reject reject_define_setjmp "$TEST_DIR/reject_define_setjmp.c" "Fil-C: cannot define reserved pass-through function 'setjmp'"
check_compile_reject reject_addrspace "$TEST_DIR/reject_addrspace.c" "Fil-C does not support non-zero pointer address spaces"
check_compile_reject reject_module_asm "$TEST_DIR/reject_module_asm.c" "Fil-C: unsupported or invalid module-level inline assembly"

# Verify asm goto (CallBrInst) lowers to a memory-safe Fil-C runtime panic (FilPizlonator intentional inline-asm policy)
"$CLANG" -O2 "$TEST_DIR/trap_asm_goto.c" -o "$TEST_DIR/trap_asm_goto"
run_and_capture trap_asm_goto "$TEST_DIR/trap_asm_goto"
RC_ASM_GOTO="$(cat "$TEST_DIR/trap_asm_goto.rc")"
if [[ "$RC_ASM_GOTO" -eq 0 ]] \
  || grep -q "UNEXPECTED_ASM_GOTO_SURVIVED" "$TEST_DIR/trap_asm_goto.stdout" \
  || ! grep -Fq "asm goto is not supported" "$TEST_DIR/trap_asm_goto.stderr"; then
  echo "error: trap_asm_goto did not safely panic at runtime (rc=$RC_ASM_GOTO)" >&2
  cat "$TEST_DIR/trap_asm_goto.stderr" >&2
  REJECT_OK=0
fi

if [[ "$REJECT_OK" -eq 1 ]]; then
  STATUS_REJECT="PASS"
else
  STATUS_REJECT="FAIL"
  FAILURES=$((FAILURES + 1))
fi

OVERALL_STATUS="PASS"
if (( FAILURES > 0 )); then
  OVERALL_STATUS="FAIL"
  echo "FILC_PHASE tests failure $(( $(date +%s) - T_TESTS_START ))"
else
  echo "FILC_PHASE tests success $(( $(date +%s) - T_TESTS_START ))"
fi

# ---------------------------------------------------------------------------
# Generate structured evidence report (Beleg)
# ---------------------------------------------------------------------------
TIMESTAMP_UTC="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
REPO_COMMIT="$(git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null || echo unknown)"
ARCH="$(uname -m)"

{
  echo "================================================================================"
  echo "FIL-C TOOLCHAIN END-TO-END VERIFICATION REPORT (BELEG)"
  echo "================================================================================"
  echo "TIMESTAMP_UTC:        $TIMESTAMP_UTC"
  echo "HOST_UNAME:           $(uname -srm)"
  echo "REPO_COMMIT:          $REPO_COMMIT"
  echo "LLVM_TAG:             ${LLVM_TAG:-none}"
  echo "LLVM_COMMIT:          $LLVM_COMMIT"
  echo "FILC_COMMIT:          $FILC_COMMIT"
  echo "MUSL_COMMIT:          $MUSL_COMMIT"
  echo "CLANG_VERSION:        $("$CLANG" --version | head -n 1)"
  echo "LLD_VERSION:          $("$LLD" --version | head -n 1)"
  echo "OVERALL_STATUS:       $OVERALL_STATUS"
  echo ""
  echo "--- TOOLCHAIN LIBRARY SHA-256 ---"
  for lib in \
    "$PIZFIX/lib/libyoloc.so" \
    "$PIZFIX/lib/libpizlo.so" \
    "$PIZFIX/lib/libc.so" \
    "$PIZFIX/lib/libc++.so.1.0" \
    "$PIZFIX/lib/libc++abi.so.1.0"; do
    echo "  $(sha256_file "$lib")  $(basename "$lib")"
  done
  echo ""
  echo "--- TEST BINARY SHA-256 ---"
  for bin in hello_world trap_oob trap_uaf hello_cxx; do
    echo "  $(sha256_file "$TEST_DIR/$bin")  $bin ($(wc -c < "$TEST_DIR/$bin" | tr -d ' ') bytes)"
  done
  echo ""
  echo "--- TEST (a) HELLO WORLD [$STATUS_HELLO] ---"
  echo "EXIT_CODE: $RC_HELLO"
  echo "STDOUT:"
  sed 's/^/  | /' "$TEST_DIR/hello_world.stdout"
  if [[ -s "$TEST_DIR/hello_world.stderr" ]]; then
    echo "STDERR:"
    sed 's/^/  | /' "$TEST_DIR/hello_world.stderr"
  fi
  echo ""
  echo "--- TEST (b1) MEMORY-SAFETY TRAP: OUT-OF-BOUNDS [$STATUS_OOB] ---"
  echo "EXIT_CODE: $RC_OOB"
  if [[ -s "$TEST_DIR/trap_oob.stdout" ]]; then
    echo "STDOUT:"
    sed 's/^/  | /' "$TEST_DIR/trap_oob.stdout"
  fi
  echo "STDERR:"
  sed 's/^/  | /' "$TEST_DIR/trap_oob.stderr"
  echo ""
  echo "--- TEST (b2) MEMORY-SAFETY TRAP: USE-AFTER-FREE [$STATUS_UAF] ---"
  echo "EXIT_CODE: $RC_UAF"
  if [[ -s "$TEST_DIR/trap_uaf.stdout" ]]; then
    echo "STDOUT:"
    sed 's/^/  | /' "$TEST_DIR/trap_uaf.stdout"
  fi
  echo "STDERR:"
  sed 's/^/  | /' "$TEST_DIR/trap_uaf.stderr"
  echo ""
  echo "--- TEST (c) C++ WITH LIBC++ [$STATUS_CXX] ---"
  echo "EXIT_CODE: $RC_CXX"
  echo "STDOUT:"
  sed 's/^/  | /' "$TEST_DIR/hello_cxx.stdout"
  if [[ -s "$TEST_DIR/hello_cxx.stderr" ]]; then
    echo "STDERR:"
    sed 's/^/  | /' "$TEST_DIR/hello_cxx.stderr"
  fi
  echo ""
  echo "--- TEST (d) SHARED LIB -Wl,--version-script [$STATUS_VERSCRIPT] ---"
  echo "EXIT_CODE_EQ: $RC_VER_EQ  EXIT_CODE_COMMA: $RC_VER_COMMA  NM_OK: $NM_OK"
  echo "STDOUT:"
  sed 's/^/  | /' "$TEST_DIR/vertest_eq.stdout"
  if [[ -s "$TEST_DIR/vertest.nm" ]]; then
    echo "EXPORTS:"
    sed 's/^/  | /' "$TEST_DIR/vertest.nm"
  fi
  echo ""
  echo "--- TEST (e) SAFE -Wa ASSEMBLER FLAGS [$STATUS_WAFLAGS] ---"
  echo "EXIT_CODE_WA_C: $RC_WA_C  WA_OK: $WA_OK"
  echo ""
  echo "--- TEST (f) COMPUTED-GOTO INDIRECTBR [$STATUS_INDIRECTBR] ---"
  echo "EXIT_CODE_O0: $RC_IBR_O0  EXIT_CODE_O2: $RC_IBR_O2"
  echo "STDOUT_O0:"
  sed 's/^/  | /' "$TEST_DIR/indirectbr_o0.stdout"
  echo "STDOUT_O2:"
  sed 's/^/  | /' "$TEST_DIR/indirectbr_o2.stdout"
  echo ""
  echo "--- TEST (g) COMPILE-TIME REJECTION OF UNSUPPORTED CONSTRUCTS [$STATUS_REJECT] ---"
  echo "REJECT_OK: $REJECT_OK (builtin_setjmp=$(cat "$TEST_DIR/reject_builtin_setjmp.rc"), builtin_longjmp=$(cat "$TEST_DIR/reject_builtin_longjmp.rc"), define_setjmp=$(cat "$TEST_DIR/reject_define_setjmp.rc"), addrspace=$(cat "$TEST_DIR/reject_addrspace.rc"), module_asm=$(cat "$TEST_DIR/reject_module_asm.rc"), trap_asm_goto=$RC_ASM_GOTO)"
  echo "================================================================================"
} > "$REPORT_FILE"

REPORT_SHA256="$(sha256_file "$REPORT_FILE")"
echo "REPORT_SHA256:        $REPORT_SHA256" >> "$REPORT_FILE"

if [[ -n "${FILC_REPORT_ARCHIVE_DIR:-}" ]]; then
  mkdir -p "$FILC_REPORT_ARCHIVE_DIR"
  ARCHIVE_NAME="toolchain-${TIMESTAMP_UTC//[:]/}-${REPO_COMMIT:0:8}-${OVERALL_STATUS}.txt"
  cp "$REPORT_FILE" "$FILC_REPORT_ARCHIVE_DIR/$ARCHIVE_NAME"
  echo "Archived report to $FILC_REPORT_ARCHIVE_DIR/$ARCHIVE_NAME"
fi

cat "$REPORT_FILE"

if (( FAILURES > 0 )); then
  echo "error: $FAILURES end-to-end toolchain test(s) failed" >&2
  exit 1
fi

echo "=== ALL END-TO-END TOOLCHAIN TESTS PASSED ==="
