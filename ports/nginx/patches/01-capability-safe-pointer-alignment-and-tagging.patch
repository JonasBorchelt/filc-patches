+++ b/src/core/ngx_config.h
@@ -99,7 +99,8 @@
 
 #define ngx_align(d, a)     (((d) + (a - 1)) & ~(a - 1))
 #define ngx_align_ptr(p, a)                                                   \
-    (u_char *) (((uintptr_t) (p) + ((uintptr_t) a - 1)) & ~((uintptr_t) a - 1))
+    ((u_char *) (p) + ((((uintptr_t) (p) + ((uintptr_t) (a) - 1))            \
+                        & ~((uintptr_t) (a) - 1)) - (uintptr_t) (p)))
 
 
