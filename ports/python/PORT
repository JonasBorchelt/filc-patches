port_configure() {
  PATH="$PIZFIX/bin:$PATH" \
    CPPFLAGS="-I$PIZFIX/include -I$PIZFIX/include/ncursesw" \
    LDFLAGS="-L$PIZFIX/lib" \
    PKG_CONFIG_PATH="$PIZFIX/lib/pkgconfig" \
    ac_cv_gcc_asm_for_x64=no \
    ac_cv_gcc_asm_for_x87=no \
    ac_cv_gcc_asm_for_mc68881=no \
    ./configure --prefix="$PIZFIX" \
      --with-openssl="$PIZFIX" \
      --with-system-expat \
      --without-pymalloc \
      --without-freelists \
      --disable-test-modules
}

port_test() {
  local out ver
  out="$("$PIZFIX/bin/python3" --version)"
  ver="${out%%$'\n'*}"
  echo "python3 version: $ver"
  printf '%s\n' "$ver" | grep -Fxq 'Python 3.12.5'
  "$PIZFIX/bin/python3" - <<'EOF' | grep -Fxq 'PYTHON_FILC_OK'
import bz2, ctypes, gc, hashlib, json, lzma, re, sqlite3, ssl, xml.etree.ElementTree as ET, zlib

assert hashlib.sha256(b"hello\n").hexdigest() == "5891b5b522d5df086d0ff0b110fbd9d21bb4fc7163af34d08286a2e846f6be03"
assert zlib.decompress(zlib.compress(b"filc-zlib")) == b"filc-zlib"
assert bz2.decompress(bz2.compress(b"filc-bz2")) == b"filc-bz2"
assert lzma.decompress(lzma.compress(b"filc-xz")) == b"filc-xz"
assert ET.fromstring("<root><x>42</x></root>").find("x").text == "42"
assert re.match(r"([a-z]+)-(\d+)", "filc-312").groups() == ("filc", "312")
assert json.loads(json.dumps({"ok": [1, 2, 3]}))["ok"] == [1, 2, 3]

conn = sqlite3.connect(":memory:")
conn.execute("CREATE TABLE t (v INT)")
conn.execute("INSERT INTO t VALUES (42)")
assert conn.execute("SELECT v FROM t").fetchone() == (42,)
conn.close()

assert hasattr(ssl, "OPENSSL_VERSION")
c_int = ctypes.c_int(42)
assert c_int.value == 42

gc.collect()
print("PYTHON_FILC_OK")
EOF
}
