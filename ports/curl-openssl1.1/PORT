port_configure() {
  # CVE-2022-32207.patch adds lib/fopen.c to lib/Makefile.inc and fchmod to
  # configure.ac. Mirror fopen.c into the pre-generated lib/Makefile.in and
  # pass -DHAVE_FCHMOD=1 so we build cleanly without requiring autoreconf.
  "${HOST_RUBY:-ruby}" -e '
    p = "lib/Makefile.in"
    s = File.binread(p)
    rep = lambda do |pat, repl, label|
      n = s.scan(pat).length
      raise "expected 1 match for #{label}, got #{n}" unless n == 1
      s = s.sub(pat, repl)
    end
    rep.call(/libcurl_la-file\.lo libcurl_la-fileinfo\.lo \\/,
             "libcurl_la-file.lo libcurl_la-fileinfo.lo libcurl_la-fopen.lo \\\\",
             "libcurl_la objects")
    rep.call(/libcurlu_la-fileinfo\.lo libcurlu_la-formdata\.lo \\/,
             "libcurlu_la-fileinfo.lo libcurlu_la-fopen.lo libcurlu_la-formdata.lo \\\\",
             "libcurlu_la objects")
    rep.call(%r{\./\$\(DEPDIR\)/libcurl_la-fileinfo\.Plo \\},
             "./$(DEPDIR)/libcurl_la-fileinfo.Plo \\\n\t./$(DEPDIR)/libcurl_la-fopen.Plo \\",
             "libcurl_la depfiles")
    rep.call(%r{\./\$\(DEPDIR\)/libcurlu_la-fileinfo\.Plo \\},
             "./$(DEPDIR)/libcurlu_la-fileinfo.Plo \\\n\t./$(DEPDIR)/libcurlu_la-fopen.Plo \\",
             "libcurlu_la depfiles")
    rep.call(/  file\.c fileinfo\.c formdata\.c /,
             "  file.c fileinfo.c fopen.c formdata.c ",
             "LIB_CFILES")
    rep.call(/  dotdot\.h easyif\.h escape\.h file\.h fileinfo\.h formdata\.h /,
             "  dotdot.h easyif.h escape.h file.h fileinfo.h fopen.h formdata.h ",
             "LIB_HFILES")
    rep.call(%r{^@AMDEP_TRUE@@am__include@ @am__quote@\./\$\(DEPDIR\)/libcurl_la-fileinfo\.Plo@am__quote@ # am--include-marker$},
             "\\0\n@AMDEP_TRUE@@am__include@ @am__quote@./$(DEPDIR)/libcurl_la-fopen.Plo@am__quote@ # am--include-marker",
             "libcurl_la am__include")
    rep.call(%r{^@AMDEP_TRUE@@am__include@ @am__quote@\./\$\(DEPDIR\)/libcurlu_la-fileinfo\.Plo@am__quote@ # am--include-marker$},
             "\\0\n@AMDEP_TRUE@@am__include@ @am__quote@./$(DEPDIR)/libcurlu_la-fopen.Plo@am__quote@ # am--include-marker",
             "libcurlu_la am__include")
    %w[libcurl_la libcurlu_la].each do |tgt|
      rule_re = /^#{tgt}-fileinfo\.lo: fileinfo\.c\n(?:.+\n){5}/
      m = s.match(rule_re)
      raise "compile rule for #{tgt}-fileinfo.lo not found" unless m
      fopen_rule = m[0].gsub("fileinfo", "fopen")
      s = s.sub(rule_re, "#{m[0]}\n#{fopen_rule}")
    end
    File.binwrite(p, s)
  '
  touch aclocal.m4 configure lib/curl_config.h.in Makefile.in lib/Makefile.in src/Makefile.in
  for mf in tests/Makefile.in tests/data/Makefile.in tests/unit/Makefile.in; do
    test -f "$mf" && touch "$mf"
  done

  CPPFLAGS="-DHAVE_FCHMOD=1 -I$PIZFIX/opt/openssl1.1/include -I$PIZFIX/include" \
    LDFLAGS="-L$PIZFIX/opt/openssl1.1/lib -L$PIZFIX/lib -Wl,-rpath,$PIZFIX/lib" \
