        "python-1.0/Lib/ipaddress.py" => "'#{ip4(192, 168, 0, 0)}/16' '#{ip4(10, 0, 0, 0)}/8' '#{ip4(172, 16, 0, 0)}/12'\n",
        "python-1.0/Lib/random.py" => "ref=#{ip4(10, 1, 1, 47)}.1\n",
        "python-1.0/Lib/urllib/request.py" => "proxy #{ip4(192, 168, 0, 1)}\"\n",
