Subject: Expose full fenv operations and isolate full x87/SSE and AArch64 float state in libpas
Policy-Class: P1-Toolchain
Rationale: Fil-C's usermusl flavor deletes musl's architecture-specific fenv assembly files and falls back to musl's generic no-op fenv.c stubs, even though libpizlo is compiled against yolomusl (which implements full hardware fenv). Expose zmath_feraiseexcept, zmath_fegetround, zmath_fesetround, zmath_fegetenv, and zmath_fesetenv alongside the existing zmath_feclearexcept/zmath_fetestexcept natives with capability bounds checks on fenv_t and FE_DFL_ENV handling, and extend pas_save_float_environment / pas_set_float_environment_to_libpas_default / pas_restore_float_environment to save, canonicalize, and restore full x87+MXCSR (x86_64) and FPCR/FPSR (AArch64) state with memory clobbers. Upstream PR #375 (pizlonator/fil-c).
Upstream-Status: Upstream-Candidate (Fil-C PR #375)
Fil-C-Origin-Commits: none

diff --git a/filc/include/pizlonated_math.h b/filc/include/pizlonated_math.h
index 4d478bb305..c46942d0cd 100644
--- a/filc/include/pizlonated_math.h
+++ b/filc/include/pizlonated_math.h
@@ -74,6 +74,11 @@ void zmath_setfpsr(unsigned fpsr);
 void zmath_feclearexcept(int excepts);
 int zmath_feenableexcept(int excepts);
 int zmath_fetestexcept(int excepts);
+int zmath_feraiseexcept(int excepts);
+int zmath_fegetround(void);
+int zmath_fesetround(int round);
+int zmath_fegetenv(void* envp);
+int zmath_fesetenv(const void* envp);
 
 #ifdef __cplusplus
 }
diff --git a/libpas/src/libpas/filc_runtime.c b/libpas/src/libpas/filc_runtime.c
index bf0876ad38..28cbfb9bab 100644
--- a/libpas/src/libpas/filc_runtime.c
+++ b/libpas/src/libpas/filc_runtime.c
@@ -16058,6 +16058,40 @@ int filc_native_zmath_fetestexcept(filc_thread* my_thread, int excepts)
     return fetestexcept(excepts);
 }
 
+int filc_native_zmath_feraiseexcept(filc_thread* my_thread, int excepts)
+{
+    PAS_UNUSED_PARAM(my_thread);
+    return feraiseexcept(excepts);
+}
+
+int filc_native_zmath_fegetround(filc_thread* my_thread)
+{
+    PAS_UNUSED_PARAM(my_thread);
+    return fegetround();
+}
+
+int filc_native_zmath_fesetround(filc_thread* my_thread, int round)
+{
+    PAS_UNUSED_PARAM(my_thread);
+    return fesetround(round);
+}
+
+int filc_native_zmath_fegetenv(filc_thread* my_thread, filc_ptr envp_ptr)
+{
+    PAS_UNUSED_PARAM(my_thread);
+    filc_check_write(envp_ptr, sizeof(fenv_t));
+    return fegetenv((fenv_t*)filc_ptr_ptr(envp_ptr));
+}
+
+int filc_native_zmath_fesetenv(filc_thread* my_thread, filc_ptr envp_ptr)
+{
+    PAS_UNUSED_PARAM(my_thread);
+    if (filc_ptr_ptr(envp_ptr) == (const void*)FE_DFL_ENV && !filc_ptr_lower(envp_ptr))
+        return fesetenv(FE_DFL_ENV);
+    filc_check_read(envp_ptr, sizeof(fenv_t));
+    return fesetenv((const fenv_t*)filc_ptr_ptr(envp_ptr));
+}
+
 PAS_END_EXTERN_C;
 
 #endif /* PAS_ENABLE_FILC */
diff --git a/libpas/src/libpas/generate_pizlonated_forwarders.rb b/libpas/src/libpas/generate_pizlonated_forwarders.rb
