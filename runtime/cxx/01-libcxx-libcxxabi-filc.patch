 inline int __wcscoll(const wchar_t* __s1, const wchar_t* __s2, __locale_t __loc) {
+#        if _LIBCPP_HAS_COSMO_LIBC
+  // Cosmo declares wcscoll_l but does not implement it (and does not implement
