Subject: Preserve pointer provenance across tagged pointers and intptr casts under Fil-C
Policy-Class: P2-Package
Rationale: PHP 5.6 stores low-bit tags inside pointers by casting through zend_uintptr_t/size_t and casting the masked integer back to a pointer, which strips Fil-C InvisiCaps provenance and causes deterministic null-object traps. Rewrite all pointer-tagging and integer-roundtrip sites in Zend/zend_gc.h (GC_ADDRESS, GC_SET_ADDRESS, GC_SET_COLOR, GC_SET_BLACK, GC_SET_PURPLE), Zend/zend_execute.c (FREE_OP, TMP_FREE, ENCODE_CTOR, DECODE_CTOR), ext/standard/var_unserializer.c (WITH_WAKEUP_FLAG, WITHOUT_WAKEUP_FLAG), sapi/phpdbg/phpdbg_watch.h (phpdbg_get_page_boundary), and ext/fileinfo/libmagic/{strcasestr.c,compress.c} to use provenance-preserving char* offset arithmetic or direct pointer casts.
Upstream-Status: Inappropriate [PHP 5.6 is EOL; Fil-C InvisiCaps pointer provenance requirement]
Fil-C-Origin-Commits: none
Origin-Kind: original

--- a/Zend/zend_gc.h
+++ b/Zend/zend_gc.h
@@ -47,18 +47,35 @@
 #define GC_GREY   0x02
 #define GC_PURPLE 0x03
 
+struct _gc_root_buffer;
+
+static zend_always_inline struct _gc_root_buffer *zend_gc_address(struct _gc_root_buffer *v)
+{
+	return (struct _gc_root_buffer *)((char *)v - (((zend_uintptr_t)v) & GC_COLOR));
+}
+
+static zend_always_inline struct _gc_root_buffer *zend_gc_set_address(struct _gc_root_buffer *v, struct _gc_root_buffer *a)
+{
+	return (struct _gc_root_buffer *)((char *)a + (((zend_uintptr_t)v) & GC_COLOR));
+}
+
+static zend_always_inline struct _gc_root_buffer *zend_gc_set_color(struct _gc_root_buffer *v, zend_uintptr_t c)
+{
+	return (struct _gc_root_buffer *)((char *)v - (((zend_uintptr_t)v) & GC_COLOR) + (c & GC_COLOR));
+}
+
 #define GC_ADDRESS(v) \
-	((gc_root_buffer*)(((zend_uintptr_t)(v)) & ~GC_COLOR))
+	zend_gc_address(v)
 #define GC_SET_ADDRESS(v, a) \
-	(v) = ((gc_root_buffer*)((((zend_uintptr_t)(v)) & GC_COLOR) | ((zend_uintptr_t)(a))))
+	(v) = zend_gc_set_address((v), (a))
 #define GC_GET_COLOR(v) \
 	(((zend_uintptr_t)(v)) & GC_COLOR)
 #define GC_SET_COLOR(v, c) \
-	(v) = ((gc_root_buffer*)((((zend_uintptr_t)(v)) & ~GC_COLOR) | (c)))
+	(v) = zend_gc_set_color((v), (c))
 #define GC_SET_BLACK(v) \
-	(v) = ((gc_root_buffer*)(((zend_uintptr_t)(v)) & ~GC_COLOR))
+	(v) = zend_gc_address(v)
 #define GC_SET_PURPLE(v) \
-	(v) = ((gc_root_buffer*)(((zend_uintptr_t)(v)) | GC_PURPLE))
+	(v) = zend_gc_set_color((v), GC_PURPLE)
 
 #define GC_ZVAL_INIT(z) \
 	((zval_gc_info*)(z))->u.buffered = NULL
