POLICY_CLASS="P4-Audit"
POLICY_RATIONALE="Pinned to the 3.3 series (latest security release 3.3.14) because Fil-C's GC replacement in gc.c and VALUE capability-tagging patch base target Ruby 3.3's monolithic gc.c/RBasic/vm_insnhelper.h architecture (split and refactored in Ruby 3.4/3.5). Audited down from Fil-C 3.3.10 (139 files, +6821/-4703) and refreshed to 3.3.14 (135 files, +3371/-1258, 59.8% line reduction, 0 fuzz, 0 offset): drops stray configure.txt, auto-generated parse.c/parse.h/ext/ripper/ripper.c (+3445/-3441, regenerated cleanly during build via bundled lrama and host ruby), and obsolete vm_args.c VALUE-index hunk fixed upstream in 3.3.14, while keeping all built ext/-test-/ and spec/ruby/optional/capi/ext/ extensions. Disables YJIT/RJIT, jemalloc, asm coroutines, and unsupported __builtin_setjmp (forcing _setjmp via --with-setjmp-type=_setjmp and ac_cv_func___builtin_setjmp=no) via P3 configure flags. C-API changes under Fil-C: VALUE and st_data_t change from integer types to capability-bearing pointer type rb_value_unit * (st_index_t stays uintptr_t); RBasic.flags, RTypedData.typed_flag, FL_* masks, rb_newobj_of(..., uintptr_t), and rb_obj_setup(..., uintptr_t) use uintptr_t instead of VALUE; RB_ST2FIX takes st_index_t; C++ cxxanyargs rb_ivar_foreach callback changes from st_foreach_callback_func* to int (*)(ID, VALUE, st_data_t); switch/bitwise ops on VALUE/st_data_t in third-party C/C++ extensions require explicit uintptr_t casts."
FILC_ORIGIN_REF="50531d7ebf61:projects/ruby-3.3.10"

port_configure() {
  # Remove pre-generated parser outputs so make regenerates them cleanly from patched parse.y / ripper.y
  rm -f parse.c parse.h ext/ripper/ripper.c
  PATH="$PIZFIX/bin:$PATH" \
    CPPFLAGS="-I$PIZFIX/include -I$PIZFIX/include/ncursesw" \
    LDFLAGS="-L$PIZFIX/lib" \
    PKG_CONFIG_PATH="$PIZFIX/lib/pkgconfig" \
    ac_cv_func___builtin_setjmp=no \
    ./configure --prefix="$PIZFIX" \
      --enable-shared \
      --disable-yjit \
      --disable-rjit \
      --without-jit \
      --without-gcc \
      --without-valgrind \
      --with-thread=pthread \
      --without-jemalloc \
      --with-coroutine=pthread \
      --with-setjmp-type=_setjmp \
      --with-openssl-dir="$PIZFIX" \
      --with-libyaml-dir="$PIZFIX" \
      --with-libffi-dir="$PIZFIX" \
      --with-zlib-dir="$PIZFIX"
}

port_install() {
  # Ruby's RDoc installation requires a valid writable HOME directory
  HOME="${HOME:-/tmp}" make -j"$JOBS" install
}

port_test() {
  local out ver
  out="$("$PIZFIX/bin/ruby" --version)"
  ver="${out%%$'\n'*}"
  echo "ruby version: $ver"
  printf '%s\n' "$ver" | grep -q '^ruby 3\.3\.14 '
  "$PIZFIX/bin/ruby" - <<'EOF' | grep -Fxq 'RUBY_FILC_OK'
require "digest"
require "fiddle"
require "json"
require "openssl"
require "ripper"
require "yaml"
require "zlib"

raise "digest" unless Digest::SHA256.hexdigest("hello\n") == "5891b5b522d5df086d0ff0b110fbd9d21bb4fc7163af34d08286a2e846f6be03"
raise "zlib" unless Zlib::Inflate.inflate(Zlib::Deflate.deflate("filc-ruby")) == "filc-ruby"
raise "json" unless JSON.parse(JSON.generate({"a" => [1, 2, 3]}))["a"] == [1, 2, 3]
raise "yaml" unless YAML.safe_load("k: 42\n")["k"] == 42
raise "openssl" unless OpenSSL::Digest::SHA256.hexdigest("hello\n") == "5891b5b522d5df086d0ff0b110fbd9d21bb4fc7163af34d08286a2e846f6be03"
raise "ripper" unless Ripper.sexp("1 + 2").is_a?(Array)
raise "fiddle" unless Fiddle::SIZEOF_VOIDP == 8

fib = Fiber.new { Fiber.yield(21); 42 }
raise "fiber1" unless fib.resume == 21
raise "fiber2" unless fib.resume == 42

GC.start
puts "RUBY_FILC_OK"
EOF
}
