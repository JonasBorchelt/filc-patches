port_configure() {
  # Bind defined function symbols locally inside shared extensions so Fil-C's
  # pizlonatedFO_get_module -> pizlonatedFIP<sig>_get_module relocation cannot
  # be interposed by an earlier RTLD_GLOBAL extension on musl (no RTLD_DEEPBIND).
  # Pass via EXTRA_LDFLAGS so configure always forwards it to PHP_SHARED_MODULE.
  PATH="$PIZFIX/bin:$PATH" \
    CPPFLAGS="-I$PIZFIX/include -I$PIZFIX/include/ncursesw" \
    LDFLAGS="-L$PIZFIX/lib -Wl,-rpath,$PIZFIX/lib -Wl,-Bsymbolic-functions" \
    EXTRA_LDFLAGS="-L$PIZFIX/lib -Wl,-rpath,$PIZFIX/lib -Wl,-Bsymbolic-functions" \
    PKG_CONFIG="$PIZFIX/bin/pkg-config --define-prefix" \
    PKG_CONFIG_PATH="$PIZFIX/lib/pkgconfig" \
    EXTENSION_DIR="$PIZFIX/lib/php8.5/extensions" \
    PHP_UNAME="Linux" \
    PHP_BUILD_SYSTEM="Linux" \
    PHP_BUILD_PROVIDER="Fil-C" \
    ac_cv_have_decl_UFFDIO_WRITEPROTECT_MODE_WP=no \
    php_cv_have_fpu_inline_asm_x86=no \
    php_cv_preserve_none=no \
    ./configure --prefix="$PIZFIX" \
      --with-layout=GNU \
      --program-suffix=8.5 \
      --libdir="$PIZFIX/lib/php8.5" \
      --includedir="$PIZFIX/include/php8.5" \
      --datadir="$PIZFIX/share/php8.5" \
      --mandir="$PIZFIX/share/man" \
      --sysconfdir="$PIZFIX/etc/php8.5" \
      --localstatedir="$PIZFIX/var/php8.5" \
      --with-config-file-path="$PIZFIX/etc/php8.5" \
      --with-config-file-scan-dir="$PIZFIX/etc/php8.5/conf.d" \
      --disable-fiber-asm \
      --without-pcre-jit \
      --disable-opcache-jit \
      --disable-huge-code-pages \
      --with-external-pcre \
      --enable-fpm \
      --with-openssl \
      --with-zlib \
      --with-bz2="$PIZFIX" \
      --with-curl \
      --with-sqlite3 \
      --with-pdo-sqlite \
      --enable-intl \
      --with-libedit \
      --enable-mbstring \
      --with-sodium \
      --enable-bcmath \
      --enable-calendar \
      --enable-exif \
      --enable-pcntl \
      --enable-sockets \
      --enable-mysqlnd \
      --with-mysqli=shared,mysqlnd \
      --with-pdo-mysql=shared,mysqlnd \
      --with-pgsql=shared,"$PIZFIX" \
      --with-pdo-pgsql=shared,"$PIZFIX" \
      --with-gmp=shared,"$PIZFIX" \
      --enable-soap=shared
}

port_test() {
  local php_bin fpm_bin ext_dir out ver fpm_ver
  php_bin="$PIZFIX/bin/php8.5"
  fpm_bin="$PIZFIX/sbin/php-fpm8.5"
  ext_dir="$PIZFIX/lib/php8.5/extensions"

  out="$("$php_bin" -n -v)"
  ver="${out%%$'\n'*}"
  echo "php8.5 version: $ver"
  printf '%s\n' "$ver" | grep -q '^PHP 8\.5\.13 '

  out="$("$fpm_bin" -n -v)"
  fpm_ver="${out%%$'\n'*}"
  echo "php-fpm8.5 version: $fpm_ver"
  printf '%s\n' "$fpm_ver" | grep -q '^PHP 8\.5\.13 '

  # OPcache is statically built-in in PHP 8.5 (no zend_extension=opcache needed)
  ls -la "$ext_dir"
  local ext ext_rc ext_out ext_failed=0 ext_failures="" reloc_hits=""
  for ext in mysqli pdo_mysql pgsql pdo_pgsql gmp soap; do
    if command -v readelf >/dev/null 2>&1 && [[ -f "$ext_dir/${ext}.so" ]]; then
      echo "readelf ${ext}.so:"
      readelf -d "$ext_dir/${ext}.so" 2>&1 | grep -E 'NEEDED|RPATH|RUNPATH' || true
      reloc_hits="$(readelf -rW "$ext_dir/${ext}.so" 2>&1 | grep -E 'pizlonatedFIP[0-9]+_get_module' || true)"
      if [[ -n "$reloc_hits" ]]; then
        echo "error: ${ext}.so still has a preemptible pizlonatedFIP*_get_module relocation: $reloc_hits" >&2
        ext_failures+=" ${ext}:preemptible-get_module"
        ext_failed=1
      fi
    fi
    ext_rc=0
    ext_out="$("$php_bin" -n \
      -d extension_dir="$ext_dir" \
      -d display_startup_errors=1 \
      -d display_errors=1 \
      -d error_reporting=E_ALL \
      -d extension="$ext" \
      -r "echo extension_loaded('${ext}') ? 'LOADED:${ext}' : 'MISSING:${ext}';" 2>&1)" || ext_rc=$?
    echo "shared-ext ${ext}: rc=${ext_rc} out=${ext_out}"
    if [[ "$ext_rc" -ne 0 ]] || ! printf '%s\n' "$ext_out" | grep -Fxq "LOADED:${ext}"; then
      echo "error: shared extension ${ext} failed to load (rc=${ext_rc})" >&2
      ext_failures+=" ${ext}:load-rc=${ext_rc}"
      ext_failed=1
    fi
  done
  if [[ "$ext_failed" -ne 0 ]]; then
    echo "error: PHP85 shared extension check failed:${ext_failures}" >&2
    return 1
  fi

  local cli_multi_rc=0 cli_multi_out=""
  cli_multi_out="$("$php_bin" -n \
    -d extension_dir="$ext_dir" \
    -d display_startup_errors=1 \
    -d display_errors=1 \
    -d error_reporting=E_ALL \
    -d opcache.enable_cli=1 \
    -d extension=mysqli \
    -d extension=pdo_mysql \
    -d extension=pgsql \
    -d extension=pdo_pgsql \
    -d extension=gmp \
    -d extension=soap \
    -r 'foreach (["mysqli","pdo_mysql","pgsql","pdo_pgsql","gmp","soap"] as $e) { if (!extension_loaded($e)) { fwrite(STDERR, "MISSING:$e\n"); exit(1); } } echo "CLI_MULTI_EXT_OK\n";' 2>&1)" || cli_multi_rc=$?
  printf '%s\n' "$cli_multi_out"
  if [[ "$cli_multi_rc" -ne 0 ]] || ! printf '%s\n' "$cli_multi_out" | grep -Fxq 'CLI_MULTI_EXT_OK' || printf '%s\n' "$cli_multi_out" | grep -q 'Warning:'; then
    echo "error: PHP85 combined -d extension= load failed (rc=$cli_multi_rc)" >&2
    return 1
  fi

  local smoke_ini
  smoke_ini="$(mktemp)"
  cat > "$smoke_ini" <<SMOKEINI
extension_dir="$ext_dir"
display_startup_errors=1
display_errors=1
error_reporting=E_ALL
zend.assertions=1
assert.exception=1
opcache.enable_cli=1
extension=mysqli
extension=pdo_mysql
extension=pgsql
extension=pdo_pgsql
extension=gmp
extension=soap
SMOKEINI

  local smoke_rc=0 smoke_out=""
  smoke_out="$(PHP_INI_SCAN_DIR="" "$php_bin" -c "$smoke_ini" \
    <<'EOF' 2>&1
<?php
// 1. WeakMap + WeakReference + GC (zexact_ptrtable + tagged pointers)
$m = new WeakMap();
$o = new stdClass();
$wr = WeakReference::create($o);
$m[$o] = 1;
foreach ($m as $k => $v) {
    assert($k === $o && $v === 1);
}
assert($wr->get() === $o);
unset($o, $k);
gc_collect_cycles();
assert(count($m) === 0);
assert($wr->get() === null);

// 2. Fibers: ping-pong suspend/resume, nested fibers, exception throw, and stack limit
$pingpong = new Fiber(function (string $init): string {
    $a = Fiber::suspend("step1:" . $init);
    $inner = new Fiber(function (int $x): int {
        $y = Fiber::suspend($x * 2);
        return $y + 1;
    });
    assert($inner->start(21) === 42);
    assert($inner->resume(99) === null);
    assert($inner->getReturn() === 100);
    $b = Fiber::suspend("step2:" . $a);
    return "done:" . $b;
});
assert($pingpong->start("go") === "step1:go");
assert($pingpong->resume("mid") === "step2:mid");
assert($pingpong->resume("end") === null);
assert($pingpong->getReturn() === "done:end");

$throwing = new Fiber(function (): void {
    try {
        Fiber::suspend("ready");
    } catch (RuntimeException $e) {
        Fiber::suspend("caught:" . $e->getMessage());
    }
});
assert($throwing->start() === "ready");
assert($throwing->throw(new RuntimeException("boom")) === "caught:boom");
$throwing->resume();

function recurse_overflow(int $n): array {
    return array_map("recurse_overflow", [$n + 1]);
}
$stack_fiber = new Fiber(function (): void {
    try {
        recurse_overflow(0);
    } catch (Error $e) {
        Fiber::suspend($e->getMessage());
    }
});
$stack_msg = $stack_fiber->start();
assert(is_string($stack_msg) && str_starts_with($stack_msg, "Maximum call stack size"));

// 3. ext/dom HTMLDocument (ext/lexbor dynamic IDs via zexact_ptrtable) + XML C14N
$doc = Dom\HTMLDocument::createFromString("<custom-el data-x=y>hi</custom-el>", LIBXML_NOERROR);
assert($doc->querySelector("custom-el")->getAttribute("data-x") === "y");
$xml = new DOMDocument();
$xml->loadXML('<root xmlns="urn:test"><child a="1">ok</child></root>');
assert(str_contains($xml->C14N(), '<child a="1">ok</child>'));

// 4. PHP 8.5 features: ext/uri (RFC 3986 + WHATWG via ext/lexbor), pipe operator, array_first/last
$rfc = new Uri\Rfc3986\Uri("https://example.invalid:8443/path/to/doc?a=1");
assert($rfc->getHost() === "example.invalid" && $rfc->getPort() === 8443);
$whatwg = new Uri\WhatWg\Url("https://EXAMPLE.INVALID/a/../b");
assert($whatwg->getAsciiHost() === "example.invalid" && $whatwg->getPath() === "/b");
assert(("  Fil-C PHP 8.5  " |> trim(...) |> strtolower(...)) === "fil-c php 8.5");
assert(array_first([10, 20, 30]) === 10 && array_last([10, 20, 30]) === 30);

// 5. Overflow arithmetic (portable builtins), strcase provenance, built-in opcache, tracked allocator
$i = PHP_INT_MAX;
$i++;
assert(is_float($i));
assert(strtolower("Fil-C PHP 8.5") === "fil-c php 8.5");
assert(strtoupper("Fil-C php 8.5") === "FIL-C PHP 8.5");
assert(opcache_get_status(false)["opcache_enabled"] === true);
assert(memory_get_usage(true) % (2 << 20) !== 0);
assert(memory_get_peak_usage(true) >= memory_get_usage(true));

// 6. Core extensions: OpenSSL, zlib, bz2, SQLite3/PDO, PCRE2, JSON, curl, intl, mbstring, sodium, bcmath
assert(hash("sha256", "hello\n") === "5891b5b522d5df086d0ff0b110fbd9d21bb4fc7163af34d08286a2e846f6be03");
assert(openssl_digest("hello\n", "sha256") === "5891b5b522d5df086d0ff0b110fbd9d21bb4fc7163af34d08286a2e846f6be03");
assert(gzuncompress(gzcompress("filc-zlib-php")) === "filc-zlib-php");
assert(bzdecompress(bzcompress("filc-bz2-php")) === "filc-bz2-php");
assert(preg_match('/^([a-z]+)-(\d+)$/', 'filc-85', $matches) === 1 && $matches[2] === '85');
assert(json_decode(json_encode(["ok" => [1, 2, 3]]), true)["ok"] === [1, 2, 3]);
assert(is_array(curl_version()) && !empty(curl_version()["version"]));
assert(mb_strlen("hällo", "UTF-8") === 5);
assert(mb_ereg_replace("([0-9]+)", "[\\1]", "v85") === "v[85]");
$coll = new Collator("en_US");
assert($coll->compare("a", "b") < 0);
$hash = sodium_crypto_generichash("filc-sodium");
assert(strlen($hash) === SODIUM_CRYPTO_GENERICHASH_BYTES);
assert(bcadd("12345678901234567890", "1", 0) === "12345678901234567891");

$db = new SQLite3(":memory:");
$db->exec("CREATE TABLE t (v INT)");
$db->exec("INSERT INTO t VALUES (42)");
assert($db->querySingle("SELECT v FROM t") === 42);
$db->close();

$pdo = new PDO("sqlite::memory:");
$pdo->exec("CREATE TABLE p (s TEXT)");
$pdo->exec("INSERT INTO p VALUES ('ok')");
assert($pdo->query("SELECT s FROM p")->fetchColumn() === "ok");

// 7. Shared extensions: mysqli, pdo_mysql, pgsql, pdo_pgsql, gmp, soap
assert(extension_loaded("mysqli") && extension_loaded("pdo_mysql"));
assert(in_array("mysql", PDO::getAvailableDrivers(), true));
assert(extension_loaded("pgsql") && extension_loaded("pdo_pgsql"));
assert(in_array("pgsql", PDO::getAvailableDrivers(), true));
assert(extension_loaded("gmp") && gmp_strval(gmp_add("123456789012345678901234567890", "1")) === "123456789012345678901234567891");
assert(extension_loaded("soap") && class_exists("SoapClient") && class_exists("SoapServer"));

echo "PHP85_FILC_SMOKE_OK\n";
EOF
  )" || smoke_rc=$?
  rm -f "$smoke_ini"
  printf '%s\n' "$smoke_out"
  if [[ "$smoke_rc" -ne 0 ]] || ! printf '%s\n' "$smoke_out" | grep -Fxq 'PHP85_FILC_SMOKE_OK' || printf '%s\n' "$smoke_out" | grep -q 'Warning:'; then
    echo "error: PHP85 port_test smoke failed (rc=$smoke_rc)" >&2
    return 1
  fi

  # Measure ext/bz2/tests/with_files.phpt isolated first so CI logs separate
  # true bz2 hangs from multi-port CPU contention during parallel runs.
  local bz2_t0 bz2_t1
  bz2_t0="$("$php_bin" -n -r 'echo intdiv(hrtime(true), 1000000);')"
  TEST_PHP_EXECUTABLE="$php_bin" \
    NO_INTERACTION=1 \
    REPORT_EXIT_STATUS=1 \
    "$php_bin" -n "$SRC_DIR/run-tests.php" \
      -q \
      -p "$php_bin" \
      -d extension_dir="$ext_dir" \
      --set-timeout 60 \
      --show-diff \
      "$SRC_DIR/ext/bz2/tests/with_files.phpt"
  bz2_t1="$("$php_bin" -n -r 'echo intdiv(hrtime(true), 1000000);')"
  echo "php8.5 isolated with_files.phpt elapsed_ms=$((bz2_t1 - bz2_t0))"

  # Curated upstream run-tests.php suite covering fibers, weakrefs, uri,
  # sqlite3, json, and bz2 (parallelized across available jobs).
  # Use --set-timeout 180 (matching upstream run-tests.php's 3x ASAN multiplier):
  # Fil-C capability/GC overhead plus concurrent multi-port publish load can
  # exceed the default 60s per-test timeout under 4 concurrent workers.
  local run_tests_log="$SRC_DIR/.filc-run-tests.log"
  TEST_PHP_EXECUTABLE="$php_bin" \
    NO_INTERACTION=1 \
    REPORT_EXIT_STATUS=1 \
    "$php_bin" -n "$SRC_DIR/run-tests.php" \
      -q \
      -j"$JOBS" \
      -p "$php_bin" \
      -d extension_dir="$ext_dir" \
      --set-timeout 180 \
      --show-diff \
      "$SRC_DIR/Zend/tests/fibers" \
      "$SRC_DIR/Zend/tests/weakrefs" \
      "$SRC_DIR/ext/bz2/tests" \
      "$SRC_DIR/ext/json/tests" \
      "$SRC_DIR/ext/sqlite3/tests" \
      "$SRC_DIR/ext/uri/tests" \
      2>&1 | tee "$run_tests_log"
}

port_package_smoke() {
  local php_bin fpm_bin ext_dir out ver fpm_ver
  php_bin="$PKG_PREFIX/bin/php8.5"
  fpm_bin="$PKG_PREFIX/sbin/php-fpm8.5"
  ext_dir="$PKG_PREFIX/lib/php8.5/extensions"

  out="$("$php_bin" -n -v)"
  ver="${out%%$'\n'*}"
  printf '%s\n' "$ver" | grep -q '^PHP 8\.5\.13 '

  out="$("$fpm_bin" -n -v)"
  fpm_ver="${out%%$'\n'*}"
  printf '%s\n' "$fpm_ver" | grep -q '^PHP 8\.5\.13 '

  local smoke_ini
  smoke_ini="$(mktemp)"
  cat > "$smoke_ini" <<SMOKEINI
extension_dir="$ext_dir"
display_startup_errors=1
display_errors=1
error_reporting=E_ALL
zend.assertions=1
assert.exception=1
opcache.enable_cli=1
extension=mysqli
extension=pdo_mysql
extension=pgsql
extension=pdo_pgsql
extension=gmp
extension=soap
SMOKEINI

  local smoke_rc=0 smoke_out=""
  smoke_out="$(PHP_INI_SCAN_DIR="" "$php_bin" -c "$smoke_ini" \
    <<'EOF' 2>&1
<?php
$prefix = realpath(getenv("PKG_PREFIX"));
assert(is_string($prefix) && str_starts_with(realpath(PHP_BINARY), $prefix . "/"));

$m = new WeakMap();
$o = new stdClass();
$wr = WeakReference::create($o);
$m[$o] = 1;
assert($wr->get() === $o);
unset($o);
gc_collect_cycles();
assert(count($m) === 0 && $wr->get() === null);

$f = new Fiber(function (string $s): string {
    $v = Fiber::suspend("hi:" . $s);
    return "ok:" . $v;
});
assert($f->start("filc") === "hi:filc");
assert($f->resume("85") === null && $f->getReturn() === "ok:85");

$doc = Dom\HTMLDocument::createFromString("<custom-el data-x=y>hi</custom-el>", LIBXML_NOERROR);
assert($doc->querySelector("custom-el")->getAttribute("data-x") === "y");
$url = new Uri\WhatWg\Url("https://EXAMPLE.INVALID/a/../b");
assert($url->getAsciiHost() === "example.invalid" && $url->getPath() === "/b");
assert(("  PHP 8.5  " |> trim(...) |> strtolower(...)) === "php 8.5");

assert(opcache_get_status(false)["opcache_enabled"] === true);
assert(openssl_digest("hello\n", "sha256") === "5891b5b522d5df086d0ff0b110fbd9d21bb4fc7163af34d08286a2e846f6be03");
assert(gzuncompress(gzcompress("filc-zlib-php")) === "filc-zlib-php");
assert(bzdecompress(bzcompress("filc-bz2-php")) === "filc-bz2-php");
assert(preg_match('/^([a-z]+)-(\d+)$/', 'filc-85', $matches) === 1 && $matches[2] === '85');
assert(is_array(curl_version()) && !empty(curl_version()["version"]));
assert(mb_ereg_replace("([0-9]+)", "[\\1]", "v85") === "v[85]");
assert((new Collator("en_US"))->compare("a", "b") < 0);
assert(strlen(sodium_crypto_generichash("filc-sodium")) === SODIUM_CRYPTO_GENERICHASH_BYTES);
assert(bcadd("12345678901234567890", "1", 0) === "12345678901234567891");

$db = new SQLite3(":memory:");
$db->exec("CREATE TABLE t (v INT); INSERT INTO t VALUES (42);");
assert($db->querySingle("SELECT v FROM t") === 42);
$db->close();

assert(extension_loaded("mysqli") && extension_loaded("pdo_mysql") && in_array("mysql", PDO::getAvailableDrivers(), true));
assert(extension_loaded("pgsql") && extension_loaded("pdo_pgsql") && in_array("pgsql", PDO::getAvailableDrivers(), true));
assert(extension_loaded("gmp") && gmp_strval(gmp_add("123456789012345678901234567890", "1")) === "123456789012345678901234567891");
assert(extension_loaded("soap") && class_exists("SoapClient"));

echo "PHP85_PKG_SMOKE_OK\n";
EOF
  )" || smoke_rc=$?
  rm -f "$smoke_ini"
  printf '%s\n' "$smoke_out"
  if [[ "$smoke_rc" -ne 0 ]] || ! printf '%s\n' "$smoke_out" | grep -Fxq 'PHP85_PKG_SMOKE_OK' || printf '%s\n' "$smoke_out" | grep -q 'Warning:'; then
    echo "error: PHP85 port_package_smoke failed (rc=$smoke_rc)" >&2
