port_configure() {
  CPPFLAGS="-I$PIZFIX/include -I$PIZFIX/include/ncurses" LDFLAGS="-L$PIZFIX/lib" \
    ./configure --prefix="$PIZFIX"
}

port_test() {
  cat > "$SRC_DIR/_filc_test_edit.c" <<'EOF'
#include <histedit.h>
#include <stdio.h>
int main(void) {
  EditLine *el = el_init("filc-test", stdin, stdout, stderr);
  if (!el) return 1;
  el_end(el);
  return 0;
}
EOF
  "$CC" -O2 -I"$PIZFIX/include" "$SRC_DIR/_filc_test_edit.c" -L"$PIZFIX/lib" -ledit -lncurses -o "$SRC_DIR/_filc_test_edit"
  "$SRC_DIR/_filc_test_edit"
}
