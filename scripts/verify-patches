#!/usr/bin/env python3
"""
Verify that every patch in ports/*/patches/series applies cleanly to its
pinned, SHA-256-verified upstream tarball with zero fuzz (--fuzz=0) and zero
line offset.

Usage:
  scripts/verify-patches [--all | --ports a,b [--with-deps] | <port>...]
                         [--cache-dir <dir>] [--cached-only] [--ports-dir <dir>]
"""

import argparse
import hashlib
import os
import re
import subprocess
import sys
import tempfile


def parse_port_file(port_file: str) -> dict:
    data = {}
    with open(port_file, "r", encoding="utf-8") as f:
        for raw in f:
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            if line.startswith("port_") and "()" in line:
                break
            m = re.match(r"^([A-Z0-9_]+)=(.*)$", line)
            if not m:
                continue
            key, val = m.group(1), m.group(2).strip()
            if len(val) >= 2 and (
                (val[0] == '"' and val[-1] == '"')
                or (val[0] == "'" and val[-1] == "'")
            ):
                val = val[1:-1]
            data[key] = val
    return data


def read_series(port_dir: str) -> list:
    series = os.path.join(port_dir, "patches", "series")
    if not os.path.isfile(series):
        return []
    out = []
    with open(series, "r", encoding="utf-8") as f:
        for raw in f:
            name = raw.split("#", 1)[0].strip()
            if name:
                out.append(os.path.join(port_dir, "patches", name))
    return out


def extract_patch_targets(patch_files: list) -> list:
    targets = []
    seen = set()
    for pfile in patch_files:
        with open(pfile, "r", encoding="utf-8", errors="replace") as f:
            for raw in f:
                if raw.startswith("--- ") or raw.startswith("+++ "):
                    path = raw[4:].split("\t", 1)[0].strip()
                    if path == "/dev/null":
                        continue
                    if path.startswith("a/") or path.startswith("b/"):
                        path = path[2:]
                    if path and path not in seen:
                        seen.add(path)
                        targets.append(path)
    return targets


def sha256_file(path: str) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        while True:
            chunk = f.read(1024 * 1024)
            if not chunk:
                break
            h.update(chunk)
    return h.hexdigest()


def ensure_tarball(meta: dict, cache_dir: str, cached_only: bool):
    name = meta["NAME"]
    version = meta["VERSION"]
    expected = meta["UPSTREAM_SHA256"]
    url = meta["UPSTREAM_URL"]
    tarball_name = os.path.basename(url.split("?", 1)[0])
    os.makedirs(cache_dir, exist_ok=True)
    tarball_path = os.path.join(cache_dir, f"{name}-{version}-{expected[:12]}-{tarball_name}")

    if not os.path.isfile(tarball_path):
        if cached_only:
            return None
        tmp_path = f"{tarball_path}.part.{os.getpid()}"
        try:
            subprocess.run(
                ["curl", "-fsSL", "--retry", "3", "--retry-delay", "2", "-o", tmp_path, url],
                check=True,
            )
            os.replace(tmp_path, tarball_path)
        finally:
            if os.path.exists(tmp_path):
                os.unlink(tmp_path)

    actual = sha256_file(tarball_path)
    if actual != expected:
        os.unlink(tarball_path)
        raise RuntimeError(
            f"{name}: SHA-256 mismatch for {tarball_name}: expected {expected}, got {actual}"
        )
    return tarball_path


def verify_exact_hunks(src_dir: str, pfile: str) -> None:
    """Verify every unified-diff hunk matches its exact line numbers (0 fuzz, 0 offset)."""
    pname = os.path.basename(pfile)
    lines = open(pfile, "r", encoding="utf-8", errors="replace").read().splitlines(keepends=True)
    i = 0
    cur_file = None
    cur_lines = None
    while i < len(lines):
        ln = lines[i]
        if ln.startswith("--- "):
            path = ln[4:].split("\t", 1)[0].strip()
            if path == "/dev/null":
                cur_file = None
                cur_lines = None
            else:
                if path.startswith("a/"):
                    path = path[2:]
                cur_file = path
                full = os.path.join(src_dir, path)
                if not os.path.isfile(full):
                    raise RuntimeError(f"{pname}: target file missing: {path}")
                cur_lines = open(full, "r", encoding="utf-8", errors="replace").read().splitlines()
            i += 1
            continue
        if ln.startswith("@@ "):
            m = re.match(r"^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@", ln)
            if not m:
                raise RuntimeError(f"{pname}: malformed hunk header: {ln.strip()}")
            old_start = int(m.group(1))
            old_count = int(m.group(2)) if m.group(2) is not None else 1
            i += 1
            if cur_file is None or cur_lines is None:
                # New file creation (/dev/null)
                while i < len(lines) and not lines[i].startswith(("@@ ", "--- ", "diff --git ")):
                    i += 1
                continue
            expected_old = []
            while i < len(lines) and len(expected_old) < old_count:
                hl = lines[i]
                if hl.startswith("\\ No newline"):
                    i += 1
                    continue
                if hl.startswith((" ", "-")):
                    expected_old.append(hl[1:].rstrip("\r\n"))
                    i += 1
                elif hl.startswith("+"):
                    i += 1
                else:
                    break
            idx0 = old_start - 1
            actual_old = cur_lines[idx0 : idx0 + len(expected_old)]
            if actual_old != expected_old:
                raise RuntimeError(
                    f"{pname}: {cur_file} hunk at line {old_start} does not match verbatim "
                    f"(offset or fuzz required)"
                )
            continue
        i += 1


def verify_port_patches(name: str, meta: dict, port_dir: str, cache_dir: str, cached_only: bool) -> str:
    patches = read_series(port_dir)
    if not patches:
        return f"SKIP [no-patches] {name} {meta['VERSION']}"

    tarball_path = ensure_tarball(meta, cache_dir, cached_only)
    if tarball_path is None:
        return f"SKIP [uncached] {name} {meta['VERSION']}"

    extract_dir = meta["EXTRACT_DIR"]
    targets = extract_patch_targets(patches)

    with tempfile.TemporaryDirectory(prefix=f"filc-vpatch-{name}-") as td:
        members = [f"{extract_dir}/{t}" for t in targets]
        # Fast selective extract first; fall back to full extract if a patch creates new files
        sel = subprocess.run(
            ["tar", "-xf", tarball_path, "-C", td] + members,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
        if sel.returncode != 0:
            subprocess.run(
                ["tar", "-xf", tarball_path, "-C", td],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                check=True,
            )

        src_dir = os.path.join(td, extract_dir)
        if not os.path.isdir(src_dir):
            raise RuntimeError(f"{name}: extract dir {extract_dir!r} not found in {tarball_path}")

        for pfile in patches:
            pname = os.path.basename(pfile)
            verify_exact_hunks(src_dir, pfile)
            with open(pfile, "rb") as pf:
                patch_bytes = pf.read()
            proc = subprocess.run(
                ["patch", "-d", src_dir, "-p1", "--batch", "--forward", "--fuzz=0"],
                input=patch_bytes,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                check=False,
            )
            combined = (
                proc.stdout.decode("utf-8", errors="replace")
                + "\n"
                + proc.stderr.decode("utf-8", errors="replace")
            ).strip()
            if proc.returncode != 0:
                raise RuntimeError(f"{name}/{pname}: patch failed (rc={proc.returncode}):\n{combined}")
            if re.search(r"\b(offset|fuzz)\b", combined, re.IGNORECASE):
                raise RuntimeError(
                    f"{name}/{pname}: patch applied with fuzz or line offset (must be exact):\n{combined}"
                )

    return f"OK [patches={len(patches)}, fuzz=0, offset=0] {name} {meta['VERSION']}"


def expand_deps(all_ports: dict, names: list) -> list:
    selected = set()
    stack = list(names)
    while stack:
        cur = stack.pop()
        if cur not in all_ports:
            raise ValueError(f"unknown port: {cur}")
        if cur in selected:
            continue
        selected.add(cur)
        for dep in all_ports[cur].get("DEPS", "").split():
            if dep:
                stack.append(dep)
    return sorted(selected)


def main() -> int:
    repo_root = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
    parser = argparse.ArgumentParser(
        description="Verify port patches apply cleanly to pinned upstream tarballs with zero fuzz and zero offset"
    )
    parser.add_argument("port_names", nargs="*", help="Specific port names to check")
    parser.add_argument("--all", action="store_true", help="Check all patched ports")
    parser.add_argument("--ports", default="", help="Comma-separated list of port names")
    parser.add_argument("--with-deps", action="store_true", help="Include transitive dependencies of selected ports")
    parser.add_argument("--cached-only", action="store_true", help="Only verify ports whose tarball is already in cache")
    parser.add_argument("--ports-dir", default=os.path.join(repo_root, "ports"))
    parser.add_argument(
        "--cache-dir",
        default=os.environ.get("FILC_PORTS_CACHE_DIR", os.path.join(repo_root, ".work", "ports", "ports-cache")),
    )
    args = parser.parse_args()

    all_ports = {}
    for entry in sorted(os.listdir(args.ports_dir)):
        pfile = os.path.join(args.ports_dir, entry, "PORT")
        if os.path.isfile(pfile):
            all_ports[entry] = parse_port_file(pfile)

    wanted = list(args.port_names)
    if args.ports:
        wanted.extend(p.strip() for p in args.ports.split(",") if p.strip())

    if wanted:
        selected = expand_deps(all_ports, wanted) if args.with_deps else sorted(set(wanted))
    else:
        selected = sorted(all_ports.keys())

    patched_selected = [
        n for n in selected if read_series(os.path.join(args.ports_dir, n))
    ]
    if not patched_selected:
        print("VERIFY_PATCHES: PASS (0 patched ports in selection)")
        return 0

    checked = 0
    skipped = 0
    failures = []
    for name in patched_selected:
        if name not in all_ports:
            print(f"error: unknown port: {name}", file=sys.stderr)
            return 1
        try:
            msg = verify_port_patches(
                name,
                all_ports[name],
                os.path.join(args.ports_dir, name),
                args.cache_dir,
                args.cached_only,
            )
            print(msg, flush=True)
            if msg.startswith("SKIP "):
                skipped += 1
            else:
                checked += 1
        except Exception as exc:
            print(f"FAIL [{name}] {exc}", file=sys.stderr, flush=True)
            failures.append((name, str(exc)))

    if failures:
        print(f"VERIFY_PATCHES: FAILED ({len(failures)}/{len(patched_selected)})", file=sys.stderr)
        return 1

    print(f"VERIFY_PATCHES: PASS (checked={checked}, skipped={skipped})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
