port_test() {
  "$PIZFIX/bin/getfattr" --version | grep -q 'getfattr 2\.6\.0'
  "$PIZFIX/bin/setfattr" --version | grep -q 'setfattr 2\.6\.0'
  "$PIZFIX/bin/pkg-config" --exists libattr
  local td
  td="$(mktemp -d)"
  cat > "$td/t.c" <<'EOF'
#include <attr/libattr.h>
#include <stdio.h>
int main(void) {
    int a1 = attr_copy_action("user.filc_test", NULL);
    int a2 = attr_copy_action("system.posix_acl_access", NULL);
    printf("actions=%d,%d\n", a1, a2);
    return (a1 == 0 && a2 == ATTR_ACTION_PERMISSIONS) ? 0 : 1;
}
EOF
  "$CC" -O2 -I"$PIZFIX/include" "$td/t.c" -L"$PIZFIX/lib" -lattr -o "$td/t"
  "$td/t" | grep -Fxq 'actions=0,2'
  rm -rf "$td"
}
