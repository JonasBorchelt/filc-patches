Subject: Implement memory-safe x86_64 ucontext in usermusl via Fil-C zfiber_context natives
Policy-Class: P1-Toolchain
Rationale: Add an opaque zfiber_context pointer slot to usermusl's x86_64 ucontext_t and implement getcontext, setcontext, swapcontext, and makecontext as thin wrappers over Fil-C's GC-aware zfiber_context_* natives (matching user-glibc's fiber ABI), enabling memory-safe fibers and ucontext programs such as PHP under Fil-C musl.
Upstream-Status: Upstream-Candidate (Fil-C)
Fil-C-Origin-Commits: none

diff --git a/arch/x86_64/bits/signal.h b/arch/x86_64/bits/signal.h
--- a/arch/x86_64/bits/signal.h
+++ b/arch/x86_64/bits/signal.h
@@ -94,6 +94,8 @@
 	size_t ss_size;
 };
 
+struct zfiber_context;
+
 typedef struct __ucontext {
 	unsigned long uc_flags;
 	struct __ucontext *uc_link;
@@ -101,6 +103,7 @@
 	mcontext_t uc_mcontext;
 	sigset_t uc_sigmask;
 	unsigned long __fpregs_mem[64];
+	struct zfiber_context *__uc_fiber_context;
 } ucontext_t;
 
 #define SA_NOCLDSTOP  1
diff --git a/src/ucontext/x86_64/ucontext.c b/src/ucontext/x86_64/ucontext.c
new file mode 100644
--- /dev/null
+++ b/src/ucontext/x86_64/ucontext.c
@@ -0,0 +1,58 @@
+#include <pizlonated_runtime.h>
+#include <stdfil.h>
+#include <stdlib.h>
+#include <ucontext.h>
+
+int getcontext(ucontext_t *ucp)
+{
+	ucp->__uc_fiber_context = zfiber_context_new();
+	zfiber_context_bind_sigset(ucp->__uc_fiber_context, &ucp->uc_sigmask);
+	zfiber_context_getcontext(ucp->__uc_fiber_context);
+	ucp->uc_link = NULL;
+	ucp->uc_stack.ss_sp = NULL;
+	ucp->uc_stack.ss_flags = 0;
+	ucp->uc_stack.ss_size = 0;
+	return 0;
+}
+
+int setcontext(const ucontext_t *ucp)
+{
+	zfiber_context_setcontext(ucp->__uc_fiber_context);
+	return 0;
+}
+
+int swapcontext(ucontext_t *oucp, const ucontext_t *ucp)
+{
+	if (!oucp->__uc_fiber_context) {
+		oucp->__uc_fiber_context = zfiber_context_new();
+		zfiber_context_bind_sigset(oucp->__uc_fiber_context, &oucp->uc_sigmask);
+	}
+	zfiber_context_swapcontext(oucp->__uc_fiber_context, ucp->__uc_fiber_context);
+	return 0;
+}
+
+struct makecontext_args {
+	ucontext_t *ucp;
+	void (*func)();
+	int argc;
+	void *first_real_arg;
+};
+
+static void makecontext_trampoline(void)
+{
+	struct makecontext_args *args = (struct makecontext_args *)zcallee_closure_data();
+	zcall(args->func, &args->first_real_arg);
+	ucontext_t *link = args->ucp->uc_link;
+	if (!link)
+		exit(0);
+	setcontext(link);
+}
+
+void makecontext(ucontext_t *ucp, void (*func)(), int argc, ...)
+{
+	(void)func;
+	(void)argc;
+	zfiber_context_makecontext(ucp->__uc_fiber_context,
+	                           ucp->uc_stack.ss_size,
+	                           zclosure_new(makecontext_trampoline, zargs()));
+}
