Subject: Fix libxml2 2.12+ const xmlError and ICU 68+ boolean macros in PHP 7.4
Policy-Class: P2-Package
Rationale: libxml2 2.12+ changed xmlGetLastError() and xmlStructuredErrorFunc to use const xmlError * and stopped transitively including libxml/encoding.h; ICU 68+ removed TRUE/FALSE macros. Update error handler signatures, include libxml/encoding.h, and use standard C/C++ boolean literals so PHP 7.4 builds cleanly against libxml2 2.15 and ICU 79.
Upstream-Status: Backport (upstream PHP 8.x libxml2 2.12 / ICU 68 compatibility fixes)
Fil-C-Origin-Commits: none
Origin-Kind: backport
Origin-Project: php/php-src

--- a/ext/libxml/libxml.c
+++ b/ext/libxml/libxml.c
@@ -541,7 +541,11 @@
 	return 1;
 }
 
+#if LIBXML_VERSION >= 21200
+static void _php_list_set_error_structure(const xmlError *error, const char *msg)
+#else
 static void _php_list_set_error_structure(xmlErrorPtr error, const char *msg)
+#endif
 {
 	xmlError error_copy;
 	int ret;
@@ -793,7 +797,11 @@
 	va_end(args);
 }
 
+#if LIBXML_VERSION >= 21200
+PHP_LIBXML_API void php_libxml_structured_error_handler(void *userData, const xmlError *error)
+#else
 PHP_LIBXML_API void php_libxml_structured_error_handler(void *userData, xmlErrorPtr error)
+#endif
 {
 	_php_list_set_error_structure(error, NULL);
 
@@ -1072,7 +1080,11 @@
    Retrieve last error from libxml */
 static PHP_FUNCTION(libxml_get_last_error)
 {
+#if LIBXML_VERSION >= 21200
+	const xmlError *error;
+#else
 	xmlErrorPtr error;
+#endif
 
 	error = xmlGetLastError();
 
