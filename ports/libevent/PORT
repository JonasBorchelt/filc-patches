port_configure() {
  CPPFLAGS="-I$PIZFIX/include" LDFLAGS="-L$PIZFIX/lib" \
    ./configure --prefix="$PIZFIX" --disable-openssl --disable-samples
}

port_test() {
  cat > "$SRC_DIR/_filc_test_event.c" <<'EOF'
#include <event2/event.h>
#include <stdio.h>
static int fired = 0;
static void on_timer(evutil_socket_t fd, short what, void *arg) {
  (void)fd; (void)what; (void)arg;
  fired = 1;
}
int main(void) {
  struct event_base *base = event_base_new();
  if (!base) return 1;
  struct timeval tv = {0, 1000};
  struct event *ev = evtimer_new(base, on_timer, NULL);
  if (!ev) return 2;
  evtimer_add(ev, &tv);
  event_base_dispatch(base);
  event_free(ev);
  event_base_free(base);
  return fired == 1 ? 0 : 3;
}
EOF
  "$CC" -O2 -I"$PIZFIX/include" "$SRC_DIR/_filc_test_event.c" -L"$PIZFIX/lib" -levent -o "$SRC_DIR/_filc_test_event"
  "$SRC_DIR/_filc_test_event"
}
