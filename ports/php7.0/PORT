port_configure() {
  # PHP 7.x ext/iconv/config.m4 falls back to /usr/local /usr and unconditionally
  # prepends -I$PHP_ICONV_PREFIX/include and -L$PHP_ICONV_PREFIX/lib to CFLAGS
  # and LDFLAGS whenever libc provides iconv() (leaving ICONV_DIR empty). Under
  # Fil-C that poisons subsequent configure probes with host glibc headers.
  # Also fix PHP 7.0's PHP_READDIR_R_TYPE probe (implicit int main(), undeclared
  # exit(), and close(dir) on a DIR *), which otherwise fails Clang 20 and falls
  # back to AC_TRY_CPP misdetecting HAVE_OLD_READDIR_R instead of POSIX.
  "${HOST_RUBY:-ruby}" -e '
    p = "configure"
    s = File.binread(p)
    pat = %r{for i in /usr/local /usr; do\s*\n\s*if test -f "\$i/include/iconv\.h" \|\| test -f "\$i/include/giconv\.h"; then\s*\n\s*PHP_ICONV_PREFIX="\$i"\s*\n\s*break\s*\n\s*fi\s*\n\s*done\s*\n\s*if test -z "\$PHP_ICONV_PREFIX"; then\s*\n\s*PHP_ICONV_PREFIX="/usr"\s*\n\s*fi}
    matches = s.scan(pat).length
    raise "ext/iconv /usr prefix fallback not found in configure (matches=#{matches})" unless matches == 1
    s = s.sub(pat, "PHP_ICONV_PREFIX=\"$prefix\"")
    rd_pat = %r{(#include <dirent\.h>\s*\n\s*#ifndef PATH_MAX\s*\n#define PATH_MAX 1024\s*\n#endif\s*\n\s*)main\(\) \{(\s*\n\s*DIR \*dir;.*?if \(readdir_r\(dir, \(struct dirent \*\) entry, &pentry\) == 0\) \{\s*\n\s*)close\(dir\);(\s*\n\s*exit\(0\);\s*\n\s*\}\s*\n\s*)close\(dir\);}m
    rd_matches = s.scan(rd_pat).length
    raise "PHP_READDIR_R_TYPE probe not found in configure (matches=#{rd_matches})" unless rd_matches == 1
    s = s.sub(rd_pat, "#include <stdlib.h>\n\\1int main(void) {\\2closedir(dir);\\3closedir(dir);")
    sp_old = "main() {char buf[20];exit(sprintf(buf,\"testing 123\")!=11); }"
    sp_matches = s.scan(sp_old).length
    raise "AC_ZEND_BROKEN_SPRINTF probe not found in configure (matches=#{sp_matches})" unless sp_matches == 1
    s = s.sub(sp_old, "#include <stdio.h>\n#include <stdlib.h>\nint main(void) {char buf[20];exit(sprintf(buf,\"testing 123\")!=11); }")
    File.binwrite(p, s)
  '
  local shim_dir="$SRC_DIR/.filc-tools"
  rm -rf "$shim_dir"
  mkdir -p "$shim_dir/bin"
  ln -s "$PIZFIX/include" "$shim_dir/include"
  ln -s "$PIZFIX/lib" "$shim_dir/lib"
  cat > "$shim_dir/bin/xml2-config" <<SHIM
#!/bin/sh
PKG_CONFIG_PATH="$PIZFIX/lib/pkgconfig"
export PKG_CONFIG_PATH
case "\$1" in
  --version) exec "$PIZFIX/bin/pkg-config" --define-prefix --modversion libxml-2.0 ;;
  --cflags)  exec "$PIZFIX/bin/pkg-config" --define-prefix --cflags libxml-2.0 ;;
  --libs)    exec "$PIZFIX/bin/pkg-config" --define-prefix --libs libxml-2.0 ;;
  --prefix)  printf '%s\n' "$PIZFIX" ;;
  *)         exec "$PIZFIX/bin/pkg-config" --define-prefix "\$@" libxml-2.0 ;;
esac
SHIM
  cat > "$shim_dir/bin/icu-config" <<SHIM
#!/bin/sh
PKG_CONFIG_PATH="$PIZFIX/lib/pkgconfig"
export PKG_CONFIG_PATH
case "\$1" in
  --version)        exec "$PIZFIX/bin/pkg-config" --define-prefix --modversion icu-uc ;;
  --cppflags)       exec "$PIZFIX/bin/pkg-config" --define-prefix --cflags icu-uc icu-io icu-i18n ;;
  --ldflags)        exec "$PIZFIX/bin/pkg-config" --define-prefix --libs icu-io icu-i18n icu-uc ;;
  --ldflags-icuio)  exec "$PIZFIX/bin/pkg-config" --define-prefix --libs icu-io ;;
  --ldflags-libsonly) exec "$PIZFIX/bin/pkg-config" --define-prefix --libs-only-l icu-io icu-i18n icu-uc ;;
  --ldflags-searchpath) exec "$PIZFIX/bin/pkg-config" --define-prefix --libs-only-L icu-io icu-i18n icu-uc ;;
  --prefix)         printf '%s\n' "$PIZFIX" ;;
  --cxxflags)       printf '%s\n' "-std=c++17" ;;
  *)                printf '' ;;
esac
SHIM
  chmod +x "$shim_dir/bin/xml2-config" "$shim_dir/bin/icu-config"
  PATH="$shim_dir/bin:$PIZFIX/bin:$PATH" \
    CPPFLAGS="-I$PIZFIX/include -I$PIZFIX/include/ncursesw" \
    CXXFLAGS="${CXXFLAGS:-} -I$PIZFIX/include -std=c++17 -DU_USING_ICU_NAMESPACE=1" \
    LDFLAGS="-L$PIZFIX/opt/openssl1.1/lib -L$PIZFIX/lib -Wl,-rpath,$PIZFIX/lib -Wl,-Bsymbolic-functions" \
    EXTRA_LDFLAGS="-L$PIZFIX/opt/openssl1.1/lib -L$PIZFIX/lib -Wl,-rpath,$PIZFIX/lib -Wl,-Bsymbolic-functions" \
    PKG_CONFIG="$PIZFIX/bin/pkg-config --define-prefix" \
    PKG_CONFIG_PATH="$PIZFIX/opt/openssl1.1/lib/pkgconfig:$PIZFIX/lib/pkgconfig" \
    EXTENSION_DIR="$PIZFIX/lib/php7.0/extensions" \
    PHP_UNAME="Linux" \
    PHP_BUILD_SYSTEM="Linux" \
    PHP_BUILD_PROVIDER="Fil-C" \
    ./configure --prefix="$PIZFIX" \
      --with-layout=GNU \
      --program-suffix=7.0 \
      --libdir="$PIZFIX/lib/php7.0" \
      --includedir="$PIZFIX/include/php7.0" \
      --datadir="$PIZFIX/share/php7.0" \
      --mandir="$PIZFIX/share/man" \
      --sysconfdir="$PIZFIX/etc/php7.0" \
      --localstatedir="$PIZFIX/var/php7.0" \
      --with-config-file-path="$PIZFIX/etc/php7.0" \
      --with-config-file-scan-dir="$PIZFIX/etc/php7.0/conf.d" \
      --without-pcre-jit \
      --with-libxml-dir="$shim_dir" \
      --with-icu-dir="$shim_dir" \
      --enable-fpm \
      --with-openssl="$PIZFIX/opt/openssl1.1" \
      --with-openssl-dir="$PIZFIX/opt/openssl1.1" \
      --with-zlib="$PIZFIX" \
      --with-bz2="$PIZFIX" \
      --with-curl="$PIZFIX/opt/openssl1.1" \
      --with-sqlite3="$PIZFIX" \
      --with-pdo-sqlite="$PIZFIX" \
      --enable-intl \
      --with-libedit="$PIZFIX" \
      --enable-mbstring \
      --enable-bcmath \
      --enable-calendar \
      --enable-exif \
      --enable-pcntl \
      --enable-sockets
  if grep -En -- '(^|[[:space:]"'"'"'])(-I["'"'"']?/usr/(local/)?include|-L["'"'"']?/usr/(local/)?lib(64)?)([[:space:]"'"'"'/]|$)' Makefile config.status >&2; then
    echo "error: host /usr include or lib path leaked into php7.0 Makefile/config.status" >&2
    return 1
  fi
}

port_test() {
  local php_bin fpm_bin ext_dir out ver fpm_ver
  php_bin="$PIZFIX/bin/php7.0"
  fpm_bin="$PIZFIX/sbin/php-fpm7.0"
  ext_dir="$PIZFIX/lib/php7.0/extensions"

  "${HOST_PYTHON3:-/usr/bin/python3}" - "$PIZFIX" "$php_bin" "$fpm_bin" <<'PY'
import os, struct, sys

prefix, bins = sys.argv[1], sys.argv[2:]
search_dirs = [os.path.join(prefix, "lib"), os.path.join(prefix, "opt/openssl1.1/lib")]

def read_needed(path):
    with open(path, "rb") as f:
        data = f.read()
    e_phoff = struct.unpack_from("<Q", data, 32)[0]
    e_phentsize, e_phnum = struct.unpack_from("<HH", data, 54)
    loads, dyn = [], None
    for i in range(e_phnum):
        off = e_phoff + i * e_phentsize
        p_type, _, p_offset, p_vaddr, _, p_filesz, _, _ = struct.unpack_from("<IIQQQQQQ", data, off)
        if p_type == 1:
            loads.append((p_vaddr, p_filesz, p_offset))
        elif p_type == 2:
            dyn = (p_offset, p_filesz)
    if not dyn:
        return []
    needed_offs, strtab_va = [], None
    for pos in range(dyn[0], dyn[0] + dyn[1], 16):
        d_tag, d_val = struct.unpack_from("<qQ", data, pos)
        if d_tag == 0:
            break
        elif d_tag == 1:
            needed_offs.append(d_val)
        elif d_tag == 5:
            strtab_va = d_val
    strtab_off = next(o + (strtab_va - v) for v, s, o in loads if v <= strtab_va < v + s)
    return [data[strtab_off + n:data.index(b"\x00", strtab_off + n)].decode("ascii", "replace") for n in needed_offs]

for bin_path in bins:
    seen_libs, queue, visited = set(), [bin_path], set()
    while queue:
        real = os.path.realpath(queue.pop(0))
        if real in visited:
            continue
        visited.add(real)
        for lib in read_needed(real):
            seen_libs.add(lib)
            for d in search_dirs:
                cand = os.path.join(d, lib)
                if os.path.isfile(cand):
                    queue.append(cand)
                    break
    assert "libssl.so.1.1" in seen_libs and "libcrypto.so.1.1" in seen_libs, f"{bin_path}: missing OpenSSL 1.1: {seen_libs}"
    assert "libssl.so.3" not in seen_libs and "libcrypto.so.3" not in seen_libs, f"{bin_path}: forbidden OpenSSL 3 in DT_NEEDED tree: {seen_libs}"
    assert "libcurl.so.4" not in seen_libs, f"{bin_path}: unexpected shared libcurl.so.4: {seen_libs}"
PY

  out="$("$php_bin" -n -v)"
  ver="${out%%$'\n'*}"
  echo "php7.0 version: $ver"
  printf '%s\n' "$ver" | grep -q '^PHP 7\.0\.33 '

  out="$("$fpm_bin" -n -v)"
  fpm_ver="${out%%$'\n'*}"
  echo "php-fpm7.0 version: $fpm_ver"
  printf '%s\n' "$fpm_ver" | grep -q '^PHP 7\.0\.33 '

