  --prefix)         printf '%s\n' "$PIZFIX" ;;
  --cxxflags)       printf '%s\n' "-std=c++17" ;;
  *)                printf '' ;;
esac
SHIM
  chmod +x "$shim_dir/bin/xml2-config" "$shim_dir/bin/icu-config"
  PATH="$shim_dir/bin:$PIZFIX/bin:$PATH" \
    CPPFLAGS="-I$PIZFIX/include -I$PIZFIX/include/ncursesw" \
    CXXFLAGS="${CXXFLAGS:-} -I$PIZFIX/include -std=c++17" \
