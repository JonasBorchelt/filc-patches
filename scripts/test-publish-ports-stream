#!/usr/bin/env ruby
# frozen_string_literal: true

# Offline unit & determinism proof suite for scripts/publish-ports-stream,
# scripts/package-port (--single-port / --finalize-index), and verifying live
# markers in scripts/report-live.rb / scripts/report-live.
#
# Zero network sockets, zero ports bound, runs in a few seconds.

require "digest/sha2"
require "fileutils"
require "json"
require "open3"
require "tmpdir"

REPO_ROOT = File.expand_path("..", __dir__)
STREAM_BIN = File.join(REPO_ROOT, "scripts", "publish-ports-stream")
REPORT_RB = File.join(REPO_ROOT, "scripts", "report-live.rb")
REPORT_PY = File.join(REPO_ROOT, "scripts", "report-live")

def assert(cond, msg)
  raise "ASSERTION FAILED: #{msg}" unless cond
end

def sha256_file(path)
  Digest::SHA256.file(path).hexdigest
end

def make_source_tarball(cache_dir, name, version)
  Dir.mktmpdir("filc-src-") do |td|
    src_dir = File.join(td, "#{name}-#{version}")
    FileUtils.mkdir_p(src_dir)
    File.write(File.join(src_dir, "README"), "#{name} #{version} clean upstream source\n", encoding: "UTF-8")
    tar_path = File.join(cache_dir, "#{name}-#{version}.tar.gz")
    _o, err, st = Open3.capture3("tar", "-czf", tar_path, "-C", td, "#{name}-#{version}")
    raise "tar failed: #{err}" unless st.success?

    sha = sha256_file(tar_path)
    named = File.join(cache_dir, "#{name}-#{version}-#{sha[0, 12]}-#{name}-#{version}.tar.gz")
    FileUtils.mv(tar_path, named)
    [named, sha]
  end
end

def write_mock_port(ports_dir, cache_dir, name:, version:, tier:, deps:, policy: "P0-Clean")
  _tar, sha = make_source_tarball(cache_dir, name, version)
  pdir = File.join(ports_dir, name)
  FileUtils.mkdir_p(pdir)
  port_content = <<~PORT
    NAME="#{name}"
    VERSION="#{version}"
    LICENSE="MIT"
    UPSTREAM_URL="https://example.invalid/#{name}-#{version}.tar.gz"
    UPSTREAM_SHA256="#{sha}"
    EXTRACT_DIR="#{name}-#{version}"
    TIER=#{tier}
    DEPS="#{deps.join(' ')}"
    BUILD_SYSTEM="custom"
    POLICY_CLASS="#{policy}"

    port_package_smoke() {
      test -x "$PKG_PREFIX/bin/#{name}-config"
      test -f "$PKG_PREFIX/include/#{name}.h"
      test -f "$PKG_PREFIX/bin/#{name}-elf"
      test -f "$PKG_PREFIX/lib/lib#{name}.a"
      "$PKG_PREFIX/bin/#{name}-config" --prefix | grep -Fq "opt-filc/0.1.4/pizfix"
      ! "$PKG_PREFIX/bin/#{name}-config" --prefix | grep -Fq "/views/"
      ! "$PKG_PREFIX/bin/#{name}-config" --prefix | grep -Fq "/.v0"
      grep -aFq "opt-filc/0.1.4/pizfix/ssl" "$PKG_PREFIX/bin/#{name}-elf"
      grep -aFq "opt-filc/0.1.4/build/bin/clang" "$PKG_PREFIX/bin/#{name}-elf"
      ! grep -aFq "/.v0" "$PKG_PREFIX/bin/#{name}-elf"
      ! grep -aFq "/build/vbn" "$PKG_PREFIX/bin/#{name}-elf"
      grep -aFq "opt-filc/0.1.4/pizfix/lib/pkgconfig" "$PKG_PREFIX/lib/lib#{name}.a"
      ! grep -aFq "/.v0" "$PKG_PREFIX/lib/lib#{name}.a"
    }
  PORT
  File.write(File.join(pdir, "PORT"), port_content, encoding: "UTF-8")
end

def write_mock_build_port(path)
  script = <<~'SH'
    #!/usr/bin/env bash
    set -euo pipefail

    PORT_NAME="$1"
    WORK_ROOT="$2"
    PORTS_DIR="${FILC_PORTS_DIR:?}"
    PIZFIX="${FILC_PIZFIX:?}"
    STATE_DIR="$WORK_ROOT/ports-state"
    mkdir -p "$STATE_DIR" "$PIZFIX/bin" "$PIZFIX/include" "$PIZFIX/lib/pkgconfig"

    # Strict secret isolation check: none of these secrets may ever enter build-port
    for secret_var in FILC_LEAK_EXACT_TOKENS FILC_PORTS_MINISIGN_KEY FILC_PORTS_UPLOAD_TOKEN FILC_LIVE_TOKEN; do
      if [[ -n "${!secret_var:-}" ]]; then
        echo "ERROR: secret env leaked into build-port: $secret_var" >&2
        exit 99
      fi
    done

    # Record observed FILC_PORTS_JOBS and FILC_PORT_TIMEOUT for budget/timeout verification
    mkdir -p "$WORK_ROOT/observed-jobs" "$WORK_ROOT/observed-timeouts"
    printf '%s\n' "${FILC_PORTS_JOBS:-unset}" > "$WORK_ROOT/observed-jobs/$PORT_NAME"
    printf '%s\n' "${FILC_PORT_TIMEOUT:-unset}" > "$WORK_ROOT/observed-timeouts/$PORT_NAME"

    # Emit UTF-8 multibyte bytes (0xC3 ..) and raw non-UTF-8 bytes (0xFF) to prove
    # run_logged_cmd never crashes under LANG=C / US-ASCII container locale.
    printf 'build-port %s locale test: \303\244\303\266\303\274\303\237 raw=\377\376 ok\n' "$PORT_NAME"

    # Read recipe metadata
    source "$PORTS_DIR/$PORT_NAME/PORT"

    # Verify every declared dependency header IS visible in the isolated view
    for dep in $DEPS; do
      if [[ ! -f "$PIZFIX/include/${dep}.h" ]]; then
        echo "ERROR: missing declared dependency header $PIZFIX/include/${dep}.h for $PORT_NAME" >&2
        exit 1
      fi
    done

    # Deliberately test isolation: if an undeclared sibling 'libc' header exists, record it!
    # In a shared mutable prefix, this would flip depending on build order and break determinism.
    HAS_SIBLING=0
    if [[ "$PORT_NAME" != "libc" && -f "$PIZFIX/include/optional_sibling.h" ]]; then
      HAS_SIBLING=1
      echo "ERROR: undeclared sibling libc leaked into isolated view for $PORT_NAME!" >&2
      exit 1
    fi

    # Optional failure injection for error-isolation test
    if [[ "${MOCK_FAIL_PORT:-}" == "$PORT_NAME" ]]; then
      for i in $(seq 1 90); do
        echo "MOCK_FAIL_DETAIL_LINE_${i} port=$PORT_NAME"
      done
      echo "error: injected build failure in $PORT_NAME" >&2
      printf '{"name":"%s","version":"%s","tier":%s,"status":"failed","failed_stage":"build","failed_kind":"package","policy_class":"%s","deps":[],"duration_seconds":1,"patch_count":0,"added_lines":0,"removed_lines":0,"files_changed":0}\n' \
        "$PORT_NAME" "$VERSION" "$TIER" "$POLICY_CLASS" > "$STATE_DIR/$PORT_NAME.json"
      exit 1
    fi

    # Install port artifacts (header, pkg-config .pc, *-config script, synthetic ELF binary,
    # and binary static archive .a embedding $PIZFIX and $FILC_CLANG to mimic openssl/pkgconf/jq/xz)
    cat > "$PIZFIX/include/${PORT_NAME}.h" <<HDR
    /* ${PORT_NAME} ${VERSION} sibling=${HAS_SIBLING} */
    #define PORT_${PORT_NAME}_VER "${VERSION}"
    HDR

    mkdir -p "$PIZFIX/lib"
    # Synthetic ELF binary embedding $PIZFIX and $FILC_CLANG in binary .rodata strings
    printf '\177ELF\002\001\001\000\000\000\000\000\000\000\000\000OPENSSLDIR=%s/ssl\000COMPILER=%s -O2 -g\000' \
      "$PIZFIX" "${FILC_CLANG:-/opt/filc/0.1.4/build/bin/clang}" > "$PIZFIX/bin/${PORT_NAME}-elf"
    if [[ "${MOCK_LEAK_PORT:-}" == "$PORT_NAME" ]]; then
      printf 'LEAK_TOKEN=forbidden-ci-secret-token\000' >> "$PIZFIX/bin/${PORT_NAME}-elf"
    fi
    chmod 0755 "$PIZFIX/bin/${PORT_NAME}-elf"

    # Synthetic binary static archive (.a with NUL bytes) embedding $PIZFIX/lib/pkgconfig
    printf '!<arch>\n\000PKG_DEFAULT_PATH=%s/lib/pkgconfig\000CC=%s\000' \
      "$PIZFIX" "${FILC_CLANG:-/opt/filc/0.1.4/build/bin/clang}" > "$PIZFIX/lib/lib${PORT_NAME}.a"

    manifest_files="\"include/${PORT_NAME}.h\", \"bin/${PORT_NAME}-config\", \"bin/${PORT_NAME}-elf\", \"lib/lib${PORT_NAME}.a\", \"lib/pkgconfig/${PORT_NAME}.pc\""
    if [[ "$PORT_NAME" == "libc" ]]; then
      echo "/* optional sibling marker */" > "$PIZFIX/include/optional_sibling.h"
      manifest_files="$manifest_files, \"include/optional_sibling.h\""
    fi

    cat > "$PIZFIX/bin/${PORT_NAME}-config" <<CFG
    #!/bin/sh
    prefix="$PIZFIX"
    if [ "\${1:-}" = "--prefix" ]; then
      echo "\$prefix"
    else
      echo "${PORT_NAME} ${VERSION} sibling=${HAS_SIBLING}"
    fi
    CFG
    chmod 0755 "$PIZFIX/bin/${PORT_NAME}-config"

    cat > "$PIZFIX/lib/pkgconfig/${PORT_NAME}.pc" <<PC
    prefix=$PIZFIX
    includedir=\${prefix}/include
    Name: ${PORT_NAME}
    Version: ${VERSION}
    Cflags: -I\${includedir}
    PC

    cat > "$STATE_DIR/$PORT_NAME.manifest.json" <<JSON
    {
      "name": "$PORT_NAME",
      "files": [$manifest_files]
    }
    JSON

    cat > "$STATE_DIR/$PORT_NAME.json" <<JSON
    {
      "name": "$PORT_NAME",
      "version": "$VERSION",
      "tier": $TIER,
      "status": "tested",
      "policy_class": "$POLICY_CLASS",
      "deps": [],
      "duration_seconds": 1,
      "patch_count": 0,
      "added_lines": 0,
      "removed_lines": 0,
      "files_changed": 0
    }
    JSON
    touch "$STATE_DIR/$PORT_NAME.installed"
  SH
  File.write(path, script, encoding: "UTF-8")
  File.chmod(0o755, path)
end

def setup_fixture(root)
  tc_root = File.join(root, "opt-filc", "0.1.4")
  FileUtils.mkdir_p(File.join(tc_root, "pizfix", "include"))
  FileUtils.mkdir_p(File.join(tc_root, "pizfix", "lib"))
  FileUtils.mkdir_p(File.join(tc_root, "build", "bin"))
  File.write(File.join(tc_root, "pizfix", "include", "base_musl.h"), "/* pristine base */\n", encoding: "UTF-8")
  %w[clang clang++ ld.lld llvm-ar llvm-ranlib llvm-nm].each do |tool|
    p = File.join(tc_root, "build", "bin", tool)
    File.write(p, "#!/bin/sh\necho mock-#{tool}\n", encoding: "UTF-8")
    File.chmod(0o755, p)
  end

  ports_dir = File.join(root, "ports")
  cache_dir = File.join(root, "ports-cache")
  FileUtils.mkdir_p(ports_dir)
  FileUtils.mkdir_p(cache_dir)

  # 6-port diamond + sibling DAG
  write_mock_port(ports_dir, cache_dir, name: "liba", version: "1.0.0", tier: 0, deps: [])
  write_mock_port(ports_dir, cache_dir, name: "libb", version: "1.0.0", tier: 0, deps: [])
  write_mock_port(ports_dir, cache_dir, name: "libc", version: "1.0.0", tier: 0, deps: [])
  write_mock_port(ports_dir, cache_dir, name: "mid1", version: "2.0.0", tier: 1, deps: %w[liba])
  write_mock_port(ports_dir, cache_dir, name: "mid2", version: "2.0.0", tier: 1, deps: %w[liba libb])
  write_mock_port(ports_dir, cache_dir, name: "app",  version: "3.0.0", tier: 2, deps: %w[mid1 mid2])

  mock_bp = File.join(root, "mock-build-port")
  write_mock_build_port(mock_bp)

  { tc_root: tc_root, ports_dir: ports_dir, cache_dir: cache_dir, mock_bp: mock_bp }
end

Dir.mktmpdir("filc-stream-test-") do |tmp|
  fix = setup_fixture(tmp)
  base_snapshot = Dir.glob(File.join(fix[:tc_root], "pizfix", "**", "*")).sort

  # Seed historical timings making liba -> mid1 -> app the longest critical path:
  # cp(liba) = 5 + 60 + 30 = 95, cp(libb) = 5 + 10 + 30 = 45, cp(libc) = 12
  timings_seed = File.join(tmp, "timings-seed.json")
  File.write(timings_seed, JSON.pretty_generate({
    "schema_version" => 1,
    "durations" => { "liba" => 5, "mid1" => 60, "app" => 30, "libb" => 5, "mid2" => 10, "libc" => 12 }
  }) + "\n", encoding: "UTF-8")

  # Run explicitly under LANG=C / LC_ALL=C (US-ASCII) to prove UTF-8/binary log safety,
  # and explicitly unset CI run-control env vars (e.g. FILC_PORTS, FILC_PORTS_FORCE)
  # via nil entries in Process.spawn/Open3 env so the self-test fixture never inherits
  # subset/force filters from outer CI runs.
  unset_run_vars = ENV.keys
                      .select { |k| k == "FILC_PORTS" || k.start_with?("FILC_PORTS_", "FILC_PORT_") }
                      .each_with_object({}) { |k, h| h[k] = nil }
  common_env = unset_run_vars.merge(
    "LANG" => "C",
    "LC_ALL" => "C",
    "FILC_PORTS" => nil,
    "FILC_PORTS_FORCE" => nil,
    "FILC_LEAK_EXACT_TOKENS" => "198.51.100.42\nforbidden-ci-secret-token\n",
    "FILC_PORTS_MINISIGN_KEY" => "must-never-leak-to-build-port",
    "FILC_PORTS_UPLOAD_TOKEN" => "must-never-leak-to-build-port",
    "FILC_LIVE_TOKEN" => "must-never-leak-to-build-port"
  )

  puts "=== [1/6] Determinism proof (6-port diamond DAG + ELF/.a relocation + US-ASCII locale) ==="
  run_hashes = {}
  run_sequences = {}

  %w[critical-path reverse].each do |order|
    work_dir = File.join(tmp, "work-#{order}")
    out_dir = File.join(tmp, "out-#{order}")
    timings_out = File.join(tmp, "timings-#{order}.json")
    FileUtils.cp(timings_seed, timings_out)

    cmd = [
      STREAM_BIN,
      "--repo-root", REPO_ROOT,
      "--ports-dir", fix[:ports_dir],
      "--toolchain-root", fix[:tc_root],
      "--work-dir", work_dir,
      "--out-dir", out_dir,
      "--ports-cache-dir", fix[:cache_dir],
      "--channel", "0.1.4",
      "--arch", "x86_64-linux",
      "--revision", "1",
      "--parallel", "4",
      "--total-jobs", "16",
      "--no-pin-cpus",
      "--isolated-prefix",
      "--schedule-order", order,
      "--timings-file", timings_out,
      "--no-bootstrap-timings",
      "--build-port-bin", fix[:mock_bp],
      "--source-date-epoch", "1700000000"
    ]
    out, err, st = Open3.capture3(common_env, *cmd)
    assert(st.success?, "#{order} run failed (rc=#{st.exitstatus}):\nOUT:\n#{out}\nERR:\n#{err}")
    assert(out.include?("PUBLISH_PORTS_STREAM_RESULT: PASS"), "missing PASS marker in #{order}")

    # Verify fixed core budget per slot (16 / 4 = 4 cores) AND scaled FILC_PORT_TIMEOUT (900 * 16 / 4 = 3600s)!
    %w[liba libb libc mid1 mid2 app].each do |p|
      obs = File.read(File.join(work_dir, "observed-jobs", p)).strip
      assert(obs == "4", "expected fixed slot_cores=4 for #{p}, got #{obs}")
      to_s = File.read(File.join(work_dir, "observed-timeouts", p)).strip
      assert(to_s == "3600", "expected scaled FILC_PORT_TIMEOUT=3600 for #{p}, got #{to_s}")
    end

    # Verify dry-run executed upload-ports --stage-port-meta --dry-run (without network PUT)
    %w[liba libb libc mid1 mid2 app].each do |p|
      plog = File.read(File.join(work_dir, "ports-logs", "#{p}.log"), encoding: "UTF-8")
      assert(plog.include?("UPLOAD_PORTS_STAGE: DRY_RUN OK port=#{p}"),
             "expected dry-run upload gate check in #{p}.log:\n#{plog}")
    end

    # Verify pristine base pizfix was NEVER mutated!
    after_snapshot = Dir.glob(File.join(fix[:tc_root], "pizfix", "**", "*")).sort
    assert(after_snapshot == base_snapshot, "pristine base pizfix was modified during #{order} run!")

    # Verify views directory, same-length sibling slot dirs, and shared wrapper dir are all cleaned up
    views_dir = File.join(fix[:tc_root], "views")
    leftover_views = File.directory?(views_dir) ? Dir.children(views_dir) : []
    assert(leftover_views.empty?, "leftover views after #{order}: #{leftover_views}")
    tc_parent_entries = Dir.children(File.dirname(fix[:tc_root])).select { |e| e.start_with?(".v", ".s") }
    assert(tc_parent_entries.empty?, "leftover same-length slot view dirs after #{order}: #{tc_parent_entries}")
    assert(!File.exist?(File.join(fix[:tc_root], "build", "vbn")), "shared wrapper dir build/vbn not cleaned up after #{order}")

    idx = JSON.parse(File.read(File.join(out_dir, "0.1.4", "x86_64-linux", "index.json"), encoding: "UTF-8"))
    summary = JSON.parse(File.read(File.join(work_dir, "publish-summary.json"), encoding: "UTF-8"))
    assert(summary["commit_allowed"] == true, "commit_allowed must be true for #{order}")
    run_sequences[order] = summary["start_sequence"]
    run_hashes[order] = idx["packages"].transform_values { |v| v["binary"]["sha256"] }
  end

  assert(run_sequences["critical-path"] != run_sequences["reverse"],
         "expected different start sequences: #{run_sequences.inspect}")
  assert(run_hashes["critical-path"] == run_hashes["reverse"],
         "DETERMINISM FAILED!\ncritical-path: #{run_hashes['critical-path']}\nreverse:       #{run_hashes['reverse']}")
  puts "DETERMINISM_PROOF: PASS (6/6 bit-for-bit identical .tar.xz SHA-256 across critical-path vs reverse):"
  run_hashes["critical-path"].keys.sort.each do |p|
    puts "  #{p.ljust(6)} #{run_hashes['critical-path'][p]}"
  end

  puts "=== [2/6] Critical-path ordering proof (parallel=1) ==="
  work_cp = File.join(tmp, "work-cp1")
  out_cp = File.join(tmp, "out-cp1")
  timings_cp = File.join(tmp, "timings-cp1.json")
  FileUtils.cp(timings_seed, timings_cp)
  out_cp_s, err_cp_s, st_cp = Open3.capture3(
    common_env,
    STREAM_BIN,
    "--repo-root", REPO_ROOT,
    "--ports-dir", fix[:ports_dir],
    "--toolchain-root", fix[:tc_root],
    "--work-dir", work_cp,
    "--out-dir", out_cp,
    "--ports-cache-dir", fix[:cache_dir],
    "--channel", "0.1.4",
    "--arch", "x86_64-linux",
    "--parallel", "1",
    "--total-jobs", "4",
    "--no-pin-cpus",
    "--isolated-prefix",
    "--schedule-order", "critical-path",
    "--timings-file", timings_cp,
    "--no-bootstrap-timings",
    "--build-port-bin", fix[:mock_bp],
    "--source-date-epoch", "1700000000"
  )
  assert(st_cp.success?, "cp1 run failed:\n#{out_cp_s}\n#{err_cp_s}")
  cp_summary = JSON.parse(File.read(File.join(work_cp, "publish-summary.json"), encoding: "UTF-8"))
  seq = cp_summary["start_sequence"]
  # cp(liba)=95 -> unlocks mid1 (cp=90) -> must run before libb (cp=45) -> unlocks mid2 (cp=40) -> unlocks app (cp=30) -> libc (cp=12)
  assert(seq == %w[liba mid1 libb mid2 app libc], "unexpected critical-path order: #{seq.inspect}")
  assert(File.file?(timings_cp), "timings file not saved")
  puts "CRITICAL_PATH_SCHEDULER: PASS (order=#{seq.join(' -> ')})"

  puts "=== [3/6] Failure isolation + atomic commit blocker summary ==="
  work_fail = File.join(tmp, "work-fail")
  out_fail = File.join(tmp, "out-fail")
  fail_env = common_env.merge("MOCK_FAIL_PORT" => "mid1")
  out_f, err_f, st_f = Open3.capture3(
    fail_env,
    STREAM_BIN,
    "--repo-root", REPO_ROOT,
    "--ports-dir", fix[:ports_dir],
    "--toolchain-root", fix[:tc_root],
    "--work-dir", work_fail,
    "--out-dir", out_fail,
    "--ports-cache-dir", fix[:cache_dir],
    "--channel", "0.1.4",
    "--arch", "x86_64-linux",
    "--parallel", "4",
    "--total-jobs", "16",
    "--no-pin-cpus",
    "--isolated-prefix",
    "--timings-file", timings_seed,
    "--no-bootstrap-timings",
    "--build-port-bin", fix[:mock_bp],
    "--source-date-epoch", "1700000000"
  )
  assert(!st_f.success?, "expected non-zero exit when mid1 fails")
  assert(out_f.include?("PUBLISH_PORTS_COMMIT_BLOCKED:"), "missing COMMIT_BLOCKED banner:\n#{out_f}")
  assert(out_f.include?("- mid1 (stage=build"), "missing mid1 in failed summary:\n#{out_f}")
  assert(out_f.include?("- app (blocked_by=mid1)"), "missing app in blocked summary:\n#{out_f}")
  assert(out_f.include?("=== FAILED PORT LOG: mid1 (stage=build, kind=package, last 80 lines) ==="),
         "missing 80-line FAILED PORT LOG header for mid1:\n#{out_f}")
  assert(out_f.include?("MOCK_FAIL_DETAIL_LINE_20 port=mid1"), "missing earlier line inside 80-line tail:\n#{out_f}")
  assert(out_f.include?("MOCK_FAIL_DETAIL_LINE_90 port=mid1"), "missing latest line inside 80-line tail:\n#{out_f}")
  assert(out_f.include?("=== END FAILED PORT LOG: mid1 ==="), "missing END FAILED PORT LOG footer:\n#{out_f}")
  assert(!File.exist?(File.join(out_fail, "0.1.4", "x86_64-linux", "index.json")),
         "index.json must NOT be written when any port fails!")
  fail_summary = JSON.parse(File.read(File.join(work_fail, "publish-summary.json"), encoding: "UTF-8"))
  assert(fail_summary["commit_allowed"] == false, "commit_allowed must be false")
  assert(fail_summary["summary"]["tested"] == 4, "independent ports liba/libb/libc/mid2 must finish: #{fail_summary['summary']}")
  assert(fail_summary["summary"]["failed"] == 1, "expected 1 failed port")
  assert(fail_summary["summary"]["blocked"] == 1, "expected 1 blocked port")
  puts "FAILURE_ISOLATION_AND_ATOMIC_GATE: PASS (4 independent ports finished, mid1 failed, app blocked, index.json blocked)"

  puts "=== [4/6] report-live.rb & report-live verifying/stream-ports dry-run parity ==="
  mock_log = File.join(tmp, "publish-ports.log")
  File.write(mock_log, <<~LOG, encoding: "UTF-8")
    FILC_PHASE stream-ports running
    FILC_PORTS_PARALLEL=4
    FILC_PORTS_TOTAL 6
    FILC_PORT liba building policy=P0-Clean stage=build
    FILC_PORT liba verifying policy=P0-Clean stage=verify
    FILC_STAGE_PROGRESS verify 1/6 liba
    FILC_PORT liba uploaded policy=P0-Clean stage=upload duration=2
    FILC_STAGE_PROGRESS upload 1/6 liba
    FILC_PORT mid1 verifying policy=P0-Clean stage=verify
  LOG
  rep_env = ENV.to_h.merge(
    "CI_PIPELINE_NUMBER" => "999",
    "CI_COMMIT_BRANCH" => "main",
    "CI_COMMIT_SHA" => "0123456789abcdef0123456789abcdef01234567",
    "CI_PIPELINE_EVENT" => "manual"
  )
  payloads = []
  [REPORT_RB, REPORT_PY].each do |bin|
    ro, re, rst = Open3.capture3(
      rep_env, bin,
      "--workflow", "publish-ports",
      "--phase", "progress",
      "--step", "stream-ports",
      "--log", mock_log,
      "--dry-run",
      "--strict"
    )
    assert(rst.success?, "#{bin} dry-run failed:\nOUT:\n#{ro}\nERR:\n#{re}")
    parsed = JSON.parse(ro)
    phases_by_name = parsed["phases"].each_with_object({}) { |ph, h| h[ph["name"]] = ph }
    assert(phases_by_name.dig("liba", "result") == "uploaded", "#{bin}: expected liba=uploaded, got #{phases_by_name['liba']}")
    assert(phases_by_name.dig("mid1", "result") == "verifying", "#{bin}: expected mid1=verifying, got #{phases_by_name['mid1']}")
    assert(phases_by_name.dig("mid1", "stage") == "verify", "#{bin}: expected mid1 stage=verify, got #{phases_by_name['mid1']}")
    payloads << phases_by_name
  end
  assert(payloads[0] == payloads[1], "report-live.rb and report-live phase parity mismatch")
  puts "REPORT_LIVE_VERIFYING_PARITY: PASS (Ruby + Python identical)"

  puts "=== [5/6] Incremental build cache (skipped (cached), dep cascade, FILC_PORTS_FORCE, HEAD-only check) ==="
  cache_manifest = File.join(tmp, "build-cache.json")
  local_art_cache = File.join(tmp, "local-art-cache")
  mock_upload_log = File.join(tmp, "mock-upload.log")
  mock_upload_bin = File.join(tmp, "mock-upload-ports")
  File.write(mock_upload_bin, <<~'RB', encoding: "UTF-8")
    #!/usr/bin/env ruby
    require "json"
    log_path = ENV.fetch("MOCK_UPLOAD_LOG")
    mode = nil
    meta = nil
    ARGV.each_with_index do |a, i|
      if a == "--stage-port-meta"
        mode = "stage"
        meta = ARGV[i + 1]
      elsif a == "--head-verify-meta"
        mode = "head"
        meta = ARGV[i + 1]
      end
    end
    rec = JSON.parse(File.read(meta, encoding: "UTF-8"))
    pname = rec["name"]
    File.open(log_path, "a") { |f| f.puts("#{mode} #{pname}") }
    if mode == "head" && ENV["MOCK_HEAD_MISS_PORT"] == pname
      exit 1
    end
    exit 0
  RB
  File.chmod(0o755, mock_upload_bin)

  run_cached_stream = lambda do |tag, extra_env: {}, force: nil, upload: true|
    wdir = File.join(tmp, "work-cache-#{tag}")
    odir = File.join(tmp, "out-cache-#{tag}")
    File.write(mock_upload_log, "", encoding: "UTF-8")
    cmd = [
      STREAM_BIN,
      "--repo-root", REPO_ROOT,
      "--ports-dir", fix[:ports_dir],
      "--toolchain-root", fix[:tc_root],
      "--work-dir", wdir,
      "--out-dir", odir,
      "--ports-cache-dir", fix[:cache_dir],
      "--channel", "0.1.4",
      "--arch", "x86_64-linux",
      "--parallel", "4",
      "--total-jobs", "16",
      "--no-pin-cpus",
      "--isolated-prefix",
      "--timings-file", timings_seed,
      "--no-bootstrap-timings",
      "--cache-manifest", cache_manifest,
      "--local-artifact-cache", local_art_cache,
      "--upload-url", "http://127.0.0.1:1",
      "--build-port-bin", fix[:mock_bp],
      "--upload-ports-bin", mock_upload_bin,
      "--source-date-epoch", "1700000000"
    ]
    cmd << "--upload" if upload
    cmd.concat(["--force", force]) if force
    out, err, st = Open3.capture3(common_env.merge("MOCK_UPLOAD_LOG" => mock_upload_log).merge(extra_env), *cmd)
    assert(st.success?, "cache run #{tag} failed:\nOUT:\n#{out}\nERR:\n#{err}")
    summary = JSON.parse(File.read(File.join(wdir, "publish-summary.json"), encoding: "UTF-8"))
    report_txt = File.read(File.join(wdir, "ports-report.txt"), encoding: "UTF-8")
    ops = File.readlines(mock_upload_log, chomp: true)
    [summary, report_txt, ops, out]
  end

  # 5a. Cold run populates cache (6 builds + 6 staged uploads)
  s1, _r1, ops1, o1 = run_cached_stream.call("cold")
  assert(s1["cached_ports"].empty?, "cold run must build all 6 ports")
  assert(ops1.count { |l| l.start_with?("stage ") } == 6, "cold run should stage-upload 6 ports: #{ops1}")
  assert(o1.include?("CACHE_CHECK port=liba ") && o1.include?("head=skip reason=no_entry"),
         "cold run must emit CACHE_CHECK no_entry diagnostics:\n#{o1}")

  # Simulate a fresh build-toolchain CI run producing different binary/archive bytes
  # (e.g. non-deterministic ar member mtimes in libc++.a or linker build-IDs in clang)
  # with identical UPSTREAM / llvm / runtime / libc inputs: toolchain_id MUST stay stable!
  File.write(File.join(fix[:tc_root], "build", "bin", "clang"), "#!/bin/sh\n# rebuilt timestamp 2\necho mock-clang\n")
  File.chmod(0o755, File.join(fix[:tc_root], "build", "bin", "clang"))
  File.binwrite(File.join(fix[:tc_root], "pizfix", "lib", "libc++.a"), "!<arch>\nrebuilt-mtime-2\n".b)

  # 5b. Warm run: ALL 6 ports skipped (cached) via HEAD-only check, 0 builds, 0 stage uploads!
  s2, r2, ops2, o2 = run_cached_stream.call("warm")
  assert(s2["toolchain_id"] == s1["toolchain_id"],
         "toolchain_id must stay stable across identical-source toolchain rebuilds: #{s1['toolchain_id']} vs #{s2['toolchain_id']}")
  assert(s2["cached_ports"].sort == %w[app liba libb libc mid1 mid2], "warm run must cache all 6: #{s2['cached_ports']}")
  assert(s2["summary"]["cached"] == 6 && s2["summary"]["tested"] == 0, "expected 6 cached / 0 tested: #{s2['summary']}")
  assert(ops2.count { |l| l.start_with?("head ") } == 6, "warm run must HEAD-verify all 6: #{ops2}")
  assert(ops2.none? { |l| l.start_with?("stage ") }, "warm run must NOT upload anything: #{ops2}")
  assert(r2.include?("skipped (cached)"), "report must label cached ports 'skipped (cached)'")
  assert(o2.include?("CACHE_CHECK port=liba ") && o2.include?("head=hit reason=cached"),
         "warm run must emit CACHE_CHECK head=hit reason=cached:\n#{o2}")

  # 5b-dry: Dry-run with --upload-url (no --upload) ALSO verifies cache via read-only HEAD and skips all 6!
  s2d, r2d, ops2d, o2d = run_cached_stream.call("warm-dry", upload: false)
  assert(s2d["cached_ports"].sort == %w[app liba libb libc mid1 mid2], "warm dry-run must cache all 6: #{s2d['cached_ports']}")
  assert(ops2d.count { |l| l.start_with?("head ") } == 6, "warm dry-run with --upload-url must HEAD-verify all 6: #{ops2d}")
  assert(ops2d.none? { |l| l.start_with?("stage ") }, "warm dry-run must NOT upload anything: #{ops2d}")
  assert(r2d.include?("skipped (cached)"), "warm dry-run report must label cached ports 'skipped (cached)'")
  assert(o2d.include?("head=hit reason=cached"), "warm dry-run must log head=hit reason=cached:\n#{o2d}")

  # 5c. Dependency recipe change (libb) -> libb, mid2, app rebuild; liba, mid1, libc stay cached!
  libb_port = File.join(fix[:ports_dir], "libb", "PORT")
  File.write(libb_port, File.read(libb_port, encoding: "UTF-8") + "\n# recipe tweak to trigger cascade\n", encoding: "UTF-8")
  # Also make libb binary output differ slightly so transitive dep hash changes!
  libb_p2 = File.read(libb_port, encoding: "UTF-8").sub('VERSION="1.0.0"', 'VERSION="1.0.1"')
  _tar_b2, sha_b2 = make_source_tarball(fix[:cache_dir], "libb", "1.0.1")
  libb_p2 = libb_p2.sub(/UPSTREAM_SHA256="[0-9a-f]+"/, "UPSTREAM_SHA256=\"#{sha_b2}\"")
                   .sub('UPSTREAM_URL="https://example.invalid/libb-1.0.0.tar.gz"', 'UPSTREAM_URL="https://example.invalid/libb-1.0.1.tar.gz"')
                   .sub('EXTRACT_DIR="libb-1.0.0"', 'EXTRACT_DIR="libb-1.0.1"')
  File.write(libb_port, libb_p2, encoding: "UTF-8")
  s3, _r3, ops3, _o3 = run_cached_stream.call("cascade")
  assert(s3["cached_ports"].sort == %w[liba libc mid1], "only liba/libc/mid1 should stay cached after libb bump: #{s3['cached_ports']}")
  rebuilt3 = ops3.select { |l| l.start_with?("stage ") }.map { |l| l.split[1] }.sort
  assert(rebuilt3 == %w[app libb mid2], "expected libb/mid2/app to rebuild and upload: #{rebuilt3}")

  # 5d. FILC_PORTS_FORCE=libc forces only libc; FILC_PORTS_FORCE=all forces all 6
  s4, _r4, ops4, _o4 = run_cached_stream.call("force-one", force: "libc")
  assert(s4["cached_ports"].sort == %w[app liba libb mid1 mid2], "FILC_PORTS_FORCE=libc must rebuild only libc: #{s4['cached_ports']}")
  assert(ops4.select { |l| l.start_with?("stage ") } == ["stage libc"], "expected only libc stage-uploaded: #{ops4}")

  s5, _r5, ops5, _o5 = run_cached_stream.call("force-all", force: "all")
  assert(s5["cached_ports"].empty?, "FILC_PORTS_FORCE=all must rebuild all 6")
  assert(ops5.count { |l| l.start_with?("stage ") } == 6, "FILC_PORTS_FORCE=all must stage-upload all 6")

  # 5e. Server HEAD miss for liba forces liba rebuild cleanly
  s6, _r6, ops6, _o6 = run_cached_stream.call("head-miss", extra_env: { "MOCK_HEAD_MISS_PORT" => "liba" })
  assert(!s6["cached_ports"].include?("liba"), "liba must rebuild on server HEAD miss")
  assert(ops6.include?("stage liba"), "liba must re-upload after HEAD miss")
  puts "INCREMENTAL_BUILD_CACHE: PASS (6/6 warm skip, dep cascade, FILC_PORTS_FORCE=<port|all>, HEAD-miss fallback)"

  puts "=== [6/6] LEAK_GATE detail reporting + per-port duration-based timeout scaling ==="
  work_leak = File.join(tmp, "work-leak")
  out_leak = File.join(tmp, "out-leak")
  slow_timings = File.join(tmp, "timings-slow.json")
  File.write(slow_timings, JSON.pretty_generate({
    "schema_version" => 1,
    "durations" => { "liba" => 600, "libc" => 2000 }
  }) + "\n", encoding: "UTF-8")
  leak_env = common_env.merge("MOCK_LEAK_PORT" => "libc")
  out_l, _err_l, st_l = Open3.capture3(
    leak_env,
    STREAM_BIN,
    "--repo-root", REPO_ROOT,
    "--ports-dir", fix[:ports_dir],
    "--toolchain-root", fix[:tc_root],
    "--work-dir", work_leak,
    "--out-dir", out_leak,
    "--ports-cache-dir", fix[:cache_dir],
    "--channel", "0.1.4",
    "--arch", "x86_64-linux",
    "--parallel", "1",
    "--total-jobs", "4",
    "--no-pin-cpus",
    "--isolated-prefix",
    "--ports", "liba,libc",
    "--timings-file", slow_timings,
    "--no-bootstrap-timings",
    "--build-port-bin", fix[:mock_bp],
    "--source-date-epoch", "1700000000"
  )
  assert(!st_l.success?, "expected LEAK_GATE failure when MOCK_LEAK_PORT=libc")
  assert(out_l.include?("LEAK_GATE FAILED for libc"), "missing LEAK_GATE header:\n#{out_l}")
  assert(out_l.include?("FAIL_DETAIL libc"), "missing immediate FAIL_DETAIL block:\n#{out_l}")
  assert(out_l.include?("ELF strings prefix/bin/libc-elf"), "missing exact ELF leak hit detail line:\n#{out_l}")
  assert(out_l.include?("matches exact forbidden infra token"), "missing exact token match reason:\n#{out_l}")
  to_liba = File.read(File.join(work_leak, "observed-timeouts", "liba")).strip
  to_libc = File.read(File.join(work_leak, "observed-timeouts", "libc")).strip
  assert(to_liba == "1500", "expected duration-scaled timeout 1500s (600*2.5) for liba, got #{to_liba}")
  assert(to_libc == "3600", "expected capped timeout 3600s for libc (2000*2.5 capped), got #{to_libc}")
  # Even though libc failed LEAK_GATE during verify, its build completed so its
  # measured duration must still be persisted to timings_file.
  saved_slow = JSON.parse(File.read(slow_timings, encoding: "UTF-8")).fetch("durations")
  assert(saved_slow.key?("libc") && saved_slow["libc"].to_f > 0.0 && saved_slow["libc"].to_f != 2000.0,
         "expected measured build duration to be persisted for verify-failed libc: #{saved_slow.inspect}")
  puts "LEAK_GATE_DETAILS_AND_TIMEOUT_SCALING: PASS (exact ELF hit printed, liba=1500s, libc=3600s, build-ok timing persisted)"

  puts "=== [7/7] Partial timings merge from bootstrap report + conservative missing estimate ==="
  load STREAM_BIN
  boot_dir = File.join(tmp, "boot-reports")
  FileUtils.mkdir_p(boot_dir)
  File.write(File.join(boot_dir, "ports-200.json"), JSON.pretty_generate({
    "ports" => [
      { "name" => "liba", "duration_seconds" => 120 },
      { "name" => "mid1", "duration_seconds" => 900 }
    ]
  }) + "\n", encoding: "UTF-8")
  partial_timings = File.join(tmp, "partial-timings.json")
  File.write(partial_timings, JSON.pretty_generate({
    "schema_version" => 1,
    "durations" => { "liba" => 80, "libb" => 60, "mid2" => 100 }
  }) + "\n", encoding: "UTF-8")
  merged = PublishPortsStream.load_timings(partial_timings, bootstrap_glob: File.join(boot_dir, "ports-*.json"))
  assert(merged["liba"] == 80.0, "timings_file must override bootstrap for liba: #{merged.inspect}")
  assert(merged["mid1"] == 900.0, "missing mid1 must be inherited from bootstrap report: #{merged.inspect}")
  ports_map = PublishPortsStream.load_ports(fix[:ports_dir])
  cp_merged = PublishPortsStream.compute_critical_paths(ports_map, ports_map.keys.sort, merged)
  # Values are [60, 80, 100, 900] -> median = 90.0 -> missing estimate = 270.0 (not 10.0)
  assert(cp_merged["libc"] == 270.0, "expected conservative 3x median (270.0) for unmeasured libc, got #{cp_merged['libc']}")
  puts "TIMINGS_BOOTSTRAP_MERGE_AND_FALLBACK: PASS (mid1=900.0 inherited, unmeasured libc=270.0)"

  puts "=== [8/8] Failure-anchored log tail when failure marker precedes long trailing output ==="
  anchored_log = File.join(tmp, "anchored-fail.log")
  log_lines = (1..40).map { |i| "build step #{i}" }
  log_lines << "STAGE_CMD_FAILED port=ruby stage=test fn=port_test line=56 rc=1 cmd=ruby"
  log_lines << "LoadError: cannot load such file -- digest"
  log_lines.concat((1..120).map { |i| "trailing cleanup line #{i}" })
  File.write(anchored_log, log_lines.join("\n") + "\n", encoding: "UTF-8")
  anchored_tail = PublishPortsStream.read_log_tail(anchored_log, max_lines: 80)
  assert(anchored_tail.any? { |l| l.include?("STAGE_CMD_FAILED port=ruby") },
         "expected anchored tail to include earlier STAGE_CMD_FAILED:\n#{anchored_tail.join("\n")}")
  assert(anchored_tail.any? { |l| l.include?("LoadError: cannot load such file -- digest") },
         "expected anchored tail to include LoadError right after anchor:\n#{anchored_tail.join("\n")}")
  assert(anchored_tail.any? { |l| l.include?("lines omitted between last failure marker and EOF") },
         "expected omission marker between anchor window and EOF:\n#{anchored_tail.join("\n")}")
  assert(anchored_tail.any? { |l| l.include?("trailing cleanup line 120") },
         "expected EOF trailing line to still be included:\n#{anchored_tail.join("\n")}")
  puts "FAILURE_ANCHORED_LOG_TAIL: PASS (anchor window + omission banner + EOF tail)"

  puts "=== [9/11] Toolchain identity reacts to UPSTREAM/patch changes, ignores rebuilt binary mtimes and fetch scripts ==="
  repo_a = File.join(tmp, "tc-repo-a")
  FileUtils.mkdir_p(File.join(repo_a, "llvm"))
  FileUtils.mkdir_p(File.join(repo_a, "scripts"))
  File.write(File.join(repo_a, "UPSTREAM"), <<~UP, encoding: "UTF-8")
    LLVM_COMMIT=1111111111111111111111111111111111111111
    FILC_COMMIT=2222222222222222222222222222222222222222
    MUSL_COMMIT=3333333333333333333333333333333333333333
  UP
  File.write(File.join(repo_a, "llvm", "01.patch"), "diff a\n", encoding: "UTF-8")
  File.write(File.join(repo_a, "scripts", "fetch"), "#!/bin/sh\necho v1\n", encoding: "UTF-8")
  id1 = PublishPortsStream.compute_toolchain_identity(toolchain_root: fix[:tc_root], repo_root: repo_a, channel: "0.1.5", arch: "x86_64-linux")
  File.binwrite(File.join(fix[:tc_root], "pizfix", "lib", "libc++.a"), "!<arch>\nrebuilt-mtime-3\n".b)
  File.write(File.join(repo_a, "scripts", "fetch"), "#!/bin/sh\necho v2-shallow-fix\n", encoding: "UTF-8")
  id2 = PublishPortsStream.compute_toolchain_identity(toolchain_root: fix[:tc_root], repo_root: repo_a, channel: "0.1.5", arch: "x86_64-linux")
  assert(id1 == id2, "toolchain_id must ignore rebuilt binary mtimes and fetch scripts: #{id1} vs #{id2}")
  File.write(File.join(repo_a, "UPSTREAM"), <<~UP, encoding: "UTF-8")
    LLVM_COMMIT=1111111111111111111111111111111111111111
    FILC_COMMIT=4444444444444444444444444444444444444444
    MUSL_COMMIT=3333333333333333333333333333333333333333
  UP
  id3 = PublishPortsStream.compute_toolchain_identity(toolchain_root: fix[:tc_root], repo_root: repo_a, channel: "0.1.5", arch: "x86_64-linux")
  assert(id3 != id1, "toolchain_id MUST change when UPSTREAM changes: #{id1} vs #{id3}")
  puts "TOOLCHAIN_IDENTITY_DETERMINISM: PASS (stable across binary rebuilds + fetch scripts, invalidates on UPSTREAM bump)"

  puts "=== [10/11] Guard 1: Channel <-> release PROVENANCE & built TOOLCHAIN_PROVENANCE verification ==="
  rel_dir = File.join(tmp, "release-0.1.5")
  FileUtils.mkdir_p(rel_dir)
  patch_sha_a = PublishPortsStream.compute_patch_series_sha256(repo_a)
  fake_archive = File.join(rel_dir, "filc-0.1.5-x86_64-linux.tar.xz")
  File.binwrite(fake_archive, "mock-release-archive-bytes-0.1.5\n".b)
  fake_archive_sha = sha256_file(fake_archive)
  File.write(File.join(rel_dir, "SHA256SUMS"), "#{fake_archive_sha}  filc-0.1.5-x86_64-linux.tar.xz\n", encoding: "UTF-8")
  File.write(File.join(rel_dir, "PROVENANCE"), <<~PROV, encoding: "UTF-8")
    ARCHIVE=filc-0.1.5-x86_64-linux.tar.xz
    VERSION=0.1.5
    ARCH=x86_64
    LLVM_COMMIT=1111111111111111111111111111111111111111
    FILC_COMMIT=4444444444444444444444444444444444444444
    MUSL_COMMIT=3333333333333333333333333333333333333333
    PATCH_SERIES_SHA256=#{patch_sha_a}
  PROV
  tc_guard = File.join(tmp, "tc-guard")
  FileUtils.mkdir_p(File.join(tc_guard, "pizfix"))
  File.write(File.join(tc_guard, "TOOLCHAIN_PROVENANCE"), <<~TPROV, encoding: "UTF-8")
    ARCH=x86_64
    LLVM_COMMIT=1111111111111111111111111111111111111111
    FILC_COMMIT=4444444444444444444444444444444444444444
    MUSL_COMMIT=3333333333333333333333333333333333333333
    PATCH_SERIES_SHA256=#{patch_sha_a}
  TPROV

  # 10a: Exact match passes
  out_ok, err_ok, st_ok = Open3.capture3(
    "ruby", STREAM_BIN,
    "--verify-channel-only",
    "--repo-root", repo_a,
    "--toolchain-root", tc_guard,
    "--channel", "0.1.5",
    "--arch", "x86_64-linux",
    "--release-provenance", File.join(rel_dir, "PROVENANCE"),
    "--require-release-provenance"
  )
  assert(st_ok.success?, "matching channel provenance must pass: #{out_ok}\n#{err_ok}")
  assert(out_ok.include?("CHANNEL_TOOLCHAIN_VERIFY: PASS"), "missing PASS marker: #{out_ok}")

  # 10b: Wrong channel / wrong FILC_COMMIT aborts BEFORE any port build or upload
  rel_dir_014 = File.join(tmp, "release-0.1.4")
  FileUtils.mkdir_p(rel_dir_014)
  File.write(File.join(rel_dir_014, "SHA256SUMS"), "#{fake_archive_sha}  filc-0.1.4-x86_64-linux.tar.xz\n", encoding: "UTF-8")
  File.write(File.join(rel_dir_014, "PROVENANCE"), <<~PROV, encoding: "UTF-8")
    ARCHIVE=filc-0.1.4-x86_64-linux.tar.xz
    VERSION=0.1.4
    ARCH=x86_64
    LLVM_COMMIT=1111111111111111111111111111111111111111
    FILC_COMMIT=9999999999999999999999999999999999999999
    MUSL_COMMIT=3333333333333333333333333333333333333333
    PATCH_SERIES_SHA256=#{patch_sha_a}
  PROV
  guard_work = File.join(tmp, "guard-mismatch-work")
  guard_out = File.join(tmp, "guard-mismatch-out")
  out_bad, err_bad, st_bad = Open3.capture3(
    "ruby", STREAM_BIN,
    "--repo-root", repo_a,
    "--ports-dir", fix[:ports_dir],
    "--toolchain-root", tc_guard,
    "--work-dir", guard_work,
    "--out-dir", guard_out,
    "--ports-cache-dir", fix[:cache_dir],
    "--channel", "0.1.4",
    "--arch", "x86_64-linux",
    "--release-provenance", File.join(rel_dir_014, "PROVENANCE"),
    "--require-release-provenance",
    "--build-port-bin", fix[:mock_bp]
  )
  assert(!st_bad.success?, "mismatched channel FILC_COMMIT must abort before builds: #{out_bad}")
  assert(err_bad.include?("CHANNEL_TOOLCHAIN_VERIFY: FAIL") && err_bad.include?("FILC_COMMIT"),
         "expected FILC_COMMIT mismatch error, got: #{err_bad}")
  assert(!Dir.exist?(File.join(guard_work, "observed-jobs")), "no port build may start after channel mismatch")
  assert(!Dir.exist?(guard_out), "no output or upload may be created after channel mismatch")

  # 10c: Overwritten / stale TOOLCHAIN_PROVENANCE aborts BEFORE any port build
  File.write(File.join(tc_guard, "TOOLCHAIN_PROVENANCE"), <<~TPROV, encoding: "UTF-8")
    ARCH=x86_64
    LLVM_COMMIT=1111111111111111111111111111111111111111
    FILC_COMMIT=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
    MUSL_COMMIT=3333333333333333333333333333333333333333
    PATCH_SERIES_SHA256=#{patch_sha_a}
  TPROV
  _out_tc, err_tc, st_tc = Open3.capture3(
    "ruby", STREAM_BIN,
    "--verify-channel-only",
    "--repo-root", repo_a,
    "--toolchain-root", tc_guard,
    "--channel", "0.1.5",
    "--arch", "x86_64-linux",
    "--release-provenance", File.join(rel_dir, "PROVENANCE"),
    "--require-release-provenance"
  )
  assert(!st_tc.success? && err_tc.include?("built toolchain FILC_COMMIT"),
         "overwritten built toolchain provenance must abort: #{err_tc}")

  # 10d: Missing PROVENANCE with --require-release-provenance aborts
  _out_mis, err_mis, st_mis = Open3.capture3(
    "ruby", STREAM_BIN,
    "--verify-channel-only",
    "--repo-root", repo_a,
    "--channel", "0.1.5",
    "--arch", "x86_64-linux",
    "--release-provenance", File.join(tmp, "nonexistent", "PROVENANCE"),
    "--require-release-provenance"
  )
  assert(!st_mis.success? && err_mis.include?("missing release PROVENANCE"),
         "missing required release PROVENANCE must abort: #{err_mis}")

  # 10e: Dry-run (--warn-release-mismatch) with PATCH_SERIES_SHA256 mismatch warns and continues
  rel_dir_mismatch = File.join(tmp, "release-0.1.5-mismatch")
  FileUtils.mkdir_p(rel_dir_mismatch)
  File.write(File.join(rel_dir_mismatch, "PROVENANCE"), <<~PROV, encoding: "UTF-8")
    ARCHIVE=filc-0.1.5-x86_64-linux.tar.xz
    VERSION=0.1.5
    ARCH=x86_64
    LLVM_COMMIT=1111111111111111111111111111111111111111
    FILC_COMMIT=4444444444444444444444444444444444444444
    MUSL_COMMIT=3333333333333333333333333333333333333333
    PATCH_SERIES_SHA256=#{'0' * 64}
  PROV
  out_warn, err_warn, st_warn = Open3.capture3(
    "ruby", STREAM_BIN,
    "--verify-channel-only",
    "--repo-root", repo_a,
    "--channel", "0.1.5",
    "--arch", "x86_64-linux",
    "--release-provenance", File.join(rel_dir_mismatch, "PROVENANCE"),
    "--warn-release-mismatch"
  )
  assert(st_warn.success?, "dry-run --warn-release-mismatch must exit 0 on release mismatch: #{out_warn}\n#{err_warn}")
  assert(out_warn.include?("CHANNEL_TOOLCHAIN_VERIFY: WARN (dry-run)") && out_warn.include?("PATCH_SERIES_SHA256"),
         "expected dry-run WARN with PATCH_SERIES_SHA256 detail, got: #{out_warn}")

  # Full dry-run stream execution with release PATCH_SERIES_SHA256 mismatch builds and exits 0
  rel_dir_dry_stream = File.join(tmp, "release-0.1.4-dry-mismatch")
  FileUtils.mkdir_p(rel_dir_dry_stream)
  repo_upstream = PublishPortsStream.parse_kv_file(File.join(REPO_ROOT, "UPSTREAM"))
  File.write(File.join(rel_dir_dry_stream, "PROVENANCE"), <<~PROV, encoding: "UTF-8")
    ARCHIVE=filc-0.1.4-x86_64-linux.tar.xz
    VERSION=0.1.4
    ARCH=x86_64
    LLVM_COMMIT=#{repo_upstream['LLVM_COMMIT']}
    FILC_COMMIT=#{repo_upstream['FILC_COMMIT']}
    MUSL_COMMIT=#{repo_upstream['MUSL_COMMIT']}
    PATCH_SERIES_SHA256=#{'f' * 64}
  PROV
  dry_warn_work = File.join(tmp, "dry-warn-work")
  dry_warn_out = File.join(tmp, "dry-warn-out")
  out_dw, err_dw, st_dw = Open3.capture3(
    common_env,
    "ruby", STREAM_BIN,
    "--repo-root", REPO_ROOT,
    "--ports-dir", fix[:ports_dir],
    "--toolchain-root", fix[:tc_root],
    "--work-dir", dry_warn_work,
    "--out-dir", dry_warn_out,
    "--ports-cache-dir", fix[:cache_dir],
    "--channel", "0.1.4",
    "--arch", "x86_64-linux",
    "--parallel", "1",
    "--total-jobs", "4",
    "--no-pin-cpus",
    "--isolated-prefix",
    "--ports", "liba",
    "--no-bootstrap-timings",
    "--release-provenance", File.join(rel_dir_dry_stream, "PROVENANCE"),
    "--warn-release-mismatch",
    "--build-port-bin", fix[:mock_bp],
    "--source-date-epoch", "1700000000"
  )
  assert(st_dw.success?, "dry-run stream with --warn-release-mismatch must continue and pass:\nOUT:\n#{out_dw}\nERR:\n#{err_dw}")
  assert(out_dw.include?("CHANNEL_TOOLCHAIN_VERIFY: WARN (dry-run)") && out_dw.include?("PATCH_SERIES_SHA256"),
         "expected dry-run stream WARN marker:\n#{out_dw}")
  dw_summary = JSON.parse(File.read(File.join(dry_warn_work, "publish-summary.json"), encoding: "UTF-8"))
  assert(dw_summary["commit_allowed"] == true && dw_summary["summary"]["tested"] == 1,
         "expected liba to build and verify in dry-run warn mode: #{dw_summary['summary']}")

  # 10f: Guardrails: --warn-release-mismatch is forbidden with --require-release-provenance or --upload
  _o_cf1, e_cf1, st_cf1 = Open3.capture3(
    "ruby", STREAM_BIN,
    "--verify-channel-only",
    "--repo-root", repo_a,
    "--channel", "0.1.5",
    "--arch", "x86_64-linux",
    "--release-provenance", File.join(rel_dir_mismatch, "PROVENANCE"),
    "--require-release-provenance",
    "--warn-release-mismatch"
  )
  assert(!st_cf1.success? && e_cf1.include?("forbidden"),
         "combining --warn-release-mismatch and --require-release-provenance must fail: #{e_cf1}")

  _o_cf2, e_cf2, st_cf2 = Open3.capture3(
    "ruby", STREAM_BIN,
    "--verify-channel-only",
    "--repo-root", repo_a,
    "--channel", "0.1.5",
    "--arch", "x86_64-linux",
    "--release-provenance", File.join(rel_dir_mismatch, "PROVENANCE"),
    "--upload",
    "--warn-release-mismatch"
  )
  assert(!st_cf2.success? && e_cf2.include?("forbidden"),
         "combining --warn-release-mismatch and --upload must fail: #{e_cf2}")

  # 10g: Even in dry-run (--warn-release-mismatch), stale built TOOLCHAIN_PROVENANCE still hard-fails
  _o_tcw, e_tcw, st_tcw = Open3.capture3(
    "ruby", STREAM_BIN,
    "--verify-channel-only",
    "--repo-root", repo_a,
    "--toolchain-root", tc_guard,
    "--channel", "0.1.5",
    "--arch", "x86_64-linux",
    "--release-provenance", File.join(rel_dir_mismatch, "PROVENANCE"),
    "--warn-release-mismatch"
  )
  assert(!st_tcw.success? && e_tcw.include?("built toolchain FILC_COMMIT"),
         "stale built TOOLCHAIN_PROVENANCE must still hard-fail in dry-run warn mode: #{e_tcw}")

  puts "CHANNEL_TOOLCHAIN_GUARD: PASS (exact match OK; live mismatch/stale/missing aborted; dry-run mismatch warns and continues; guardrails enforced)"

  puts "=== [11/11] Guard 2: Exclusive channel lock serializes concurrent runs without clobbering ==="
  lock_path = File.join(tmp, "locks", "publish-ports-0.1.5-x86_64-linux.lock")
  FileUtils.mkdir_p(File.dirname(lock_path))
  holder = File.open(lock_path, File::CREAT | File::RDWR, 0o666)
  holder.flock(File::LOCK_EX)
  t_lock_start = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  releaser = Thread.new do
    sleep 0.5
    holder.flock(File::LOCK_UN)
    holder.close
  end
  out_lk, err_lk, st_lk = Open3.capture3(
    "ruby", STREAM_BIN,
    "--verify-channel-only",
    "--repo-root", repo_a,
    "--channel", "0.1.5",
    "--arch", "x86_64-linux",
    "--release-provenance", File.join(rel_dir, "PROVENANCE"),
    "--require-release-provenance",
    "--lock-file", lock_path
  )
  releaser.join
  lock_elapsed = Process.clock_gettime(Process::CLOCK_MONOTONIC) - t_lock_start
  assert(st_lk.success?, "locked run must succeed after lock release: #{out_lk}\n#{err_lk}")
  assert(out_lk.include?("PUBLISH_PORTS_LOCK: waiting for exclusive lock"), "expected waiting log line: #{out_lk}")
  assert(lock_elapsed >= 0.4, "locked run did not wait for holder (elapsed=#{lock_elapsed}s)")
  puts "CHANNEL_EXCLUSIVE_LOCK: PASS (waited #{lock_elapsed.round(2)}s for active lock holder before proceeding)"

  puts "ALL PUBLISH-PORTS-STREAM TESTS PASSED"
end
