EXTRACT_DIR="diffutils-3.12"
TIER=4
DEPS=""
BUILD_SYSTEM="autotools"
CONFIGURE_ARGS="--disable-nls --disable-rpath"
MAKE_ARGS=""
INSTALL_ARGS=""
TEST_CMD=""
POLICY_CLASS="P2-Package"
POLICY_RATIONALE="Applies a 1-line Fil-C guard (+1/-1 in lib/sigsegv.c) disabling raw sigsegv stack-overflow recovery under __FILC__, matching ports/grep and upstream Fil-C diffutils-3.12."
FILC_ORIGIN_REF="8553fcd026b9:projects/diffutils-3.12"

port_configure() {
  ./configure --prefix="$PIZFIX" --disable-nls --disable-rpath
}

port_test() {
  local out rc
  out="$("$PIZFIX/bin/diff" --version)"
  grep -q 'diff (GNU diffutils) 3\.12' <<<"$out"
  out="$("$PIZFIX/bin/cmp" --version)"
  grep -q 'cmp (GNU diffutils) 3\.12' <<<"$out"

  local td
  td="$(mktemp -d)"
  printf 'line1\nold\nline3\n' > "$td/a.txt"
  printf 'line1\nnew\nline3\n' > "$td/b.txt"

  "$PIZFIX/bin/cmp" -s "$td/a.txt" "$td/a.txt"
  if "$PIZFIX/bin/cmp" -s "$td/a.txt" "$td/b.txt"; then
    rm -rf "$td"
    return 1
  fi
  rc=0
  out="$("$PIZFIX/bin/diff" -u "$td/a.txt" "$td/b.txt")" || rc=$?
  test "$rc" -eq 1
  grep -Fxq -- '-old' <<<"$out"
  grep -Fxq -- '+new' <<<"$out"
  rm -rf "$td"
}

port_package_smoke() {
  local td out rc
  out="$("$PKG_PREFIX/bin/diff" --version)"
  grep -q 'diff (GNU diffutils) 3\.12' <<<"$out"
  out="$("$PKG_PREFIX/bin/cmp" --version)"
  grep -q 'cmp (GNU diffutils) 3\.12' <<<"$out"

  td="$(mktemp -d)"
  printf 'alpha\nbeta\n' > "$td/1.txt"
  printf 'alpha\ngamma\n' > "$td/2.txt"

  "$PKG_PREFIX/bin/cmp" -s "$td/1.txt" "$td/1.txt"
  rc=0
  out="$("$PKG_PREFIX/bin/diff" -u "$td/1.txt" "$td/2.txt")" || rc=$?
  test "$rc" -eq 1
  grep -Fxq -- '-beta' <<<"$out"
  grep -Fxq -- '+gamma' <<<"$out"
  rm -rf "$td"
}
