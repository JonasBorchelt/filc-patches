port_configure() {
  local target="linux-x86_64"
  case "$(uname -m)" in
    aarch64|arm64) target="linux-aarch64" ;;
  esac
  ./Configure "$target" no-asm no-async zlib -DOPENSSL_NO_SECURE_MEMORY \
    --prefix="$PIZFIX/opt/openssl1.1" \
    --openssldir="$PIZFIX/opt/openssl1.1/ssl" \
    --libdir=lib \
    --with-zlib-include="$PIZFIX/include" --with-zlib-lib="$PIZFIX/lib" \
    -I"$PIZFIX/include" -L"$PIZFIX/lib"
}

port_build() {
  make -j"$JOBS"
}

port_install() {
  make -j"$JOBS" install_sw install_ssldirs

  # Place versioned runtime SONAME shared libraries (libssl.so.1.1 / libcrypto.so.1.1)
  # directly in $PIZFIX/lib so OpenSSL 1.1.1 coexists collision-free with OpenSSL 3.6.5
  # (.so.3) and downstream binaries (bin/openssl11, bin/php7.*) resolve them via
  # standard $ORIGIN/../lib RPATH after package-port relocation.
  mkdir -p "$PIZFIX/lib/pkgconfig" "$PIZFIX/bin"
  mv "$PIZFIX/opt/openssl1.1/lib/libcrypto.so.1.1" "$PIZFIX/lib/libcrypto.so.1.1"
  mv "$PIZFIX/opt/openssl1.1/lib/libssl.so.1.1" "$PIZFIX/lib/libssl.so.1.1"
  ln -sf "../../../lib/libcrypto.so.1.1" "$PIZFIX/opt/openssl1.1/lib/libcrypto.so.1.1"
  ln -sf "../../../lib/libssl.so.1.1" "$PIZFIX/opt/openssl1.1/lib/libssl.so.1.1"
  ln -sf "../../../lib/libcrypto.so.1.1" "$PIZFIX/opt/openssl1.1/lib/libcrypto.so"
  ln -sf "../../../lib/libssl.so.1.1" "$PIZFIX/opt/openssl1.1/lib/libssl.so"

  # Move CLI binary to $PIZFIX/bin/openssl11 (keeps opt/openssl1.1/bin/openssl symlink)
  mv "$PIZFIX/opt/openssl1.1/bin/openssl" "$PIZFIX/bin/openssl11"
  ln -sf "../../../bin/openssl11" "$PIZFIX/opt/openssl1.1/bin/openssl"

  # Install versioned pkg-config files pointing into $PIZFIX/opt/openssl1.1
  sed -e 's|^Name: OpenSSL-libcrypto$|Name: OpenSSL11-libcrypto|' \
      -e 's|^Requires\.private:.*|Requires.private: zlib|' \
      "$PIZFIX/opt/openssl1.1/lib/pkgconfig/libcrypto.pc" > "$PIZFIX/lib/pkgconfig/libcrypto11.pc"
  sed -e 's|^Name: OpenSSL-libssl$|Name: OpenSSL11-libssl|' \
      -e 's|^Requires\.private: libcrypto$|Requires.private: libcrypto11|' \
      "$PIZFIX/opt/openssl1.1/lib/pkgconfig/libssl.pc" > "$PIZFIX/lib/pkgconfig/libssl11.pc"
  sed -e 's|^Name: OpenSSL$|Name: OpenSSL11|' \
      -e 's|^Requires: libssl libcrypto$|Requires: libssl11 libcrypto11|' \
      "$PIZFIX/opt/openssl1.1/lib/pkgconfig/openssl.pc" > "$PIZFIX/lib/pkgconfig/openssl11.pc"
}

port_test() {
  local ver modver cflags dgst_out
  ver="$("$PIZFIX/bin/openssl11" version)"
  grep -q 'OpenSSL 1\.1\.1w' <<<"$ver"
  modver="$(pkg-config --modversion openssl11)"
  grep -q '^1\.1\.1w$' <<<"$modver"
  cflags="$(pkg-config --cflags openssl11)"
  grep -Fq "opt/openssl1.1/include" <<<"$cflags"
  local tests="test_dgst test_evp test_rsa test_ec test_x509 test_ssl_new test_cms"
  if ! HARNESS_JOBS="$JOBS" make test TESTS="$tests"; then
    make test V=1 TESTS="$tests"
  fi
  local td
  td="$(mktemp -d)"
  printf 'filc-openssl11-check\n' > "$td/in.txt"
  dgst_out="$("$PIZFIX/bin/openssl11" dgst -sha256 "$td/in.txt")"
  grep -q 'SHA256' <<<"$dgst_out"
  "$PIZFIX/bin/openssl11" enc -aes-256-cbc -pbkdf2 -pass pass:filc-test -in "$td/in.txt" -out "$td/out.enc"
  "$PIZFIX/bin/openssl11" enc -d -aes-256-cbc -pbkdf2 -pass pass:filc-test -in "$td/out.enc" -out "$td/out.txt"
  cmp -s "$td/in.txt" "$td/out.txt"
  "$PIZFIX/bin/openssl11" genpkey -algorithm ED25519 -out "$td/ed.key"
  "$PIZFIX/bin/openssl11" pkeyutl -sign -inkey "$td/ed.key" -rawin -in "$td/in.txt" -out "$td/in.sig"
  "$PIZFIX/bin/openssl11" pkeyutl -verify -inkey "$td/ed.key" -rawin -in "$td/in.txt" -sigfile "$td/in.sig"
  rm -rf "$td"
}

port_package_smoke() {
  local ver dgst_out
  ver="$("$PKG_PREFIX/bin/openssl11" version)"
  grep -q 'OpenSSL 1\.1\.1w' <<<"$ver"
  dgst_out="$(printf 'hello\n' | "$PKG_PREFIX/bin/openssl11" dgst -sha256)"
  grep -q '5891b5b522d5df086d0ff0b110fbd9d21bb4fc7163af34d08286a2e846f6be03' <<<"$dgst_out"
  test -f "$PKG_PREFIX/lib/libssl.so.1.1"
  test -f "$PKG_PREFIX/lib/libcrypto.so.1.1"
  test -f "$PKG_PREFIX/lib/pkgconfig/openssl11.pc"
  grep -Fq "/opt/openssl1.1" "$PKG_PREFIX/lib/pkgconfig/openssl11.pc"
}
