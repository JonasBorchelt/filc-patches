port_configure() {
  local arch ar_bin nm_bin
  arch="$(uname -m)"
  ar_bin="$(command -v "$AR" || echo "$AR")"
  nm_bin="$(command -v "$NM" || echo "$NM")"
  sh ./Configure -des \
    -Dcc="$CC" \
    -Dar="$ar_bin" \
    -Dnm="$nm_bin" \
    -Uusenm \
    -Doptimize="-O2 -g -fno-strict-aliasing -D_GNU_SOURCE" \
    -Dprefix="$PIZFIX" \
    -Dinstallprefix="$PIZFIX" \
    -Dbin="$PIZFIX/bin" \
    -Dprivlib="$PIZFIX/lib/perl5/5.40.5" \
    -Darchlib="$PIZFIX/lib/perl5/5.40.5/${arch}-linux" \
    -Dsiteprefix="$PIZFIX" \
    -Dsitelib="$PIZFIX/lib/perl5/site_perl/5.40.5" \
    -Dsitearch="$PIZFIX/lib/perl5/site_perl/5.40.5/${arch}-linux" \
    -Dman1dir="$PIZFIX/share/man/man1" \
    -Dman3dir="$PIZFIX/share/man/man3" \
    -Dscriptdir="$PIZFIX/bin" \
    -Dsitebin="$PIZFIX/bin" \
    -Dsitescript="$PIZFIX/bin" \
    -Dlibpth=' ' \
    -Dglibpth=' ' \
    -Dloclibpth=' ' \
    -Dplibpth=' ' \
    -Dlocincpth=' ' \
    -Dusethreads \
    -Dmyuname="linux" \
    -Dcf_by="filc-ports" \
    -Dcf_email="ports@example.invalid"
}

port_build() {
  make -j"$JOBS"
}

port_install() {
  make -j"$JOBS" install
}

port_test() {
  local ver
  ver="$("$PIZFIX/bin/perl" -e 'print "$^V\n"')"
  echo "perl version: $ver"
  test "$ver" = "v5.40.5"
  "$PIZFIX/bin/perl" -Mthreads -Mthreads::shared -MStorable -MEncode -MCompress::Raw::Zlib -e '
    my $t = threads->create(sub { return 21 * 2; });
    die "threads" unless $t->join() == 42;
    my $frozen = Storable::freeze({ k => [1, 2, 3] });
    my $thawed = Storable::thaw($frozen);
    die "storable" unless $thawed->{k}[2] == 3;
    my $u = Encode::decode("UTF-8", "h\xc3\xa4llo");
    die "encode" unless length($u) == 5;
    print "PERL_FILC_SMOKE_OK\n";
  ' | grep -Fxq 'PERL_FILC_SMOKE_OK'
  # Prepend /usr/bin:/bin so t/op/magic.t's `env` uses standard host env rather
  # than staged GNU coreutils 9.12 env (which defaults to shell-quoting values
  # when QUOTING_STYLE is unset, even on pipes; magic.t clears %ENV first).
  local test_path="/usr/bin:/bin:$PATH"
  local harness_log="$SRC_DIR/.filc-test-harness.log"
  local rc=0
  set +e
  PATH="$test_path" TEST_JOBS="$JOBS" make test_harness 2>&1 | tee "$harness_log"
  rc=${PIPESTATUS[0]}
  set -e

  ruby - "$SRC_DIR" "$harness_log" "$rc" <<'RB'
require "open3"

src_dir, log_path, raw_rc = ARGV
rc = raw_rc.to_i
lines = File.binread(log_path).force_encoding("UTF-8").encode("UTF-8", invalid: :replace, undef: :replace).lines.map(&:chomp)

APPROVED_PLATFORM_EXCLUSIONS = {
  "cpan/IPC-SysV/t/ipcsysv.t" => "Fil-C runtime returns ENOSYS for semctl GETALL/SETALL (filc_runtime.c:11429-11432, pinned cede3de02b42)",
  "cpan/IPC-SysV/t/sem.t"     => "Fil-C runtime returns ENOSYS for semctl GETALL/SETALL (filc_runtime.c:11429-11432, pinned cede3de02b42)",
  "io/sem.t"                  => "Fil-C runtime returns ENOSYS for semctl GETALL/SETALL (filc_runtime.c:11429-11432, pinned cede3de02b42)",
  "ext/POSIX/t/fenv.t"        => "Fil-C musl flavor stubs fenv assembly; fesetround is a no-op (filc/tests/fenvroundtrip/fenvroundtrip.c:4-8, pinned cede3de02b42)",
}.freeze

files_run = 0
tests_run = 0
lines.reverse_each do |ln|
  if (m = /\AFiles=(\d+),\s*Tests=(\d+)/.match(ln))
    files_run = m[1].to_i
    tests_run = m[2].to_i
    break
  end
end

if files_run < 2500
  warn "PERL_TEST_HARNESS: FAIL (incomplete run: files=#{files_run} < 2500, rc=#{rc})"
  exit(rc.zero? ? 1 : rc)
end

if rc.zero?
  puts "PERL_TEST_HARNESS: PASS (files=#{files_run}, tests=#{tests_run}, unexpected_failures=0, excluded_platform=0)"
  exit 0
end

sidx = lines.rindex { |l| /\ATest Summary Report\b/.match?(l) }
if sidx.nil?
  warn "PERL_TEST_HARNESS: FAIL (rc=#{rc}, missing Test Summary Report)"
  exit rc
end

failed = []
lines[(sidx + 1)..].each do |ln|
  break if /\AFiles=\d+/.match?(ln)
  if (m = /\A(\S+\.t)\s+\(Wstat:\s+(\d+)(?:[^)]*)\)/.match(ln))
    failed << [m[1], m[2].to_i]
  end
end

excluded = []
unexpected = []
failed.each do |tpath, wstat|
  norm = tpath.sub(%r{\A\.\./}, "")
  if APPROVED_PLATFORM_EXCLUSIONS.key?(norm)
    excluded << [norm, wstat, APPROVED_PLATFORM_EXCLUSIONS[norm]]
  else
    unexpected << [tpath, wstat]
  end
end

excluded.each do |norm, wstat, reason|
  puts "PERL_TEST_EXCLUSION: #{norm} -> excluded (platform) [wstat=#{wstat}]: #{reason}"
end

if unexpected.empty? && !excluded.empty?
  puts "PERL_TEST_HARNESS: PASS (files=#{files_run}, tests=#{tests_run}, unexpected_failures=0, excluded_platform=#{excluded.length})"
  exit 0
end

puts "=== PERL FAILURE DIAGNOSTICS ==="
puts "failing_test_files=#{failed.length} unexpected_failures=#{unexpected.length} excluded_platform=#{excluded.length}"
t_dir = File.join(src_dir, "t")
unexpected.first(200).each do |tpath, wstat|
  cmd = ["timeout", "--foreground", "120", "./perl", "harness", "-v", tpath]
  out, st = Open3.capture2e({ "PERL_CORE" => "1", "PATH" => "/usr/bin:/bin:#{ENV['PATH']}" }, *cmd, chdir: t_dir)
  ol = out.force_encoding("UTF-8").encode("UTF-8", invalid: :replace, undef: :replace).lines.map(&:chomp)
  puts "DIAG #{tpath} wstat=#{wstat} rerun_rc=#{st.exitstatus}"
  hdr_i = ol.index { |l| /\bfilc\b[^\n]*\berror:/i.match?(l) }
  if hdr_i
    end_i = ol[hdr_i..].index { |l| /(?:\bfilc panic:|thwarted a futile attempt)/i.match?(l) }
    stop_i = end_i ? [hdr_i + end_i, hdr_i + 2000].min : [ol.length - 1, hdr_i + 200].min
    blk = ol[hdr_i..stop_i]
    hdr = []
    frames = []
    in_fr = false
    in_so = false
    tail_m = nil
    blk.each_with_index do |ln, idx|
      if idx == blk.length - 1 && /(?:\bfilc panic:|thwarted a futile attempt)/i.match?(ln)
        tail_m = ln
        next
      end
      stp = ln.strip
      if !in_fr
        hdr << ln
        if /\Asemantic origin:/i.match?(stp)
          in_so = true
        elsif /\Acheck scheduled at/i.match?(stp)
          in_so = false
          in_fr = true
        elsif idx > 0 && !in_so && (ln.start_with?(" ", "\t")) && !/\Apointer:/i.match?(stp)
          hdr.pop
          in_fr = true
          frames << ln
        end
      else
        frames << ln
      end
    end
    runs = []
    frames.each do |ln|
      if !runs.empty? && runs.last[0].strip == ln.strip
        runs.last[1] += 1
      else
        runs << [ln, 1]
      end
    end
    hdr.each { |l| puts "  #{l}" }
    runs.first(8).each do |ln, cnt|
      puts "  #{ln}"
      puts "      ... #{cnt}x #{ln.strip.split(': ').last}" if cnt > 1
    end
    puts "  #{tail_m}" if tail_m
  else
    picked = []
    ol.each_with_index do |l, idx|
      if /\A(?:not ok |Bail out!|Can't |Compilation failed|panic:|Died |semctl|shmget|msgget)/.match?(l)
        picked << l
        ((idx + 1)..[ol.length - 1, idx + 25].min).each do |j|
          break if /\A(?:ok |not ok )/.match?(ol[j])
          picked << ol[j] if ol[j].start_with?("#") || /error:|undefined|failed|ENOSYS|not implemented/i.match?(ol[j])
        end
      elsif /\A#\s+(?:Failed|got:|expected:|Looks like|Bail out!)|error:|undefined reference|ld\.lld:|ENOSYS/i.match?(l)
        picked << l unless picked.last == l
      end
      break if picked.length >= 40
    end
    sample = picked.empty? ? ol.last(15) : picked.first(40)
    sample.each { |l| puts "  #{l}" }
  end
end
puts "=== END PERL FAILURE DIAGNOSTICS ==="
exit(rc.zero? ? 1 : rc)
RB
}
