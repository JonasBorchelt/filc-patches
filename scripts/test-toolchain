echo "=== Running (i) Runtime semctl(GETALL/SETALL) & prctl(PR_SET_NAME) TGID-comm Regression ==="
cat > "$TEST_DIR/test_semctl_prctl.c" <<'EOF'
#include <errno.h>
#include <stdio.h>
#include <string.h>
#include <sys/ipc.h>
#include <sys/prctl.h>
#include <sys/sem.h>

union semun {
    int val;
    struct semid_ds *buf;
    unsigned short *array;
};

int main(void) {
    /* 1. semctl SETALL / GETALL roundtrip */
    int semid = semget(IPC_PRIVATE, 3, IPC_CREAT | 0600);
    if (semid < 0) {
        fprintf(stderr, "semget failed: %s\n", strerror(errno));
        return 1;
    }
    unsigned short set_vals[3] = {11, 22, 33};
    unsigned short get_vals[3] = {0, 0, 0};
    union semun arg;
    arg.array = set_vals;
    if (semctl(semid, 0, SETALL, arg) < 0) {
        fprintf(stderr, "semctl(SETALL) failed: %s\n", strerror(errno));
        semctl(semid, 0, IPC_RMID);
        return 2;
    }
    arg.array = get_vals;
    if (semctl(semid, 0, GETALL, arg) < 0) {
        fprintf(stderr, "semctl(GETALL) failed: %s\n", strerror(errno));
        semctl(semid, 0, IPC_RMID);
        return 3;
    }
    semctl(semid, 0, IPC_RMID);
    if (get_vals[0] != 11 || get_vals[1] != 22 || get_vals[2] != 33) {
        fprintf(stderr, "semctl mismatch: %u %u %u\n", get_vals[0], get_vals[1], get_vals[2]);
        return 4;
    }

    /* 2. prctl(PR_SET_NAME) updates both current thread and TGID leader /proc/self/comm */
    const char *want = "filc_tgid_ok";
    if (prctl(PR_SET_NAME, want, 0, 0, 0) != 0) {
        fprintf(stderr, "prctl(PR_SET_NAME) failed: %s\n", strerror(errno));
        return 5;
    }
    char got_prctl[16] = {0};
    if (prctl(PR_GET_NAME, got_prctl, 0, 0, 0) != 0 || strcmp(got_prctl, want) != 0) {
        fprintf(stderr, "prctl(PR_GET_NAME) mismatch: '%s'\n", got_prctl);
        return 6;
    }
    FILE *fp = fopen("/proc/self/comm", "r");
    if (fp) {
        char got_comm[32] = {0};
        if (!fgets(got_comm, sizeof(got_comm), fp)) {
            fclose(fp);
            fprintf(stderr, "failed to read /proc/self/comm\n");
            return 7;
        }
        fclose(fp);
        size_t len = strlen(got_comm);
        while (len > 0 && (got_comm[len - 1] == '\n' || got_comm[len - 1] == '\r'))
            got_comm[--len] = '\0';
        if (strcmp(got_comm, want) != 0) {
            fprintf(stderr, "/proc/self/comm mismatch: got '%s', want '%s'\n", got_comm, want);
            return 8;
        }
    }

    printf("SEMCTL_PRCTL_OK\n");
    return 0;
}
EOF

cat > "$TEST_DIR/trap_semctl_oob.c" <<'EOF'
#include <errno.h>
#include <stdio.h>
#include <stdlib.h>
#include <sys/ipc.h>
#include <sys/sem.h>
#include <sys/wait.h>
#include <unistd.h>

union semun {
    unsigned short *array;
};

static int run_oob_child(int semid, int cmd) {
    fflush(NULL);
    pid_t pid = fork();
    if (pid < 0)
        return -1;
    if (pid == 0) {
        /* Fil-C rounds allocation upper bounds to FILC_MINALIGN (16 bytes),
           so allocate exactly 16 bytes (8 shorts) against sem_nsems=16 (32 bytes). */
        unsigned short *tiny = (unsigned short *)calloc(8, sizeof(unsigned short));
        if (!tiny)
            _exit(10);
        union semun arg;
        arg.array = tiny;
        int rc = semctl(semid, 0, cmd, arg);
        printf("UNEXPECTED_SEMCTL_OOB_SURVIVED cmd=%d rc=%d errno=%d\n", cmd, rc, errno);
        fflush(stdout);
        _exit(0);
    }
    int status = 0;
    if (waitpid(pid, &status, 0) < 0)
        return -2;
    if (!WIFSIGNALED(status)) {
        fprintf(stderr, "semctl OOB child (cmd=%d) did not trap by signal (status=0x%x)\n", cmd, status);
        return 1;
    }
    return 0;
}

int main(void) {
    int semid = semget(IPC_PRIVATE, 16, IPC_CREAT | 0600);
    if (semid < 0)
        return 1;
    int r_get = run_oob_child(semid, GETALL);
    int r_set = run_oob_child(semid, SETALL);
    semctl(semid, 0, IPC_RMID);
    if (r_get != 0)
        return 2;
    if (r_set != 0)
        return 3;
    printf("SEMCTL_OOB_TRAPPED_OK\n");
    return 0;
}
EOF

