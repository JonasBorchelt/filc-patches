  p201_report = File.join(td, "p201-leak-report.json")
  p201_env = BASE_ENV.merge("PATH" => "#{p201_bin}:#{ENV['PATH']}")
  p201_out_s, p201_err_s, p201_st = Open3.capture3(
    p201_env,
    "ruby", PACKAGE_SCRIPT,
    "--repo-root", p201_repo,
    "--work-dir", p201_work,
    "--pizfix", p201_pizfix,
    "--neutral-prefix", p201_pizfix,
    "--ports-cache-dir", p201_cache,
    "--out-dir", p201_out,
    "--leak-report", p201_report,
    "--channel", "0.1.4",
    "--arch", "x86_64-linux"
  )
  assert(p201_st.success?, "p201 94-hit fixture should pass after bash RPATH fix + upstream provenance: #{p201_out_s}\n#{p201_err_s}")
  assert(p201_out_s.include?("LEAK_GATE PROVENANCE ALLOWED: 54 generic hit(s) across 12 package(s)"),
         "expected 54 provenance-allowed hits across 12 packages, got:\n#{p201_out_s}")
  assert(File.file?(p201_report), "missing leak-gate JSON report")
  rep = JSON.parse(File.read(p201_report))
  assert(rep["provenance_allowed_total"] == 54, "expected 54 provenance hits in JSON report, got #{rep['provenance_allowed_total']}")
  assert(rep["failed_hits_total"] == 0, "expected 0 failed hits in JSON report")
  py_prov = rep.dig("provenance_allowed", "python") || []
  assert(py_prov.any? { |e| e["upstream_source"].include?("pip-24.0-py3-none-any.whl!pip/_vendor/rich/highlighter.py") },
         "expected nested .whl provenance for python pip vendor")
  rb_prov = rep.dig("provenance_allowed", "ruby") || []
  assert(rb_prov.any? { |e| e["upstream_source"].include?("rbs-3.4.0.gem!stdlib/socket/0/socket.rbs") },
         "expected nested .gem provenance for ruby rbs")
  # Metadata/report must NEVER store plaintext matched tokens, only SHA-256 hashes
  rep.fetch("provenance_allowed").each do |pkg_k, entries|
    entries.each do |entry|
      assert(!entry.key?("token"), "plaintext token leaked in provenance_allowed for #{pkg_k}: #{entry.inspect}")
      assert(/\A[0-9a-f]{64}\z/.match?(entry["token_sha256"].to_s),
             "missing valid token_sha256 in provenance_allowed for #{pkg_k}: #{entry.inspect}")
    end
  end

  # Verify bash loadable builtins inside the packaged tarball were relocated to $ORIGIN/..
  bash_ext = File.join(td, "bash-ext")
  FileUtils.mkdir_p(bash_ext)
  p201_idx = JSON.parse(File.read(File.join(p201_out, "0.1.4", "x86_64-linux", "index.json")))
  bash_entry = p201_idx.dig("packages", "bash")
  bash_rel = bash_entry.dig("binary", "path")
  bash_sha = bash_entry.dig("binary", "sha256")
  assert(bash_rel == "bin/bash-1.0-r1-x86_64-linux-#{bash_sha[0, 12]}.tar.xz",
         "bash binary must use content-addressed filename, got: #{bash_rel.inspect}")
  bash_tar = File.join(p201_out, "0.1.4", "x86_64-linux", bash_rel)
  _bto, bterr, btst = Open3.capture3("tar", "-xf", bash_tar, "-C", bash_ext)
  assert(btst.success?, "extract bash tarball failed: #{bterr}")
  accept_raw = File.binread(File.join(bash_ext, "prefix", "lib", "bash", "accept"))
  assert(accept_raw.include?("RPATH=$ORIGIN/.."), "bash builtin RPATH must be relocated to $ORIGIN/.., got: #{accept_raw.inspect}")

  # 7. Negative tests: exact infra tokens MUST ALWAYS abort even when embedded in upstream files,
  #    and unverified generic IPs (including second IP after a valid upstream IP) MUST abort.
  neg_ip = ip4(198, 51, 100, 10)
  neg_path = "/#{srv_seg}/example-ci/artifacts"
  neg_unverified_ip = ip4(192, 168, 77, 88)

  # 7a. Exact infra IP embedded in BOTH upstream source and staged file -> MUST ABORT!
  register_p201_port.call(
    "neg-exact-ip",
    { "share/doc/upstream.txt" => "upstream example #{neg_ip}:8080\n" },
    { "neg-exact-ip-1.0/upstream.txt" => "upstream example #{neg_ip}:8080\n" }
  )
  # 7b. Exact infra path embedded in BOTH upstream source and staged file -> MUST ABORT!
  register_p201_port.call(
    "neg-exact-path",
    { "share/doc/path.txt" => "dir = #{neg_path}\n" },
    { "neg-exact-path-1.0/path.txt" => "dir = #{neg_path}\n" }
  )
  # 7c. Exact infra org embedded in upstream file -> MUST ABORT!
  register_p201_port.call(
    "neg-exact-org",
    { "share/doc/org.txt" => "url = https://example.invalid/Internal-Forge-Org/repo\n" },
    { "neg-exact-org-1.0/org.txt" => "url = https://example.invalid/Internal-Forge-Org/repo\n" }
  )
  # 7d. Valid upstream IP followed by an unverified second private IP in the SAME file -> MUST ABORT!
  register_p201_port.call(
    "neg-second-ip",
    { "share/doc/mixed.txt" => "valid #{ip4(192, 168, 1, 1)} and injected #{neg_unverified_ip}\n" },
    { "neg-second-ip-1.0/mixed.txt" => "valid #{ip4(192, 168, 1, 1)} only\n" }
  )

  _ngo, ngerr, ngst = Open3.capture3(
    p201_env,
    "ruby", PACKAGE_SCRIPT,
    "--repo-root", p201_repo,
    "--work-dir", p201_work,
    "--pizfix", p201_pizfix,
    "--neutral-prefix", p201_pizfix,
    "--ports", "neg-exact-ip,neg-exact-path,neg-exact-org,neg-second-ip",
    "--ports-cache-dir", p201_cache,
    "--out-dir", File.join(td, "p201-neg-out"),
    "--channel", "0.1.4",
    "--arch", "x86_64-linux"
  )
  assert(!ngst.success?, "negative security cases must abort")
  assert(ngerr.include?("LEAK_GATE FAILED across 4 package(s)"), "all 4 negative packages must fail, got:\n#{ngerr}")
  assert(ngerr.include?("[neg-exact-ip]") && ngerr.include?("matches exact forbidden infra token"),
         "neg-exact-ip must hit exact token rule, got:\n#{ngerr}")
  assert(ngerr.include?("[neg-exact-path]") && ngerr.include?("matches exact forbidden infra token"),
         "neg-exact-path must hit exact token rule, got:\n#{ngerr}")
  assert(ngerr.include?("[neg-exact-org]") && ngerr.include?("matches exact forbidden infra token"),
         "neg-exact-org must hit exact token rule, got:\n#{ngerr}")
  assert(ngerr.include?("[neg-second-ip]") && ngerr.include?("unverified generic private_ipv4_192"),
         "neg-second-ip must catch second unverified IP, got:\n#{ngerr}")
  # Secret token values must NOT be echoed in stderr output
  assert(!ngerr.include?(neg_ip), "stderr must not echo secret exact IP token")
  assert(!ngerr.include?("Internal-Forge-Org"), "stderr must not echo secret org token")

  # 8. Overlapping --watch-done-file + --parallel 2 packaging AND parallel upload
  #    with atomic commit-index abort when a single upload fails
  ov_work = File.join(td, "ov-work")
  ov_state = File.join(ov_work, "ports-state")
  ov_out = File.join(td, "ov-out")
  ov_done = File.join(ov_work, "build.done")
  FileUtils.mkdir_p([ov_state, ov_out])
  File.write(File.join(ov_state, "ports-plan.json"), JSON.generate("total" => 2, "ports" => %w[bison rsync]))

  # Launch package-port in watch mode BEFORE manifests appear
  pkg_out = +""
  pkg_err = +""
  pkg_status = nil
  pkg_thr = Thread.new do
    pkg_out, pkg_err, pkg_status = Open3.capture3(
      p201_env,
      "ruby", PACKAGE_SCRIPT,
      "--repo-root", p201_repo,
      "--work-dir", ov_work,
      "--pizfix", p201_pizfix,
      "--neutral-prefix", p201_pizfix,
      "--ports-cache-dir", p201_cache,
      "--out-dir", ov_out,
      "--watch-done-file", ov_done,
      "--parallel", "2",
      "--channel", "0.1.4",
      "--arch", "x86_64-linux"
    )
  end

  # Simulate staggered port completions while package-port is watching
  %w[bison rsync].each do |pname|
    sleep 0.2
    FileUtils.cp(File.join(p201_state, "#{pname}.manifest.json"), File.join(ov_state, "#{pname}.manifest.json"))
    File.write(File.join(ov_state, "#{pname}.json"), JSON.generate("name" => pname, "status" => "tested"))
  end
  sleep 0.2
  File.write(ov_done, "done\n")
  pkg_thr.join(30)
  assert(pkg_status&.success?, "watch-done-file packaging failed: #{pkg_out}\n#{pkg_err}")
  assert(pkg_out.include?("FILC_PORT bison packaging") && pkg_out.include?("FILC_PORT bison packaged"),
         "missing live packaging markers for bison: #{pkg_out}")
  assert(pkg_out.include?("FILC_STAGE_PROGRESS package 2/2 "),
         "missing package stage progress 2/2: #{pkg_out}")

  # Atomic commit-index guard: fail one PUT in mock server and verify commit-index is NEVER called
  ov_ch_dir = File.join(ov_out, "0.1.4", "x86_64-linux")
  File.write(File.join(ov_ch_dir, "index.json.minisig"), "untrusted comment: test\nAA==\ntrusted comment: t\nAA==\n")
  File.write(File.join(ov_ch_dir, "SHA256SUMS.minisig"), "untrusted comment: test\nAA==\ntrusted comment: t\nAA==\n")

  commit_called = false
  with_mock_http_server(lambda do |s, method, path, _req_head, _body|
    if method == "HEAD"
      s.write("HTTP/1.1 404 Not Found\r\nContent-Length: 2\r\nConnection: close\r\n\r\n{}")
    elsif method == "PUT" && path.include?("/bin/rsync-")
      s.write("HTTP/1.1 500 Internal Server Error\r\nContent-Length: 4\r\nConnection: close\r\n\r\nfail")
    elsif method == "PUT"
      resp = JSON.generate("ok" => true)
      s.write("HTTP/1.1 201 Created\r\nContent-Type: application/json\r\nContent-Length: #{resp.bytesize}\r\nConnection: close\r\n\r\n#{resp}")
    elsif method == "POST"
      commit_called = true
      resp = JSON.generate("ok" => true, "packages" => 2)
      s.write("HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: #{resp.bytesize}\r\nConnection: close\r\n\r\n#{resp}")
    end
  end) do |fail_port|
    _fuo, _fue, fust = capture3_with_timeout(
      30,
      BASE_ENV.merge("FILC_PORTS_UPLOAD_TOKEN" => "ci-upload-secret"),
      "ruby", UPLOAD_SCRIPT,
      "--channel-dir", ov_ch_dir,
      "--channel", "0.1.4",
      "--arch", "x86_64-linux",
      "--parallel", "2",
      "--allow-unsigned-test",
      "--base-url", "http://127.0.0.1:#{fail_port}"
    )
    assert(!fust.success?, "upload-ports must fail when one package PUT fails")
    assert(!commit_called, "commit-index MUST NOT be called when any package upload failed")
  end
  # 9. Verify explicit --xz-threads 1 produces deterministic .tar.xz output
  out_t1a = File.join(td, "out-t1a")
  out_t1b = File.join(td, "out-t1b")
  _t1ao, t1ae, t1ast = Open3.capture3(
    { "FILC_LEAK_EXACT_TOKENS" => TEST_EXACT_TOKENS, "SOURCE_DATE_EPOCH" => "1700000000" },
    "ruby", PACKAGE_SCRIPT,
    "--repo-root", repo,
    "--work-dir", work,
    "--pizfix", pizfix,
    "--neutral-prefix", pizfix,
    "--ports-cache-dir", cache,
    "--out-dir", out_t1a,
    "--channel", "0.1.4",
    "--arch", "x86_64-linux",
    "--ports", "demo",
    "--parallel", "1",
    "--xz-threads", "1"
  )
  assert(t1ast.success?, "package-port --xz-threads 1 run A failed: #{t1ae}")
  _t1bo, t1be, t1bst = Open3.capture3(
    { "FILC_LEAK_EXACT_TOKENS" => TEST_EXACT_TOKENS, "SOURCE_DATE_EPOCH" => "1700000000" },
    "ruby", PACKAGE_SCRIPT,
    "--repo-root", repo,
    "--work-dir", work,
    "--pizfix", pizfix,
    "--neutral-prefix", pizfix,
    "--ports-cache-dir", cache,
    "--out-dir", out_t1b,
    "--channel", "0.1.4",
    "--arch", "x86_64-linux",
    "--ports", "demo",
    "--parallel", "1",
    "--xz-threads", "1"
  )
  assert(t1bst.success?, "package-port --xz-threads 1 run B failed: #{t1be}")
  bin_t1a = Dir.glob(File.join(out_t1a, "0.1.4", "x86_64-linux", "bin", "demo-*.tar.xz")).first
  bin_t1b = Dir.glob(File.join(out_t1b, "0.1.4", "x86_64-linux", "bin", "demo-*.tar.xz")).first
  assert(bin_t1a && bin_t1b && File.size(bin_t1a) > 0 && File.size(bin_t1b) > 0,
         "package-port --xz-threads 1 must produce non-empty .tar.xz archives")
  _xto, xte, xtst = Open3.capture3("xz", "-t", bin_t1a, bin_t1b)
  assert(xtst.success?, "xz -t failed for --xz-threads 1 archives: #{xte}")
  tar_ver, = Open3.capture3("tar", "--version")
  if tar_ver.include?("GNU tar")
    assert(File.binread(bin_t1a) == File.binread(bin_t1b),
           "package-port --xz-threads 1 must produce byte-identical deterministic .tar.xz archives on GNU tar")
  end

  # 10. Verify two-phase watch mode transitions cleanly from throttled background
  #     (--bg-throttle --bg-parallel 1 --bg-xz-threads 1) to full post-build speed
  #     (--parallel 4 --xz-threads 0) when the done-marker appears.
  out_tp = File.join(td, "out-twophase")
  done_tp = File.join(td, "twophase.done")
  File.unlink(done_tp) if File.exist?(done_tp)
  File.write(File.join(state, "demo.json"), JSON.generate("name" => "demo", "status" => "tested"))
  tp_out = +""
  tp_err = +""
  tp_st = nil
  tp_thr = Thread.new do
    tp_out, tp_err, tp_st = Open3.capture3(
      { "FILC_LEAK_EXACT_TOKENS" => TEST_EXACT_TOKENS, "SOURCE_DATE_EPOCH" => "1700000000" },
      "ruby", PACKAGE_SCRIPT,
      "--repo-root", repo,
      "--work-dir", work,
      "--pizfix", pizfix,
      "--neutral-prefix", pizfix,
      "--ports-cache-dir", cache,
      "--out-dir", out_tp,
      "--channel", "0.1.4",
      "--arch", "x86_64-linux",
      "--ports", "demo",
      "--watch-done-file", done_tp,
      "--bg-throttle",
      "--bg-parallel", "1",
      "--bg-xz-threads", "1",
      "--parallel", "4",
      "--xz-threads", "0"
    )
  end
  sleep 0.6
  File.write(done_tp, "done\n")
  tp_thr.join
  assert(tp_st && tp_st.success?, "two-phase watch package-port failed: #{tp_err}\n#{tp_out}")
  assert(tp_out.include?("PACKAGER_MODE: phase=background parallel=1 xz_threads=1"),
         "missing background mode banner: #{tp_out}")
  assert(tp_out.include?("PACKAGER_MODE: phase=post-build parallel=4 xz_threads=0 throttle=off"),
         "missing post-build mode banner: #{tp_out}")
  assert(tp_out.include?("FILC_PORT demo packaged "), "missing demo packaged marker: #{tp_out}")

  # 11. Verify non-watch post-build packaging (--parallel 4 --xz-threads 0) and
  #     parallel --sign-only --parallel 4 per-port signing/signed live markers.
  out_pb = File.join(td, "out-postbuild")
  pb_out, pb_err, pb_st = Open3.capture3(
    p201_env,
    "ruby", PACKAGE_SCRIPT,
    "--repo-root", p201_repo,
    "--work-dir", p201_work,
    "--pizfix", p201_pizfix,
    "--neutral-prefix", p201_pizfix,
    "--ports-cache-dir", p201_cache,
    "--out-dir", out_pb,
    "--ports", "bison,rsync",
    "--parallel", "4",
    "--xz-threads", "0",
    "--channel", "0.1.4",
    "--arch", "x86_64-linux"
  )
  assert(pb_st.success?, "post-build parallel package-port failed: #{pb_err}\n#{pb_out}")
  assert(pb_out.include?("PACKAGER_MODE: phase=post-build parallel=4 xz_threads=0 throttle=off"),
         "missing non-watch post-build banner: #{pb_out}")
  assert(pb_out.include?("FILC_PORT bison packaged ") && pb_out.include?("FILC_PORT rsync packaged "),
         "missing per-port packaged markers: #{pb_out}")
  assert(pb_out.include?("FILC_STAGE_PROGRESS package 2/2 "),
         "missing package 2/2 stage progress: #{pb_out}")

  fake_sign_bin = File.join(td, "fake-minisign-bin")
  FileUtils.mkdir_p(fake_sign_bin)
  fake_minisign = File.join(fake_sign_bin, "minisign")
  File.write(fake_minisign, <<~SH)
    #!/usr/bin/env ruby
    out_sig = nil
    ARGV.each_with_index do |arg, idx|
      out_sig = ARGV[idx + 1] if arg == "-x"
    end
    raise "missing -x" unless out_sig
    File.write(out_sig, "untrusted comment: fake\\nAA==\\ntrusted comment: fake\\nAA==\\n")
  SH
  File.chmod(0o755, fake_minisign)

  sign_env = {
    "PATH" => "#{fake_sign_bin}:#{ENV['PATH']}",
    "FILC_PORTS_MINISIGN_KEY" => "untrusted comment: fake key\nRWQf6LRCGA9i53mlYecO4IzT51TGPpvWucNSCh1CBM0QTaLn73Y7GFO3\n"
  }
  sg_out, sg_err, sg_st = Open3.capture3(
    sign_env,
    "ruby", PACKAGE_SCRIPT,
    "--sign-only",
    "--parallel", "4",
    "--out-dir", out_pb,
    "--channel", "0.1.4",
    "--arch", "x86_64-linux"
  )
  assert(sg_st.success?, "parallel --sign-only failed: #{sg_err}\n#{sg_out}")
  assert(sg_out.include?("FILC_PORT bison signing stage=sign") && sg_out.include?("FILC_PORT bison signed stage=sign"),
         "missing bison signing/signed markers: #{sg_out}")
  assert(sg_out.include?("FILC_PORT rsync signing stage=sign") && sg_out.include?("FILC_PORT rsync signed stage=sign"),
         "missing rsync signing/signed markers: #{sg_out}")
  assert(sg_out.include?("FILC_STAGE_PROGRESS sign 2/2 "),
         "missing sign 2/2 stage progress: #{sg_out}")
  assert(sg_out.include?("PACKAGE_PORT: SIGNED channel=0.1.4 arch=x86_64-linux packages=2 parallel=2"),
         "missing SIGNED summary banner: #{sg_out}")
  pb_ch_dir = File.join(out_pb, "0.1.4", "x86_64-linux")
  assert(File.file?(File.join(pb_ch_dir, "index.json.minisig")) && File.file?(File.join(pb_ch_dir, "SHA256SUMS.minisig")),
         "missing .minisig outputs after --sign-only")

  # 12. Generic hardlink preservation & identical-file deduplication:
  #     A package with 50 hardlinks (plus 5 independent copies) of a 1 MiB incompressible
  #     ELF binary must stay small (~2 MiB across two RPATH depths, not ~55 MiB), run
  #     strip once per unique (inode, rpath), preserve hardlinks in tar, and print Top 10 sizes.
  hl_repo = File.join(td, "hl-repo")
  hl_work = File.join(td, "hl-work")
  hl_pizfix = File.join(td, "hl-pizfix")
  hl_cache = File.join(hl_work, "ports-cache")
  hl_state = File.join(hl_work, "ports-state")
  hl_out = File.join(td, "hl-out")
  hl_tools = File.join(td, "hl-tools")
  strip_log = File.join(td, "strip-calls.log")
  FileUtils.mkdir_p([
    File.join(hl_repo, "ports", "biggit"),
    File.join(hl_pizfix, "bin"),
    File.join(hl_pizfix, "libexec", "git-core"),
    hl_cache,
    hl_state,
    hl_out,
    hl_tools
  ])
  FileUtils.cp(File.join(repo, "UPSTREAM"), File.join(hl_repo, "UPSTREAM"))
  setup_fake_patchelf(hl_tools)
  # Replace no-op strip with one that logs invocations and strips a trailing debug marker
  File.write(File.join(hl_tools, "strip"), <<~SH)
    #!/usr/bin/env ruby
    log_path = ENV["TEST_STRIP_LOG"]
    path = ARGV.last
    File.open(log_path, "a") { |f| f.puts(path) } if log_path && !log_path.empty?
    raw = File.binread(path)
    trimmed = raw.delete_suffix("DEBUG_TAIL_MARKER".b)
    # Rewrite via temp file + rename just like GNU strip (which breaks hardlinks if unhandled)
    tmp = path + ".strip.tmp"
    File.binwrite(tmp, trimmed)
    File.chmod(File.stat(path).mode & 0o777, tmp)
    File.rename(tmp, path)
  SH
  File.chmod(0o755, File.join(hl_tools, "strip"))

  hl_src_tmp = File.join(td, "biggit-2.56.0.tar.gz")
  hl_src_sha = make_tar_gz(hl_src_tmp, { "biggit-2.56.0/README" => "biggit upstream\n" })
  FileUtils.cp(hl_src_tmp, File.join(hl_cache, "biggit-2.56.0-#{hl_src_sha[0, 12]}-biggit-2.56.0.tar.gz"))
  File.write(File.join(hl_repo, "ports", "biggit", "PORT"), <<~PORT)
    NAME=biggit
    VERSION=2.56.0
    LICENSE=GPL-2.0-only
    UPSTREAM_URL=https://example.invalid/biggit-2.56.0.tar.gz
    UPSTREAM_SHA256=#{hl_src_sha}
    EXTRACT_DIR=biggit-2.56.0
    TIER=5
    DEPS=""
    BUILD_SYSTEM=autotools
    POLICY_CLASS=P2-Package
  PORT

  # Deterministic 1 MiB incompressible pseudo-random payload (LCG byte stream)
  rng = Random.new(42)
  big_payload = "\x7fELF\x02\x01\x01\x00RPATH=/opt/filc/0.1.4/pizfix/lib\x00".b +
                rng.bytes(1_048_576) + "DEBUG_TAIL_MARKER".b
  git_bin = File.join(hl_pizfix, "bin", "git")
  File.binwrite(git_bin, big_payload)
  File.chmod(0o755, git_bin)

  hl_manifest_files = ["bin/git"]
  # 50 hardlinks in libexec/git-core pointing to the same 1 MiB ELF
  (1..50).each do |i|
    rel = format("libexec/git-core/git-cmd-%02d", i)
    dst = File.join(hl_pizfix, rel)
    File.link(git_bin, dst)
    hl_manifest_files << rel
  end
  # Plus 5 separate byte-identical copies (simulating cp without hardlinks)
  (51..55).each do |i|
    rel = format("libexec/git-core/git-cmd-%02d", i)
    dst = File.join(hl_pizfix, rel)
    File.binwrite(dst, big_payload)
    File.chmod(0o755, dst)
    hl_manifest_files << rel
  end
  # Plus symlinks: one relative (INSTALL_SYMLINKS=YesPlease style) and one absolute inside pizfix
  File.symlink("../../bin/git", File.join(hl_pizfix, "libexec", "git-core", "git-rel-sym"))
  File.symlink(File.join(hl_pizfix, "bin", "git"), File.join(hl_pizfix, "libexec", "git-core", "git-abs-sym"))
  hl_manifest_files << "libexec/git-core/git-rel-sym"
  hl_manifest_files << "libexec/git-core/git-abs-sym"

  File.write(File.join(hl_state, "biggit.manifest.json"), JSON.pretty_generate(
    "port" => "biggit",
    "files" => hl_manifest_files
  ) + "\n")

  hl_env = BASE_ENV.merge(
    "PATH" => "#{hl_tools}:#{ENV['PATH']}",
    "TEST_STRIP_LOG" => strip_log
  )
  hl_out_s, hl_err_s, hl_st = Open3.capture3(
    hl_env,
    "ruby", PACKAGE_SCRIPT,
    "--repo-root", hl_repo,
    "--work-dir", hl_work,
    "--pizfix", hl_pizfix,
    "--neutral-prefix", hl_pizfix,
    "--ports-cache-dir", hl_cache,
    "--out-dir", hl_out,
    "--channel", "0.1.4",
    "--arch", "x86_64-linux"
  )
  assert(hl_st.success?, "hardlink dedup package-port failed: #{hl_out_s}\n#{hl_err_s}")

  hl_idx = JSON.parse(File.read(File.join(hl_out, "0.1.4", "x86_64-linux", "index.json")))
  biggit_entry = hl_idx.dig("packages", "biggit")
  biggit_rel = biggit_entry.dig("binary", "path")
  biggit_sha = biggit_entry.dig("binary", "sha256")
  assert(biggit_rel == "bin/biggit-2.56.0-r1-x86_64-linux-#{biggit_sha[0, 12]}.tar.xz",
         "biggit binary must use content-addressed filename, got: #{biggit_rel.inspect}")
  biggit_tar = File.join(hl_out, "0.1.4", "x86_64-linux", biggit_rel)
  assert(File.file?(biggit_tar), "missing biggit binary archive")
  # 56 copies of 1 MiB incompressible bytes would be ~56 MiB without dedup;
  # with hardlink dedup across 2 RPATH depths (bin/ + libexec/git-core/), archive must be < 3 MiB.
  assert(File.size(biggit_tar) < 3 * 1024 * 1024,
         "hardlink dedup archive too large: #{File.size(biggit_tar)} bytes (expected < 3 MiB)")
  assert(hl_out_s.include?("PACKAGE_SIZES:") && hl_out_s.include?("TOP_10_LARGEST_PACKAGES:"),
         "missing PACKAGE_SIZES / TOP_10_LARGEST_PACKAGES summary: #{hl_out_s}")
  assert(hl_out_s.include?("biggit") && hl_out_s.include?("hardlinks=54"),
         "expected biggit with 54 hardlinks (49 reused + 5 deduped) in summary: #{hl_out_s}")

  strip_calls = File.readlines(strip_log, chomp: true)
  # 1 (bin/git) + 1 (libexec/git-core/git-cmd-01 reused for 02..50) + 5 (separate copies 51..55) = 7 strip calls, NOT 56
  assert(strip_calls.length == 7,
         "expected 7 strip invocations (reusing hardlinked ELFs), got #{strip_calls.length}: #{strip_calls.inspect}")

  hl_ext = File.join(td, "hl-ext")
  FileUtils.mkdir_p(hl_ext)
  _hto, hterr, htst = Open3.capture3("tar", "-xf", biggit_tar, "-C", hl_ext)
  assert(htst.success?, "tar extract biggit failed: #{hterr}")
  ext_bin_git = File.join(hl_ext, "prefix", "bin", "git")
  ext_cmd01 = File.join(hl_ext, "prefix", "libexec", "git-core", "git-cmd-01")
  ext_cmd50 = File.join(hl_ext, "prefix", "libexec", "git-core", "git-cmd-50")
  ext_cmd55 = File.join(hl_ext, "prefix", "libexec", "git-core", "git-cmd-55")
  assert(File.binread(ext_bin_git, 128).include?("RPATH=$ORIGIN/../lib".b), "bin/git RPATH wrong")
  assert(File.binread(ext_cmd01, 128).include?("RPATH=$ORIGIN/../../lib".b), "libexec/git-core/git-cmd-01 RPATH wrong")
  assert(!File.binread(ext_cmd01).end_with?("DEBUG_TAIL_MARKER".b), "strip did not run on git-cmd-01")
  assert(File.stat(ext_cmd01).ino == File.stat(ext_cmd50).ino, "hardlinks 01..50 must share inode after tar extract")
  assert(File.stat(ext_cmd01).ino == File.stat(ext_cmd55).ino, "deduplicated copies 51..55 must share inode after tar extract")
  assert(File.stat(ext_bin_git).ino != File.stat(ext_cmd01).ino, "different-RPATH binaries must not share inode")
  # Verify both relative and nested absolute symlinks resolve to ../../bin/git
  assert(File.readlink(File.join(hl_ext, "prefix", "libexec", "git-core", "git-rel-sym")) == "../../bin/git",
         "relative symlink must stay ../../bin/git")
  assert(File.readlink(File.join(hl_ext, "prefix", "libexec", "git-core", "git-abs-sym")) == "../../bin/git",
         "nested absolute symlink inside pizfix must be rewritten to ../../bin/git")

  # 13. Mandatory pre-upload size limit gate in package-port AND upload-ports
  hl_out_lim = File.join(td, "hl-out-limit")
  lim_out, lim_err, lim_st = Open3.capture3(
    hl_env,
    "ruby", PACKAGE_SCRIPT,
    "--repo-root", hl_repo,
    "--work-dir", hl_work,
    "--pizfix", hl_pizfix,
    "--neutral-prefix", hl_pizfix,
    "--ports-cache-dir", hl_cache,
    "--out-dir", hl_out_lim,
    "--max-artifact-bytes", "500000",
    "--channel", "0.1.4",
    "--arch", "x86_64-linux"
  )
  assert(!lim_st.success?, "package-port must abort when an artifact exceeds --max-artifact-bytes")
  assert(lim_err.include?("SIZE_LIMIT FAILED"), "expected SIZE_LIMIT FAILED error, got: #{lim_err}")
  assert(lim_out.include?("TOP_10_LARGEST_PACKAGES:"), "size limit failure must still report TOP_10_LARGEST_PACKAGES")
  assert(!File.exist?(File.join(hl_out_lim, "0.1.4", "x86_64-linux", "index.json")),
         "index.json must not be written when SIZE_LIMIT fails")

  hl_ch_dir = File.join(hl_out, "0.1.4", "x86_64-linux")
  File.write(File.join(hl_ch_dir, "index.json.minisig"), "untrusted comment: test\nAA==\ntrusted comment: t\nAA==\n")
  File.write(File.join(hl_ch_dir, "SHA256SUMS.minisig"), "untrusted comment: test\nAA==\ntrusted comment: t\nAA==\n")
  _ulim_o, ulim_e, ulim_st = Open3.capture3(
    BASE_ENV,
    "ruby", UPLOAD_SCRIPT,
    "--channel-dir", hl_ch_dir,
    "--channel", "0.1.4",
    "--arch", "x86_64-linux",
    "--allow-unsigned-test",
    "--max-artifact-bytes", "500000",
    "--dry-run"
  )
  assert(!ulim_st.success?, "upload-ports must reject oversized artifact before upload")
  assert(ulim_e.include?("SIZE_LIMIT FAILED"), "expected SIZE_LIMIT FAILED from upload-ports, got: #{ulim_e}")

  # 14. Idempotent upload replacement: unchanged artifacts (matching HEAD X-Content-SHA256)
  #     are skipped while a changed package with a new SHA-256 replaces the old invisible file via PUT.
  hl_idx = JSON.parse(File.read(File.join(hl_ch_dir, "index.json")))
  src_art = hl_idx.dig("packages", "biggit", "source")
  bin_art = hl_idx.dig("packages", "biggit", "binary")
  old_bin_sha = "0" * 64
  stored_hashes = {
    "/api/ports-artifacts/0.1.4/x86_64-linux/#{src_art['path']}" => src_art["sha256"],
    "/api/ports-artifacts/0.1.4/x86_64-linux/#{bin_art['path']}" => old_bin_sha
  }
  repl_puts = []
  with_mock_http_server(lambda do |sock, method, path, req_head, body|
    x_sha = req_head[/^X-Content-SHA256:\s*([0-9a-f]{64})/i, 1]
    if method == "HEAD"
      if stored_hashes.key?(path)
        sock.write("HTTP/1.1 200 OK\r\nX-Content-SHA256: #{stored_hashes[path]}\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
      else
        sock.write("HTTP/1.1 404 Not Found\r\nContent-Length: 2\r\nConnection: close\r\n\r\n{}")
      end
    elsif method == "PUT"
      existed = stored_hashes.key?(path)
      stored_hashes[path] = Digest::SHA256.hexdigest(body)
      repl_puts << [path, x_sha, existed]
      status_line = existed ? "HTTP/1.1 200 OK" : "HTTP/1.1 201 Created"
      resp = JSON.generate("ok" => true, "created" => !existed, "sha256" => stored_hashes[path])
      sock.write("#{status_line}\r\nContent-Type: application/json\r\nContent-Length: #{resp.bytesize}\r\nConnection: close\r\n\r\n#{resp}")
    elsif method == "POST"
      resp = JSON.generate("ok" => true, "packages" => 1)
      sock.write("HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: #{resp.bytesize}\r\nConnection: close\r\n\r\n#{resp}")
    end
  end) do |repl_port|
    ruo, rue, rust = capture3_with_timeout(
      30,
      BASE_ENV.merge("FILC_PORTS_UPLOAD_TOKEN" => "ci-upload-secret"),
      "ruby", UPLOAD_SCRIPT,
      "--channel-dir", hl_ch_dir,
      "--channel", "0.1.4",
      "--arch", "x86_64-linux",
      "--allow-unsigned-test",
      "--base-url", "http://127.0.0.1:#{repl_port}"
    )
    assert(rust.success?, "idempotent replacement upload failed: #{ruo}\n#{rue}")
    assert(ruo.include?("uploaded=2 skipped=1"), "expected 2 uploaded (recipe + replaced bin) and 1 skipped (unchanged src), got: #{ruo}")
    bin_put = repl_puts.find { |p, _, _| p.end_with?(bin_art["path"]) }
    assert(bin_put && bin_put[1] == bin_art["sha256"] && bin_put[2] == true,
           "changed bin package must replace old invisible file via PUT: #{repl_puts.inspect}")
    assert(stored_hashes["/api/ports-artifacts/0.1.4/x86_64-linux/#{bin_art['path']}"] == bin_art["sha256"],
           "server must hold new bin SHA-256 after replacement")
  end

  # 15. Post-packaging extract + smoke verification in a fresh alternate prefix:
  #     Verifies that packaged archives unpack into a different prefix, preserve
  #     relative symlinks + hardlinks + transitive deps, execute port_package_smoke(),
  #     and abort cleanly on failing smoke commands or broken relative symlinks.
  sm_repo = File.join(td, "sm-repo")
  sm_work = File.join(td, "sm-work")
  sm_pizfix = File.join(td, "sm-pizfix")
  sm_cache = File.join(sm_work, "ports-cache")
  sm_state = File.join(sm_work, "ports-state")
  sm_out = File.join(td, "sm-out")
  FileUtils.mkdir_p([
    File.join(sm_repo, "ports", "smdep"),
    File.join(sm_repo, "ports", "smtool"),
    File.join(sm_pizfix, "bin"),
    File.join(sm_pizfix, "libexec", "smtool-core"),
    File.join(sm_pizfix, "share", "smdep"),
    sm_cache,
    sm_state,
    sm_out
  ])
  FileUtils.cp(File.join(repo, "UPSTREAM"), File.join(sm_repo, "UPSTREAM"))

  smdep_tar = File.join(td, "smdep-1.0.tar.gz")
  smdep_sha = make_tar_gz(smdep_tar, { "smdep-1.0/README" => "smdep\n" })
  FileUtils.cp(smdep_tar, File.join(sm_cache, "smdep-1.0-#{smdep_sha[0, 12]}-smdep-1.0.tar.gz"))
  File.write(File.join(sm_repo, "ports", "smdep", "PORT"), <<~PORT)
    NAME=smdep
    VERSION=1.0
    LICENSE=MIT
    UPSTREAM_URL=https://example.invalid/smdep-1.0.tar.gz
    UPSTREAM_SHA256=#{smdep_sha}
    EXTRACT_DIR=smdep-1.0
    TIER=0
    DEPS=""
    BUILD_SYSTEM=autotools
    POLICY_CLASS=P0-Clean
  PORT
  File.write(File.join(sm_pizfix, "share", "smdep", "token.txt"), "DEP_TOKEN_OK\n")
  File.write(File.join(sm_state, "smdep.manifest.json"), JSON.pretty_generate(
    "port" => "smdep",
    "files" => ["share/smdep/token.txt"]
  ) + "\n")

  smtool_tar = File.join(td, "smtool-2.0.tar.gz")
  smtool_sha = make_tar_gz(smtool_tar, { "smtool-2.0/README" => "smtool\n" })
  FileUtils.cp(smtool_tar, File.join(sm_cache, "smtool-2.0-#{smtool_sha[0, 12]}-smtool-2.0.tar.gz"))
  smtool_port = File.join(sm_repo, "ports", "smtool", "PORT")
  File.write(smtool_port, <<~'PORT'.sub("__SHA__", smtool_sha))
    NAME=smtool
    VERSION=2.0
    LICENSE=MIT
    UPSTREAM_URL=https://example.invalid/smtool-2.0.tar.gz
    UPSTREAM_SHA256=__SHA__
    EXTRACT_DIR=smtool-2.0
    TIER=1
    DEPS="smdep"
    BUILD_SYSTEM=autotools
    POLICY_CLASS=P0-Clean

    port_package_smoke() {
      test "$PKG_PREFIX" != "$FILC_ORIGINAL_PIZFIX"
      test -L "$PKG_PREFIX/libexec/smtool-core/smtool-status"
      test "$(readlink "$PKG_PREFIX/libexec/smtool-core/smtool-status")" = "../../bin/smtool"
      "$PKG_PREFIX/bin/smtool" --version | grep -Fxq "smtool 2.0"
      "$PKG_PREFIX/libexec/smtool-core/smtool-status" | grep -Fxq "invoked:smtool-status"
      "$PKG_PREFIX/bin/smtool-alias" | grep -Fxq "invoked:smtool-alias"
      grep -Fxq "DEP_TOKEN_OK" "$PKG_PREFIX/share/smdep/token.txt"
    }
  PORT

  smtool_bin = File.join(sm_pizfix, "bin", "smtool")
  File.write(smtool_bin, <<~'SH')
    #!/bin/sh
    if [ "${1:-}" = "--version" ]; then
      echo "smtool 2.0"
    else
      echo "invoked:$(basename "$0")"
    fi
  SH
  File.chmod(0o755, smtool_bin)
  File.link(smtool_bin, File.join(sm_pizfix, "bin", "smtool-alias"))
  File.symlink(smtool_bin, File.join(sm_pizfix, "libexec", "smtool-core", "smtool-status"))
  File.write(File.join(sm_state, "smtool.manifest.json"), JSON.pretty_generate(
    "port" => "smtool",
    "files" => [
      "bin/smtool",
      "bin/smtool-alias",
      "libexec/smtool-core/smtool-status"
    ]
  ) + "\n")

  smo_o, smo_e, smo_st = Open3.capture3(
    BASE_ENV,
    "ruby", PACKAGE_SCRIPT,
    "--repo-root", sm_repo,
    "--work-dir", sm_work,
    "--pizfix", sm_pizfix,
    "--neutral-prefix", sm_pizfix,
    "--ports-cache-dir", sm_cache,
    "--out-dir", sm_out,
    "--channel", "0.1.4",
    "--arch", "x86_64-linux"
  )
  assert(smo_st.success?, "post-packaging smoke pass test failed: #{smo_o}\n#{smo_e}")
  assert(smo_o.include?("PACKAGE_SMOKE: PASS packages=2 smoke_cmds=1 symlinks=1 hardlinks=1"),
         "expected PACKAGE_SMOKE PASS summary, got:\n#{smo_o}")

  # 15b. Failing port_package_smoke() must abort packaging with PACKAGE_SMOKE FAILED and no index.json
  File.write(smtool_port, File.read(smtool_port).sub('grep -Fxq "smtool 2.0"', 'grep -Fxq "wrong-version"'))
  sm_out_fail = File.join(td, "sm-out-fail")
  smf_o, smf_e, smf_st = Open3.capture3(
    BASE_ENV,
    "ruby", PACKAGE_SCRIPT,
    "--repo-root", sm_repo,
    "--work-dir", sm_work,
    "--pizfix", sm_pizfix,
    "--neutral-prefix", sm_pizfix,
    "--ports-cache-dir", sm_cache,
    "--out-dir", sm_out_fail,
    "--channel", "0.1.4",
    "--arch", "x86_64-linux"
  )
  assert(!smf_st.success?, "failing port_package_smoke must fail package-port")
  assert(smf_e.include?("PACKAGE_SMOKE FAILED"), "expected PACKAGE_SMOKE FAILED error, got: #{smf_e}")
  assert(smf_e.include?("SMOKE_CMD_FAILED"), "expected SMOKE_CMD_FAILED diagnostic in smoke error, got: #{smf_e}")
  assert(!File.exist?(File.join(sm_out_fail, "0.1.4", "x86_64-linux", "index.json")),
         "index.json must not be written when PACKAGE_SMOKE fails")

  # 15c. Broken relative symlink in a packaged archive must fail PACKAGE_SMOKE
  File.write(smtool_port, File.read(smtool_port).sub('grep -Fxq "wrong-version"', 'grep -Fxq "smtool 2.0"'))
  File.symlink("../../bin/does-not-exist", File.join(sm_pizfix, "libexec", "smtool-core", "smtool-broken"))
  File.write(File.join(sm_state, "smtool.manifest.json"), JSON.pretty_generate(
    "port" => "smtool",
    "files" => [
      "bin/smtool",
      "bin/smtool-alias",
      "libexec/smtool-core/smtool-status",
      "libexec/smtool-core/smtool-broken"
    ]
  ) + "\n")
  sm_out_brk = File.join(td, "sm-out-broken-sym")
  smb_o, smb_e, smb_st = Open3.capture3(
    BASE_ENV,
    "ruby", PACKAGE_SCRIPT,
    "--repo-root", sm_repo,
    "--work-dir", sm_work,
    "--pizfix", sm_pizfix,
    "--neutral-prefix", sm_pizfix,
    "--ports-cache-dir", sm_cache,
    "--out-dir", sm_out_brk,
    "--channel", "0.1.4",
    "--arch", "x86_64-linux"
  )
  assert(!smb_st.success?, "broken relative symlink must fail package-port smoke check")
  assert(smb_e.include?("PACKAGE_SMOKE FAILED") && smb_e.include?("broken relative symlink"),
         "expected broken relative symlink error, got: #{smb_e}")

  # 15d. Hanging port_package_smoke() must dump timeout diagnostics (gdb + process info) before kill and exit 124
  FileUtils.rm_f(File.join(sm_pizfix, "libexec", "smtool-core", "smtool-broken"))
  File.write(File.join(sm_state, "smtool.manifest.json"), JSON.pretty_generate(
    "port" => "smtool",
    "files" => [
      "bin/smtool",
      "bin/smtool-alias",
      "libexec/smtool-core/smtool-status"
    ]
  ) + "\n")
  mock_gdb = File.join(td, "mock-gdb-smoke")
  File.write(mock_gdb, "#!/usr/bin/env bash\necho \"MOCK_SMOKE_GDB args=$*\"\necho \"#0 in smoke_hang_frame ()\"\n")
  File.chmod(0o755, mock_gdb)
  File.write(smtool_port, File.read(smtool_port).sub('grep -Fxq "smtool 2.0"', 'sleep 30'))
  sm_out_to = File.join(td, "sm-out-timeout")
  smt_env = BASE_ENV.merge("FILC_PACKAGE_SMOKE_TIMEOUT" => "1", "FILC_TIMEOUT_GDB_BIN" => mock_gdb)
  smt_o, smt_e, smt_st = Open3.capture3(
    smt_env,
    "ruby", PACKAGE_SCRIPT,
    "--repo-root", sm_repo,
    "--work-dir", sm_work,
    "--pizfix", sm_pizfix,
    "--neutral-prefix", sm_pizfix,
    "--ports-cache-dir", sm_cache,
    "--out-dir", sm_out_to,
    "--channel", "0.1.4",
    "--arch", "x86_64-linux"
  )
  assert(!smt_st.success?, "hanging port_package_smoke must fail package-port")
  assert(smt_e.include?("PACKAGE_SMOKE FAILED") && smt_e.include?("exit=124"),
         "expected PACKAGE_SMOKE FAILED with exit=124, got: #{smt_e}")
  assert(smt_e.include?("--- TIMEOUT DIAGNOSTICS (label=port=smtool stage=package_smoke,"),
         "expected timeout diagnostics header in smoke error, got: #{smt_e}")
  assert(smt_e.include?("MOCK_SMOKE_GDB args=-n -batch -p ") && smt_e.include?("smoke_hang_frame"),
         "expected gdb backtrace in smoke timeout error, got: #{smt_e}")
end

# 16. Dotfiles (e.g. perl's .packlist) inside prefix must be normalized from slot view
# to neutral prefix and recorded in filc-pkg.json with zero LEAK_GATE hits.
Dir.mktmpdir("filc-pkg-dotfile-") do |td|
  dot_repo = File.join(td, "repo")
  dot_tc_parent = File.join(td, "filc")
  dot_neutral = File.join(dot_tc_parent, "0.1.4", "pizfix")
  dot_view = File.join(dot_tc_parent, ".v000", "pizfix")
  dot_work = File.join(td, "work")
  dot_state = File.join(dot_work, "ports-state")
  dot_cache = File.join(td, "cache")
  dot_out = File.join(td, "out")
  FileUtils.mkdir_p([
    File.join(dot_repo, "ports", "dotpkg"),
    File.join(dot_neutral),
    File.join(dot_view, "lib", "perl5", "5.40.5", "x86_64-linux"),
    dot_state, dot_cache, dot_out
  ])
  FileUtils.cp(File.join(REPO_ROOT, "UPSTREAM"), File.join(dot_repo, "UPSTREAM"))
  dot_tar = File.join(td, "dotpkg-1.0.tar.gz")
  dot_sha = make_tar_gz(dot_tar, { "dotpkg-1.0/README" => "dotpkg\n" })
  FileUtils.cp(dot_tar, File.join(dot_cache, "dotpkg-1.0-#{dot_sha[0, 12]}-dotpkg-1.0.tar.gz"))
  File.write(File.join(dot_repo, "ports", "dotpkg", "PORT"), <<~PORT)
    NAME=dotpkg
    VERSION=1.0
    LICENSE=MIT
    UPSTREAM_URL=https://example.invalid/dotpkg-1.0.tar.gz
    UPSTREAM_SHA256=#{dot_sha}
    EXTRACT_DIR=dotpkg-1.0
    TIER=0
    DEPS=""
    BUILD_SYSTEM=autotools
    POLICY_CLASS=P0-Clean
  PORT
  packlist_rel = "lib/perl5/5.40.5/x86_64-linux/.packlist"
  File.write(File.join(dot_view, packlist_rel), "#{dot_view}/bin/perl\n#{dot_view}/lib/perl5/Config.pm\n")
  File.write(File.join(dot_state, "dotpkg.manifest.json"), JSON.pretty_generate(
    "port" => "dotpkg",
    "files" => [packlist_rel]
  ) + "\n")

  do_o, do_e, do_st = Open3.capture3(
    BASE_ENV,
    "ruby", PACKAGE_SCRIPT,
    "--repo-root", dot_repo,
    "--work-dir", dot_work,
    "--pizfix", dot_view,
    "--neutral-prefix", dot_neutral,
    "--ports-cache-dir", dot_cache,
    "--out-dir", dot_out,
    "--channel", "0.1.4",
    "--arch", "x86_64-linux",
    "--skip-package-smoke"
  )
  assert(do_st.success?, "dotfile normalization test failed: #{do_o}\n#{do_e}")
  bin_arc = Dir.glob(File.join(dot_out, "0.1.4", "x86_64-linux", "bin", "dotpkg-*.tar.xz")).first
  assert(bin_arc && File.file?(bin_arc), "dotpkg archive missing")
  ext_dir = File.join(td, "extracted")
  FileUtils.mkdir_p(ext_dir)
  _to, _te, tst = Open3.capture3("tar", "-xJf", bin_arc, "-C", ext_dir)
  assert(tst.success?, "failed to extract dotpkg archive")
  extracted_pl = File.read(File.join(ext_dir, "prefix", packlist_rel), encoding: "UTF-8")
  assert(!extracted_pl.include?(".v000"), ".packlist still leaked slot view path: #{extracted_pl}")
  assert(extracted_pl.include?("#{dot_neutral}/bin/perl"), ".packlist not normalized to neutral prefix: #{extracted_pl}")
  pkg_meta = JSON.parse(File.read(File.join(ext_dir, "filc-pkg.json"), encoding: "UTF-8"))
  assert(pkg_meta.fetch("files").key?(packlist_rel), ".packlist missing from filc-pkg.json files map")
end

# 17. Staged metadata provenance hashing + upload-ports exact-token leak gate:
#     (a) A port with upstream private-IP / dotted-version strings in docs passes
#         package-port --single-port (no plaintext tokens in staged JSON) AND upload-ports
#         (--dry-run and live staged PUT).
#     (b) upload-ports blocks a real internal IP from FILC_LEAK_EXACT_TOKENS (without echoing
#         the secret), blocks plaintext provenance tokens, and aborts when secret env is missing.
Dir.mktmpdir("filc-upload-leak-test-") do |td|
  up_repo = File.join(td, "repo")
  up_work = File.join(td, "work")
  up_pizfix = File.join(td, "pizfix")
  up_state = File.join(up_work, "ports-state")
  up_cache = File.join(up_work, "ports-cache")
  up_out = File.join(td, "out")
  up_staged = File.join(td, "staged")
  FileUtils.mkdir_p([
    File.join(up_repo, "ports", "docip"),
    File.join(up_pizfix, "share", "doc", "docip"),
    up_state, up_cache, up_out, up_staged
  ])
  FileUtils.cp(File.join(REPO_ROOT, "UPSTREAM"), File.join(up_repo, "UPSTREAM"))
  up_ip = ip4(192, 168, 1, 1)
  up_ver = ip4(10, "04", 46, 57)
  doc_body = "Upstream docs example host #{up_ip} and date-version #{up_ver}\n"
  up_tar = File.join(td, "docip-1.0.tar.gz")
  up_sha = make_tar_gz(up_tar, { "docip-1.0/README" => doc_body })
  FileUtils.cp(up_tar, File.join(up_cache, "docip-1.0-#{up_sha[0, 12]}-docip-1.0.tar.gz"))
  File.write(File.join(up_repo, "ports", "docip", "PORT"), <<~PORT)
    NAME=docip
    VERSION=1.0
    LICENSE=MIT
    UPSTREAM_URL=https://example.invalid/docip-1.0.tar.gz
    UPSTREAM_SHA256=#{up_sha}
    EXTRACT_DIR=docip-1.0
    TIER=0
    DEPS=""
    BUILD_SYSTEM=autotools
    POLICY_CLASS=P0-Clean
  PORT
  File.write(File.join(up_pizfix, "share", "doc", "docip", "README"), doc_body)
  File.write(File.join(up_state, "docip.manifest.json"), JSON.pretty_generate(
    "port" => "docip",
    "files" => ["share/doc/docip/README"]
  ) + "\n")

  sp_o, sp_e, sp_st = Open3.capture3(
    BASE_ENV,
    "ruby", PACKAGE_SCRIPT,
    "--repo-root", up_repo,
    "--work-dir", up_work,
    "--pizfix", up_pizfix,
    "--neutral-prefix", up_pizfix,
    "--ports-cache-dir", up_cache,
    "--out-dir", up_out,
    "--staged-dir", up_staged,
    "--channel", "0.1.4",
    "--arch", "x86_64-linux",
    "--single-port", "docip",
    "--skip-package-smoke"
  )
  assert(sp_st.success?, "docip single-port packaging failed: #{sp_o}\n#{sp_e}")
  meta_path = File.join(up_staged, "docip.json")
  meta_raw = File.read(meta_path, encoding: "UTF-8")
  assert(!meta_raw.include?(up_ip), "staged metadata must not contain plaintext upstream IP #{up_ip}:\n#{meta_raw}")
  assert(!meta_raw.include?(up_ver), "staged metadata must not contain plaintext upstream token #{up_ver}:\n#{meta_raw}")
  meta_obj = JSON.parse(meta_raw)
  docip_prov = meta_obj.dig("provenance_allowed", "docip") || []
  assert(docip_prov.length == 2, "expected 2 hashed provenance entries for docip, got: #{docip_prov.inspect}")
  assert(docip_prov.all? { |e| !e.key?("token") && /\A[0-9a-f]{64}\z/.match?(e["token_sha256"].to_s) },
         "all provenance entries must use token_sha256 without plaintext token: #{docip_prov.inspect}")

  up_ch_dir = File.join(up_out, "0.1.4", "x86_64-linux")
  # 17a-1: upload-ports --stage-port-meta --dry-run must PASS
  dr_o, dr_e, dr_st = Open3.capture3(
    BASE_ENV,
    "ruby", UPLOAD_SCRIPT,
    "--channel-dir", up_ch_dir,
    "--channel", "0.1.4",
    "--arch", "x86_64-linux",
    "--stage-port-meta", meta_path,
    "--dry-run"
  )
  assert(dr_st.success?, "upload-ports --dry-run failed on docip with upstream IP: #{dr_o}\n#{dr_e}")
  assert(dr_o.include?("UPLOAD_PORTS_STAGE: DRY_RUN OK port=docip"), "missing DRY_RUN OK banner: #{dr_o}")

  # 17a-2: upload-ports --stage-port-meta against mock HTTP server must PASS
  st_puts = []
  with_mock_http_server(lambda do |sock, method, path, _req_head, _body|
    if method == "HEAD"
      sock.write("HTTP/1.1 404 Not Found\r\nContent-Length: 2\r\nConnection: close\r\n\r\n{}")
    elsif method == "PUT"
      st_puts << path
      resp = JSON.generate("ok" => true, "created" => true)
      sock.write("HTTP/1.1 201 Created\r\nContent-Type: application/json\r\nContent-Length: #{resp.bytesize}\r\nConnection: close\r\n\r\n#{resp}")
    end
  end) do |st_port|
    lv_o, lv_e, lv_st = capture3_with_timeout(
      30,
      BASE_ENV.merge("FILC_PORTS_UPLOAD_TOKEN" => "ci-upload-secret"),
      "ruby", UPLOAD_SCRIPT,
      "--channel-dir", up_ch_dir,
      "--channel", "0.1.4",
      "--arch", "x86_64-linux",
      "--stage-port-meta", meta_path,
      "--base-url", "http://127.0.0.1:#{st_port}"
    )
    assert(lv_st.success?, "staged upload failed for docip with upstream IP: #{lv_o}\n#{lv_e}")
    assert(st_puts.length == 3, "expected 3 PUT uploads for docip, got #{st_puts.inspect}")
  end

  # 17b-1: Real internal IP from FILC_LEAK_EXACT_TOKENS in metadata MUST be blocked (without echoing secret)
  secret_ip = ip4(198, 51, 100, 10)
  bad_secret_meta = File.join(up_staged, "docip-secret-leak.json")
  bad_obj = JSON.parse(meta_raw)
  bad_obj["provenance_allowed"]["docip"].first["upstream_source"] = "docip-1.0/leak-#{secret_ip}.txt"
  File.write(bad_secret_meta, JSON.pretty_generate(bad_obj) + "\n", encoding: "UTF-8")
  _bs_o, bs_e, bs_st = Open3.capture3(
    BASE_ENV,
    "ruby", UPLOAD_SCRIPT,
    "--channel-dir", up_ch_dir,
    "--channel", "0.1.4",
    "--arch", "x86_64-linux",
    "--stage-port-meta", bad_secret_meta,
    "--dry-run"
  )
  assert(!bs_st.success?, "upload-ports must block exact internal IP from FILC_LEAK_EXACT_TOKENS")
  assert(bs_e.include?("LEAK_GATE FAILED") && bs_e.include?("matches exact forbidden infra token"),
         "expected exact-token LEAK_GATE failure, got: #{bs_e}")
  assert(!bs_e.include?(secret_ip), "upload-ports stderr must not echo secret IP token: #{bs_e}")

  # 17b-2: Plaintext 'token' key in provenance_allowed MUST be blocked
  bad_plain_meta = File.join(up_staged, "docip-plain-token.json")
  plain_obj = JSON.parse(meta_raw)
  plain_obj["provenance_allowed"]["docip"].first["token"] = up_ip
  File.write(bad_plain_meta, JSON.pretty_generate(plain_obj) + "\n", encoding: "UTF-8")
  _bp_o, bp_e, bp_st = Open3.capture3(
    BASE_ENV,
    "ruby", UPLOAD_SCRIPT,
    "--channel-dir", up_ch_dir,
    "--channel", "0.1.4",
    "--arch", "x86_64-linux",
    "--stage-port-meta", bad_plain_meta,
    "--dry-run"
  )
  assert(!bp_st.success?, "upload-ports must block plaintext provenance token in metadata")
  assert(bp_e.include?("plaintext provenance token forbidden"), "expected plaintext token error, got: #{bp_e}")

  # 17b-3: Missing FILC_LEAK_EXACT_TOKENS MUST hard-abort upload-ports
  _ns_o, ns_e, ns_st = Open3.capture3(
    { "FILC_LEAK_EXACT_TOKENS" => nil },
    "ruby", UPLOAD_SCRIPT,
    "--channel-dir", up_ch_dir,
    "--channel", "0.1.4",
    "--arch", "x86_64-linux",
    "--stage-port-meta", meta_path,
    "--dry-run"
  )
  assert(!ns_st.success?, "upload-ports must abort when FILC_LEAK_EXACT_TOKENS is unset")
  assert(ns_e.include?("LEAK_GATE CONFIG ERROR"), "expected LEAK_GATE CONFIG ERROR, got: #{ns_e}")
end

# Test 18: Content-addressed filenames for bin/ and recipes/ prevent same-version overwrites
puts "[18/18] Content-addressed bin/ and recipes/ filenames preserve previous build archives"
Dir.mktmpdir("filc-pkg-ca-") do |td|
  ca_repo = File.join(td, "repo")
  ca_work = File.join(td, "work")
  ca_pizfix = File.join(ca_work, "pizfix")
  ca_state = File.join(ca_work, "ports-state")
  ca_cache = File.join(td, "cache")
  ca_out = File.join(td, "out")
  FileUtils.mkdir_p([
    File.join(ca_repo, "ports", "rebuilt"),
    File.join(ca_pizfix, "bin"),
    ca_state, ca_cache, ca_out
  ])
  FileUtils.cp(File.join(REPO_ROOT, "UPSTREAM"), File.join(ca_repo, "UPSTREAM"))
  src_tar = File.join(td, "rebuilt-1.0.tar.gz")
  src_sha = make_tar_gz(src_tar, { "rebuilt-1.0/README" => "hello upstream\n" })
  FileUtils.cp(src_tar, File.join(ca_cache, "rebuilt-1.0-#{src_sha[0, 12]}-rebuilt-1.0.tar.gz"))
  File.write(File.join(ca_repo, "ports", "rebuilt", "PORT"), <<~PORT)
    NAME=rebuilt
    VERSION=1.0
    LICENSE=MIT
    UPSTREAM_URL=https://example.invalid/rebuilt-1.0.tar.gz
    UPSTREAM_SHA256=#{src_sha}
    EXTRACT_DIR=rebuilt-1.0
    TIER=0
    DEPS=""
    BUILD_SYSTEM=autotools
    POLICY_CLASS=P0-Clean
  PORT
  File.write(File.join(ca_pizfix, "bin", "rebuilt-tool"), "#!/bin/sh\necho build-one\n")
  File.chmod(0o755, File.join(ca_pizfix, "bin", "rebuilt-tool"))
  File.write(File.join(ca_state, "rebuilt.manifest.json"), JSON.pretty_generate(
    "port" => "rebuilt",
    "files" => ["bin/rebuilt-tool"]
  ) + "\n")

  run_pkg = lambda do
    o, e, st = Open3.capture3(
      BASE_ENV,
      "ruby", PACKAGE_SCRIPT,
      "--repo-root", ca_repo,
      "--work-dir", ca_work,
      "--pizfix", ca_pizfix,
      "--neutral-prefix", ca_pizfix,
      "--ports-cache-dir", ca_cache,
      "--out-dir", ca_out,
      "--channel", "0.1.4",
      "--arch", "x86_64-linux",
      "--skip-package-smoke"
    )
    assert(st.success?, "content-addressed package-port failed: #{o}\n#{e}")
    JSON.parse(File.read(File.join(ca_out, "0.1.4", "x86_64-linux", "index.json")))
  end

  idx1 = run_pkg.call
  e1 = idx1.dig("packages", "rebuilt")
  bin1_rel = e1.dig("binary", "path")
  bin1_sha = e1.dig("binary", "sha256")
  rec1_rel = e1.dig("recipe", "path")
  rec1_sha = e1.dig("recipe", "sha256")
  src1_rel = e1.dig("source", "path")
  assert(bin1_rel == "bin/rebuilt-1.0-r1-x86_64-linux-#{bin1_sha[0, 12]}.tar.xz",
         "unexpected bin1 path: #{bin1_rel}")
  assert(rec1_rel == "recipes/rebuilt-1.0-r1-recipe-#{rec1_sha[0, 12]}.tar.xz",
         "unexpected rec1 path: #{rec1_rel}")
  assert(src1_rel == "src/rebuilt-1.0.tar.gz", "src path must keep upstream basename, got: #{src1_rel}")

  # Rebuild same version-r1 with different binary output into the same out-dir
  File.write(File.join(ca_pizfix, "bin", "rebuilt-tool"), "#!/bin/sh\necho build-two-rebuilt\n")
  idx2 = run_pkg.call
  e2 = idx2.dig("packages", "rebuilt")
  bin2_rel = e2.dig("binary", "path")
  bin2_sha = e2.dig("binary", "sha256")
  assert(bin2_sha != bin1_sha, "rebuilt binary must have different SHA-256")
  assert(bin2_rel == "bin/rebuilt-1.0-r1-x86_64-linux-#{bin2_sha[0, 12]}.tar.xz",
         "unexpected bin2 path: #{bin2_rel}")
  assert(bin2_rel != bin1_rel, "rebuilt binary must have distinct content-addressed filename")

  ch_dir = File.join(ca_out, "0.1.4", "x86_64-linux")
  assert(File.file?(File.join(ch_dir, bin1_rel)), "previous build archive must still exist untouched")
  assert(Digest::SHA256.file(File.join(ch_dir, bin1_rel)).hexdigest == bin1_sha,
         "previous build archive SHA-256 must remain unchanged")
  assert(File.file?(File.join(ch_dir, bin2_rel)), "new build archive must exist")
  assert(Digest::SHA256.file(File.join(ch_dir, bin2_rel)).hexdigest == bin2_sha,
         "new build archive SHA-256 must match index")
  assert(Dir.glob(File.join(ch_dir, "bin", ".tmp-*")).empty?, "no leftover .tmp-* files in bin/")
  assert(Dir.glob(File.join(ch_dir, "recipes", ".tmp-*")).empty?, "no leftover .tmp-* files in recipes/")
  assert(!e1.key?("docker_image"), "port without DOCKER_IMAGE_* must not emit docker_image")
  assert(!e2.key?("support"), "active port must not emit eol support metadata")

  # Test 19: EOL metadata fields (support, eol_date, security_source) emitted in index.json
  File.write(File.join(ca_repo, "ports", "rebuilt", "PORT"), <<~PORT)
    NAME=rebuilt
    VERSION=1.0+deb11u1
    LICENSE=MIT
    SUPPORT_STATUS=eol
    EOL_DATE=2023-09-11
    SECURITY_SOURCE=freexian-elts
    UPSTREAM_URL=https://example.invalid/rebuilt-1.0.tar.gz
    UPSTREAM_SHA256=#{src_sha}
    EXTRACT_DIR=rebuilt-1.0
    TIER=0
    DEPS=""
    BUILD_SYSTEM=autotools
    POLICY_CLASS=P4-Audit
  PORT
  FileUtils.cp(src_tar, File.join(ca_cache, "rebuilt-1.0+deb11u1-#{src_sha[0, 12]}-rebuilt-1.0.tar.gz"))
  idx_eol = run_pkg.call
  e_eol = idx_eol.dig("packages", "rebuilt")
  assert(e_eol["support"] == "eol", "expected support=eol, got #{e_eol['support'].inspect}")
  assert(e_eol["eol_date"] == "2023-09-11", "expected eol_date=2023-09-11, got #{e_eol['eol_date'].inspect}")
  assert(e_eol["security_source"] == "freexian-elts", "expected security_source=freexian-elts, got #{e_eol['security_source'].inspect}")
  puts "[19/21] EOL metadata (support, eol_date, security_source) emitted in index.json"
end

# Test 20: Optional DOCKER_IMAGE_* metadata in PORT is forwarded into index.json
puts "[20/21] Optional DOCKER_IMAGE_* metadata in PORT is forwarded into index.json"
Dir.mktmpdir("filc-test-pkg-docker-") do |td|
  dm_repo = File.join(td, "repo")
  dm_work = File.join(td, "work")
  dm_pizfix = File.join(dm_work, "pizfix")
  dm_cache = File.join(td, "cache")
  dm_out = File.join(td, "out")
  dm_state = File.join(dm_work, "ports-state")
  FileUtils.mkdir_p([
    File.join(dm_repo, "ports", "php8.5"),
    File.join(dm_pizfix, "bin"),
    dm_cache, dm_out, dm_state
  ])
  FileUtils.cp(File.join(REPO_ROOT, "UPSTREAM"), File.join(dm_repo, "UPSTREAM"))
  src_tar = File.join(td, "php-8.5.13.tar.gz")
  src_sha = make_tar_gz(src_tar, { "php-8.5.13/README" => "hello php\n" })
  FileUtils.cp(src_tar, File.join(dm_cache, "php8.5-8.5.13-#{src_sha[0, 12]}-php-8.5.13.tar.gz"))
  File.write(File.join(dm_repo, "ports", "php8.5", "PORT"), <<~PORT)
    NAME=php8.5
    VERSION=8.5.13
    LICENSE=PHP-3.01
    UPSTREAM_URL=https://example.invalid/php-8.5.13.tar.gz
    UPSTREAM_SHA256=#{src_sha}
    EXTRACT_DIR=php-8.5.13
    TIER=5
    DEPS=""
    BUILD_SYSTEM=autotools
    POLICY_CLASS=P4-Audit
    DOCKER_IMAGE_REPO="jonasborchelt/filc-php"
    DOCKER_IMAGE_TAG="8.5"
    DOCKER_IMAGE_VARIANTS="cli fpm"
    DOCKER_IMAGE_URL="https://hub.docker.com/r/jonasborchelt/filc-php"
  PORT
  File.write(File.join(dm_pizfix, "bin", "php8.5"), "#!/bin/sh\necho ok\n")
  File.chmod(0o755, File.join(dm_pizfix, "bin", "php8.5"))
  File.write(File.join(dm_state, "php8.5.manifest.json"), JSON.pretty_generate(
    "port" => "php8.5",
    "files" => ["bin/php8.5"]
  ) + "\n")

  o, e, st = Open3.capture3(
    BASE_ENV,
    "ruby", PACKAGE_SCRIPT,
    "--repo-root", dm_repo,
    "--work-dir", dm_work,
    "--pizfix", dm_pizfix,
    "--neutral-prefix", dm_pizfix,
    "--ports-cache-dir", dm_cache,
    "--out-dir", dm_out,
    "--channel", "0.1.5",
    "--arch", "x86_64-linux",
    "--skip-package-smoke"
  )
  assert(st.success?, "docker_image package-port failed: #{o}\n#{e}")
  idx = JSON.parse(File.read(File.join(dm_out, "0.1.5", "x86_64-linux", "index.json")))
  expected = {
    "repo" => "jonasborchelt/filc-php",
    "tag" => "8.5",
    "variants" => %w[cli fpm],
    "url" => "https://hub.docker.com/r/jonasborchelt/filc-php"
  }
  assert(idx.dig("packages", "php8.5", "docker_image") == expected,
         "unexpected docker_image in index.json: #{idx.dig('packages', 'php8.5', 'docker_image').inspect}")
end

# Test 21: Bounded idempotent retry with backoff for transient upload errors
puts "[21/21] upload-ports bounded idempotent retry (EOFError/503, HEAD SHA check, hard 4xx/mismatch)"
Dir.mktmpdir("filc-test-upload-retry-") do |td|
  ch_dir = File.join(td, "0.1.6", "x86_64-linux")
  %w[src recipes bin].each { |b| FileUtils.mkdir_p(File.join(ch_dir, b)) }

  src_rel = "src/retrytest-1.0.tar.gz"
  rec_rel = "recipes/retrytest-1.0-r1.recipe.tar.xz"
  bin_rel = "bin/retrytest-1.0-r1-x86_64-linux.tar.xz"
  File.binwrite(File.join(ch_dir, src_rel), "src-bytes-retry\n")
  File.binwrite(File.join(ch_dir, rec_rel), "rec-bytes-retry\n")
  File.binwrite(File.join(ch_dir, bin_rel), "bin-bytes-retry\n")
  src_sha = Digest::SHA256.file(File.join(ch_dir, src_rel)).hexdigest
  rec_sha = Digest::SHA256.file(File.join(ch_dir, rec_rel)).hexdigest
  bin_sha = Digest::SHA256.file(File.join(ch_dir, bin_rel)).hexdigest

  meta_path = File.join(td, "retrytest.json")
  File.write(meta_path, JSON.pretty_generate(
    "channel" => "0.1.6",
    "arch" => "x86_64-linux",
    "name" => "retrytest",
    "package" => {
      "source" => { "path" => src_rel, "sha256" => src_sha, "size_bytes" => File.size(File.join(ch_dir, src_rel)) },
      "recipe" => { "path" => rec_rel, "sha256" => rec_sha, "size_bytes" => File.size(File.join(ch_dir, rec_rel)) },
      "binary" => { "path" => bin_rel, "sha256" => bin_sha, "size_bytes" => File.size(File.join(ch_dir, bin_rel)) }
    }
  ) + "\n")

  run_retry_case = lambda do |mode|
    events = []
    stored = {}
    bin_puts = 0
    with_mock_http_server(lambda do |sock, method, path, _req_head, body|
      events << [method, path]
      is_bin = path.end_with?("/#{bin_rel}")
      if method == "HEAD"
        if is_bin && mode == :head_mismatch_after_eof && bin_puts >= 1
          wrong_sha = "0" * 64
          sock.write("HTTP/1.1 200 OK\r\nX-Content-SHA256: #{wrong_sha}\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
        elsif stored.key?(path)
          sock.write("HTTP/1.1 200 OK\r\nX-Content-SHA256: #{stored[path]}\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
        else
          sock.write("HTTP/1.1 404 Not Found\r\nContent-Length: 2\r\nConnection: close\r\n\r\n{}")
        end
      elsif method == "PUT"
        bin_puts += 1 if is_bin
        if is_bin && mode == :eof_before_store && bin_puts == 1
          # Simulate dropped connection before response status line (EOFError)
          sock.close
        elsif is_bin && mode == :eof_after_store && bin_puts == 1
          # Server persisted artifact, then dropped connection before response
          stored[path] = Digest::SHA256.hexdigest(body)
          sock.close
        elsif is_bin && mode == :head_mismatch_after_eof && bin_puts == 1
          sock.close
        elsif is_bin && mode == :transient_503 && bin_puts == 1
          sock.write("HTTP/1.1 503 Service Unavailable\r\nContent-Length: 4\r\nConnection: close\r\n\r\nbusy")
        elsif is_bin && mode == :hard_409
          sock.write("HTTP/1.1 409 Conflict\r\nContent-Length: 8\r\nConnection: close\r\n\r\nconflict")
        else
          stored[path] = Digest::SHA256.hexdigest(body)
          resp = JSON.generate("ok" => true, "created" => true)
          sock.write("HTTP/1.1 201 Created\r\nContent-Type: application/json\r\nContent-Length: #{resp.bytesize}\r\nConnection: close\r\n\r\n#{resp}")
        end
      end
    end) do |port|
      o, e, st = capture3_with_timeout(
        30,
        BASE_ENV.merge("FILC_PORTS_UPLOAD_TOKEN" => "retry-secret"),
        "ruby", UPLOAD_SCRIPT,
        "--channel-dir", ch_dir,
        "--channel", "0.1.6",
        "--arch", "x86_64-linux",
        "--base-url", "http://127.0.0.1:#{port}",
        "--retry-delays", "0.01,0.02,0.03",
        "--stage-port-meta", meta_path
      )
      [o, e, st, events, bin_puts]
    end
  end

  # 20a: EOFError before store -> retry runs fresh HEAD (404), succeeds on PUT #2, verifies via HEAD
  o, e, st, events, bin_puts = run_retry_case.call(:eof_before_store)
  assert(st.success?, "20a EOFError retry must succeed: #{o}\n#{e}")
  assert(bin_puts == 2, "20a expected 2 PUTs for bin artifact, got #{bin_puts}")
  bin_events = events.select { |_, p| p.end_with?("/#{bin_rel}") }.map(&:first)
  assert(bin_events == %w[HEAD PUT HEAD PUT HEAD], "20a expected HEAD->PUT->HEAD->PUT->HEAD, got #{bin_events.inspect}")
  assert(e.include?("UPLOAD_PORTS_RETRY:") && e.include?("EOFError"), "20a must log retry line with EOFError: #{e}")

  # 20b: EOFError after server already stored artifact -> retry HEAD (200 matching SHA) skips 2nd PUT
  o, e, st, events, bin_puts = run_retry_case.call(:eof_after_store)
  assert(st.success?, "20b idempotent HEAD after EOFError must succeed: #{o}\n#{e}")
  assert(bin_puts == 1, "20b must NOT re-PUT when retry HEAD matches SHA-256, got #{bin_puts}")
  bin_events = events.select { |_, p| p.end_with?("/#{bin_rel}") }.map(&:first)
  assert(bin_events == %w[HEAD PUT HEAD], "20b expected HEAD->PUT->HEAD, got #{bin_events.inspect}")
  assert(e.include?("UPLOAD_PORTS_RETRY:") && e.include?("UPLOAD_PORTS_RETRY_VERIFIED:"), "20b must log retry + verified lines: #{e}")

  # 20c: HTTP 503 on first PUT -> retry succeeds on PUT #2
  o, e, st, _events, bin_puts = run_retry_case.call(:transient_503)
  assert(st.success?, "20c HTTP 503 retry must succeed: #{o}\n#{e}")
  assert(bin_puts == 2, "20c expected 2 PUTs for HTTP 503 retry, got #{bin_puts}")
  assert(e.include?("UPLOAD_PORTS_RETRY:") && e.include?("503"), "20c must log retry line with 503: #{e}")

  # 20d: HTTP 409 Conflict (4xx) -> immediate hard failure with zero retries
  o, e, st, _events, bin_puts = run_retry_case.call(:hard_409)
  assert(!st.success?, "20d HTTP 409 must fail immediately: #{o}\n#{e}")
  assert(bin_puts == 1, "20d must NOT retry 4xx (expected 1 PUT, got #{bin_puts})")
  assert(!e.include?("UPLOAD_PORTS_RETRY:"), "20d must not log any retry on 4xx: #{e}")

  # 20e: Mismatched remote SHA-256 after retry -> pre-check does not skip, post-upload verify fails hard (no 3rd PUT)
  o, e, st, events, bin_puts = run_retry_case.call(:head_mismatch_after_eof)
  assert(!st.success?, "20e post-upload SHA-256 mismatch after retry must fail hard: #{o}\n#{e}")
  assert(bin_puts == 2, "20e expected retry PUT #2 followed by hard post-upload failure (got #{bin_puts} PUTs)")
  bin_events = events.select { |_, p| p.end_with?("/#{bin_rel}") }.map(&:first)
  assert(bin_events == %w[HEAD PUT HEAD PUT HEAD], "20e expected HEAD->PUT->HEAD->PUT->HEAD then hard fail, got #{bin_events.inspect}")
  assert(e.include?("post-upload HEAD") && e.include?("SHA-256 mismatch"), "20e must fail in post-upload SHA-256 check: #{e}")
end

puts "TEST_PACKAGE_PORT: PASS (21/21)"
