port_configure() {
  CPPFLAGS="-I$PIZFIX/include" LDFLAGS="-L$PIZFIX/lib" \
    PKG_CONFIG_PATH="$PIZFIX/lib/pkgconfig" \
    ./configure --prefix="$PIZFIX" \
      --with-openssl="$PIZFIX" \
      --with-nghttp2="$PIZFIX" \
      --with-zlib="$PIZFIX" \
      --with-zstd="$PIZFIX" \
      --with-brotli="$PIZFIX" \
      --with-libidn2="$PIZFIX" \
      --without-libpsl \
      --enable-versioned-symbols \
      --enable-websockets \
      --with-ca-bundle=/etc/ssl/certs/ca-certificates.crt \
      --with-ca-path=/etc/ssl/certs
}

port_test() {
  local ver
  ver="$("$PIZFIX/bin/curl" --version)"
  printf '%s\n' "$ver"
  printf '%s\n' "$ver" | grep -q 'OpenSSL/3\.6\.5'
  printf '%s\n' "$ver" | grep -q 'HTTP2'
  printf '%s\n' "$ver" | grep -q 'zstd'
  printf '%s\n' "$ver" | grep -q 'brotli'

  local td
  td="$(mktemp -d)"
  printf 'filc-curl-ok\n' > "$td/hello.txt"
  "$PIZFIX/bin/curl" -fsS "file://$td/hello.txt" | grep -qx 'filc-curl-ok'

  "${HOST_PYTHON3:-/usr/bin/python3}" - "$PIZFIX/bin/curl" <<'PY'
import subprocess, sys, threading
from http.server import BaseHTTPRequestHandler, HTTPServer

class H(BaseHTTPRequestHandler):
    def do_GET(self):
        body = b"filc-curl-http-ok\n"
        self.send_response(200)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)
    def log_message(self, *args):
        pass

srv = HTTPServer(("127.0.0.1", 0), H)
t = threading.Thread(target=srv.serve_forever, daemon=True)
t.start()
try:
    out = subprocess.check_output(
        [sys.argv[1], "-fsS", f"http://127.0.0.1:{srv.server_port}/test"],
        text=True, timeout=15,
    )
    assert out.strip() == "filc-curl-http-ok", out
finally:
    srv.shutdown()
    srv.server_close()
PY
  rm -rf "$td"
}

port_package_smoke() {
  local ver td
  ver="$("$PKG_PREFIX/bin/curl" --version)"
  printf '%s\n' "$ver" | grep -q 'OpenSSL/3\.6\.5'
  printf '%s\n' "$ver" | grep -q 'HTTP2'
  td="$(mktemp -d)"
  printf 'filc-curl-pkg-ok\n' > "$td/hello.txt"
  "$PKG_PREFIX/bin/curl" -fsS "file://$td/hello.txt" | grep -qx 'filc-curl-pkg-ok'
  rm -rf "$td"
}
