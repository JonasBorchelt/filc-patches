UPSTREAM_SHA256_SOURCE="pgp:https://ftp.gnu.org/gnu/findutils/findutils-4.11.0.tar.xz.sig key:ports/pgp-keys/gnu-youngman-release-key.asc fpr:0CF4E8D871593224842832B888DD9E08C5DDACB9"
