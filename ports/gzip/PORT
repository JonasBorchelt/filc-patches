port_test() {
  "$PIZFIX/bin/gzip" --version | grep -q 'gzip 1\.15'
  local td
  td="$(mktemp -d)"
  seq 1 5000 > "$td/in.txt"
  "$PIZFIX/bin/gzip" -9 -c "$td/in.txt" > "$td/in.txt.gz"
  "$PIZFIX/bin/gzip" -t "$td/in.txt.gz"
  "$PIZFIX/bin/gzip" -d -c "$td/in.txt.gz" > "$td/out.txt"
  cmp -s "$td/in.txt" "$td/out.txt"
  rm -rf "$td"
}
