port_configure() {
  # PHP 5.6 ext/iconv/config.m4 falls back to /usr/local /usr and unconditionally
  # prepends -I$PHP_ICONV_PREFIX/include and -L$PHP_ICONV_PREFIX/lib to CFLAGS
  # and LDFLAGS whenever libc provides iconv(). Also fix implicit int main()
  # and missing stdlib.h/stdio.h in PHP_READDIR_R_TYPE and AC_ZEND_BROKEN_SPRINTF
  # probes (rejected by Clang 20), and version phar5.6 in ext/phar/Makefile.frag.
  "${HOST_RUBY:-ruby}" -e '
    p = "configure"
    s = File.binread(p)
    pat = %r{for i in /usr/local /usr; do\s*\n\s*if test -f "\$i/include/iconv\.h" \|\| test -f "\$i/include/giconv\.h"; then\s*\n\s*PHP_ICONV_PREFIX="\$i"\s*\n\s*break\s*\n\s*fi\s*\n\s*done\s*\n\s*if test -z "\$PHP_ICONV_PREFIX"; then\s*\n\s*PHP_ICONV_PREFIX="/usr"\s*\n\s*fi}
    matches = s.scan(pat).length
    raise "ext/iconv /usr prefix fallback not found in configure (matches=#{matches})" unless matches == 1
    s = s.sub(pat, "PHP_ICONV_PREFIX=\"$prefix\"")
    rd_old = "#include <sys/types.h>\n#include <dirent.h>\n\n#ifndef PATH_MAX\n#define PATH_MAX 1024\n#endif\n\nmain() {"
    rd_matches = s.scan(rd_old).length
    raise "PHP_READDIR_R_TYPE probe not found in configure (matches=#{rd_matches})" unless rd_matches == 1
    s = s.sub(rd_old, "#include <stdlib.h>\n#include <sys/types.h>\n#include <dirent.h>\n\n#ifndef PATH_MAX\n#define PATH_MAX 1024\n#endif\n\nint main(void) {")
    sp_old = "main() {char buf[20];exit(sprintf(buf,\"testing 123\")!=11); }"
    sp_matches = s.scan(sp_old).length
    raise "AC_ZEND_BROKEN_SPRINTF probe not found in configure (matches=#{sp_matches})" unless sp_matches == 1
    s = s.sub(sp_old, "#include <stdio.h>\n#include <stdlib.h>\nint main(void) {char buf[20];exit(sprintf(buf,\"testing 123\")!=11); }")
    uname_old = "PHP_UNAME=`uname -a | xargs`"
    uname_matches = s.scan(uname_old).length
    raise "PHP_UNAME assignment not found in configure (matches=#{uname_matches})" unless uname_matches == 1
    s = s.sub(uname_old, "PHP_UNAME=\"${PHP_UNAME:-`uname -a | xargs`}\"")
    File.binwrite(p, s)
    pf = "ext/phar/Makefile.frag"
    ps = File.binread(pf)
    phar_old = <<~FRAG
      install-pharcmd: pharcmd
      \t-@$(mkinstalldirs) $(INSTALL_ROOT)$(bindir)
      \t$(INSTALL) $(builddir)/phar.phar $(INSTALL_ROOT)$(bindir)
      \t-@rm -f $(INSTALL_ROOT)$(bindir)/phar
      \t$(LN_S) -f phar.phar $(INSTALL_ROOT)$(bindir)/phar
      \t@$(mkinstalldirs) $(INSTALL_ROOT)$(mandir)/man1
      \t@$(INSTALL_DATA) $(builddir)/phar.1 $(INSTALL_ROOT)$(mandir)/man1/phar.1
      \t@$(INSTALL_DATA) $(builddir)/phar.phar.1 $(INSTALL_ROOT)$(mandir)/man1/phar.phar.1
    FRAG
    phar_new = <<~FRAG
      install-pharcmd: pharcmd
      \t-@$(mkinstalldirs) $(INSTALL_ROOT)$(bindir)
      \t$(INSTALL) $(builddir)/phar.phar $(INSTALL_ROOT)$(bindir)/$(program_prefix)phar$(program_suffix).phar
      \t-@rm -f $(INSTALL_ROOT)$(bindir)/$(program_prefix)phar$(program_suffix)
      \t$(LN_S) -f $(program_prefix)phar$(program_suffix).phar $(INSTALL_ROOT)$(bindir)/$(program_prefix)phar$(program_suffix)
      \t@$(mkinstalldirs) $(INSTALL_ROOT)$(mandir)/man1
      \t@$(INSTALL_DATA) $(builddir)/phar.1 $(INSTALL_ROOT)$(mandir)/man1/$(program_prefix)phar$(program_suffix).1
      \t@$(INSTALL_DATA) $(builddir)/phar.phar.1 $(INSTALL_ROOT)$(mandir)/man1/$(program_prefix)phar$(program_suffix).phar.1
    FRAG
    raise "install-pharcmd block not found in #{pf}" unless ps.include?(phar_old)
    File.binwrite(pf, ps.sub(phar_old, phar_new))
  '
