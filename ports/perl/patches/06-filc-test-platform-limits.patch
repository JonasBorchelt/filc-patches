Subject: Skip Fil-C by-design memory-safety pointer-synthesis subtests cleanly
Policy-Class: P4-Audit
Rationale: Dedicated test-only patch cleanly separated from production code, skipping only 8 specific subtests that intentionally synthesize or byte-mangle raw pointers (disallowed by design under Fil-C InvisiCaps memory safety) while keeping all remaining subtests active: (1) t/io/scalar.t:350-375 (4 subtests in has_trailing_nul) synthesizes pointers via integer arithmetic on pack/unpack P (124/128 subtests still run); (2) t/op/pack.t:326,331,1648,1651 (4 subtests) byte-swaps pointers (p>) or utf8-upgrades raw pointer bytes (14,718/14,722 subtests still run, including native pack/unpack p/P).
Upstream-Status: Fil-C-Specific
Fil-C-Origin-Commits: none

--- a/t/io/scalar.t
+++ b/t/io/scalar.t
@@ -348,6 +348,7 @@
     return $trailing eq "\0";
 }
 SKIP: {
+    skip "Fil-C InvisiCaps: has_trailing_nul synthesizes pointers via pack/unpack P integer arithmetic", 4;
     if ($Config::Config{'extensions'} !~ m!\bB\b!) {
 	skip "no B", 4;
     }
--- a/t/op/pack.t
+++ b/t/op/pack.t
@@ -323,12 +323,16 @@
 is(unpack("p",pack("p","foo")), "foo");
 SKIP: {
   is(unpack("p<",pack("p<","foo")), "foo");
+  skip "Fil-C InvisiCaps: byte-swapping a pointer via pack/unpack p> strips capability", 1;
   is(unpack("p>",pack("p>","foo")), "foo");
 }
 # scalars
 is(unpack("p",pack("p",239)), 239);
 is(unpack("p<",pack("p<",239)), 239);
-is(unpack("p>",pack("p>",239)), 239);
+SKIP: {
+  skip "Fil-C InvisiCaps: byte-swapping a pointer via pack/unpack p> strips capability", 1;
+  is(unpack("p>",pack("p>",239)), 239);
+}
 
 # temps
 sub foo { my $a = "a"; return $a . $a++ . $a++ }
@@ -1645,10 +1649,16 @@
     is(unpack("p", $down), "abc\xa5", "unpack p downgraded");
     $up   = $down;
     utf8::upgrade($up);
-    is(unpack("p", $up), "abc\xa5", "unpack p upgraded");
+    SKIP: {
+      skip "Fil-C InvisiCaps: utf8::upgrade on packed pointer bytes strips capability", 1;
+      is(unpack("p", $up), "abc\xa5", "unpack p upgraded");
+    }
 
     is(unpack("P7", $down), "abc\xa5\x00\xfed", "unpack P downgraded");
-    is(unpack("P7", $up),   "abc\xa5\x00\xfed", "unpack P upgraded");
+    SKIP: {
+      skip "Fil-C InvisiCaps: utf8::upgrade on packed pointer bytes strips capability", 1;
+      is(unpack("P7", $up),   "abc\xa5\x00\xfed", "unpack P upgraded");
+    }
 
     # x, X and @
     $down = "\xf8\xf9\xfa\xfb\xfc\xfd\xfe\xff\x05\x06";
 
