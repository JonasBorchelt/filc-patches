echo "=== Running (k) LLVM 23 PtrToAddrInst & sprintf(\"%s\") -O2 Regression ==="
cat > "$TEST_DIR/ptrtoaddr_sprintf_test.c" <<'EOF'
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

__attribute__((noinline))
static size_t format_joined(char *buf, const char *const *items, size_t n) {
    char *p = buf;
    for (size_t i = 0; i < n; ++i) {
        if (i > 0) {
            strcpy(p, ", ");
            p += 2;
        }
        p += sprintf(p, "%s", items[i]);
    }
    return (size_t)(p - buf);
}

int main(void) {
    const char *items[] = {"alpha", "beta", "gamma"};
    char *buf = (char *)malloc(64);
    if (!buf)
        return 1;
    size_t len = format_joined(buf, items, 3);
    if (len != 18 || strcmp(buf, "alpha, beta, gamma") != 0) {
        fprintf(stderr, "unexpected format_joined result: len=%zu buf='%s'\n", len, buf);
        free(buf);
        return 2;
    }
    printf("PTRTOADDR_SPRINTF_OK %s (len=%zu)\n", buf, len);
    free(buf);
    return 0;
}
EOF

cat > "$TEST_DIR/ptrtoaddr_ir_driver.c" <<'EOF'
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <sys/wait.h>
#include <unistd.h>

extern int64_t filc_test_ptrtoaddr_diff(const void *a, const void *b);
extern volatile char *filc_test_ptrtoaddr_noprov(const void *a);

int main(void) {
    char *buf = (char *)malloc(32);
    if (!buf)
        return 1;
    buf[0] = 'X';
    int64_t diff = filc_test_ptrtoaddr_diff(buf + 3, buf + 19);
    if (diff != 16) {
        fprintf(stderr, "ptrtoaddr diff mismatch: got %lld, want 16\n", (long long)diff);
        free(buf);
        return 2;
    }

    fflush(NULL);
    pid_t pid = fork();
    if (pid < 0)
        return 3;
    if (pid == 0) {
        volatile char *bad = filc_test_ptrtoaddr_noprov(buf);
        char v = *bad;
        printf("UNEXPECTED_PTRTOADDR_PROV_LEAK=%d\n", (int)v);
        fflush(stdout);
        _exit(0);
    }
    int status = 0;
    if (waitpid(pid, &status, 0) < 0)
        return 4;
    if (!WIFSIGNALED(status)) {
        fprintf(stderr, "ptrtoaddr inttoptr child did not trap (status=0x%x)\n", status);
        free(buf);
        return 5;
    }
    printf("PTRTOADDR_IR_OK diff=%lld\n", (long long)diff);
    free(buf);
    return 0;
}
EOF

PTRTOADDR_OK=1
"$CLANG" -O2 -Wall -Wextra -Werror "$TEST_DIR/ptrtoaddr_sprintf_test.c" -o "$TEST_DIR/ptrtoaddr_sprintf_test"
run_and_capture ptrtoaddr_sprintf_test "$TEST_DIR/ptrtoaddr_sprintf_test"
RC_PTRTOADDR_SPRINTF="$(cat "$TEST_DIR/ptrtoaddr_sprintf_test.rc")"
if [[ "$RC_PTRTOADDR_SPRINTF" -ne 0 ]] || ! grep -Fxq "PTRTOADDR_SPRINTF_OK alpha, beta, gamma (len=18)" "$TEST_DIR/ptrtoaddr_sprintf_test.stdout"; then
  echo "error: ptrtoaddr_sprintf_test failed (rc=$RC_PTRTOADDR_SPRINTF)" >&2
  cat "$TEST_DIR/ptrtoaddr_sprintf_test.stdout" >&2
  cat "$TEST_DIR/ptrtoaddr_sprintf_test.stderr" >&2
  PTRTOADDR_OK=0
fi

"$CLANG" -O2 -S -emit-llvm "$TEST_DIR/ptrtoaddr_sprintf_test.c" -o "$TEST_DIR/ptrtoaddr_post.ll"
PTRTOADDR_AFTER_DL="$(sed -n '/^target datalayout_after_filc = "/{s/^target datalayout_after_filc = "\(.*\)"$/\1/;p;q;}' "$TEST_DIR/ptrtoaddr_post.ll")"
PTRTOADDR_TRIPLE="$(sed -n '/^target triple = "/{s/^target triple = "\(.*\)"$/\1/;p;q;}' "$TEST_DIR/ptrtoaddr_post.ll")"
if [[ -z "$PTRTOADDR_AFTER_DL" || -z "$PTRTOADDR_TRIPLE" ]]; then
  echo "error: failed to extract target datalayout_after_filc / triple from ptrtoaddr_post.ll" >&2
  PTRTOADDR_OK=0
fi
if [[ "$PTRTOADDR_AFTER_DL" == e-m:e-* ]]; then
  PTRTOADDR_BEFORE_DL="e-m:e-ni:0-${PTRTOADDR_AFTER_DL#e-m:e-}"
else
  PTRTOADDR_BEFORE_DL="${PTRTOADDR_AFTER_DL}-ni:0"
fi
printf 'target datalayout = "%s"\ntarget datalayout_after_filc = "%s"\ntarget triple = "%s"\n' \
  "$PTRTOADDR_BEFORE_DL" "$PTRTOADDR_AFTER_DL" "$PTRTOADDR_TRIPLE" > "$TEST_DIR/ptrtoaddr_ir.ll"
cat >> "$TEST_DIR/ptrtoaddr_ir.ll" <<'EOF'

define dso_local i64 @filc_test_ptrtoaddr_diff(ptr noundef %a, ptr noundef %b) {
entry:
  %ia = ptrtoaddr ptr %a to i64
  %ib = ptrtoaddr ptr %b to i64
  %d = sub i64 %ib, %ia
  ret i64 %d
}

define dso_local ptr @filc_test_ptrtoaddr_noprov(ptr noundef %a) {
entry:
  %ia = ptrtoaddr ptr %a to i64
  %p = inttoptr i64 %ia to ptr
  ret ptr %p
}
EOF

"$CLANG" -O2 -c -x ir "$TEST_DIR/ptrtoaddr_ir.ll" -o "$TEST_DIR/ptrtoaddr_ir.o"
"$CLANG" -O2 -Wall -Wextra -Werror "$TEST_DIR/ptrtoaddr_ir_driver.c" "$TEST_DIR/ptrtoaddr_ir.o" -o "$TEST_DIR/ptrtoaddr_ir_test"
run_and_capture ptrtoaddr_ir_test "$TEST_DIR/ptrtoaddr_ir_test"
RC_PTRTOADDR_IR="$(cat "$TEST_DIR/ptrtoaddr_ir_test.rc")"
if [[ "$RC_PTRTOADDR_IR" -ne 0 ]] \
  || grep -q "UNEXPECTED_PTRTOADDR_PROV_LEAK" "$TEST_DIR/ptrtoaddr_ir_test.stdout" \
  || ! grep -Fxq "PTRTOADDR_IR_OK diff=16" "$TEST_DIR/ptrtoaddr_ir_test.stdout" \
  || ! grep -qi "filc safety error" "$TEST_DIR/ptrtoaddr_ir_test.stderr"; then
  echo "error: ptrtoaddr_ir_test failed (rc=$RC_PTRTOADDR_IR)" >&2
  cat "$TEST_DIR/ptrtoaddr_ir_test.stdout" >&2
  cat "$TEST_DIR/ptrtoaddr_ir_test.stderr" >&2
  PTRTOADDR_OK=0
fi

if [[ "$PTRTOADDR_OK" -eq 1 ]]; then
  STATUS_PTRTOADDR="PASS"
else
  STATUS_PTRTOADDR="FAIL"
  FAILURES=$((FAILURES + 1))
fi

echo "=== Running (l) RTLD_GLOBAL Duplicate-Export FunctionObject Isolation ==="
cat > "$TEST_DIR/rtld_global_a.c" <<'EOF'
#include <stdarg.h>

const char *filc_plugin_id(void) {
    return "plugin_a";
}

int filc_plugin_tag(int x) {
    return x + 100;
}

int filc_plugin_vsum(int count, ...) {
    va_list ap;
    va_start(ap, count);
    int sum = 100;
    for (int i = 0; i < count; ++i)
        sum += va_arg(ap, int);
    va_end(ap);
    return sum;
}
EOF

cat > "$TEST_DIR/rtld_global_b.c" <<'EOF'
#include <stdarg.h>

const char *filc_plugin_id(void) {
    return "plugin_b";
}

int filc_plugin_tag(int x) {
    return x + 200;
}

int filc_plugin_vsum(int count, ...) {
    va_list ap;
    va_start(ap, count);
    int sum = 200;
    for (int i = 0; i < count; ++i)
        sum += va_arg(ap, int);
    va_end(ap);
    return sum;
}
EOF

cat > "$TEST_DIR/rtld_global_main.c" <<'EOF'
#define _GNU_SOURCE
#include <dlfcn.h>
#include <stdio.h>
#include <string.h>

typedef const char *(*id_fn_t)(void);
typedef int (*tag_fn_t)(int);
typedef int (*vsum_fn_t)(int, ...);

int main(int argc, char **argv) {
    if (argc != 3) {
        fprintf(stderr, "usage: %s liba.so libb.so\n", argv[0]);
        return 99;
    }

    void *ha = dlopen(argv[1], RTLD_LAZY | RTLD_GLOBAL);
    if (!ha) {
        fprintf(stderr, "dlopen(%s) failed: %s\n", argv[1], dlerror());
        return 1;
    }
    void *hb = dlopen(argv[2], RTLD_LAZY | RTLD_GLOBAL);
    if (!hb) {
        fprintf(stderr, "dlopen(%s) failed: %s\n", argv[2], dlerror());
        dlclose(ha);
        return 2;
    }

    id_fn_t id_a = (id_fn_t)dlsym(ha, "filc_plugin_id");
    id_fn_t id_b = (id_fn_t)dlsym(hb, "filc_plugin_id");
    tag_fn_t tag_a = (tag_fn_t)dlsym(ha, "filc_plugin_tag");
    tag_fn_t tag_b = (tag_fn_t)dlsym(hb, "filc_plugin_tag");
    vsum_fn_t vsum_a = (vsum_fn_t)dlsym(ha, "filc_plugin_vsum");
    vsum_fn_t vsum_b = (vsum_fn_t)dlsym(hb, "filc_plugin_vsum");
    id_fn_t id_def = (id_fn_t)dlsym(RTLD_DEFAULT, "filc_plugin_id");

    if (!id_a || !id_b || !tag_a || !tag_b || !vsum_a || !vsum_b || !id_def) {
        fprintf(stderr, "dlsym failed: %s\n", dlerror());
        return 3;
    }

    const char *sa = id_a();
    const char *sb = id_b();
    const char *sd = id_def();
    int ta = tag_a(7);
    int tb = tag_b(7);
    int va = vsum_a(2, 10, 20);
    int vb = vsum_b(2, 10, 20);

    if (strcmp(sa, "plugin_a") != 0 || strcmp(sb, "plugin_b") != 0 || strcmp(sd, "plugin_a") != 0) {
        fprintf(stderr, "id mismatch: a='%s' b='%s' default='%s'\n", sa, sb, sd);
        return 4;
    }
    if (ta != 107 || tb != 207) {
        fprintf(stderr, "tag mismatch: a=%d b=%d\n", ta, tb);
        return 5;
    }
    if (va != 130 || vb != 230) {
        fprintf(stderr, "vsum mismatch: a=%d b=%d\n", va, vb);
        return 6;
    }
    if (id_a == id_b || tag_a == tag_b || vsum_a == vsum_b) {
        fprintf(stderr, "function pointers unexpectedly identical across DSOs\n");
        return 7;
    }

    printf("RTLD_GLOBAL_OK: a=%s(%d,%d) b=%s(%d,%d) default=%s\n", sa, ta, va, sb, tb, vb, sd);
    return 0;
}
EOF

RTLD_GLOBAL_OK=1
RTLD_GLOBAL_ELF_OK=1
"$CLANG" -O2 -Wall -Wextra -Werror -fPIC -shared "$TEST_DIR/rtld_global_a.c" -o "$TEST_DIR/librtld_global_a.so"
"$CLANG" -O2 -Wall -Wextra -Werror -fPIC -shared "$TEST_DIR/rtld_global_b.c" -o "$TEST_DIR/librtld_global_b.so"
"$CLANG" -O2 -Wall -Wextra -Werror "$TEST_DIR/rtld_global_main.c" -o "$TEST_DIR/rtld_global_main"

READELF_BIN="$(command -v readelf || command -v llvm-readelf || true)"
if [[ -z "$READELF_BIN" && -x "$BUILD_DIR/bin/llvm-readelf" ]]; then
  READELF_BIN="$BUILD_DIR/bin/llvm-readelf"
fi
for so in "$TEST_DIR/librtld_global_a.so" "$TEST_DIR/librtld_global_b.so"; do
  if "$LLVM_NM" -D --defined-only "$so" | grep -q 'pizlonatedFIP'; then
    echo "error: unexpected exported pizlonatedFIP symbol in $so" >&2
    "$LLVM_NM" -D --defined-only "$so" | grep 'pizlonatedFIP' >&2 || true
    RTLD_GLOBAL_ELF_OK=0
  fi
  for sym in pizlonated_filc_plugin_id pizlonated_filc_plugin_tag pizlonated_filc_plugin_vsum; do
    if ! "$LLVM_NM" -D --defined-only "$so" | grep -Eq " [A-Za-z] ${sym}$"; then
      echo "error: expected exported getter ${sym} in $so" >&2
      RTLD_GLOBAL_ELF_OK=0
    fi
  done
  for fn in filc_plugin_id filc_plugin_tag; do
    if ! "$LLVM_NM" -D --defined-only "$so" | grep -Eq " [A-Za-z] pizlonatedFI[0-9]+_${fn}$"; then
      echo "error: expected exported fast-call alias pizlonatedFI*_${fn} in $so" >&2
      RTLD_GLOBAL_ELF_OK=0
    fi
  done
  if [[ -n "$READELF_BIN" ]]; then
    if "$READELF_BIN" -rW "$so" | grep -q 'pizlonatedFIP'; then
      echo "error: unexpected preemptible pizlonatedFIP dynamic relocation in $so" >&2
      "$READELF_BIN" -rW "$so" | grep 'pizlonatedFIP' >&2 || true
      RTLD_GLOBAL_ELF_OK=0
    fi
  else
    echo "error: readelf / llvm-readelf not found for relocation verification" >&2
    RTLD_GLOBAL_ELF_OK=0
  fi
done

run_and_capture rtld_global_main "$TEST_DIR/rtld_global_main" "$TEST_DIR/librtld_global_a.so" "$TEST_DIR/librtld_global_b.so"
RC_RTLD_GLOBAL="$(cat "$TEST_DIR/rtld_global_main.rc")"
if [[ "$RC_RTLD_GLOBAL" -ne 0 ]] \
  || [[ "$RTLD_GLOBAL_ELF_OK" -ne 1 ]] \
  || ! grep -Fxq "RTLD_GLOBAL_OK: a=plugin_a(107,130) b=plugin_b(207,230) default=plugin_a" "$TEST_DIR/rtld_global_main.stdout"; then
  echo "error: rtld_global_main failed (rc=$RC_RTLD_GLOBAL elf_ok=$RTLD_GLOBAL_ELF_OK)" >&2
  cat "$TEST_DIR/rtld_global_main.stdout" >&2
  cat "$TEST_DIR/rtld_global_main.stderr" >&2
  RTLD_GLOBAL_OK=0
fi

if [[ "$RTLD_GLOBAL_OK" -eq 1 ]]; then
  STATUS_RTLD_GLOBAL="PASS"
else
  STATUS_RTLD_GLOBAL="FAIL"
  FAILURES=$((FAILURES + 1))
fi

OVERALL_STATUS="PASS"
if (( FAILURES > 0 )); then
  OVERALL_STATUS="FAIL"
  echo "FILC_PHASE tests failure $(( $(date +%s) - T_TESTS_START ))"
else
  echo "FILC_PHASE tests success $(( $(date +%s) - T_TESTS_START ))"
fi

# ---------------------------------------------------------------------------
# Generate structured evidence report (Beleg)
# ---------------------------------------------------------------------------
TIMESTAMP_UTC="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
REPO_COMMIT="$(git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null || echo unknown)"
ARCH="$(uname -m)"

{
  echo "================================================================================"
  echo "FIL-C TOOLCHAIN END-TO-END VERIFICATION REPORT (BELEG)"
  echo "================================================================================"
  echo "TIMESTAMP_UTC:        $TIMESTAMP_UTC"
  echo "HOST_UNAME:           $(uname -srm)"
  echo "REPO_COMMIT:          $REPO_COMMIT"
  echo "LLVM_TAG:             ${LLVM_TAG:-none}"
  echo "LLVM_COMMIT:          $LLVM_COMMIT"
  echo "FILC_COMMIT:          $FILC_COMMIT"
  echo "MUSL_COMMIT:          $MUSL_COMMIT"
  echo "CLANG_VERSION:        $("$CLANG" --version | head -n 1)"
  echo "LLD_VERSION:          $("$LLD" --version | head -n 1)"
  echo "OVERALL_STATUS:       $OVERALL_STATUS"
  echo ""
  echo "--- TOOLCHAIN LIBRARY SHA-256 ---"
  for lib in \
    "$PIZFIX/lib/libyoloc.so" \
    "$PIZFIX/lib/libpizlo.so" \
    "$PIZFIX/lib/libc.so" \
    "$PIZFIX/lib/libc++.so.1.0" \
    "$PIZFIX/lib/libc++abi.so.1.0"; do
    echo "  $(sha256_file "$lib")  $(basename "$lib")"
  done
  echo ""
  echo "--- TEST BINARY SHA-256 ---"
  for bin in hello_world trap_oob trap_uaf hello_cxx; do
    echo "  $(sha256_file "$TEST_DIR/$bin")  $bin ($(wc -c < "$TEST_DIR/$bin" | tr -d ' ') bytes)"
  done
  echo ""
  echo "--- TEST (a) HELLO WORLD [$STATUS_HELLO] ---"
  echo "EXIT_CODE: $RC_HELLO"
  echo "STDOUT:"
  sed 's/^/  | /' "$TEST_DIR/hello_world.stdout"
  if [[ -s "$TEST_DIR/hello_world.stderr" ]]; then
    echo "STDERR:"
    sed 's/^/  | /' "$TEST_DIR/hello_world.stderr"
  fi
  echo ""
  echo "--- TEST (b1) MEMORY-SAFETY TRAP: OUT-OF-BOUNDS [$STATUS_OOB] ---"
  echo "EXIT_CODE: $RC_OOB"
  if [[ -s "$TEST_DIR/trap_oob.stdout" ]]; then
    echo "STDOUT:"
    sed 's/^/  | /' "$TEST_DIR/trap_oob.stdout"
  fi
  echo "STDERR:"
  sed 's/^/  | /' "$TEST_DIR/trap_oob.stderr"
  echo ""
  echo "--- TEST (b2) MEMORY-SAFETY TRAP: USE-AFTER-FREE [$STATUS_UAF] ---"
  echo "EXIT_CODE: $RC_UAF"
  if [[ -s "$TEST_DIR/trap_uaf.stdout" ]]; then
    echo "STDOUT:"
    sed 's/^/  | /' "$TEST_DIR/trap_uaf.stdout"
  fi
  echo "STDERR:"
  sed 's/^/  | /' "$TEST_DIR/trap_uaf.stderr"
  echo ""
  echo "--- TEST (c) C++ WITH LIBC++ [$STATUS_CXX] ---"
  echo "EXIT_CODE: $RC_CXX"
  echo "STDOUT:"
  sed 's/^/  | /' "$TEST_DIR/hello_cxx.stdout"
  if [[ -s "$TEST_DIR/hello_cxx.stderr" ]]; then
    echo "STDERR:"
    sed 's/^/  | /' "$TEST_DIR/hello_cxx.stderr"
  fi
  echo ""
  echo "--- TEST (d) SHARED LIB -Wl,--version-script [$STATUS_VERSCRIPT] ---"
  echo "EXIT_CODE_EQ: $RC_VER_EQ  EXIT_CODE_COMMA: $RC_VER_COMMA  NM_OK: $NM_OK"
  echo "STDOUT:"
  sed 's/^/  | /' "$TEST_DIR/vertest_eq.stdout"
  if [[ -s "$TEST_DIR/vertest.nm" ]]; then
    echo "EXPORTS:"
    sed 's/^/  | /' "$TEST_DIR/vertest.nm"
  fi
  echo ""
  echo "--- TEST (e) SAFE -Wa ASSEMBLER FLAGS [$STATUS_WAFLAGS] ---"
  echo "EXIT_CODE_WA_C: $RC_WA_C  WA_OK: $WA_OK"
  echo ""
  echo "--- TEST (f) COMPUTED-GOTO INDIRECTBR [$STATUS_INDIRECTBR] ---"
  echo "EXIT_CODE_O0: $RC_IBR_O0  EXIT_CODE_O2: $RC_IBR_O2"
  echo "STDOUT_O0:"
  sed 's/^/  | /' "$TEST_DIR/indirectbr_o0.stdout"
  echo "STDOUT_O2:"
  sed 's/^/  | /' "$TEST_DIR/indirectbr_o2.stdout"
  echo ""
  echo "--- TEST (g) COMPILE-TIME REJECTION OF UNSUPPORTED CONSTRUCTS [$STATUS_REJECT] ---"
  echo "REJECT_OK: $REJECT_OK (builtin_setjmp=$(cat "$TEST_DIR/reject_builtin_setjmp.rc"), builtin_longjmp=$(cat "$TEST_DIR/reject_builtin_longjmp.rc"), define_setjmp=$(cat "$TEST_DIR/reject_define_setjmp.rc"), addrspace=$(cat "$TEST_DIR/reject_addrspace.rc"), module_asm=$(cat "$TEST_DIR/reject_module_asm.rc"), trap_asm_goto=$RC_ASM_GOTO)"
  echo ""
  echo "--- TEST (h) FLOATING-POINT ENVIRONMENT (<fenv.h>) [$STATUS_FENV] ---"
  echo "EXIT_CODE: $RC_FENV"
  echo "STDOUT:"
  sed 's/^/  | /' "$TEST_DIR/fenv_test.stdout"
  if [[ -s "$TEST_DIR/fenv_test.stderr" ]]; then
    echo "STDERR:"
    sed 's/^/  | /' "$TEST_DIR/fenv_test.stderr"
  fi
  echo ""
  echo "--- TEST (i) RUNTIME SEMCTL(GETALL/SETALL) & PRCTL TGID COMM [$STATUS_SEMCTL_PRCTL] ---"
  echo "EXIT_CODE: $RC_SEMCTL_PRCTL  OOB_TRAP_RC: $RC_SEMCTL_OOB"
  echo ""
  echo "--- TEST (j) FIBER CONTEXT (<ucontext.h>) GC & STACK OVERFLOW [$STATUS_FIBER] ---"
  echo "GC_EXIT_CODE: $RC_FIBER_GC  OVERFLOW_TRAP_RC: $RC_FIBER_OVF"
  echo ""
  echo "--- TEST (k) LLVM 23 PTRTOADDR & SPRINTF(\"%s\") -O2 [$STATUS_PTRTOADDR] ---"
  echo "SPRINTF_EXIT_CODE: $RC_PTRTOADDR_SPRINTF  IR_EXIT_CODE: $RC_PTRTOADDR_IR"
  echo ""
  echo "--- TEST (l) RTLD_GLOBAL DUPLICATE-EXPORT ISOLATION [$STATUS_RTLD_GLOBAL] ---"
  echo "EXIT_CODE: $RC_RTLD_GLOBAL  ELF_OK: $RTLD_GLOBAL_ELF_OK"
  if [[ -s "$TEST_DIR/rtld_global_main.stdout" ]]; then
    echo "STDOUT:"
    sed 's/^/  | /' "$TEST_DIR/rtld_global_main.stdout"
  fi
  if [[ -s "$TEST_DIR/rtld_global_main.stderr" ]]; then
    echo "STDERR:"
    sed 's/^/  | /' "$TEST_DIR/rtld_global_main.stderr"
  fi
  echo "================================================================================"
} > "$REPORT_FILE"

REPORT_SHA256="$(sha256_file "$REPORT_FILE")"
echo "REPORT_SHA256:        $REPORT_SHA256" >> "$REPORT_FILE"

if [[ -n "${FILC_REPORT_ARCHIVE_DIR:-}" ]]; then
  mkdir -p "$FILC_REPORT_ARCHIVE_DIR"
  ARCHIVE_NAME="toolchain-${TIMESTAMP_UTC//[:]/}-${REPO_COMMIT:0:8}-${OVERALL_STATUS}.txt"
  cp "$REPORT_FILE" "$FILC_REPORT_ARCHIVE_DIR/$ARCHIVE_NAME"
  echo "Archived report to $FILC_REPORT_ARCHIVE_DIR/$ARCHIVE_NAME"
fi

cat "$REPORT_FILE"

if (( FAILURES > 0 )); then
  echo "error: $FAILURES end-to-end toolchain test(s) failed" >&2
  exit 1
fi

echo "=== ALL END-TO-END TOOLCHAIN TESTS PASSED ==="
