port_test() {
  cat > "$SRC_DIR/_filc_test_uv.c" <<'EOF'
#include <uv.h>
static int fired = 0;
static void on_timer(uv_timer_t *handle) {
  fired = 1;
  uv_close((uv_handle_t *)handle, NULL);
}
int main(void) {
  uv_loop_t loop;
  if (uv_loop_init(&loop) != 0) return 1;
  uv_timer_t timer;
  if (uv_timer_init(&loop, &timer) != 0) return 2;
  if (uv_timer_start(&timer, on_timer, 1, 0) != 0) return 3;
  uv_run(&loop, UV_RUN_DEFAULT);
  uv_loop_close(&loop);
  return fired == 1 ? 0 : 4;
}
EOF
  "$CC" -O2 -I"$PIZFIX/include" "$SRC_DIR/_filc_test_uv.c" -L"$PIZFIX/lib" -luv -lpthread -o "$SRC_DIR/_filc_test_uv"
  "$SRC_DIR/_filc_test_uv"
}
