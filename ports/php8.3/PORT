port_test() {
  local php_bin fpm_bin ext_dir out ver fpm_ver
  php_bin="$PIZFIX/bin/php8.3"
  fpm_bin="$PIZFIX/sbin/php-fpm8.3"
  ext_dir="$PIZFIX/lib/php8.3/extensions"

  out="$("$php_bin" -n -v)"
  ver="${out%%$'\n'*}"
  echo "php8.3 version: $ver"
  printf '%s\n' "$ver" | grep -q '^PHP 8\.3\.37 '

  out="$("$fpm_bin" -n -v)"
  fpm_ver="${out%%$'\n'*}"
  echo "php-fpm8.3 version: $fpm_ver"
  printf '%s\n' "$fpm_ver" | grep -q '^PHP 8\.3\.37 '

  "$php_bin" -n \
    -d extension_dir="$ext_dir" \
    -d zend.assertions=1 \
    -d assert.exception=1 \
    -d zend_extension=opcache \
    -d opcache.enable_cli=1 \
    <<'EOF' | grep -Fxq 'PHP83_FILC_SMOKE_OK'
<?php
// 1. WeakMap + WeakReference + GC (zexact_ptrtable + tagged pointers)
$m = new WeakMap();
$o = new stdClass();
$wr = WeakReference::create($o);
$m[$o] = 1;
foreach ($m as $k => $v) {
    assert($k === $o && $v === 1);
}
assert($wr->get() === $o);
unset($o, $k);
gc_collect_cycles();
assert(count($m) === 0);
assert($wr->get() === null);

// 2. Fibers: ping-pong suspend/resume, nested fibers, exception throw, and stack limit
$pingpong = new Fiber(function (string $init): string {
    $a = Fiber::suspend("step1:" . $init);
    $inner = new Fiber(function (int $x): int {
        $y = Fiber::suspend($x * 2);
        return $y + 1;
    });
    assert($inner->start(21) === 42);
    assert($inner->resume(99) === null);
    assert($inner->getReturn() === 100);
    $b = Fiber::suspend("step2:" . $a);
    return "done:" . $b;
});
assert($pingpong->start("go") === "step1:go");
assert($pingpong->resume("mid") === "step2:mid");
assert($pingpong->resume("end") === null);
assert($pingpong->getReturn() === "done:end");

$throwing = new Fiber(function (): void {
    try {
        Fiber::suspend("ready");
    } catch (RuntimeException $e) {
        Fiber::suspend("caught:" . $e->getMessage());
    }
});
assert($throwing->start() === "ready");
assert($throwing->throw(new RuntimeException("boom")) === "caught:boom");
$throwing->resume();

function recurse_overflow(int $n): array {
    return array_map("recurse_overflow", [$n + 1]);
}
$stack_fiber = new Fiber(function (): void {
    try {
        recurse_overflow(0);
    } catch (Error $e) {
        Fiber::suspend($e->getMessage());
    }
});
$stack_msg = $stack_fiber->start();
assert(is_string($stack_msg) && str_starts_with($stack_msg, "Maximum call stack size"));

// 3. ext/dom XML C14N + XPath (libxml2)
$xml = new DOMDocument();
$xml->loadXML('<root xmlns="urn:test"><child a="1">ok</child></root>');
assert(str_contains($xml->C14N(), '<child a="1">ok</child>'));

// 4. Overflow arithmetic (portable builtins), strcase provenance, opcache, tracked allocator
$i = PHP_INT_MAX;
$i++;
assert(is_float($i));
assert(strtolower("Fil-C PHP 8.3") === "fil-c php 8.3");
assert(strtoupper("Fil-C php 8.3") === "FIL-C PHP 8.3");
assert(opcache_get_status(false)["opcache_enabled"] === true);
assert(memory_get_usage(true) % (2 << 20) !== 0);
assert(memory_get_peak_usage(true) >= memory_get_usage(true));

// 5. Core extensions: OpenSSL, zlib, bz2, SQLite3/PDO, PCRE2, JSON, curl, intl, mbstring, sodium, bcmath
assert(hash("sha256", "hello\n") === "5891b5b522d5df086d0ff0b110fbd9d21bb4fc7163af34d08286a2e846f6be03");
assert(openssl_digest("hello\n", "sha256") === "5891b5b522d5df086d0ff0b110fbd9d21bb4fc7163af34d08286a2e846f6be03");
assert(gzuncompress(gzcompress("filc-zlib-php")) === "filc-zlib-php");
assert(bzdecompress(bzcompress("filc-bz2-php")) === "filc-bz2-php");
assert(preg_match('/^([a-z]+)-(\d+)$/', 'filc-83', $matches) === 1 && $matches[2] === '83');
assert(json_decode(json_encode(["ok" => [1, 2, 3]]), true)["ok"] === [1, 2, 3]);
assert(is_array(curl_version()) && !empty(curl_version()["version"]));
assert(mb_strlen("hällo", "UTF-8") === 5);
assert(mb_ereg_replace("([0-9]+)", "[\\1]", "v83") === "v[83]");
$coll = new Collator("en_US");
assert($coll->compare("a", "b") < 0);
$hash = sodium_crypto_generichash("filc-sodium");
assert(strlen($hash) === SODIUM_CRYPTO_GENERICHASH_BYTES);
assert(bcadd("12345678901234567890", "1", 0) === "12345678901234567891");

$db = new SQLite3(":memory:");
$db->exec("CREATE TABLE t (v INT)");
$db->exec("INSERT INTO t VALUES (42)");
assert($db->querySingle("SELECT v FROM t") === 42);
$db->close();

$pdo = new PDO("sqlite::memory:");
$pdo->exec("CREATE TABLE p (s TEXT)");
$pdo->exec("INSERT INTO p VALUES ('ok')");
assert($pdo->query("SELECT s FROM p")->fetchColumn() === "ok");

echo "PHP83_FILC_SMOKE_OK\n";
EOF

  # Curated upstream run-tests.php suite covering fibers, weakrefs,
  # sqlite3, json, and bz2 (parallelized across available jobs).
  local run_tests_log="$SRC_DIR/.filc-run-tests.log"
  TEST_PHP_EXECUTABLE="$php_bin" \
    NO_INTERACTION=1 \
    REPORT_EXIT_STATUS=1 \
    "$php_bin" -n "$SRC_DIR/run-tests.php" \
      -q \
      -j"$JOBS" \
      -p "$php_bin" \
      -d extension_dir="$ext_dir" \
      --show-diff \
      "$SRC_DIR/Zend/tests/fibers" \
      "$SRC_DIR/Zend/tests/weakrefs" \
      "$SRC_DIR/ext/bz2/tests" \
      "$SRC_DIR/ext/json/tests" \
      "$SRC_DIR/ext/sqlite3/tests" \
      2>&1 | tee "$run_tests_log"
}

port_package_smoke() {
  local php_bin fpm_bin ext_dir out ver fpm_ver
  php_bin="$PKG_PREFIX/bin/php8.3"
  fpm_bin="$PKG_PREFIX/sbin/php-fpm8.3"
  ext_dir="$PKG_PREFIX/lib/php8.3/extensions"

  out="$("$php_bin" -n -v)"
  ver="${out%%$'\n'*}"
  printf '%s\n' "$ver" | grep -q '^PHP 8\.3\.37 '

  out="$("$fpm_bin" -n -v)"
  fpm_ver="${out%%$'\n'*}"
  printf '%s\n' "$fpm_ver" | grep -q '^PHP 8\.3\.37 '

  "$php_bin" -n \
    -d extension_dir="$ext_dir" \
    -d zend.assertions=1 \
    -d assert.exception=1 \
    -d zend_extension=opcache \
    -d opcache.enable_cli=1 \
    <<'EOF' | grep -Fxq 'PHP83_PKG_SMOKE_OK'
<?php
$prefix = realpath(getenv("PKG_PREFIX"));
assert(is_string($prefix) && str_starts_with(realpath(PHP_BINARY), $prefix . "/"));

$m = new WeakMap();
$o = new stdClass();
$wr = WeakReference::create($o);
$m[$o] = 1;
assert($wr->get() === $o);
unset($o);
gc_collect_cycles();
assert(count($m) === 0 && $wr->get() === null);

$f = new Fiber(function (string $s): string {
    $v = Fiber::suspend("hi:" . $s);
    return "ok:" . $v;
});
assert($f->start("filc") === "hi:filc");
assert($f->resume("83") === null && $f->getReturn() === "ok:83");

$xml = new DOMDocument();
$xml->loadXML('<root xmlns="urn:test"><child a="1">ok</child></root>');
assert(str_contains($xml->C14N(), '<child a="1">ok</child>'));

assert(opcache_get_status(false)["opcache_enabled"] === true);
assert(openssl_digest("hello\n", "sha256") === "5891b5b522d5df086d0ff0b110fbd9d21bb4fc7163af34d08286a2e846f6be03");
assert(gzuncompress(gzcompress("filc-zlib-php")) === "filc-zlib-php");
assert(bzdecompress(bzcompress("filc-bz2-php")) === "filc-bz2-php");
assert(preg_match('/^([a-z]+)-(\d+)$/', 'filc-83', $matches) === 1 && $matches[2] === '83');
assert(is_array(curl_version()) && !empty(curl_version()["version"]));
assert(mb_ereg_replace("([0-9]+)", "[\\1]", "v83") === "v[83]");
assert((new Collator("en_US"))->compare("a", "b") < 0);
assert(strlen(sodium_crypto_generichash("filc-sodium")) === SODIUM_CRYPTO_GENERICHASH_BYTES);
assert(bcadd("12345678901234567890", "1", 0) === "12345678901234567891");

$db = new SQLite3(":memory:");
$db->exec("CREATE TABLE t (v INT); INSERT INTO t VALUES (42);");
assert($db->querySingle("SELECT v FROM t") === 42);
$db->close();

echo "PHP83_PKG_SMOKE_OK\n";
EOF
}
