#!/usr/bin/env ruby
# frozen_string_literal: true

# Uploads a packaged, leak-gated, and minisign-signed Fil-C ports channel
# directory to filc-live using a dedicated least-privilege upload token
# (FILC_PORTS_UPLOAD_TOKEN). Refuses unsigned or inconsistent channels.

require "digest/sha2"
require "json"
require "net/http"
require "open3"
require "optparse"
require "uri"

Encoding.default_external = Encoding::UTF_8
Encoding.default_internal = Encoding::UTF_8

module PortsUploader
  DEFAULT_PUBKEY = File.expand_path("../ports/ports-pubkey.pub", __dir__)
  MAX_ARTIFACT_BYTES = 512 * 1024 * 1024
  SHA256_RE = /\A[0-9a-f]{64}\z/
  IPV4_EXACT_RE = /\A\d{1,3}(?:\.\d{1,3}){3}\z/
  CHANNEL_RE = /\A\d+\.\d+\.\d+(?:-[a-z0-9.]+)?\z/
  ARCH_RE = /\A(?:x86_64|aarch64)-linux\z/
  INFRA_WORDS = [
    %w[ci server].join("-"),
    %w[wood pecker].join,
    %w[prox mox].join,
    %w[hyper ingress].join("-")
  ].freeze
  WP_SEG = %w[wood pecker].join.freeze

  # Built-in hard-block patterns (identical to package-port; NEVER exempted).
  # Host-specific internal IPs, paths, and infra orgs come from FILC_LEAK_EXACT_TOKENS
  # rather than generic private-IP regexes that false-positive on upstream docs/versions.
  HARD_FORBIDDEN_RE = [
    ["infra_word", Regexp.new("(?<![A-Za-z0-9_-])(?:#{INFRA_WORDS.join('|')})(?![A-Za-z0-9_-])", Regexp::IGNORECASE)],
    ["ccache_path", %r{(?<![A-Za-z0-9_.-])/ccache(?:/|(?![A-Za-z0-9_.-]))}],
    ["wp_path", Regexp.new("(?<![A-Za-z0-9_.-])/#{WP_SEG}(?:/|(?![A-Za-z0-9_.-]))")],
    ["work_path", %r{(?<![A-Za-z0-9_.-])/\.work(?:/|(?![A-Za-z0-9_.-]))}]
  ].freeze

  module_function

  def file_sha256(path)
    sha = Digest::SHA256.new
    File.open(path, "rb") do |f|
      while (buf = f.read(65_536))
        sha.update(buf)
      end
    end
    sha.hexdigest
  end

  def compile_exact_token_regex(token)
    escaped = Regexp.escape(token)
    if IPV4_EXACT_RE.match?(token)
      Regexp.new("(?<![0-9.])#{escaped}(?![0-9]|\\.[0-9])")
    elsif token.start_with?("/")
      if token.end_with?("/")
        Regexp.new("(?<![A-Za-z0-9_.-])#{escaped}")
      else
        Regexp.new("(?<![A-Za-z0-9_.-])#{escaped}(?![A-Za-z0-9_.-])")
      end
    elsif token.include?("://") || token.include?(".")
      Regexp.new("(?<![A-Za-z0-9_.-])#{escaped}(?![A-Za-z0-9_.-])", Regexp::IGNORECASE)
    else
      Regexp.new("(?<![A-Za-z0-9_-])#{escaped}(?![A-Za-z0-9_-])", Regexp::IGNORECASE)
    end
  end

  def load_exact_tokens!(env_var: "FILC_LEAK_EXACT_TOKENS")
    raw = ENV[env_var]
    if raw.nil? || raw.strip.empty?
      raise "LEAK_GATE CONFIG ERROR: required exact-token secret env #{env_var} is missing or empty"
    end

    rules = []
    raw.each_line do |line|
      tok = line.strip
      next if tok.empty? || tok.start_with?("#")

      rules << { idx: rules.length + 1, regex: compile_exact_token_regex(tok), length: tok.length }
    end
    if rules.empty?
      raise "LEAK_GATE CONFIG ERROR: required exact-token secret env #{env_var} contains no active tokens"
    end

    rules
  end

  def leak_check_text!(label, text, exact_rules:)
    exact_rules.each do |rule|
      if rule[:regex].match?(text)
        raise "LEAK_GATE FAILED on #{label}: matches exact forbidden infra token ##{rule[:idx]} (len=#{rule[:length]})"
      end
    end
    HARD_FORBIDDEN_RE.each do |pat_name, re|
      if (m = re.match(text))
        raise "LEAK_GATE FAILED on #{label}: matches forbidden #{pat_name} #{m[0].strip.inspect}"
      end
    end
  end

  def verify_provenance_metadata!(label, provenance_allowed)
    return if provenance_allowed.nil?
    raise "LEAK_GATE FAILED on #{label}: provenance_allowed must be a JSON object" unless provenance_allowed.is_a?(Hash)

    provenance_allowed.each do |pkg_key, entries|
      Array(entries).each do |entry|
        next unless entry.is_a?(Hash)

        if entry.key?("token")
          raise "LEAK_GATE FAILED on #{label}: plaintext provenance token forbidden in metadata (#{pkg_key})"
        end
        unless SHA256_RE.match?(entry["token_sha256"].to_s)
          raise "LEAK_GATE FAILED on #{label}: provenance entry missing valid token_sha256 (#{pkg_key})"
        end
      end
    end
  end

  def verify_minisign!(file_path, sig_path, pubkey_path)
    raise "refusing upload: minisign public key not found: #{pubkey_path}" unless pubkey_path && File.file?(pubkey_path)

    out, err, st = Open3.capture3("minisign", "-Vm", file_path, "-p", pubkey_path, "-x", sig_path)
    return if st.success?

    raise "minisign verification failed for #{File.basename(file_path)}: #{err.strip} #{out.strip}".strip
  rescue Errno::ENOENT
    raise "refusing upload: minisign binary not found in PATH for signature verification"
  end

  def verify_channel_before_upload!(channel_dir, channel, arch, pubkey_path: nil, verify_sig: true, max_artifact_bytes: MAX_ARTIFACT_BYTES, exact_rules: [])
    index_path = File.join(channel_dir, "index.json")
    index_sig_path = File.join(channel_dir, "index.json.minisig")
    sums_path = File.join(channel_dir, "SHA256SUMS")
    sums_sig_path = File.join(channel_dir, "SHA256SUMS.minisig")

    [index_path, index_sig_path, sums_path, sums_sig_path].each do |req|
      raise "refusing upload: missing required channel file #{req}" unless File.file?(req)
    end

    if verify_sig
      verify_minisign!(index_path, index_sig_path, pubkey_path)
      verify_minisign!(sums_path, sums_sig_path, pubkey_path)
    end

    index_raw = File.read(index_path, encoding: "UTF-8")
    index_sig = File.read(index_sig_path, encoding: "UTF-8")
    sums_raw = File.read(sums_path, encoding: "UTF-8")
    sums_sig = File.read(sums_sig_path, encoding: "UTF-8")

    leak_check_text!("index.json", index_raw, exact_rules: exact_rules)
    leak_check_text!("SHA256SUMS", sums_raw, exact_rules: exact_rules)

    parsed = JSON.parse(index_raw)
    raise "index.json channel mismatch (#{parsed['channel']} != #{channel})" unless parsed["channel"] == channel
    raise "index.json arch mismatch (#{parsed['arch']} != #{arch})" unless parsed["arch"] == arch
    raise "index.json packages must be non-empty" unless parsed["packages"].is_a?(Hash) && !parsed["packages"].empty?

    uploads = { "src" => [], "recipes" => [], "bin" => [] }
    packages = []
    seen = {}

    parsed["packages"].keys.sort.each do |pkg_name|
      entry = parsed["packages"][pkg_name]
      pkg_items = []
      %w[source recipe binary].each do |kind|
        art = entry[kind]
        raise "package #{pkg_name} missing #{kind} entry" unless art.is_a?(Hash) && art["path"].is_a?(String) && SHA256_RE.match?(art["sha256"].to_s)

        rel = art["path"]
        bucket = rel.split("/", 2).first
        full = File.join(channel_dir, rel)
        raise "missing artifact file #{full}" unless File.file?(full)

        actual = file_sha256(full)
        raise "SHA-256 mismatch for #{rel} (index=#{art['sha256']}, disk=#{actual})" unless actual == art["sha256"]

        size = File.size(full)
        if size > max_artifact_bytes
          raise format(
            "SIZE_LIMIT FAILED: refusing upload of %s (%d bytes / %.2f MiB exceeds %d bytes / %.2f MiB limit)",
            rel, size, size.to_f / (1024 * 1024), max_artifact_bytes, max_artifact_bytes.to_f / (1024 * 1024)
          )
        end

        item = { rel: rel, full: full, sha256: actual, size: size, bucket: bucket }
        pkg_items << item
        next if seen[rel]

        seen[rel] = true
        uploads[bucket] << item
      end
      packages << { name: pkg_name, items: pkg_items }
    end

    {
      index_raw: index_raw,
      index_sig: index_sig,
      sums_raw: sums_raw,
      sums_sig: sums_sig,
      uploads: uploads,
      packages: packages,
      package_count: parsed["packages"].size
    }
  end

  def verify_staged_port_before_upload!(channel_dir, meta_path, channel, arch, max_artifact_bytes: MAX_ARTIFACT_BYTES, exact_rules: [])
    raise "refusing staged upload: missing port metadata file #{meta_path}" unless File.file?(meta_path)

    raw = File.read(meta_path, encoding: "UTF-8")
    leak_check_text!(File.basename(meta_path), raw, exact_rules: exact_rules)
    parsed = JSON.parse(raw)
    verify_provenance_metadata!(File.basename(meta_path), parsed["provenance_allowed"])
    raise "staged meta channel mismatch (#{parsed['channel']} != #{channel})" unless parsed["channel"] == channel
    raise "staged meta arch mismatch (#{parsed['arch']} != #{arch})" unless parsed["arch"] == arch

    pkg_name = parsed["name"].to_s
    entry = parsed["package"]
    raise "staged meta missing package entry" unless !pkg_name.empty? && entry.is_a?(Hash)

    items = []
    %w[source recipe binary].each do |kind|
      art = entry[kind]
      raise "staged package #{pkg_name} missing #{kind} entry" unless art.is_a?(Hash) && art["path"].is_a?(String) && SHA256_RE.match?(art["sha256"].to_s)

      rel = art["path"]
      bucket = rel.split("/", 2).first
      full = File.join(channel_dir, rel)
      raise "missing staged artifact file #{full}" unless File.file?(full)

      actual = file_sha256(full)
      raise "SHA-256 mismatch for #{rel} (meta=#{art['sha256']}, disk=#{actual})" unless actual == art["sha256"]

      size = File.size(full)
      if size > max_artifact_bytes
        raise format(
          "SIZE_LIMIT FAILED: refusing upload of %s (%d bytes / %.2f MiB exceeds %d bytes / %.2f MiB limit)",
          rel, size, size.to_f / (1024 * 1024), max_artifact_bytes, max_artifact_bytes.to_f / (1024 * 1024)
        )
      end

      items << { rel: rel, full: full, sha256: actual, size: size, bucket: bucket }
    end

    { name: pkg_name, items: items }
  end

  def http_for(uri)
    http = Net::HTTP.new(uri.host, uri.port)
    http.use_ssl = uri.scheme == "https"
    http.open_timeout = 15
    http.read_timeout = 300
    http.write_timeout = 300 if http.respond_to?(:write_timeout=)
    http
  end

  def head_verify_artifact(base_uri, channel, arch, item, token)
    path = "/api/ports-artifacts/#{channel}/#{arch}/#{item[:rel]}"
    http = http_for(base_uri)
    head_req = Net::HTTP::Head.new(path)
    head_req["Authorization"] = "Bearer #{token}"
    head_res = http.request(head_req)
    return [false, "http=#{head_res.code}(#{item[:rel]})"] unless head_res.code == "200"

    got_sha = head_res["x-content-sha256"].to_s
    return [false, "sha_mismatch(#{item[:rel]}:got=#{got_sha[0, 12]},want=#{item[:sha256][0, 12]})"] unless got_sha == item[:sha256]

    [true, "ok"]
  rescue StandardError => e
    [false, "error=#{e.class}:#{e.message}"]
  end

  def upload_artifact(base_uri, channel, arch, item, token)
    path = "/api/ports-artifacts/#{channel}/#{arch}/#{item[:rel]}"
    http = http_for(base_uri)

    # 1. Idempotency check via HEAD
    head_req = Net::HTTP::Head.new(path)
    head_req["Authorization"] = "Bearer #{token}"
    head_res = http.request(head_req)
    if head_res.code == "200" && head_res["x-content-sha256"] == item[:sha256]
      return :skipped
    end

    # 2. Streaming PUT (never loads full tarball into RAM)
    File.open(item[:full], "rb") do |io|
      put_req = Net::HTTP::Put.new(path)
      put_req["Authorization"] = "Bearer #{token}"
      put_req["Content-Type"] = "application/octet-stream"
      put_req["Content-Length"] = item[:size].to_s
      put_req["X-Content-SHA256"] = item[:sha256]
      put_req.body_stream = io
      res = http.request(put_req)
      unless %w[200 201].include?(res.code)
        raise "PUT #{path} failed (#{res.code}): #{res.body}"
      end
    end
    :uploaded
  end

  def commit_index(base_uri, channel, arch, verified, token)
    path = "/api/ports-artifacts/#{channel}/#{arch}/commit-index"
    http = http_for(base_uri)
    req = Net::HTTP::Post.new(path)
    req["Authorization"] = "Bearer #{token}"
    req["Content-Type"] = "application/json"
    req.body = JSON.generate(
      "index_json" => verified[:index_raw],
      "index_minisig" => verified[:index_sig],
      "sha256sums" => verified[:sums_raw],
      "sha256sums_minisig" => verified[:sums_sig]
    )
    res = http.request(req)
    raise "POST #{path} failed (#{res.code}): #{res.body}" unless res.code == "200"

    JSON.parse(res.body)
  end

  def main(argv)
    default_pub = ENV["FILC_PORTS_PUBKEY"].to_s.strip
    default_pub = DEFAULT_PUBKEY if default_pub.empty? && File.file?(DEFAULT_PUBKEY)
    opts = {
      channel_dir: nil,
      channel: nil,
      arch: "x86_64-linux",
      base_url: ENV["FILC_PORTS_UPLOAD_URL"].to_s.strip,
      token_env: "FILC_PORTS_UPLOAD_TOKEN",
      exact_tokens_env: "FILC_LEAK_EXACT_TOKENS",
      pubkey_path: default_pub.empty? ? nil : default_pub,
      verify_sig: true,
      dry_run: false,
      parallel: 4,
      stage_port_meta: nil,
      head_verify_meta: nil,
      commit_only: false,
      max_artifact_bytes: MAX_ARTIFACT_BYTES
    }

    parser = OptionParser.new do |o|
      o.banner = "Usage: scripts/upload-ports [options]"
      o.on("--channel-dir DIR", "Directory containing channel/<arch>/index.json or <out-dir>/<channel>/<arch>") { |v| opts[:channel_dir] = File.expand_path(v) }
      o.on("--channel VERSION", "Toolchain release channel (e.g. 0.1.3)") { |v| opts[:channel] = v }
      o.on("--arch ARCH", "Target architecture (default: x86_64-linux)") { |v| opts[:arch] = v }
      o.on("--base-url URL", "filc-live base URL") { |v| opts[:base_url] = v }
      o.on("--token-env VAR", "Env var containing upload token (default: FILC_PORTS_UPLOAD_TOKEN)") { |v| opts[:token_env] = v }
      o.on("--exact-tokens-env VAR", "Env var containing exact forbidden infra tokens (default: FILC_LEAK_EXACT_TOKENS)") { |v| opts[:exact_tokens_env] = v }
      o.on("--pubkey PATH", "Minisign public key file to verify channel signatures (default: ports/ports-pubkey.pub)") { |v| opts[:pubkey_path] = File.expand_path(v) }
      o.on("--stage-port-meta PATH", "Upload one verified port's artifacts (src/recipes/bin) without committing index.json") { |v| opts[:stage_port_meta] = File.expand_path(v) }
      o.on("--head-verify-meta PATH", "Check via HEAD + X-Content-SHA256 only that a cached port's artifacts exist on server (zero GET/PUT)") { |v| opts[:head_verify_meta] = File.expand_path(v) }
      o.on("--commit-only", "Verify signed index.json + SHA256SUMS, ensure all artifacts exist on server, and commit index atomically") { opts[:commit_only] = true }
      o.on("--max-artifact-bytes N", Integer, "Maximum allowed artifact size in bytes (default: 536870912 / 512 MiB)") do |v|
        raise OptionParser::InvalidArgument, "--max-artifact-bytes must be >= 1" if v < 1

        opts[:max_artifact_bytes] = v
      end
      o.on("--allow-unsigned-test", "Skip cryptographic minisign verification (unit tests only)") { opts[:verify_sig] = false }
      o.on("--dry-run", "Verify locally without uploading") { opts[:dry_run] = true }
      o.on("-j", "--parallel N", Integer, "Concurrent package upload workers (1..8, default: 4)") { |v| opts[:parallel] = v.clamp(1, 8) }
    end
    parser.parse!(argv)

    raise ArgumentError, "--channel-dir is required" if opts[:channel_dir].nil? || opts[:channel_dir].empty?
    raise ArgumentError, "--channel invalid" unless CHANNEL_RE.match?(opts[:channel].to_s)
    raise ArgumentError, "--arch invalid" unless ARCH_RE.match?(opts[:arch].to_s)
    if [opts[:stage_port_meta], opts[:head_verify_meta], opts[:commit_only]].count { |v| v } > 1
      raise ArgumentError, "--stage-port-meta, --head-verify-meta, and --commit-only are mutually exclusive"
    end

    if opts[:head_verify_meta]
      raise "missing metadata file #{opts[:head_verify_meta]}" unless File.file?(opts[:head_verify_meta])

      parsed = JSON.parse(File.read(opts[:head_verify_meta], encoding: "UTF-8"))
      raise "channel mismatch" unless parsed["channel"] == opts[:channel]
      raise "arch mismatch" unless parsed["arch"] == opts[:arch]

      pkg_name = parsed["name"].to_s
      entry = parsed["package"]
      raise "invalid package metadata" unless !pkg_name.empty? && entry.is_a?(Hash)

      items = %w[source recipe binary].map do |kind|
        art = entry[kind]
        raise "missing #{kind} entry" unless art.is_a?(Hash) && art["path"].is_a?(String) && SHA256_RE.match?(art["sha256"].to_s)

        { rel: art["path"], sha256: art["sha256"] }
      end

      token = ENV[opts[:token_env]].to_s.strip
      raise "missing upload token in env #{opts[:token_env]}" if token.empty?
      raise ArgumentError, "--base-url or FILC_PORTS_UPLOAD_URL is required" if opts[:base_url].empty?

      base_uri = URI.parse(opts[:base_url])
      miss_reason = nil
      all_present = items.all? do |item|
        ok, reason = head_verify_artifact(base_uri, opts[:channel], opts[:arch], item, token)
        miss_reason = reason unless ok
        ok
      end
      if all_present
        puts "UPLOAD_PORTS_HEAD_VERIFY: HIT port=#{pkg_name} channel=#{opts[:channel]} arch=#{opts[:arch]} files=#{items.length}"
        return 0
      else
        puts "UPLOAD_PORTS_HEAD_VERIFY: MISS port=#{pkg_name} channel=#{opts[:channel]} arch=#{opts[:arch]} reason=#{miss_reason}"
        return 1
      end
    end

    if opts[:stage_port_meta]
      exact_rules = load_exact_tokens!(env_var: opts[:exact_tokens_env])
      staged = verify_staged_port_before_upload!(
        opts[:channel_dir], opts[:stage_port_meta], opts[:channel], opts[:arch],
        max_artifact_bytes: opts[:max_artifact_bytes],
        exact_rules: exact_rules
      )
      if opts[:dry_run]
        puts "UPLOAD_PORTS_STAGE: DRY_RUN OK port=#{staged[:name]} channel=#{opts[:channel]} arch=#{opts[:arch]} files=#{staged[:items].length}"
        return 0
      end

      token = ENV[opts[:token_env]].to_s.strip
      raise "missing upload token in env #{opts[:token_env]}" if token.empty?
      raise ArgumentError, "--base-url or FILC_PORTS_UPLOAD_URL is required" if opts[:base_url].empty?

      base_uri = URI.parse(opts[:base_url])
      uploaded = 0
      skipped = 0
      staged[:items].each do |item|
        st = upload_artifact(base_uri, opts[:channel], opts[:arch], item, token)
        if st == :uploaded
          uploaded += 1
        else
          skipped += 1
        end
      end
      puts "UPLOAD_PORTS_STAGE: OK port=#{staged[:name]} channel=#{opts[:channel]} arch=#{opts[:arch]} uploaded=#{uploaded} skipped=#{skipped}"
      return 0
    end

    exact_rules = load_exact_tokens!(env_var: opts[:exact_tokens_env])
    verified = verify_channel_before_upload!(
      opts[:channel_dir], opts[:channel], opts[:arch],
      pubkey_path: opts[:pubkey_path], verify_sig: opts[:verify_sig],
      max_artifact_bytes: opts[:max_artifact_bytes],
      exact_rules: exact_rules
    )
    if opts[:dry_run]
      puts "UPLOAD_PORTS: DRY_RUN OK channel=#{opts[:channel]} arch=#{opts[:arch]} packages=#{verified[:package_count]}"
      return 0
    end

    token = ENV[opts[:token_env]].to_s.strip
    raise "missing upload token in env #{opts[:token_env]}" if token.empty?
    raise ArgumentError, "--base-url or FILC_PORTS_UPLOAD_URL is required" if opts[:base_url].empty?

    base_uri = URI.parse(opts[:base_url])
    packages = verified[:packages]
    total_pkgs = packages.length
    workers = [opts[:parallel], total_pkgs].min
    workers = 1 if workers < 1

    queue = Queue.new
    packages.each { |pkg| queue << pkg }
    workers.times { queue << nil }

    mu = Mutex.new
    uploaded_rel = {}
    uploaded = 0
    skipped = 0
    done_pkgs = 0
    first_error = nil

    threads = Array.new(workers) do
      Thread.new do
        while (pkg = queue.pop)
          break if mu.synchronize { !first_error.nil? }

          pkg_name = pkg[:name]
          unless opts[:commit_only]
            mu.synchronize do
              $stdout.puts("FILC_PORT #{pkg_name} uploading stage=upload")
              $stdout.flush
            end
          end

          begin
            # Strictly preserve per-package src -> recipes -> bin upload order
            # (idempotent via HEAD: already-staged ports skip immediately in --commit-only mode).
            pkg[:items].each do |item|
              rel = item[:rel]
              already = mu.synchronize do
                if uploaded_rel.key?(rel)
                  true
                else
                  uploaded_rel[rel] = :in_flight
                  false
                end
              end
              next if already

              st = upload_artifact(base_uri, opts[:channel], opts[:arch], item, token)
              mu.synchronize do
                uploaded_rel[rel] = st
                if st == :uploaded
                  uploaded += 1
                else
                  skipped += 1
                end
              end
            end

            mu.synchronize do
              done_pkgs += 1
              unless opts[:commit_only]
                $stdout.puts("FILC_PORT #{pkg_name} uploaded stage=upload")
                $stdout.puts("FILC_STAGE_PROGRESS upload #{done_pkgs}/#{total_pkgs} #{pkg_name}")
                $stdout.flush
              end
            end
          rescue StandardError => e
            mu.synchronize { first_error ||= e }
          end
        end
      end
    end
    threads.each(&:join)
    raise first_error if first_error

    # Atomic publish boundary: commit-index is ONLY invoked once 100% of packages succeeded.
    result = commit_index(base_uri, opts[:channel], opts[:arch], verified, token)
    mode_tag = opts[:commit_only] ? "COMMIT_ONLY " : ""
    puts "UPLOAD_PORTS: #{mode_tag}OK channel=#{opts[:channel]} arch=#{opts[:arch]} packages=#{result['packages']} uploaded=#{uploaded} skipped=#{skipped}"
    0
  end
end

exit(PortsUploader.main(ARGV)) if $PROGRAM_NAME == __FILE__
